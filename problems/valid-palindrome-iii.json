    "problemName": "valid-palindrome-iii",
    "language": "python3",
    "code": "class Solution:\r\n    def isValidPalindrome(self, s: str, k: int) -> bool:\r\n        n = len(s)\r\n        f = [[0] * n for _ in range(n)]\r\n        for i in range(n):\r\n            f[i][i] = 1\r\n        for i in range(n - 2, -1, -1):\r\n            for j in range(i + 1, n):\r\n                if s[i] == s[j]:\r\n                    f[i][j] = f[i + 1][j - 1] + 2\r\n                else:\r\n                    f[i][j] = max(f[i + 1][j], f[i][j - 1])\r\n                if f[i][j] + k >= n:\r\n                    return True\r\n        return False",
