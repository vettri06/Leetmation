{
    "problemName": "minimum-number-of-keypresses",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumKeypresses(self, s: str) -> int:\r\n        cnt = Counter(s)\r\n        ans, k = 0, 1\r\n        for i, x in enumerate(sorted(cnt.values(), reverse=True), 1):\r\n            ans += k * x\r\n            if i % 9 == 0:\r\n                k += 1\r\n        return ans",
