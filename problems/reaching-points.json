{
    "problemName": "reaching-points",
    "language": "python3",
    "code": "class Solution:\r\n    def reachingPoints(self, sx: int, sy: int, tx: int, ty: int) -> bool:\r\n        while tx > sx and ty > sy and tx != ty:\r\n            if tx > ty:\r\n                tx %= ty\r\n            else:\r\n                ty %= tx\r\n        if tx == sx and ty == sy:\r\n            return True\r\n        if tx == sx:\r\n            return ty > sy and (ty - sy) % tx == 0\r\n        if ty == sy:\r\n            return tx > sx and (tx - sx) % ty == 0\r\n        return False",
