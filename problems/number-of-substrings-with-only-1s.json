    "problemName": "number-of-substrings-with-only-1s",
    "language": "python3",
    "code": "class Solution:\r\n    def numSub(self, s: str) -> int:\r\n        mod = 10**9 + 7\r\n        ans = cur = 0\r\n        for c in s:\r\n            if c == \"0\":\r\n                cur = 0\r\n            else:\r\n                cur += 1\r\n                ans = (ans + cur) % mod\r\n        return ans",
