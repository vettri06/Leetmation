{
    "problemName": "minimum-cost-to-reach-every-position",
    "language": "python3",
    "code": "class Solution:\r\n    def minCosts(self, cost: List[int]) -> List[int]:\r\n        n = len(cost)\r\n        ans = [0] * n\r\n        mi = cost[0]\r\n        for i, c in enumerate(cost):\r\n            mi = min(mi, c)\r\n            ans[i] = mi\r\n        return ans",
