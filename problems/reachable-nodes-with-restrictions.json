{
    "problemName": "reachable-nodes-with-restrictions",
    "language": "python3",
    "code": "class Solution:\r\n    def reachableNodes(\r\n        self, n: int, edges: List[List[int]], restricted: List[int]\r\n    ) -> int:\r\n        def dfs(i: int) -> int:\r\n            vis.add(i)\r\n            return 1 + sum(j not in vis and dfs(j) for j in g[i])\r\n\r\n        g = defaultdict(list)\r\n        for a, b in edges:\r\n            g[a].append(b)\r\n            g[b].append(a)\r\n        vis = set(restricted)\r\n        return dfs(0)",
