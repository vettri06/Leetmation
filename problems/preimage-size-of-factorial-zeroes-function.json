{
    "problemName": "preimage-size-of-factorial-zeroes-function",
    "language": "python3",
    "code": "class Solution:\r\n    def preimageSizeFZF(self, k: int) -> int:\r\n        def f(x):\r\n            if x == 0:\r\n                return 0\r\n            return x // 5 + f(x // 5)\r\n\r\n        def g(k):\r\n            return bisect_left(range(5 * k), k, key=f)\r\n\r\n        return g(k + 1) - g(k)",
