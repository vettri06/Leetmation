    "problemName": "number-of-zero-filled-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def zeroFilledSubarray(self, nums: List[int]) -> int:\r\n        ans = cnt = 0\r\n        for x in nums:\r\n            if x == 0:\r\n                cnt += 1\r\n                ans += cnt\r\n            else:\r\n                cnt = 0\r\n        return ans",
