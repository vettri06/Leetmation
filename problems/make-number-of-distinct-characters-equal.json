{
    "problemName": "make-number-of-distinct-characters-equal",
    "language": "python3",
    "code": "class Solution:\r\n    def isItPossible(self, word1: str, word2: str) -> bool:\r\n        cnt1 = Counter(word1)\r\n        cnt2 = Counter(word2)\r\n        x, y = len(cnt1), len(cnt2)\r\n        for c1, v1 in cnt1.items():\r\n            for c2, v2 in cnt2.items():\r\n                if c1 == c2:\r\n                    if x == y:\r\n                        return True\r\n                else:\r\n                    a = x - (v1 == 1) + (cnt1[c2] == 0)\r\n                    b = y - (v2 == 1) + (cnt2[c1] == 0)\r\n                    if a == b:\r\n                        return True\r\n        return False",
