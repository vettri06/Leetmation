{
    "problemName": "move-pieces-to-obtain-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def canChange(self, start: str, target: str) -> bool:\r\n        a = [(v, i) for i, v in enumerate(start) if v != '_']\r\n        b = [(v, i) for i, v in enumerate(target) if v != '_']\r\n        if len(a) != len(b):\r\n            return False\r\n        for (c, i), (d, j) in zip(a, b):\r\n            if c != d:\r\n                return False\r\n            if c == 'L' and i < j:\r\n                return False\r\n            if c == 'R' and i > j:\r\n                return False\r\n        return True",
