{
    "problemName": "number-of-wonderful-substrings",
    "language": "python3",
    "code": "class Solution:\r\n    def wonderfulSubstrings(self, word: str) -> int:\r\n        cnt = defaultdict(int)\r\n        cnt[0] = 1\r\n        ans = st = 0\r\n        for c in word:\r\n            st ^= 1 << (ord(c) - ord(\"a\"))\r\n            ans += cnt[st]\r\n            ans += sum(cnt[st ^ (1 << i)] for i in range(10))\r\n            cnt[st] += 1\r\n        return ans",
