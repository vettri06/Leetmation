    "problemName": "previous-permutation-with-one-swap",
    "language": "python3",
    "code": "class Solution:\r\n    def prevPermOpt1(self, arr: List[int]) -> List[int]:\r\n        n = len(arr)\r\n        for i in range(n - 1, 0, -1):\r\n            if arr[i - 1] > arr[i]:\r\n                for j in range(n - 1, i - 1, -1):\r\n                    if arr[j] < arr[i - 1] and arr[j] != arr[j - 1]:\r\n                        arr[i - 1], arr[j] = arr[j], arr[i - 1]\r\n                        return arr\r\n        return arr",
