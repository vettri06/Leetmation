{
    "problemName": "3sum-with-multiplicity",
    "language": "python3",
    "code": "class Solution:\r\n    def threeSumMulti(self, arr: List[int], target: int) -> int:\r\n        mod = 10**9 + 7\r\n        cnt = Counter(arr)\r\n        ans = 0\r\n        for j, b in enumerate(arr):\r\n            cnt[b] -= 1\r\n            for a in arr[:j]:\r\n                c = target - a - b\r\n                ans = (ans + cnt[c]) % mod\r\n        return ans",
