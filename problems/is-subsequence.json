    "problemName": "is-subsequence",
    "language": "python3",
    "code": "class Solution:\r\n    def isSubsequence(self, s: str, t: str) -> bool:\r\n        i = j = 0\r\n        while i < len(s) and j < len(t):\r\n            if s[i] == t[j]:\r\n                i += 1\r\n            j += 1\r\n        return i == len(s)",
