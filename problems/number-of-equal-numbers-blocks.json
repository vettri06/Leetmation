{
    "problemName": "number-of-equal-numbers-blocks",
    "language": "python3",
    "code": "# Definition for BigArray.\r\n# class BigArray:\r\n#     def at(self, index: long) -> int:\r\n#         pass\r\n#     def size(self) -> long:\r\n#         pass\r\nclass Solution(object):\r\n    def countBlocks(self, nums: Optional[\"BigArray\"]) -> int:\r\n        i, n = 0, nums.size()\r\n        ans = 0\r\n        while i < n:\r\n            ans += 1\r\n            x = nums.at(i)\r\n            if i + 1 < n and nums.at(i + 1) != x:\r\n                i += 1\r\n            else:\r\n                i += bisect_left(range(i, n), True, key=lambda j: nums.at(j) != x)\r\n        return ans",
