    "language": "python3",
    "code": "class Solution:\r\n    def escapeGhosts(self, ghosts: List[List[int]], target: List[int]) -> bool:\r\n        tx, ty = target\r\n        return all(abs(tx - x) + abs(ty - y) > abs(tx) + abs(ty) for x, y in ghosts)",
