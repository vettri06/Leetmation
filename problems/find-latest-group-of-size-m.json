    "problemName": "find-latest-group-of-size-m",
    "language": "python3",
    "code": "class Solution:\r\n    def findLatestStep(self, arr: List[int], m: int) -> int:\r\n        def find(x):\r\n            if p[x] != x:\r\n                p[x] = find(p[x])\r\n            return p[x]\r\n\r\n        def union(a, b):\r\n            pa, pb = find(a), find(b)\r\n            if pa == pb:\r\n                return\r\n            p[pa] = pb\r\n            size[pb] += size[pa]\r\n\r\n        n = len(arr)\r\n        if m == n:\r\n            return n\r\n        vis = [False] * n\r\n        p = list(range(n))\r\n        size = [1] * n\r\n        ans = -1\r\n        for i, v in enumerate(arr):\r\n            v -= 1\r\n            if v and vis[v - 1]:\r\n                if size[find(v - 1)] == m:\r\n                    ans = i\r\n                union(v, v - 1)\r\n            if v < n - 1 and vis[v + 1]:\r\n                if size[find(v + 1)] == m:\r\n                    ans = i\r\n                union(v, v + 1)\r\n            vis[v] = True\r\n        return ans",
