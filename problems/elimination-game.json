{
    "problemName": "elimination-game",
    "language": "python3",
    "code": "class Solution:\r\n    def lastRemaining(self, n: int) -> int:\r\n        a1, an = 1, n\r\n        i, step, cnt = 0, 1, n\r\n        while cnt > 1:\r\n            if i % 2:\r\n                an -= step\r\n                if cnt % 2:\r\n                    a1 += step\r\n            else:\r\n                a1 += step\r\n                if cnt % 2:\r\n                    an -= step\r\n            cnt >>= 1\r\n            step <<= 1\r\n            i += 1\r\n        return a1",
