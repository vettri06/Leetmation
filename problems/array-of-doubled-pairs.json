    "problemName": "array-of-doubled-pairs",
    "language": "python3",
    "code": "class Solution:\r\n    def canReorderDoubled(self, arr: List[int]) -> bool:\r\n        freq = Counter(arr)\r\n        if freq[0] & 1:\r\n            return False\r\n        for x in sorted(freq, key=abs):\r\n            if freq[x << 1] < freq[x]:\r\n                return False\r\n            freq[x << 1] -= freq[x]\r\n        return True",
