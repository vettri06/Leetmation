    "problemName": "maximum-number-of-removable-characters",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumRemovals(self, s: str, p: str, removable: List[int]) -> int:\r\n        def check(k: int) -> bool:\r\n            rem = [False] * len(s)\r\n            for i in removable[:k]:\r\n                rem[i] = True\r\n            i = j = 0\r\n            while i < len(s) and j < len(p):\r\n                if not rem[i] and p[j] == s[i]:\r\n                    j += 1\r\n                i += 1\r\n            return j == len(p)\r\n\r\n        l, r = 0, len(removable)\r\n        while l < r:\r\n            mid = (l + r + 1) >> 1\r\n            if check(mid):\r\n                l = mid\r\n            else:\r\n                r = mid - 1\r\n        return l",
