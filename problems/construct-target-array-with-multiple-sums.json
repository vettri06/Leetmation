{
    "problemName": "construct-target-array-with-multiple-sums",
    "language": "python3",
    "code": "class Solution:\r\n    def isPossible(self, target: List[int]) -> bool:\r\n        s = sum(target)\r\n        pq = [-x for x in target]\r\n        heapify(pq)\r\n        while -pq[0] > 1:\r\n            mx = -heappop(pq)\r\n            t = s - mx\r\n            if t == 0 or mx - t < 1:\r\n                return False\r\n            x = (mx % t) or t\r\n            heappush(pq, -x)\r\n            s = s - mx + x\r\n        return True",
