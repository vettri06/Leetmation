    "code": "# The rand7() API is already defined for you.\r\n# def rand7():\r\n# @return a random integer in the range 1 to 7\r\n\r\n\r\nclass Solution:\r\n    def rand10(self):\r\n        \"\"\"\r\n        :rtype: int\r\n        \"\"\"\r\n        while 1:\r\n            i = rand7() - 1\r\n            j = rand7()\r\n            x = i * 7 + j\r\n            if x <= 40:\r\n                return x % 10 + 1",
