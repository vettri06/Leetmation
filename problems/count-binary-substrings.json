{
    "problemName": "count-binary-substrings",
    "language": "python3",
    "code": "class Solution:\r\n    def countBinarySubstrings(self, s: str) -> int:\r\n        n = len(s)\r\n        ans = i = 0\r\n        pre = 0\r\n        while i < n:\r\n            j = i + 1\r\n            while j < n and s[j] == s[i]:\r\n                j += 1\r\n            cur = j - i\r\n            ans += min(pre, cur)\r\n            pre = cur\r\n            i = j\r\n        return ans",
