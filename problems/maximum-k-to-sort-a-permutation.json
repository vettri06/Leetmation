    "problemName": "maximum-k-to-sort-a-permutation",
    "language": "python3",
    "code": "class Solution:\r\n    def sortPermutation(self, nums: List[int]) -> int:\r\n        ans = -1\r\n        for i, x in enumerate(nums):\r\n            if i != x:\r\n                ans &= x\r\n        return max(ans, 0)",
