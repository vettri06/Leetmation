{
    "problemName": "3sum-smaller",
    "language": "python3",
    "code": "class Solution:\r\n    def threeSumSmaller(self, nums: List[int], target: int) -> int:\r\n        nums.sort()\r\n        ans, n = 0, len(nums)\r\n        for i in range(n - 2):\r\n            j, k = i + 1, n - 1\r\n            while j < k:\r\n                x = nums[i] + nums[j] + nums[k]\r\n                if x < target:\r\n                    ans += k - j\r\n                    j += 1\r\n                else:\r\n                    k -= 1\r\n        return ans",
