    "problemName": "longest-common-subsequence-between-sorted-arrays",
    "language": "python3",
    "code": "class Solution:\r\n    def longestCommonSubsequence(self, arrays: List[List[int]]) -> List[int]:\r\n        cnt = [0] * 101\r\n        for row in arrays:\r\n            for x in row:\r\n                cnt[x] += 1\r\n        return [x for x, v in enumerate(cnt) if v == len(arrays)]",
