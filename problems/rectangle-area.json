{
    "problemName": "rectangle-area",
    "language": "python3",
    "code": "class Solution:\r\n    def computeArea(\r\n        self,\r\n        ax1: int,\r\n        ay1: int,\r\n        ax2: int,\r\n        ay2: int,\r\n        bx1: int,\r\n        by1: int,\r\n        bx2: int,\r\n        by2: int,\r\n    ) -> int:\r\n        a = (ax2 - ax1) * (ay2 - ay1)\r\n        b = (bx2 - bx1) * (by2 - by1)\r\n        width = min(ax2, bx2) - max(ax1, bx1)\r\n        height = min(ay2, by2) - max(ay1, by1)\r\n        return a + b - max(height, 0) * max(width, 0)",
