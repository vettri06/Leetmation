    "problemName": "water-bottles-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def maxBottlesDrunk(self, numBottles: int, numExchange: int) -> int:\r\n        ans = numBottles\r\n        while numBottles >= numExchange:\r\n            numBottles -= numExchange\r\n            numExchange += 1\r\n            ans += 1\r\n            numBottles += 1\r\n        return ans",
