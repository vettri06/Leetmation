    "problemName": "harshad-number",
    "language": "python3",
    "code": "class Solution:\r\n    def sumOfTheDigitsOfHarshadNumber(self, x: int) -> int:\r\n        s, y = 0, x\r\n        while y:\r\n            s += y % 10\r\n            y //= 10\r\n        return s if x % s == 0 else -1",
