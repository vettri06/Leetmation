{
    "problemName": "find-the-number-of-k-even-arrays",
    "language": "python3",
    "code": "class Solution:\r\n    def countOfArrays(self, n: int, m: int, k: int) -> int:\r\n        @cache\r\n        def dfs(i: int, j: int, k: int) -> int:\r\n            if j < 0:\r\n                return 0\r\n            if i >= n:\r\n                return int(j == 0)\r\n            return (\r\n                cnt1 * dfs(i + 1, j, 1) + cnt0 * dfs(i + 1, j - (k & 1 ^ 1), 0)\r\n            ) % mod\r\n\r\n        cnt0 = m // 2\r\n        cnt1 = m - cnt0\r\n        mod = 10**9 + 7\r\n        ans = dfs(0, k, 1)\r\n        dfs.cache_clear()\r\n        return ans",
