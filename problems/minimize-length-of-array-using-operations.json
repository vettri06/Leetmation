    "problemName": "minimize-length-of-array-using-operations",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumArrayLength(self, nums: List[int]) -> int:\r\n        mi = min(nums)\r\n        if any(x % mi for x in nums):\r\n            return 1\r\n        return (nums.count(mi) + 1) // 2",
