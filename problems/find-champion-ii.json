    "problemName": "find-champion-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def findChampion(self, n: int, edges: List[List[int]]) -> int:\r\n        indeg = [0] * n\r\n        for _, v in edges:\r\n            indeg[v] += 1\r\n        return -1 if indeg.count(0) != 1 else indeg.index(0)",
