{
    "problemName": "longest-well-performing-interval",
    "language": "python3",
    "code": "class Solution:\r\n    def longestWPI(self, hours: List[int]) -> int:\r\n        ans = s = 0\r\n        pos = {}\r\n        for i, x in enumerate(hours):\r\n            s += 1 if x > 8 else -1\r\n            if s > 0:\r\n                ans = i + 1\r\n            elif s - 1 in pos:\r\n                ans = max(ans, i - pos[s - 1])\r\n            if s not in pos:\r\n                pos[s] = i\r\n        return ans",
