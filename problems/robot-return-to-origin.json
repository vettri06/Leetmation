    "problemName": "robot-return-to-origin",
    "language": "python3",
    "code": "class Solution:\r\n    def judgeCircle(self, moves: str) -> bool:\r\n        x = y = 0\r\n        for c in moves:\r\n            match c:\r\n                case \"U\":\r\n                    y += 1\r\n                case \"D\":\r\n                    y -= 1\r\n                case \"L\":\r\n                    x -= 1\r\n                case \"R\":\r\n                    x += 1\r\n        return x == 0 and y == 0",
