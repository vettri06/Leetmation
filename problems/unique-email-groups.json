{
    "problemName": "unique-email-groups",
    "language": "python3",
    "code": "class Solution:\r\n    def uniqueEmailGroups(self, emails: list[str]) -> int:\r\n        st = set()\r\n        for email in emails:\r\n            local, domain = email.split(\"@\")\r\n            local = local.split(\"+\")[0].replace(\".\", \"\").lower()\r\n            domain = domain.lower()\r\n            normalized = local + domain\r\n            st.add(normalized)\r\n        return len(st)",
