{
    "problemName": "all-paths-from-source-to-target",
    "language": "python3",
    "code": "class Solution:\r\n    def allPathsSourceTarget(self, graph: List[List[int]]) -> List[List[int]]:\r\n        n = len(graph)\r\n        q = deque([[0]])\r\n        ans = []\r\n        while q:\r\n            path = q.popleft()\r\n            u = path[-1]\r\n            if u == n - 1:\r\n                ans.append(path)\r\n                continue\r\n            for v in graph[u]:\r\n                q.append(path + [v])\r\n        return ans",
