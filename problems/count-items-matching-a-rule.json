    "code": "class Solution:\r\n    def countMatches(self, items: List[List[str]], ruleKey: str, ruleValue: str) -> int:\r\n        i = 0 if ruleKey[0] == 't' else (1 if ruleKey[0] == 'c' else 2)\r\n        return sum(v[i] == ruleValue for v in items)",
