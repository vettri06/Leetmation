{
    "problemName": "partition-array-for-maximum-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSumAfterPartitioning(self, arr: List[int], k: int) -> int:\r\n        n = len(arr)\r\n        f = [0] * (n + 1)\r\n        for i in range(1, n + 1):\r\n            mx = 0\r\n            for j in range(i, max(0, i - k), -1):\r\n                mx = max(mx, arr[j - 1])\r\n                f[i] = max(f[i], f[j - 1] + mx * (i - j + 1))\r\n        return f[n]",
