{
    "problemName": "strings-differ-by-one-character",
    "language": "python3",
    "code": "class Solution:\r\n    def differByOne(self, dict: List[str]) -> bool:\r\n        s = set()\r\n        for word in dict:\r\n            for i in range(len(word)):\r\n                t = word[:i] + \"*\" + word[i + 1 :]\r\n                if t in s:\r\n                    return True\r\n                s.add(t)\r\n        return False",
