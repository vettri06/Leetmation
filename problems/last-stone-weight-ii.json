{
    "problemName": "last-stone-weight-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def lastStoneWeightII(self, stones: List[int]) -> int:\r\n        s = sum(stones)\r\n        m, n = len(stones), s >> 1\r\n        dp = [[0] * (n + 1) for _ in range(m + 1)]\r\n        for i in range(1, m + 1):\r\n            for j in range(n + 1):\r\n                dp[i][j] = dp[i - 1][j]\r\n                if stones[i - 1] <= j:\r\n                    dp[i][j] = max(\r\n                        dp[i][j], dp[i - 1][j - stones[i - 1]] + stones[i - 1]\r\n                    )\r\n        return s - 2 * dp[-1][-1]",
