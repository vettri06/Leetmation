    "problemName": "duplicate-zeros",
    "language": "python3",
    "code": "class Solution:\r\n    def duplicateZeros(self, arr: List[int]) -> None:\r\n        \"\"\"\r\n        Do not return anything, modify arr in-place instead.\r\n        \"\"\"\r\n        n = len(arr)\r\n        i, k = -1, 0\r\n        while k < n:\r\n            i += 1\r\n            k += 1 if arr[i] else 2\r\n        j = n - 1\r\n        if k == n + 1:\r\n            arr[j] = 0\r\n            i, j = i - 1, j - 1\r\n        while ~j:\r\n            if arr[i] == 0:\r\n                arr[j] = arr[j - 1] = arr[i]\r\n                j -= 1\r\n            else:\r\n                arr[j] = arr[i]\r\n            i, j = i - 1, j - 1",
