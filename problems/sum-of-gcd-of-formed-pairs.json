    "problemName": "sum-of-gcd-of-formed-pairs",
    "language": "python3",
    "code": "class Solution:\r\n    def gcdSum(self, nums: list[int]) -> int:\r\n        n = len(nums)\r\n        prefix_gcd = [0] * n\r\n        mx = 0\r\n        for i, x in enumerate(nums):\r\n            mx = max(mx, x)\r\n            prefix_gcd[i] = gcd(x, mx)\r\n        prefix_gcd.sort()\r\n        return sum(gcd(prefix_gcd[i], prefix_gcd[-i - 1]) for i in range(n // 2))",
