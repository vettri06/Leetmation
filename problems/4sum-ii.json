    "problemName": "4sum-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def fourSumCount(\r\n        self, nums1: List[int], nums2: List[int], nums3: List[int], nums4: List[int]\r\n    ) -> int:\r\n        cnt = Counter(a + b for a in nums1 for b in nums2)\r\n        return sum(cnt[-(c + d)] for c in nums3 for d in nums4)",
