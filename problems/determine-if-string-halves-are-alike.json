{
    "problemName": "determine-if-string-halves-are-alike",
    "language": "python3",
    "code": "class Solution:\r\n    def halvesAreAlike(self, s: str) -> bool:\r\n        cnt, n = 0, len(s) >> 1\r\n        vowels = set('aeiouAEIOU')\r\n        for i in range(n):\r\n            cnt += s[i] in vowels\r\n            cnt -= s[i + n] in vowels\r\n        return cnt == 0",
