    "language": "python3",
    "code": "class Solution:\r\n    def largestNumber(self, nums: List[int]) -> str:\r\n        nums = [str(v) for v in nums]\r\n        nums.sort(key=cmp_to_key(lambda a, b: 1 if a + b < b + a else -1))\r\n        return \"0\" if nums[0] == \"0\" else \"\".join(nums)",
