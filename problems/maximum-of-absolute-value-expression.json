{
    "problemName": "maximum-of-absolute-value-expression",
    "language": "python3",
    "code": "class Solution:\r\n    def maxAbsValExpr(self, arr1: List[int], arr2: List[int]) -> int:\r\n        dirs = (1, -1, -1, 1, 1)\r\n        ans = -inf\r\n        for a, b in pairwise(dirs):\r\n            mx, mi = -inf, inf\r\n            for i, (x, y) in enumerate(zip(arr1, arr2)):\r\n                mx = max(mx, a * x + b * y + i)\r\n                mi = min(mi, a * x + b * y + i)\r\n                ans = max(ans, mx - mi)\r\n        return ans",
