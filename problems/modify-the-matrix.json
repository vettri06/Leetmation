{
    "problemName": "modify-the-matrix",
    "language": "python3",
    "code": "class Solution:\r\n    def modifiedMatrix(self, matrix: List[List[int]]) -> List[List[int]]:\r\n        m, n = len(matrix), len(matrix[0])\r\n        for j in range(n):\r\n            mx = max(matrix[i][j] for i in range(m))\r\n            for i in range(m):\r\n                if matrix[i][j] == -1:\r\n                    matrix[i][j] = mx\r\n        return matrix",
