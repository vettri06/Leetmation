    "problemName": "closest-divisors",
    "language": "python3",
    "code": "class Solution:\r\n    def closestDivisors(self, num: int) -> List[int]:\r\n        def f(x):\r\n            for i in range(int(sqrt(x)), 0, -1):\r\n                if x % i == 0:\r\n                    return [i, x // i]\r\n\r\n        a = f(num + 1)\r\n        b = f(num + 2)\r\n        return a if abs(a[0] - a[1]) < abs(b[0] - b[1]) else b",
