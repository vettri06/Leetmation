    "problemName": "minimum-rectangles-to-cover-points",
    "language": "python3",
    "code": "class Solution:\r\n    def minRectanglesToCoverPoints(self, points: List[List[int]], w: int) -> int:\r\n        points.sort()\r\n        ans, x1 = 0, -1\r\n        for x, _ in points:\r\n            if x > x1:\r\n                ans += 1\r\n                x1 = x + w\r\n        return ans",
