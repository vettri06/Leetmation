    "code": "import pandas as pd\r\n\r\n\r\ndef rising_temperature(weather: pd.DataFrame) -> pd.DataFrame:\r\n    weather.sort_values(by=\"recordDate\", inplace=True)\r\n    return weather[\r\n        (weather.temperature.diff() > 0) & (weather.recordDate.diff().dt.days == 1)\r\n    ][[\"id\"]]",
