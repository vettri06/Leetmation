    "language": "python3",
    "code": "class Solution:\r\n    def simplifiedFractions(self, n: int) -> List[str]:\r\n        return [\r\n            f'{i}/{j}'\r\n            for i in range(1, n)\r\n            for j in range(i + 1, n + 1)\r\n            if gcd(i, j) == 1\r\n        ]",
