    "problemName": "number-of-different-subsequences-gcds",
    "language": "python3",
    "code": "class Solution:\r\n    def countDifferentSubsequenceGCDs(self, nums: List[int]) -> int:\r\n        mx = max(nums)\r\n        vis = set(nums)\r\n        ans = 0\r\n        for x in range(1, mx + 1):\r\n            g = 0\r\n            for y in range(x, mx + 1, x):\r\n                if y in vis:\r\n                    g = gcd(g, y)\r\n                    if g == x:\r\n                        ans += 1\r\n                        break\r\n        return ans",
