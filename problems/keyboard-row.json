    "code": "class Solution:\r\n    def findWords(self, words: List[str]) -> List[str]:\r\n        s1 = set('qwertyuiop')\r\n        s2 = set('asdfghjkl')\r\n        s3 = set('zxcvbnm')\r\n        ans = []\r\n        for w in words:\r\n            s = set(w.lower())\r\n            if s <= s1 or s <= s2 or s <= s3:\r\n                ans.append(w)\r\n        return ans",
