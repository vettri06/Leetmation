    "problemName": "minimum-deletions-to-make-string-k-special",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumDeletions(self, word: str, k: int) -> int:\r\n        def f(v: int) -> int:\r\n            ans = 0\r\n            for x in nums:\r\n                if x < v:\r\n                    ans += x\r\n                elif x > v + k:\r\n                    ans += x - v - k\r\n            return ans\r\n\r\n        nums = Counter(word).values()\r\n        return min(f(v) for v in range(len(word) + 1))",
