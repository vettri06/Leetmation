    "problemName": "asteroid-collision",
    "language": "python3",
    "code": "class Solution:\r\n    def asteroidCollision(self, asteroids: List[int]) -> List[int]:\r\n        stk = []\r\n        for x in asteroids:\r\n            if x > 0:\r\n                stk.append(x)\r\n            else:\r\n                while stk and stk[-1] > 0 and stk[-1] < -x:\r\n                    stk.pop()\r\n                if stk and stk[-1] == -x:\r\n                    stk.pop()\r\n                elif not stk or stk[-1] < 0:\r\n                    stk.append(x)\r\n        return stk",
