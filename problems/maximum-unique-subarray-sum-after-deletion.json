{
    "problemName": "maximum-unique-subarray-sum-after-deletion",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSum(self, nums: List[int]) -> int:\r\n        mx = max(nums)\r\n        if mx <= 0:\r\n            return mx\r\n        ans = 0\r\n        s = set()\r\n        for x in nums:\r\n            if x < 0 or x in s:\r\n                continue\r\n            ans += x\r\n            s.add(x)\r\n        return ans",
