    "problemName": "reach-a-number",
    "language": "python3",
    "code": "class Solution:\r\n    def reachNumber(self, target: int) -> int:\r\n        target = abs(target)\r\n        s = k = 0\r\n        while 1:\r\n            if s >= target and (s - target) % 2 == 0:\r\n                return k\r\n            k += 1\r\n            s += k",
