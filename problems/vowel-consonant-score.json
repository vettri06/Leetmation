    "problemName": "vowel-consonant-score",
    "language": "python3",
    "code": "class Solution:\r\n    def vowelConsonantScore(self, s: str) -> int:\r\n        v = c = 0\r\n        for ch in s:\r\n            if ch.isalpha():\r\n                c += 1\r\n                if ch in \"aeiou\":\r\n                    v += 1\r\n        c -= v\r\n        return 0 if c == 0 else v // c",
