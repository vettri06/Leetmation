{
    "problemName": "largest-values-from-labels",
    "language": "python3",
    "code": "class Solution:\r\n    def largestValsFromLabels(\r\n        self, values: List[int], labels: List[int], numWanted: int, useLimit: int\r\n    ) -> int:\r\n        ans = num = 0\r\n        cnt = Counter()\r\n        for v, l in sorted(zip(values, labels), reverse=True):\r\n            if cnt[l] < useLimit:\r\n                cnt[l] += 1\r\n                num += 1\r\n                ans += v\r\n                if num == numWanted:\r\n                    break\r\n        return ans",
