    "problemName": "maximum-points-in-an-archery-competition",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumBobPoints(self, numArrows: int, aliceArrows: List[int]) -> List[int]:\r\n        st = mx = 0\r\n        m = len(aliceArrows)\r\n        for mask in range(1, 1 << m):\r\n            cnt = s = 0\r\n            for i, x in enumerate(aliceArrows):\r\n                if mask >> i & 1:\r\n                    s += i\r\n                    cnt += x + 1\r\n            if cnt <= numArrows and s > mx:\r\n                mx = s\r\n                st = mask\r\n        ans = [0] * m\r\n        for i, x in enumerate(aliceArrows):\r\n            if st >> i & 1:\r\n                ans[i] = x + 1\r\n                numArrows -= ans[i]\r\n        ans[0] += numArrows\r\n        return ans",
