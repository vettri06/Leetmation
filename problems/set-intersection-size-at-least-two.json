    "problemName": "set-intersection-size-at-least-two",
    "language": "python3",
    "code": "class Solution:\r\n    def intersectionSizeTwo(self, intervals: List[List[int]]) -> int:\r\n        intervals.sort(key=lambda x: (x[1], -x[0]))\r\n        s = e = -1\r\n        ans = 0\r\n        for a, b in intervals:\r\n            if a <= s:\r\n                continue\r\n            if a > e:\r\n                ans += 2\r\n                s, e = b - 1, b\r\n            else:\r\n                ans += 1\r\n                s, e = e, b\r\n        return ans",
