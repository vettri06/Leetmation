    "problemName": "construct-the-longest-new-string",
    "language": "python3",
    "code": "class Solution:\r\n    def longestString(self, x: int, y: int, z: int) -> int:\r\n        if x < y:\r\n            return (x * 2 + z + 1) * 2\r\n        if x > y:\r\n            return (y * 2 + z + 1) * 2\r\n        return (x + y + z) * 2",
