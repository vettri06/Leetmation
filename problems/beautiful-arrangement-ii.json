    "problemName": "beautiful-arrangement-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def constructArray(self, n: int, k: int) -> List[int]:\r\n        l, r = 1, n\r\n        ans = []\r\n        for i in range(k):\r\n            if i % 2 == 0:\r\n                ans.append(l)\r\n                l += 1\r\n            else:\r\n                ans.append(r)\r\n                r -= 1\r\n        for i in range(k, n):\r\n            if k % 2 == 0:\r\n                ans.append(r)\r\n                r -= 1\r\n            else:\r\n                ans.append(l)\r\n                l += 1\r\n        return ans",
