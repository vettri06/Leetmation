{
    "problemName": "di-string-match",
    "language": "python3",
    "code": "class Solution:\r\n    def diStringMatch(self, s: str) -> List[int]:\r\n        low, high = 0, len(s)\r\n        ans = []\r\n        for c in s:\r\n            if c == \"I\":\r\n                ans.append(low)\r\n                low += 1\r\n            else:\r\n                ans.append(high)\r\n                high -= 1\r\n        ans.append(low)\r\n        return ans",
