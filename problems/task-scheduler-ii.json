    "problemName": "task-scheduler-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def taskSchedulerII(self, tasks: List[int], space: int) -> int:\r\n        day = defaultdict(int)\r\n        ans = 0\r\n        for task in tasks:\r\n            ans += 1\r\n            ans = max(ans, day[task])\r\n            day[task] = ans + space + 1\r\n        return ans",
