    "language": "python3",
    "code": "class Solution:\r\n    def minimumBoxes(self, apple: List[int], capacity: List[int]) -> int:\r\n        capacity.sort(reverse=True)\r\n        s = sum(apple)\r\n        for i, c in enumerate(capacity, 1):\r\n            s -= c\r\n            if s <= 0:\r\n                return i",
