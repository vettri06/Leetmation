{
    "problemName": "maximum-alternating-sum-of-squares",
    "language": "python3",
    "code": "class Solution:\r\n    def maxAlternatingSum(self, nums: List[int]) -> int:\r\n        nums.sort(key=lambda x: x * x)\r\n        n = len(nums)\r\n        s1 = sum(x * x for x in nums[: n // 2])\r\n        s2 = sum(x * x for x in nums[n // 2 :])\r\n        return s2 - s1",
