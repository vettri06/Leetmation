{
    "problemName": "count-partitions-with-even-sum-difference",
    "language": "python3",
    "code": "class Solution:\r\n    def countPartitions(self, nums: List[int]) -> int:\r\n        l, r = 0, sum(nums)\r\n        ans = 0\r\n        for x in nums[:-1]:\r\n            l += x\r\n            r -= x\r\n            ans += (l - r) % 2 == 0\r\n        return ans",
