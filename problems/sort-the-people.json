    "code": "class Solution:\r\n    def sortPeople(self, names: List[str], heights: List[int]) -> List[str]:\r\n        idx = list(range(len(heights)))\r\n        idx.sort(key=lambda i: -heights[i])\r\n        return [names[i] for i in idx]",
