    "problemName": "brick-wall",
    "language": "cpp",
    "code": "class Solution {\npublic:\n    int leastBricks(vector<vector<int>>& wall) {\n        unordered_map<long long, int> edgeCount;\n        int best = 0;\n\n        for (const auto& row : wall) {\n            long long edge = 0;\n            for (int i = 0; i + 1 < row.size(); i++) {\n                edge += row[i];\n                best = max(best, ++edgeCount[edge]);\n            }\n        }\n\n        return (int)wall.size() - best;\n    }\n};",
