{
    "problemName": "increasing-decreasing-string",
    "language": "python3",
    "code": "class Solution:\r\n    def sortString(self, s: str) -> str:\r\n        cnt = Counter(s)\r\n        cs = ascii_lowercase + ascii_lowercase[::-1]\r\n        ans = []\r\n        while len(ans) < len(s):\r\n            for c in cs:\r\n                if cnt[c]:\r\n                    ans.append(c)\r\n                    cnt[c] -= 1\r\n        return \"\".join(ans)",
