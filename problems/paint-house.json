    "code": "class Solution:\r\n    def minCost(self, costs: List[List[int]]) -> int:\r\n        a = b = c = 0\r\n        for ca, cb, cc in costs:\r\n            a, b, c = min(b, c) + ca, min(a, c) + cb, min(a, b) + cc\r\n        return min(a, b, c)",
