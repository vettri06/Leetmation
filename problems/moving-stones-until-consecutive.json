{
    "problemName": "moving-stones-until-consecutive",
    "language": "python3",
    "code": "class Solution:\r\n    def numMovesStones(self, a: int, b: int, c: int) -> List[int]:\r\n        x, z = min(a, b, c), max(a, b, c)\r\n        y = a + b + c - x - z\r\n        mi = mx = 0\r\n        if z - x > 2:\r\n            mi = 1 if y - x < 3 or z - y < 3 else 2\r\n            mx = z - x - 2\r\n        return [mi, mx]",
