{
    "problemName": "count-pairs-in-two-arrays",
    "language": "python3",
    "code": "class Solution:\r\n    def countPairs(self, nums1: List[int], nums2: List[int]) -> int:\r\n        nums = [a - b for a, b in zip(nums1, nums2)]\r\n        nums.sort()\r\n        l, r = 0, len(nums) - 1\r\n        ans = 0\r\n        while l < r:\r\n            while l < r and nums[l] + nums[r] <= 0:\r\n                l += 1\r\n            ans += r - l\r\n            r -= 1\r\n        return ans",
