{
    "problemName": "utf-8-validation",
    "language": "python3",
    "code": "class Solution:\r\n    def validUtf8(self, data: List[int]) -> bool:\r\n        cnt = 0\r\n        for v in data:\r\n            if cnt > 0:\r\n                if v >> 6 != 0b10:\r\n                    return False\r\n                cnt -= 1\r\n            elif v >> 7 == 0:\r\n                cnt = 0\r\n            elif v >> 5 == 0b110:\r\n                cnt = 1\r\n            elif v >> 4 == 0b1110:\r\n                cnt = 2\r\n            elif v >> 3 == 0b11110:\r\n                cnt = 3\r\n            else:\r\n                return False\r\n        return cnt == 0",
