{
    "problemName": "search-a-2d-matrix",
    "language": "python3",
    "code": "class Solution:\r\n    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:\r\n        m, n = len(matrix), len(matrix[0])\r\n        left, right = 0, m * n - 1\r\n        while left < right:\r\n            mid = (left + right) >> 1\r\n            x, y = divmod(mid, n)\r\n            if matrix[x][y] >= target:\r\n                right = mid\r\n            else:\r\n                left = mid + 1\r\n        return matrix[left // n][left % n] == target",
