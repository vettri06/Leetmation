    "problemName": "apply-substitutions",
    "language": "python3",
    "code": "class Solution:\r\n    def applySubstitutions(self, replacements: List[List[str]], text: str) -> str:\r\n        def dfs(s: str) -> str:\r\n            i = s.find(\"%\")\r\n            if i == -1:\r\n                return s\r\n            j = s.find(\"%\", i + 1)\r\n            if j == -1:\r\n                return s\r\n            key = s[i + 1 : j]\r\n            replacement = dfs(d[key])\r\n            return s[:i] + replacement + dfs(s[j + 1 :])\r\n\r\n        d = {s: t for s, t in replacements}\r\n        return dfs(text)",
