    "problemName": "robot-bounded-in-circle",
    "language": "python3",
    "code": "class Solution:\r\n    def isRobotBounded(self, instructions: str) -> bool:\r\n        k = 0\r\n        dist = [0] * 4\r\n        for c in instructions:\r\n            if c == 'L':\r\n                k = (k + 1) % 4\r\n            elif c == 'R':\r\n                k = (k + 3) % 4\r\n            else:\r\n                dist[k] += 1\r\n        return (dist[0] == dist[2] and dist[1] == dist[3]) or k != 0",
