{
    "problemName": "count-the-number-of-good-partitions",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfGoodPartitions(self, nums: List[int]) -> int:\r\n        last = {x: i for i, x in enumerate(nums)}\r\n        mod = 10**9 + 7\r\n        j, k = -1, 0\r\n        for i, x in enumerate(nums):\r\n            j = max(j, last[x])\r\n            k += i == j\r\n        return pow(2, k - 1, mod)",
