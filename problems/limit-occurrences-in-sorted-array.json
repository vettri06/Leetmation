{
    "problemName": "limit-occurrences-in-sorted-array",
    "language": "python3",
    "code": "class Solution:\r\n    def limitOccurrences(self, nums: list[int], k: int) -> list[int]:\r\n        n = len(nums)\r\n        cnt = l = 1\r\n        for r in range(1, n):\r\n            if nums[r] != nums[r - 1]:\r\n                cnt = 1\r\n            else:\r\n                cnt += 1\r\n            if cnt <= k:\r\n                nums[l] = nums[r]\r\n                l += 1\r\n        return nums[:l]",
