    "problemName": "minimum-number-of-frogs-croaking",
    "language": "python3",
    "code": "class Solution:\r\n    def minNumberOfFrogs(self, croakOfFrogs: str) -> int:\r\n        if len(croakOfFrogs) % 5 != 0:\r\n            return -1\r\n        idx = {c: i for i, c in enumerate('croak')}\r\n        cnt = [0] * 5\r\n        ans = x = 0\r\n        for i in map(idx.get, croakOfFrogs):\r\n            cnt[i] += 1\r\n            if i == 0:\r\n                x += 1\r\n                ans = max(ans, x)\r\n            else:\r\n                if cnt[i - 1] == 0:\r\n                    return -1\r\n                cnt[i - 1] -= 1\r\n                if i == 4:\r\n                    x -= 1\r\n        return -1 if x else ans",
