{
    "problemName": "first-unique-even-element",
    "language": "python3",
    "code": "class Solution:\r\n    def firstUniqueEven(self, nums: list[int]) -> int:\r\n        cnt = Counter(nums)\r\n        for x in nums:\r\n            if x % 2 == 0 and cnt[x] == 1:\r\n                return x\r\n        return -1",
