    "problemName": "shortest-word-distance",
    "language": "python3",
    "code": "class Solution:\r\n    def shortestDistance(self, wordsDict: List[str], word1: str, word2: str) -> int:\r\n        i = j = -1\r\n        ans = inf\r\n        for k, w in enumerate(wordsDict):\r\n            if w == word1:\r\n                i = k\r\n            if w == word2:\r\n                j = k\r\n            if i != -1 and j != -1:\r\n                ans = min(ans, abs(i - j))\r\n        return ans",
