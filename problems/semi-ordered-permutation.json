    "problemName": "semi-ordered-permutation",
    "language": "python3",
    "code": "class Solution:\r\n    def semiOrderedPermutation(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        i = nums.index(1)\r\n        j = nums.index(n)\r\n        k = 1 if i < j else 2\r\n        return i + n - j - k",
