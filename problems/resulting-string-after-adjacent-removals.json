{
    "problemName": "resulting-string-after-adjacent-removals",
    "language": "python3",
    "code": "class Solution:\r\n    def resultingString(self, s: str) -> str:\r\n        stk = []\r\n        for c in s:\r\n            if stk and abs(ord(c) - ord(stk[-1])) in (1, 25):\r\n                stk.pop()\r\n            else:\r\n                stk.append(c)\r\n        return \"\".join(stk)",
