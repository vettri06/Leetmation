{
    "problemName": "reformat-phone-number",
    "language": "python3",
    "code": "class Solution:\r\n    def reformatNumber(self, number: str) -> str:\r\n        number = number.replace(\"-\", \"\").replace(\" \", \"\")\r\n        n = len(number)\r\n        ans = [number[i * 3 : i * 3 + 3] for i in range(n // 3)]\r\n        if n % 3 == 1:\r\n            ans[-1] = ans[-1][:2]\r\n            ans.append(number[-2:])\r\n        elif n % 3 == 2:\r\n            ans.append(number[-2:])\r\n        return \"-\".join(ans)",
