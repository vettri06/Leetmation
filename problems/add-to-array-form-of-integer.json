{
    "problemName": "add-to-array-form-of-integer",
    "language": "python3",
    "code": "class Solution:\r\n    def addToArrayForm(self, num: List[int], k: int) -> List[int]:\r\n        ans = []\r\n        i = len(num) - 1\r\n        while i >= 0 or k:\r\n            k += 0 if i < 0 else num[i]\r\n            k, x = divmod(k, 10)\r\n            ans.append(x)\r\n            i -= 1\r\n        return ans[::-1]",
