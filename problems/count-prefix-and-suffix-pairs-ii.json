{
    "problemName": "count-prefix-and-suffix-pairs-ii",
    "language": "python3",
    "code": "class Node:\r\n    __slots__ = [\"children\", \"cnt\"]\r\n\r\n    def __init__(self):\r\n        self.children = {}\r\n        self.cnt = 0\r\n\r\n\r\nclass Solution:\r\n    def countPrefixSuffixPairs(self, words: List[str]) -> int:\r\n        ans = 0\r\n        trie = Node()\r\n        for s in words:\r\n            node = trie\r\n            for p in zip(s, reversed(s)):\r\n                if p not in node.children:\r\n                    node.children[p] = Node()\r\n                node = node.children[p]\r\n                ans += node.cnt\r\n            node.cnt += 1\r\n        return ans",
