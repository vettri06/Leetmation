    "code": "class Solution:\r\n    def fullBloomFlowers(\r\n        self, flowers: List[List[int]], people: List[int]\r\n    ) -> List[int]:\r\n        start, end = sorted(a for a, _ in flowers), sorted(b for _, b in flowers)\r\n        return [bisect_right(start, p) - bisect_left(end, p) for p in people]",
