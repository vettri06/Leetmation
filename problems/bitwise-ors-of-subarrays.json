    "problemName": "bitwise-ors-of-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def subarrayBitwiseORs(self, arr: List[int]) -> int:\r\n        ans = set()\r\n        s = set()\r\n        for x in arr:\r\n            s = {x | y for y in s} | {x}\r\n            ans |= s\r\n        return len(ans)",
