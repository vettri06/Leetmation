{
    "problemName": "convert-to-base-2",
    "language": "python3",
    "code": "class Solution:\r\n    def baseNeg2(self, n: int) -> str:\r\n        k = 1\r\n        ans = []\r\n        while n:\r\n            if n % 2:\r\n                ans.append('1')\r\n                n -= k\r\n            else:\r\n                ans.append('0')\r\n            n //= 2\r\n            k *= -1\r\n        return ''.join(ans[::-1]) or '0'",
