{
    "problemName": "wiggle-sort-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def wiggleSort(self, nums: List[int]) -> None:\r\n        \"\"\"\r\n        Do not return anything, modify nums in-place instead.\r\n        \"\"\"\r\n        arr = sorted(nums)\r\n        n = len(arr)\r\n        i, j = (n - 1) >> 1, n - 1\r\n        for k in range(n):\r\n            if k % 2 == 0:\r\n                nums[k] = arr[i]\r\n                i -= 1\r\n            else:\r\n                nums[k] = arr[j]\r\n                j -= 1",
