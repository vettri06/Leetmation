{
    "problemName": "strange-printer",
    "language": "python3",
    "code": "class Solution:\r\n    def strangePrinter(self, s: str) -> int:\r\n        n = len(s)\r\n        f = [[inf] * n for _ in range(n)]\r\n        for i in range(n - 1, -1, -1):\r\n            f[i][i] = 1\r\n            for j in range(i + 1, n):\r\n                if s[i] == s[j]:\r\n                    f[i][j] = f[i][j - 1]\r\n                else:\r\n                    for k in range(i, j):\r\n                        f[i][j] = min(f[i][j], f[i][k] + f[k + 1][j])\r\n        return f[0][-1]",
