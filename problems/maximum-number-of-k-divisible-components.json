    "problemName": "maximum-number-of-k-divisible-components",
    "language": "python3",
    "code": "class Solution:\r\n    def maxKDivisibleComponents(\r\n        self, n: int, edges: List[List[int]], values: List[int], k: int\r\n    ) -> int:\r\n        def dfs(i: int, fa: int) -> int:\r\n            s = values[i]\r\n            for j in g[i]:\r\n                if j != fa:\r\n                    s += dfs(j, i)\r\n            nonlocal ans\r\n            ans += s % k == 0\r\n            return s\r\n\r\n        g = [[] for _ in range(n)]\r\n        for a, b in edges:\r\n            g[a].append(b)\r\n            g[b].append(a)\r\n        ans = 0\r\n        dfs(0, -1)\r\n        return ans",
