    "language": "python3",
    "code": "class Solution:\r\n    def totalReplacements(self, ranks: List[int]) -> int:\r\n        ans, cur = 0, ranks[0]\r\n        for x in ranks:\r\n            if x < cur:\r\n                cur = x\r\n                ans += 1\r\n        return ans",
