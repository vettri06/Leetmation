    "problemName": "count-sorted-vowel-strings",
    "language": "python3",
    "code": "class Solution:\r\n    def countVowelStrings(self, n: int) -> int:\r\n        @cache\r\n        def dfs(i, j):\r\n            return 1 if i >= n else sum(dfs(i + 1, k) for k in range(j, 5))\r\n\r\n        return dfs(0, 0)",
