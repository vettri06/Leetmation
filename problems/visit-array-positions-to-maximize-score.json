{
    "problemName": "visit-array-positions-to-maximize-score",
    "language": "python3",
    "code": "class Solution:\r\n    def maxScore(self, nums: List[int], x: int) -> int:\r\n        f = [-inf] * 2\r\n        f[nums[0] & 1] = nums[0]\r\n        for v in nums[1:]:\r\n            f[v & 1] = max(f[v & 1], f[v & 1 ^ 1] - x) + v\r\n        return max(f)",
