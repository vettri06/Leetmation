    "problemName": "odd-string-difference",
    "language": "python3",
    "code": "class Solution:\r\n    def oddString(self, words: List[str]) -> str:\r\n        d = defaultdict(list)\r\n        for s in words:\r\n            t = tuple(ord(b) - ord(a) for a, b in pairwise(s))\r\n            d[t].append(s)\r\n        return next(ss[0] for ss in d.values() if len(ss) == 1)",
