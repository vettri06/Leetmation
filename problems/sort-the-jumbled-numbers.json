{
    "problemName": "sort-the-jumbled-numbers",
    "language": "python3",
    "code": "class Solution:\r\n    def sortJumbled(self, mapping: List[int], nums: List[int]) -> List[int]:\r\n        def f(x: int) -> int:\r\n            if x == 0:\r\n                return mapping[0]\r\n            y, k = 0, 1\r\n            while x:\r\n                x, v = divmod(x, 10)\r\n                v = mapping[v]\r\n                y = k * v + y\r\n                k *= 10\r\n            return y\r\n\r\n        arr = sorted((f(x), i) for i, x in enumerate(nums))\r\n        return [nums[i] for _, i in arr]",
