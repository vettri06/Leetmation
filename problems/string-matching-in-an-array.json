    "problemName": "string-matching-in-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def stringMatching(self, words: List[str]) -> List[str]:\r\n        ans = []\r\n        for i, s in enumerate(words):\r\n            if any(i != j and s in t for j, t in enumerate(words)):\r\n                ans.append(s)\r\n        return ans",
