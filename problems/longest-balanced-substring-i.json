{
    "problemName": "longest-balanced-substring-i",
    "language": "python3",
    "code": "class Solution:\r\n    def longestBalanced(self, s: str) -> int:\r\n        n = len(s)\r\n        ans = 0\r\n        for i in range(n):\r\n            cnt = Counter()\r\n            mx = v = 0\r\n            for j in range(i, n):\r\n                cnt[s[j]] += 1\r\n                mx = max(mx, cnt[s[j]])\r\n                if cnt[s[j]] == 1:\r\n                    v += 1\r\n                if mx * v == j - i + 1:\r\n                    ans = max(ans, j - i + 1)\r\n        return ans",
