    "problemName": "optimize-water-distribution-in-a-village",
    "language": "python3",
    "code": "class Solution:\r\n    def minCostToSupplyWater(\r\n        self, n: int, wells: List[int], pipes: List[List[int]]\r\n    ) -> int:\r\n        def find(x: int) -> int:\r\n            if p[x] != x:\r\n                p[x] = find(p[x])\r\n            return p[x]\r\n\r\n        for i, w in enumerate(wells, 1):\r\n            pipes.append([0, i, w])\r\n        pipes.sort(key=lambda x: x[2])\r\n        p = list(range(n + 1))\r\n        ans = 0\r\n        for a, b, c in pipes:\r\n            pa, pb = find(a), find(b)\r\n            if pa != pb:\r\n                p[pa] = pb\r\n                n -= 1\r\n                ans += c\r\n                if n == 0:\r\n                    return ans",
