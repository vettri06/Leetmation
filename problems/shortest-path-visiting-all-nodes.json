{
    "problemName": "shortest-path-visiting-all-nodes",
    "language": "python3",
    "code": "class Solution:\r\n    def shortestPathLength(self, graph: List[List[int]]) -> int:\r\n        n = len(graph)\r\n        q = deque()\r\n        vis = set()\r\n        for i in range(n):\r\n            q.append((i, 1 << i))\r\n            vis.add((i, 1 << i))\r\n        ans = 0\r\n        while 1:\r\n            for _ in range(len(q)):\r\n                i, st = q.popleft()\r\n                if st == (1 << n) - 1:\r\n                    return ans\r\n                for j in graph[i]:\r\n                    nst = st | 1 << j\r\n                    if (j, nst) not in vis:\r\n                        vis.add((j, nst))\r\n                        q.append((j, nst))\r\n            ans += 1",
