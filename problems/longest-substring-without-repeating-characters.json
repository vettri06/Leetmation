{
    "problemName": "longest-substring-without-repeating-characters",
    "language": "python3",
    "code": "class Solution:\r\n    def lengthOfLongestSubstring(self, s: str) -> int:\r\n        cnt = Counter()\r\n        ans = l = 0\r\n        for r, c in enumerate(s):\r\n            cnt[c] += 1\r\n            while cnt[c] > 1:\r\n                cnt[s[l]] -= 1\r\n                l += 1\r\n            ans = max(ans, r - l + 1)\r\n        return ans",
