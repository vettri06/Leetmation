{
    "problemName": "max-chunks-to-make-sorted-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def maxChunksToSorted(self, arr: List[int]) -> int:\r\n        stk = []\r\n        for v in arr:\r\n            if not stk or v >= stk[-1]:\r\n                stk.append(v)\r\n            else:\r\n                mx = stk.pop()\r\n                while stk and stk[-1] > v:\r\n                    stk.pop()\r\n                stk.append(mx)\r\n        return len(stk)",
