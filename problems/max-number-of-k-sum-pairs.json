{
    "problemName": "max-number-of-k-sum-pairs",
    "language": "python3",
    "code": "class Solution:\r\n    def maxOperations(self, nums: List[int], k: int) -> int:\r\n        nums.sort()\r\n        l, r, ans = 0, len(nums) - 1, 0\r\n        while l < r:\r\n            s = nums[l] + nums[r]\r\n            if s == k:\r\n                ans += 1\r\n                l, r = l + 1, r - 1\r\n            elif s > k:\r\n                r -= 1\r\n            else:\r\n                l += 1\r\n        return ans",
