    "problemName": "reverse-words-in-a-string-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def reverseWords(self, s: List[str]) -> None:\r\n        def reverse(i: int, j: int):\r\n            while i < j:\r\n                s[i], s[j] = s[j], s[i]\r\n                i, j = i + 1, j - 1\r\n\r\n        i, n = 0, len(s)\r\n        for j, c in enumerate(s):\r\n            if c == \" \":\r\n                reverse(i, j - 1)\r\n                i = j + 1\r\n            elif j == n - 1:\r\n                reverse(i, j)\r\n        reverse(0, n - 1)",
