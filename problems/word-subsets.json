{
    "problemName": "word-subsets",
    "language": "python3",
    "code": "class Solution:\r\n    def wordSubsets(self, words1: List[str], words2: List[str]) -> List[str]:\r\n        cnt = Counter()\r\n        for b in words2:\r\n            t = Counter(b)\r\n            for c, v in t.items():\r\n                cnt[c] = max(cnt[c], v)\r\n        ans = []\r\n        for a in words1:\r\n            t = Counter(a)\r\n            if all(v <= t[c] for c, v in cnt.items()):\r\n                ans.append(a)\r\n        return ans",
