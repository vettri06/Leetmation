    "code": "class Solution:\r\n    def canVisitAllRooms(self, rooms: List[List[int]]) -> bool:\r\n        def dfs(i: int):\r\n            if i in vis:\r\n                return\r\n            vis.add(i)\r\n            for j in rooms[i]:\r\n                dfs(j)\r\n\r\n        vis = set()\r\n        dfs(0)\r\n        return len(vis) == len(rooms)",
