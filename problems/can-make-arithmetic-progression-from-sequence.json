    "language": "python3",
    "code": "class Solution:\r\n    def canMakeArithmeticProgression(self, arr: List[int]) -> bool:\r\n        arr.sort()\r\n        d = arr[1] - arr[0]\r\n        return all(b - a == d for a, b in pairwise(arr))",
