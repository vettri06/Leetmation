    "problemName": "paint-house-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def minCostII(self, costs: List[List[int]]) -> int:\r\n        n, k = len(costs), len(costs[0])\r\n        f = costs[0][:]\r\n        for i in range(1, n):\r\n            g = costs[i][:]\r\n            for j in range(k):\r\n                t = min(f[h] for h in range(k) if h != j)\r\n                g[j] += t\r\n            f = g\r\n        return min(f)",
