{
    "problemName": "latest-time-by-replacing-hidden-digits",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumTime(self, time: str) -> str:\r\n        t = list(time)\r\n        if t[0] == '?':\r\n            t[0] = '1' if '4' <= t[1] <= '9' else '2'\r\n        if t[1] == '?':\r\n            t[1] = '3' if t[0] == '2' else '9'\r\n        if t[3] == '?':\r\n            t[3] = '5'\r\n        if t[4] == '?':\r\n            t[4] = '9'\r\n        return ''.join(t)",
