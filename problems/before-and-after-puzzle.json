    "problemName": "before-and-after-puzzle",
    "language": "python3",
    "code": "class Solution:\r\n    def beforeAndAfterPuzzles(self, phrases: List[str]) -> List[str]:\r\n        ps = []\r\n        for p in phrases:\r\n            ws = p.split()\r\n            ps.append((ws[0], ws[-1]))\r\n        n = len(ps)\r\n        ans = []\r\n        for i in range(n):\r\n            for j in range(n):\r\n                if i != j and ps[i][1] == ps[j][0]:\r\n                    ans.append(phrases[i] + phrases[j][len(ps[j][0]) :])\r\n        return sorted(set(ans))",
