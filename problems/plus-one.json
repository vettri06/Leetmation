    "problemName": "plus-one",
    "language": "python3",
    "code": "class Solution:\r\n    def plusOne(self, digits: List[int]) -> List[int]:\r\n        n = len(digits)\r\n        for i in range(n - 1, -1, -1):\r\n            digits[i] += 1\r\n            digits[i] %= 10\r\n            if digits[i] != 0:\r\n                return digits\r\n        return [1] + digits",
