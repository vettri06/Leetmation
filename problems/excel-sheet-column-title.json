    "problemName": "excel-sheet-column-title",
    "language": "python3",
    "code": "class Solution:\r\n    def convertToTitle(self, columnNumber: int) -> str:\r\n        res = []\r\n        while columnNumber:\r\n            columnNumber -= 1\r\n            res.append(chr(ord('A') + columnNumber % 26))\r\n            columnNumber //= 26\r\n        return ''.join(res[::-1])",
