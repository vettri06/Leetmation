{
    "problemName": "lemonade-change",
    "language": "python3",
    "code": "class Solution:\r\n    def lemonadeChange(self, bills: List[int]) -> bool:\r\n        five = ten = 0\r\n        for v in bills:\r\n            if v == 5:\r\n                five += 1\r\n            elif v == 10:\r\n                ten += 1\r\n                five -= 1\r\n            else:\r\n                if ten:\r\n                    ten -= 1\r\n                    five -= 1\r\n                else:\r\n                    five -= 3\r\n            if five < 0:\r\n                return False\r\n        return True",
