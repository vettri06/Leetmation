{
    "problemName": "solving-questions-with-brainpower",
    "language": "python3",
    "code": "class Solution:\r\n    def mostPoints(self, questions: List[List[int]]) -> int:\r\n        @cache\r\n        def dfs(i: int) -> int:\r\n            if i >= len(questions):\r\n                return 0\r\n            p, b = questions[i]\r\n            return max(p + dfs(i + b + 1), dfs(i + 1))\r\n\r\n        return dfs(0)",
