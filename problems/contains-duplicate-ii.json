    "problemName": "contains-duplicate-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def containsNearbyDuplicate(self, nums: List[int], k: int) -> bool:\r\n        d = {}\r\n        for i, x in enumerate(nums):\r\n            if x in d and i - d[x] <= k:\r\n                return True\r\n            d[x] = i\r\n        return False",
