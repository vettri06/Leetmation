    "problemName": "trionic-array-i",
    "language": "python3",
    "code": "class Solution:\r\n    def isTrionic(self, nums: List[int]) -> bool:\r\n        n = len(nums)\r\n        p = 0\r\n        while p < n - 2 and nums[p] < nums[p + 1]:\r\n            p += 1\r\n        if p == 0:\r\n            return False\r\n        q = p\r\n        while q < n - 1 and nums[q] > nums[q + 1]:\r\n            q += 1\r\n        if q == p or q == n - 1:\r\n            return False\r\n        while q < n - 1 and nums[q] < nums[q + 1]:\r\n            q += 1\r\n        return q == n - 1",
