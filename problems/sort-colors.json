    "problemName": "sort-colors",
    "language": "python3",
    "code": "class Solution:\r\n    def sortColors(self, nums: List[int]) -> None:\r\n        i, j, k = -1, len(nums), 0\r\n        while k < j:\r\n            if nums[k] == 0:\r\n                i += 1\r\n                nums[i], nums[k] = nums[k], nums[i]\r\n                k += 1\r\n            elif nums[k] == 2:\r\n                j -= 1\r\n                nums[j], nums[k] = nums[k], nums[j]\r\n            else:\r\n                k += 1",
