{
    "problemName": "find-all-anagrams-in-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def findAnagrams(self, s: str, p: str) -> List[int]:\r\n        m, n = len(s), len(p)\r\n        ans = []\r\n        if m < n:\r\n            return ans\r\n        cnt1 = Counter(p)\r\n        cnt2 = Counter(s[: n - 1])\r\n        for i in range(n - 1, m):\r\n            cnt2[s[i]] += 1\r\n            if cnt1 == cnt2:\r\n                ans.append(i - n + 1)\r\n            cnt2[s[i - n + 1]] -= 1\r\n        return ans",
