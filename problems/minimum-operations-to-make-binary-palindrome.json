{
    "problemName": "minimum-operations-to-make-binary-palindrome",
    "language": "python3",
    "code": "p = []\r\nfor i in range(1 << 14):\r\n    s = bin(i)[2:]\r\n    if s == s[::-1]:\r\n        p.append(i)\r\n\r\n\r\nclass Solution:\r\n    def minOperations(self, nums: List[int]) -> List[int]:\r\n        ans = []\r\n        for x in nums:\r\n            i = bisect_left(p, x)\r\n            times = inf\r\n            if i < len(p):\r\n                times = min(times, p[i] - x)\r\n            if i >= 1:\r\n                times = min(times, x - p[i - 1])\r\n            ans.append(times)\r\n        return ans",
