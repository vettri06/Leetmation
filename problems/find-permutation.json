    "problemName": "find-permutation",
    "language": "python3",
    "code": "class Solution:\r\n    def findPermutation(self, s: str) -> List[int]:\r\n        n = len(s)\r\n        ans = list(range(1, n + 2))\r\n        i = 0\r\n        while i < n:\r\n            j = i\r\n            while j < n and s[j] == 'D':\r\n                j += 1\r\n            ans[i : j + 1] = ans[i : j + 1][::-1]\r\n            i = max(i + 1, j)\r\n        return ans",
