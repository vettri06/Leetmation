    "language": "python3",
    "code": "class StockSpanner:\r\n    def __init__(self):\r\n        self.stk = []\r\n\r\n    def next(self, price: int) -> int:\r\n        cnt = 1\r\n        while self.stk and self.stk[-1][0] <= price:\r\n            cnt += self.stk.pop()[1]\r\n        self.stk.append((price, cnt))\r\n        return cnt\r\n\r\n\r\n# Your StockSpanner object will be instantiated and called as such:\r\n# obj = StockSpanner()\r\n# param_1 = obj.next(price)",
