{
    "problemName": "finding-the-number-of-visible-mountains",
    "language": "python3",
    "code": "class Solution:\r\n    def visibleMountains(self, peaks: List[List[int]]) -> int:\r\n        arr = [(x - y, x + y) for x, y in peaks]\r\n        cnt = Counter(arr)\r\n        arr.sort(key=lambda x: (x[0], -x[1]))\r\n        ans, cur = 0, -inf\r\n        for l, r in arr:\r\n            if r <= cur:\r\n                continue\r\n            cur = r\r\n            if cnt[(l, r)] == 1:\r\n                ans += 1\r\n        return ans",
