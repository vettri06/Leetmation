{
    "problemName": "longest-arithmetic-subsequence",
    "language": "python3",
    "code": "class Solution:\r\n    def longestArithSeqLength(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        f = [[1] * 1001 for _ in range(n)]\r\n        ans = 0\r\n        for i in range(1, n):\r\n            for k in range(i):\r\n                j = nums[i] - nums[k] + 500\r\n                f[i][j] = max(f[i][j], f[k][j] + 1)\r\n                ans = max(ans, f[i][j])\r\n        return ans",
