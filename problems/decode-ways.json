{
    "problemName": "decode-ways",
    "language": "python3",
    "code": "class Solution:\r\n    def numDecodings(self, s: str) -> int:\r\n        n = len(s)\r\n        f = [1] + [0] * n\r\n        for i, c in enumerate(s, 1):\r\n            if c != \"0\":\r\n                f[i] = f[i - 1]\r\n            if i > 1 and s[i - 2] != \"0\" and int(s[i - 2 : i]) <= 26:\r\n                f[i] += f[i - 2]\r\n        return f[n]",
