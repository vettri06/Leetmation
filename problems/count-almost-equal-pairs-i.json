{
    "problemName": "count-almost-equal-pairs-i",
    "language": "python3",
    "code": "class Solution:\r\n    def countPairs(self, nums: List[int]) -> int:\r\n        nums.sort()\r\n        ans = 0\r\n        cnt = defaultdict(int)\r\n        for x in nums:\r\n            vis = {x}\r\n            s = list(str(x))\r\n            for j in range(len(s)):\r\n                for i in range(j):\r\n                    s[i], s[j] = s[j], s[i]\r\n                    vis.add(int(\"\".join(s)))\r\n                    s[i], s[j] = s[j], s[i]\r\n            ans += sum(cnt[x] for x in vis)\r\n            cnt[x] += 1\r\n        return ans",
