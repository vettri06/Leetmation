    "problemName": "group-anagrams",
    "language": "python3",
    "code": "class Solution:\r\n    def groupAnagrams(self, strs: List[str]) -> List[List[str]]:\r\n        d = defaultdict(list)\r\n        for s in strs:\r\n            k = ''.join(sorted(s))\r\n            d[k].append(s)\r\n        return list(d.values())",
