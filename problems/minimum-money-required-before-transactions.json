{
    "problemName": "minimum-money-required-before-transactions",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumMoney(self, transactions: List[List[int]]) -> int:\r\n        s = sum(max(0, a - b) for a, b in transactions)\r\n        ans = 0\r\n        for a, b in transactions:\r\n            if a > b:\r\n                ans = max(ans, s + b)\r\n            else:\r\n                ans = max(ans, s + a)\r\n        return ans",
