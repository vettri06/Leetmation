{
    "problemName": "find-special-substring-of-length-k",
    "language": "python3",
    "code": "class Solution:\r\n    def hasSpecialSubstring(self, s: str, k: int) -> bool:\r\n        l, n = 0, len(s)\r\n        while l < n:\r\n            r = l\r\n            while r < n and s[r] == s[l]:\r\n                r += 1\r\n            if r - l == k:\r\n                return True\r\n            l = r\r\n        return False",
