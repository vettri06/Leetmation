    "problemName": "count-commas-in-range-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def countCommas(self, n: int) -> int:\r\n        ans = 0\r\n        x = 1000\r\n        while x <= n:\r\n            ans += n - x + 1\r\n            x *= 1000\r\n        return ans",
