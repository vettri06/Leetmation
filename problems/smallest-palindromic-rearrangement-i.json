    "problemName": "smallest-palindromic-rearrangement-i",
    "language": "python3",
    "code": "class Solution:\r\n    def smallestPalindrome(self, s: str) -> str:\r\n        cnt = Counter(s)\r\n        t = []\r\n        ch = \"\"\r\n        for c in ascii_lowercase:\r\n            v = cnt[c] // 2\r\n            t.append(c * v)\r\n            cnt[c] -= v * 2\r\n            if cnt[c] == 1:\r\n                ch = c\r\n        ans = \"\".join(t)\r\n        ans = ans + ch + ans[::-1]\r\n        return ans",
