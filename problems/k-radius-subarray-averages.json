{
    "problemName": "k-radius-subarray-averages",
    "language": "python3",
    "code": "class Solution:\r\n    def getAverages(self, nums: List[int], k: int) -> List[int]:\r\n        n = len(nums)\r\n        ans = [-1] * n\r\n        s = 0\r\n        for i, x in enumerate(nums):\r\n            s += x\r\n            if i >= k * 2:\r\n                ans[i - k] = s // (k * 2 + 1)\r\n                s -= nums[i - k * 2]\r\n        return ans",
