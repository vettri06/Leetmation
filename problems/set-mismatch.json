    "problemName": "set-mismatch",
    "language": "python3",
    "code": "class Solution:\r\n    def findErrorNums(self, nums: List[int]) -> List[int]:\r\n        n = len(nums)\r\n        s1 = (1 + n) * n // 2\r\n        s2 = sum(set(nums))\r\n        s = sum(nums)\r\n        return [s - s2, s1 - s2]",
