{
    "problemName": "count-of-interesting-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def countInterestingSubarrays(self, nums: List[int], modulo: int, k: int) -> int:\r\n        arr = [int(x % modulo == k) for x in nums]\r\n        cnt = Counter()\r\n        cnt[0] = 1\r\n        ans = s = 0\r\n        for x in arr:\r\n            s += x\r\n            ans += cnt[(s - k) % modulo]\r\n            cnt[s % modulo] += 1\r\n        return ans",
