    "problemName": "minimum-remove-to-make-valid-parentheses",
    "language": "python3",
    "code": "class Solution:\r\n    def minRemoveToMakeValid(self, s: str) -> str:\r\n        stk = []\r\n        x = 0\r\n        for c in s:\r\n            if c == ')' and x == 0:\r\n                continue\r\n            if c == '(':\r\n                x += 1\r\n            elif c == ')':\r\n                x -= 1\r\n            stk.append(c)\r\n        x = 0\r\n        ans = []\r\n        for c in stk[::-1]:\r\n            if c == '(' and x == 0:\r\n                continue\r\n            if c == ')':\r\n                x += 1\r\n            elif c == '(':\r\n                x -= 1\r\n            ans.append(c)\r\n        return ''.join(ans[::-1])",
