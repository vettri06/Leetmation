    "problemName": "fair-distribution-of-cookies",
    "language": "python3",
    "code": "class Solution:\r\n    def distributeCookies(self, cookies: List[int], k: int) -> int:\r\n        def dfs(i):\r\n            if i >= len(cookies):\r\n                nonlocal ans\r\n                ans = max(cnt)\r\n                return\r\n            for j in range(k):\r\n                if cnt[j] + cookies[i] >= ans or (j and cnt[j] == cnt[j - 1]):\r\n                    continue\r\n                cnt[j] += cookies[i]\r\n                dfs(i + 1)\r\n                cnt[j] -= cookies[i]\r\n\r\n        ans = inf\r\n        cnt = [0] * k\r\n        cookies.sort(reverse=True)\r\n        dfs(0)\r\n        return ans",
