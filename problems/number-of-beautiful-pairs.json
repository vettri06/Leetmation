{
    "problemName": "number-of-beautiful-pairs",
    "language": "python3",
    "code": "class Solution:\r\n    def countBeautifulPairs(self, nums: List[int]) -> int:\r\n        cnt = [0] * 10\r\n        ans = 0\r\n        for x in nums:\r\n            for y in range(10):\r\n                if cnt[y] and gcd(x % 10, y) == 1:\r\n                    ans += cnt[y]\r\n            cnt[int(str(x)[0])] += 1\r\n        return ans",
