    "problemName": "combinations",
    "language": "python3",
    "code": "class Solution:\r\n    def combine(self, n: int, k: int) -> List[List[int]]:\r\n        def dfs(i: int):\r\n            if len(t) == k:\r\n                ans.append(t[:])\r\n                return\r\n            if i > n:\r\n                return\r\n            t.append(i)\r\n            dfs(i + 1)\r\n            t.pop()\r\n            dfs(i + 1)\r\n\r\n        ans = []\r\n        t = []\r\n        dfs(1)\r\n        return ans",
