    "problemName": "maximum-sum-obtained-of-any-permutation",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSumRangeQuery(self, nums: List[int], requests: List[List[int]]) -> int:\r\n        n = len(nums)\r\n        d = [0] * n\r\n        for l, r in requests:\r\n            d[l] += 1\r\n            if r + 1 < n:\r\n                d[r + 1] -= 1\r\n        for i in range(1, n):\r\n            d[i] += d[i - 1]\r\n        nums.sort()\r\n        d.sort()\r\n        mod = 10**9 + 7\r\n        return sum(a * b for a, b in zip(nums, d)) % mod",
