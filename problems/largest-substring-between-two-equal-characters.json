{
    "problemName": "largest-substring-between-two-equal-characters",
    "language": "python3",
    "code": "class Solution:\r\n    def maxLengthBetweenEqualCharacters(self, s: str) -> int:\r\n        d = {}\r\n        ans = -1\r\n        for i, c in enumerate(s):\r\n            if c in d:\r\n                ans = max(ans, i - d[c] - 1)\r\n            else:\r\n                d[c] = i\r\n        return ans",
