{
    "problemName": "maximum-or",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumOr(self, nums: List[int], k: int) -> int:\r\n        n = len(nums)\r\n        suf = [0] * (n + 1)\r\n        for i in range(n - 1, -1, -1):\r\n            suf[i] = suf[i + 1] | nums[i]\r\n        ans = pre = 0\r\n        for i, x in enumerate(nums):\r\n            ans = max(ans, pre | (x << k) | suf[i + 1])\r\n            pre |= x\r\n        return ans",
