{
    "problemName": "maximum-bitwise-xor-after-rearrangement",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumXor(self, s: str, t: str) -> str:\r\n        cnt = [0, 0]\r\n        for c in t:\r\n            cnt[int(c)] += 1\r\n        ans = ['0'] * len(s)\r\n        for i, c in enumerate(s):\r\n            x = int(c)\r\n            if cnt[x ^ 1]:\r\n                cnt[x ^ 1] -= 1\r\n                ans[i] = '1'\r\n            else:\r\n                cnt[x] -= 1\r\n        return ''.join(ans)",
