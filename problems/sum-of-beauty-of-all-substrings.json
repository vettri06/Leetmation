{
    "problemName": "sum-of-beauty-of-all-substrings",
    "language": "python3",
    "code": "class Solution:\r\n    def beautySum(self, s: str) -> int:\r\n        ans, n = 0, len(s)\r\n        for i in range(n):\r\n            cnt = Counter()\r\n            for j in range(i, n):\r\n                cnt[s[j]] += 1\r\n                ans += max(cnt.values()) - min(cnt.values())\r\n        return ans",
