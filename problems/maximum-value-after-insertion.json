{
    "problemName": "maximum-value-after-insertion",
    "language": "python3",
    "code": "class Solution:\r\n    def maxValue(self, n: str, x: int) -> str:\r\n        i = 0\r\n        if n[0] == \"-\":\r\n            i += 1\r\n            while i < len(n) and int(n[i]) <= x:\r\n                i += 1\r\n        else:\r\n            while i < len(n) and int(n[i]) >= x:\r\n                i += 1\r\n        return n[:i] + str(x) + n[i:]",
