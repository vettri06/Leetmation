    "problemName": "make-array-non-decreasing",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumPossibleSize(self, nums: List[int]) -> int:\r\n        ans = mx = 0\r\n        for x in nums:\r\n            if mx <= x:\r\n                ans += 1\r\n                mx = x\r\n        return ans",
