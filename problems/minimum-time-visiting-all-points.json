    "code": "class Solution:\r\n    def minTimeToVisitAllPoints(self, points: List[List[int]]) -> int:\r\n        return sum(\r\n            max(abs(p1[0] - p2[0]), abs(p1[1] - p2[1])) for p1, p2 in pairwise(points)\r\n        )",
