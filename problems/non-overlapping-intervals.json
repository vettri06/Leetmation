    "problemName": "non-overlapping-intervals",
    "language": "python3",
    "code": "class Solution:\r\n    def eraseOverlapIntervals(self, intervals: List[List[int]]) -> int:\r\n        intervals.sort(key=lambda x: x[1])\r\n        ans = len(intervals)\r\n        pre = -inf\r\n        for l, r in intervals:\r\n            if pre <= l:\r\n                ans -= 1\r\n                pre = r\r\n        return ans",
