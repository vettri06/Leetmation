{
    "problemName": "find-duplicate-file-in-system",
    "language": "python3",
    "code": "class Solution:\r\n    def findDuplicate(self, paths: List[str]) -> List[List[str]]:\r\n        d = defaultdict(list)\r\n        for p in paths:\r\n            ps = p.split()\r\n            for f in ps[1:]:\r\n                i = f.find('(')\r\n                name, content = f[:i], f[i + 1 : -1]\r\n                d[content].append(ps[0] + '/' + name)\r\n        return [v for v in d.values() if len(v) > 1]",
