{
    "problemName": "split-a-circular-linked-list",
    "language": "python3",
    "code": "# Definition for singly-linked list.\r\n# class ListNode:\r\n#     def __init__(self, val=0, next=None):\r\n#         self.val = val\r\n#         self.next = next\r\nclass Solution:\r\n    def splitCircularLinkedList(\r\n        self, list: Optional[ListNode]\r\n    ) -> List[Optional[ListNode]]:\r\n        a = b = list\r\n        while b.next != list and b.next.next != list:\r\n            a = a.next\r\n            b = b.next.next\r\n        if b.next != list:\r\n            b = b.next\r\n        list2 = a.next\r\n        b.next = list2\r\n        a.next = list\r\n        return [list, list2]",
    "problemId": 2674,
