{
    "problemName": "find-missing-and-repeated-values",
    "language": "python3",
    "code": "class Solution:\r\n    def findMissingAndRepeatedValues(self, grid: List[List[int]]) -> List[int]:\r\n        n = len(grid)\r\n        cnt = [0] * (n * n + 1)\r\n        for row in grid:\r\n            for v in row:\r\n                cnt[v] += 1\r\n        ans = [0] * 2\r\n        for i in range(1, n * n + 1):\r\n            if cnt[i] == 2:\r\n                ans[0] = i\r\n            if cnt[i] == 0:\r\n                ans[1] = i\r\n        return ans",
