{
    "problemName": "minimum-cost-to-hire-k-workers",
    "language": "python3",
    "code": "class Solution:\r\n    def mincostToHireWorkers(\r\n        self, quality: List[int], wage: List[int], k: int\r\n    ) -> float:\r\n        t = sorted(zip(quality, wage), key=lambda x: x[1] / x[0])\r\n        ans, tot = inf, 0\r\n        h = []\r\n        for q, w in t:\r\n            tot += q\r\n            heappush(h, -q)\r\n            if len(h) == k:\r\n                ans = min(ans, w / q * tot)\r\n                tot += heappop(h)\r\n        return ans",
