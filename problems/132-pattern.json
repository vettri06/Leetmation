{
    "problemName": "132-pattern",
    "language": "python3",
    "code": "class Solution:\r\n    def find132pattern(self, nums: List[int]) -> bool:\r\n        vk = -inf\r\n        stk = []\r\n        for x in nums[::-1]:\r\n            if x < vk:\r\n                return True\r\n            while stk and stk[-1] < x:\r\n                vk = stk.pop()\r\n            stk.append(x)\r\n        return False",
