    "problemName": "maximize-happiness-of-selected-children",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumHappinessSum(self, happiness: List[int], k: int) -> int:\r\n        happiness.sort(reverse=True)\r\n        ans = 0\r\n        for i, x in enumerate(happiness[:k]):\r\n            x -= i\r\n            ans += max(x, 0)\r\n        return ans",
