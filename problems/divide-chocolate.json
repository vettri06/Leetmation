    "problemName": "divide-chocolate",
    "language": "python3",
    "code": "class Solution:\r\n    def maximizeSweetness(self, sweetness: List[int], k: int) -> int:\r\n        def check(x: int) -> bool:\r\n            s = cnt = 0\r\n            for v in sweetness:\r\n                s += v\r\n                if s >= x:\r\n                    s = 0\r\n                    cnt += 1\r\n            return cnt > k\r\n\r\n        l, r = 0, sum(sweetness)\r\n        while l < r:\r\n            mid = (l + r + 1) >> 1\r\n            if check(mid):\r\n                l = mid\r\n            else:\r\n                r = mid - 1\r\n        return l",
