{
    "problemName": "contiguous-array",
    "language": "python3",
    "code": "class Solution:\r\n    def findMaxLength(self, nums: List[int]) -> int:\r\n        d = {0: -1}\r\n        ans = s = 0\r\n        for i, x in enumerate(nums):\r\n            s += 1 if x else -1\r\n            if s in d:\r\n                ans = max(ans, i - d[s])\r\n            else:\r\n                d[s] = i\r\n        return ans",
