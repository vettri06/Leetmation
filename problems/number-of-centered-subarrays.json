{
    "problemName": "number-of-centered-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def centeredSubarrays(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        ans = 0\r\n        for i in range(n):\r\n            st = set()\r\n            s = 0\r\n            for j in range(i, n):\r\n                s += nums[j]\r\n                st.add(nums[j])\r\n                if s in st:\r\n                    ans += 1\r\n        return ans",
