{
    "problemName": "distribute-candies-among-children-iii",
    "language": "python3",
    "code": "class Solution:\r\n    def distributeCandies(self, n: int, limit: int) -> int:\r\n        if n > 3 * limit:\r\n            return 0\r\n        ans = comb(n + 2, 2)\r\n        if n > limit:\r\n            ans -= 3 * comb(n - limit + 1, 2)\r\n        if n - 2 >= 2 * limit:\r\n            ans += 3 * comb(n - 2 * limit, 2)\r\n        return ans",
