{
    "problemName": "count-number-of-maximum-bitwise-or-subsets",
    "language": "python3",
    "code": "class Solution:\r\n    def countMaxOrSubsets(self, nums: List[int]) -> int:\r\n        def dfs(i, t):\r\n            nonlocal ans, mx\r\n            if i == len(nums):\r\n                if t == mx:\r\n                    ans += 1\r\n                return\r\n            dfs(i + 1, t)\r\n            dfs(i + 1, t | nums[i])\r\n\r\n        ans = 0\r\n        mx = reduce(lambda x, y: x | y, nums)\r\n        dfs(0, 0)\r\n        return ans",
