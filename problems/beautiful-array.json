    "problemName": "beautiful-array",
    "language": "python3",
    "code": "class Solution:\r\n    def beautifulArray(self, n: int) -> List[int]:\r\n        if n == 1:\r\n            return [1]\r\n        left = self.beautifulArray((n + 1) >> 1)\r\n        right = self.beautifulArray(n >> 1)\r\n        left = [x * 2 - 1 for x in left]\r\n        right = [x * 2 for x in right]\r\n        return left + right",
