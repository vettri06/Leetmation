{
    "problemName": "count-operations-to-obtain-zero",
    "language": "python3",
    "code": "class Solution:\r\n    def countOperations(self, num1: int, num2: int) -> int:\r\n        ans = 0\r\n        while num1 and num2:\r\n            if num1 >= num2:\r\n                num1 -= num2\r\n            else:\r\n                num2 -= num1\r\n            ans += 1\r\n        return ans",
