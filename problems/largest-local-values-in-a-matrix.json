{
    "problemName": "largest-local-values-in-a-matrix",
    "language": "python3",
    "code": "class Solution:\r\n    def largestLocal(self, grid: List[List[int]]) -> List[List[int]]:\r\n        n = len(grid)\r\n        ans = [[0] * (n - 2) for _ in range(n - 2)]\r\n        for i in range(n - 2):\r\n            for j in range(n - 2):\r\n                ans[i][j] = max(\r\n                    grid[x][y] for x in range(i, i + 3) for y in range(j, j + 3)\r\n                )\r\n        return ans",
