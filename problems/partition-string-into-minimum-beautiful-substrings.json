    "language": "python3",
    "code": "class Solution:\r\n    def minimumBeautifulSubstrings(self, s: str) -> int:\r\n        @cache\r\n        def dfs(i: int) -> int:\r\n            if i >= n:\r\n                return 0\r\n            if s[i] == \"0\":\r\n                return inf\r\n            x = 0\r\n            ans = inf\r\n            for j in range(i, n):\r\n                x = x << 1 | int(s[j])\r\n                if x in ss:\r\n                    ans = min(ans, 1 + dfs(j + 1))\r\n            return ans\r\n\r\n        n = len(s)\r\n        x = 1\r\n        ss = {x}\r\n        for i in range(n):\r\n            x *= 5\r\n            ss.add(x)\r\n        ans = dfs(0)\r\n        return -1 if ans == inf else ans",
