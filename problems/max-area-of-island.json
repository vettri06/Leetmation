    "problemName": "max-area-of-island",
    "language": "python3",
    "code": "class Solution:\r\n    def maxAreaOfIsland(self, grid: List[List[int]]) -> int:\r\n        def dfs(i: int, j: int) -> int:\r\n            if grid[i][j] == 0:\r\n                return 0\r\n            ans = 1\r\n            grid[i][j] = 0\r\n            dirs = (-1, 0, 1, 0, -1)\r\n            for a, b in pairwise(dirs):\r\n                x, y = i + a, j + b\r\n                if 0 <= x < m and 0 <= y < n:\r\n                    ans += dfs(x, y)\r\n            return ans\r\n\r\n        m, n = len(grid), len(grid[0])\r\n        return max(dfs(i, j) for i in range(m) for j in range(n))",
