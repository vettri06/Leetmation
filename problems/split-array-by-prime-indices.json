    "problemName": "split-array-by-prime-indices",
    "language": "python3",
    "code": "m = 10**5 + 10\r\nprimes = [True] * m\r\nprimes[0] = primes[1] = False\r\nfor i in range(2, m):\r\n    if primes[i]:\r\n        for j in range(i + i, m, i):\r\n            primes[j] = False\r\n\r\n\r\nclass Solution:\r\n    def splitArray(self, nums: List[int]) -> int:\r\n        return abs(sum(x if primes[i] else -x for i, x in enumerate(nums)))",
