    "language": "python3",
    "code": "class Solution:\r\n    def predictPartyVictory(self, senate: str) -> str:\r\n        qr = deque()\r\n        qd = deque()\r\n        for i, c in enumerate(senate):\r\n            if c == \"R\":\r\n                qr.append(i)\r\n            else:\r\n                qd.append(i)\r\n        n = len(senate)\r\n        while qr and qd:\r\n            if qr[0] < qd[0]:\r\n                qr.append(qr[0] + n)\r\n            else:\r\n                qd.append(qd[0] + n)\r\n            qr.popleft()\r\n            qd.popleft()\r\n        return \"Radiant\" if qr else \"Dire\"",
