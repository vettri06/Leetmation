{
    "problemName": "shortest-distance-to-a-character",
    "language": "python3",
    "code": "class Solution:\r\n    def shortestToChar(self, s: str, c: str) -> List[int]:\r\n        n = len(s)\r\n        ans = [n] * n\r\n        pre = -inf\r\n        for i, ch in enumerate(s):\r\n            if ch == c:\r\n                pre = i\r\n            ans[i] = min(ans[i], i - pre)\r\n        suf = inf\r\n        for i in range(n - 1, -1, -1):\r\n            if s[i] == c:\r\n                suf = i\r\n            ans[i] = min(ans[i], suf - i)\r\n        return ans",
