{
    "problemName": "unique-substrings-in-wraparound-string",
    "language": "python3",
    "code": "class Solution:\r\n    def findSubstringInWraproundString(self, s: str) -> int:\r\n        f = defaultdict(int)\r\n        k = 0\r\n        for i, c in enumerate(s):\r\n            if i and (ord(c) - ord(s[i - 1])) % 26 == 1:\r\n                k += 1\r\n            else:\r\n                k = 1\r\n            f[c] = max(f[c], k)\r\n        return sum(f.values())",
