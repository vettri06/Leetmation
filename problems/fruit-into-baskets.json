{
    "problemName": "fruit-into-baskets",
    "language": "python3",
    "code": "class Solution:\r\n    def totalFruit(self, fruits: List[int]) -> int:\r\n        cnt = Counter()\r\n        ans = j = 0\r\n        for i, x in enumerate(fruits):\r\n            cnt[x] += 1\r\n            while len(cnt) > 2:\r\n                y = fruits[j]\r\n                cnt[y] -= 1\r\n                if cnt[y] == 0:\r\n                    cnt.pop(y)\r\n                j += 1\r\n            ans = max(ans, i - j + 1)\r\n        return ans",
