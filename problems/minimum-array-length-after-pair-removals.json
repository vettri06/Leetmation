    "problemName": "minimum-array-length-after-pair-removals",
    "language": "python3",
    "code": "class Solution:\r\n    def minLengthAfterRemovals(self, nums: List[int]) -> int:\r\n        cnt = Counter(nums)\r\n        pq = [-x for x in cnt.values()]\r\n        heapify(pq)\r\n        ans = len(nums)\r\n        while len(pq) > 1:\r\n            x, y = -heappop(pq), -heappop(pq)\r\n            x -= 1\r\n            y -= 1\r\n            if x > 0:\r\n                heappush(pq, -x)\r\n            if y > 0:\r\n                heappush(pq, -y)\r\n            ans -= 2\r\n        return ans",
