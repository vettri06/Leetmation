{
    "problemName": "arithmetic-slices-ii-subsequence",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfArithmeticSlices(self, nums: List[int]) -> int:\r\n        f = [defaultdict(int) for _ in nums]\r\n        ans = 0\r\n        for i, x in enumerate(nums):\r\n            for j, y in enumerate(nums[:i]):\r\n                d = x - y\r\n                ans += f[j][d]\r\n                f[i][d] += f[j][d] + 1\r\n        return ans",
