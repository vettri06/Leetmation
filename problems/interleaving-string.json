    "problemName": "interleaving-string",
    "language": "python3",
    "code": "class Solution:\r\n    def isInterleave(self, s1: str, s2: str, s3: str) -> bool:\r\n        @cache\r\n        def dfs(i: int, j: int) -> bool:\r\n            if i >= m and j >= n:\r\n                return True\r\n            k = i + j\r\n            if i < m and s1[i] == s3[k] and dfs(i + 1, j):\r\n                return True\r\n            if j < n and s2[j] == s3[k] and dfs(i, j + 1):\r\n                return True\r\n            return False\r\n\r\n        m, n = len(s1), len(s2)\r\n        if m + n != len(s3):\r\n            return False\r\n        return dfs(0, 0)",
