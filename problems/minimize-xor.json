{
    "problemName": "minimize-xor",
    "language": "python3",
    "code": "class Solution:\r\n    def minimizeXor(self, num1: int, num2: int) -> int:\r\n        cnt = num2.bit_count()\r\n        x = 0\r\n        for i in range(30, -1, -1):\r\n            if num1 >> i & 1 and cnt:\r\n                x |= 1 << i\r\n                cnt -= 1\r\n        for i in range(30):\r\n            if num1 >> i & 1 ^ 1 and cnt:\r\n                x |= 1 << i\r\n                cnt -= 1\r\n        return x",
