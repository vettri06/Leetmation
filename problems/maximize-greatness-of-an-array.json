    "problemName": "maximize-greatness-of-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def maximizeGreatness(self, nums: List[int]) -> int:\r\n        nums.sort()\r\n        i = 0\r\n        for x in nums:\r\n            i += x > nums[i]\r\n        return i",
