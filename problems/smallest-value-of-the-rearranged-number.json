{
    "problemName": "smallest-value-of-the-rearranged-number",
    "language": "python3",
    "code": "class Solution:\r\n    def smallestNumber(self, num: int) -> int:\r\n        neg = num < 0\r\n        num = abs(num)\r\n        cnt = [0] * 10\r\n        while num:\r\n            cnt[num % 10] += 1\r\n            num //= 10\r\n        ans = 0\r\n        if neg:\r\n            for i in reversed(range(10)):\r\n                for _ in range(cnt[i]):\r\n                    ans *= 10\r\n                    ans += i\r\n            return -ans\r\n        if cnt[0]:\r\n            for i in range(1, 10):\r\n                if cnt[i]:\r\n                    ans = i\r\n                    cnt[i] -= 1\r\n                    break\r\n        for i in range(10):\r\n            for _ in range(cnt[i]):\r\n                ans *= 10\r\n                ans += i\r\n        return ans",
