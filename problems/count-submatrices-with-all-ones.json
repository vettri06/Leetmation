    "problemName": "count-submatrices-with-all-ones",
    "language": "python3",
    "code": "class Solution:\r\n    def numSubmat(self, mat: List[List[int]]) -> int:\r\n        m, n = len(mat), len(mat[0])\r\n        g = [[0] * n for _ in range(m)]\r\n        for i in range(m):\r\n            for j in range(n):\r\n                if mat[i][j]:\r\n                    g[i][j] = 1 if j == 0 else 1 + g[i][j - 1]\r\n        ans = 0\r\n        for i in range(m):\r\n            for j in range(n):\r\n                col = inf\r\n                for k in range(i, -1, -1):\r\n                    col = min(col, g[k][j])\r\n                    ans += col\r\n        return ans",
