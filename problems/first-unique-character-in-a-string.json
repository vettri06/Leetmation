    "problemName": "first-unique-character-in-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def firstUniqChar(self, s: str) -> int:\r\n        cnt = Counter(s)\r\n        for i, c in enumerate(s):\r\n            if cnt[c] == 1:\r\n                return i\r\n        return -1",
