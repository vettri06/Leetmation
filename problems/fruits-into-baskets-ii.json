{
    "problemName": "fruits-into-baskets-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def numOfUnplacedFruits(self, fruits: List[int], baskets: List[int]) -> int:\r\n        n = len(fruits)\r\n        vis = [False] * n\r\n        ans = n\r\n        for x in fruits:\r\n            for i, y in enumerate(baskets):\r\n                if y >= x and not vis[i]:\r\n                    vis[i] = True\r\n                    ans -= 1\r\n                    break\r\n        return ans",
