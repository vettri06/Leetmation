    "problemName": "minimum-processing-time",
    "language": "python3",
    "code": "class Solution:\r\n    def minProcessingTime(self, processorTime: List[int], tasks: List[int]) -> int:\r\n        processorTime.sort()\r\n        tasks.sort()\r\n        ans = 0\r\n        i = len(tasks) - 1\r\n        for t in processorTime:\r\n            ans = max(ans, t + tasks[i])\r\n            i -= 4\r\n        return ans",
