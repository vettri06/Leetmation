    "problemName": "find-the-array-concatenation-value",
    "language": "python3",
    "code": "class Solution:\r\n    def findTheArrayConcVal(self, nums: List[int]) -> int:\r\n        ans = 0\r\n        i, j = 0, len(nums) - 1\r\n        while i < j:\r\n            ans += int(str(nums[i]) + str(nums[j]))\r\n            i, j = i + 1, j - 1\r\n        if i == j:\r\n            ans += nums[i]\r\n        return ans",
