    "problemName": "redundant-connection",
    "language": "python3",
    "code": "class Solution:\r\n    def findRedundantConnection(self, edges: List[List[int]]) -> List[int]:\r\n        def find(x: int) -> int:\r\n            if p[x] != x:\r\n                p[x] = find(p[x])\r\n            return p[x]\r\n\r\n        p = list(range(len(edges)))\r\n        for a, b in edges:\r\n            pa, pb = find(a - 1), find(b - 1)\r\n            if pa == pb:\r\n                return [a, b]\r\n            p[pa] = pb",
