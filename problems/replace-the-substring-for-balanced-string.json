{
    "problemName": "replace-the-substring-for-balanced-string",
    "language": "python3",
    "code": "class Solution:\r\n    def balancedString(self, s: str) -> int:\r\n        cnt = Counter(s)\r\n        n = len(s)\r\n        if all(v <= n // 4 for v in cnt.values()):\r\n            return 0\r\n        ans, j = n, 0\r\n        for i, c in enumerate(s):\r\n            cnt[c] -= 1\r\n            while j <= i and all(v <= n // 4 for v in cnt.values()):\r\n                ans = min(ans, i - j + 1)\r\n                cnt[s[j]] += 1\r\n                j += 1\r\n        return ans",
