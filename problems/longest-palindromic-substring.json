    "problemName": "longest-palindromic-substring",
    "language": "python3",
    "code": "class Solution:\r\n    def longestPalindrome(self, s: str) -> str:\r\n        n = len(s)\r\n        f = [[True] * n for _ in range(n)]\r\n        k, mx = 0, 1\r\n        for i in range(n - 2, -1, -1):\r\n            for j in range(i + 1, n):\r\n                f[i][j] = False\r\n                if s[i] == s[j]:\r\n                    f[i][j] = f[i + 1][j - 1]\r\n                    if f[i][j] and mx < j - i + 1:\r\n                        k, mx = i, j - i + 1\r\n        return s[k : k + mx]",
