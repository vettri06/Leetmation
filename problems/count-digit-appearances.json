{
    "problemName": "count-digit-appearances",
    "language": "python3",
    "code": "class Solution:\r\n    def countDigitOccurrences(self, nums: list[int], digit: int) -> int:\r\n        ans = 0\r\n        for x in nums:\r\n            while x:\r\n                v = x % 10\r\n                if v == digit:\r\n                    ans += 1\r\n                x //= 10\r\n        return ans",
