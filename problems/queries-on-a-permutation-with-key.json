{
    "problemName": "queries-on-a-permutation-with-key",
    "language": "python3",
    "code": "class Solution:\r\n    def processQueries(self, queries: List[int], m: int) -> List[int]:\r\n        p = list(range(1, m + 1))\r\n        ans = []\r\n        for v in queries:\r\n            j = p.index(v)\r\n            ans.append(j)\r\n            p.pop(j)\r\n            p.insert(0, v)\r\n        return ans",
