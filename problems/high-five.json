    "problemName": "high-five",
    "language": "python3",
    "code": "class Solution:\r\n    def highFive(self, items: List[List[int]]) -> List[List[int]]:\r\n        d = defaultdict(list)\r\n        m = 0\r\n        for i, x in items:\r\n            d[i].append(x)\r\n            m = max(m, i)\r\n        ans = []\r\n        for i in range(1, m + 1):\r\n            if xs := d[i]:\r\n                avg = sum(nlargest(5, xs)) // 5\r\n                ans.append([i, avg])\r\n        return ans",
