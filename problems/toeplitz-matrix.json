    "problemName": "toeplitz-matrix",
    "language": "python3",
    "code": "class Solution:\r\n    def isToeplitzMatrix(self, matrix: List[List[int]]) -> bool:\r\n        m, n = len(matrix), len(matrix[0])\r\n        for i in range(1, m):\r\n            for j in range(1, n):\r\n                if matrix[i][j] != matrix[i - 1][j - 1]:\r\n                    return False\r\n        return True",
