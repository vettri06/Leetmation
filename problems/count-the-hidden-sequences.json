{
    "problemName": "count-the-hidden-sequences",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfArrays(self, differences: List[int], lower: int, upper: int) -> int:\r\n        x = mi = mx = 0\r\n        for d in differences:\r\n            x += d\r\n            mi = min(mi, x)\r\n            mx = max(mx, x)\r\n        return max(upper - lower - (mx - mi) + 1, 0)",
