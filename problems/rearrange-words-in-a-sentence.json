    "code": "class Solution:\r\n    def arrangeWords(self, text: str) -> str:\r\n        words = text.split()\r\n        words[0] = words[0].lower()\r\n        words.sort(key=len)\r\n        words[0] = words[0].title()\r\n        return \" \".join(words)",
