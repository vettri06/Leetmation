{
    "problemName": "power-of-heroes",
    "language": "python3",
    "code": "class Solution:\r\n    def sumOfPower(self, nums: List[int]) -> int:\r\n        mod = 10**9 + 7\r\n        nums.sort()\r\n        ans = 0\r\n        p = 0\r\n        for x in nums[::-1]:\r\n            ans = (ans + (x * x % mod) * x) % mod\r\n            ans = (ans + x * p) % mod\r\n            p = (p * 2 + x * x) % mod\r\n        return ans",
