{
    "problemName": "minimum-absolute-difference-between-two-values",
    "language": "python3",
    "code": "class Solution:\r\n    def minAbsoluteDifference(self, nums: list[int]) -> int:\r\n        n = len(nums)\r\n        ans = n + 1\r\n        last = [-inf] * 3\r\n        for i, x in enumerate(nums):\r\n            if x:\r\n                ans = min(ans, i - last[3 - x])\r\n                last[x] = i\r\n        return -1 if ans > n else ans",
