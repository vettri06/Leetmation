{
    "problemName": "number-of-ways-to-split-array",
    "language": "python3",
    "code": "class Solution:\r\n    def waysToSplitArray(self, nums: List[int]) -> int:\r\n        s = sum(nums)\r\n        ans = t = 0\r\n        for x in nums[:-1]:\r\n            t += x\r\n            ans += t >= s - t\r\n        return ans",
