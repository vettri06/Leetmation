    "code": "/**\r\n * @param {Array} arr\r\n * @param {number} size\r\n * @return {Array[]}\r\n */\r\nvar chunk = function (arr, size) {\r\n    const ans = [];\r\n    for (let i = 0, n = arr.length; i < n; i += size) {\r\n        ans.push(arr.slice(i, i + size));\r\n    }\r\n    return ans;\r\n};",
