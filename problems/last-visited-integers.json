{
    "problemName": "last-visited-integers",
    "language": "python3",
    "code": "class Solution:\r\n    def lastVisitedIntegers(self, nums: List[int]) -> List[int]:\r\n        seen = []\r\n        ans = []\r\n        k = 0\r\n        for x in nums:\r\n            if x == -1:\r\n                k += 1\r\n                ans.append(-1 if k > len(seen) else seen[-k])\r\n            else:\r\n                k = 0\r\n                seen.append(x)\r\n        return ans",
