    "language": "python3",
    "code": "class MyStack:\r\n    def __init__(self):\r\n        self.q1 = deque()\r\n        self.q2 = deque()\r\n\r\n    def push(self, x: int) -> None:\r\n        self.q2.append(x)\r\n        while self.q1:\r\n            self.q2.append(self.q1.popleft())\r\n        self.q1, self.q2 = self.q2, self.q1\r\n\r\n    def pop(self) -> int:\r\n        return self.q1.popleft()\r\n\r\n    def top(self) -> int:\r\n        return self.q1[0]\r\n\r\n    def empty(self) -> bool:\r\n        return len(self.q1) == 0\r\n\r\n\r\n# Your MyStack object will be instantiated and called as such:\r\n# obj = MyStack()\r\n# obj.push(x)\r\n# param_2 = obj.pop()\r\n# param_3 = obj.top()\r\n# param_4 = obj.empty()",
