{
    "problemName": "extra-characters-in-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def minExtraChar(self, s: str, dictionary: List[str]) -> int:\r\n        ss = set(dictionary)\r\n        n = len(s)\r\n        f = [0] * (n + 1)\r\n        for i in range(1, n + 1):\r\n            f[i] = f[i - 1] + 1\r\n            for j in range(i):\r\n                if s[j:i] in ss and f[j] < f[i]:\r\n                    f[i] = f[j]\r\n        return f[n]",
