{
    "problemName": "number-of-nodes-with-value-one",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfNodes(self, n: int, queries: List[int]) -> int:\r\n        def dfs(i):\r\n            if i > n:\r\n                return\r\n            tree[i] ^= 1\r\n            dfs(i << 1)\r\n            dfs(i << 1 | 1)\r\n\r\n        tree = [0] * (n + 1)\r\n        cnt = Counter(queries)\r\n        for i, v in cnt.items():\r\n            if v & 1:\r\n                dfs(i)\r\n        return sum(tree)",
