    "code": "class Solution:\r\n    def relativeSortArray(self, arr1: List[int], arr2: List[int]) -> List[int]:\r\n        pos = {x: i for i, x in enumerate(arr2)}\r\n        return sorted(arr1, key=lambda x: pos.get(x, 1000 + x))",
