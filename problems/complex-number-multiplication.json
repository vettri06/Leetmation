    "problemName": "complex-number-multiplication",
    "language": "python3",
    "code": "class Solution:\r\n    def complexNumberMultiply(self, num1: str, num2: str) -> str:\r\n        a1, b1 = map(int, num1[:-1].split(\"+\"))\r\n        a2, b2 = map(int, num2[:-1].split(\"+\"))\r\n        return f\"{a1 * a2 - b1 * b2}+{a1 * b2 + a2 * b1}i\"",
