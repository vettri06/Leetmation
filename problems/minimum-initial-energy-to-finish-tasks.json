{
    "problemName": "minimum-initial-energy-to-finish-tasks",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumEffort(self, tasks: List[List[int]]) -> int:\r\n        ans = cur = 0\r\n        for a, m in sorted(tasks, key=lambda x: x[0] - x[1]):\r\n            if cur < m:\r\n                ans += m - cur\r\n                cur = m\r\n            cur -= a\r\n        return ans",
