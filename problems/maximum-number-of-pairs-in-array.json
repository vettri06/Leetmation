    "code": "class Solution:\r\n    def numberOfPairs(self, nums: List[int]) -> List[int]:\r\n        cnt = Counter(nums)\r\n        s = sum(v // 2 for v in cnt.values())\r\n        return [s, len(nums) - s * 2]",
