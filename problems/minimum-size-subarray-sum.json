{
    "problemName": "minimum-size-subarray-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def minSubArrayLen(self, target: int, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        s = list(accumulate(nums, initial=0))\r\n        ans = n + 1\r\n        for i, x in enumerate(s):\r\n            j = bisect_left(s, x + target)\r\n            if j <= n:\r\n                ans = min(ans, j - i)\r\n        return ans if ans <= n else 0",
