{
    "problemName": "powerful-integers",
    "language": "python3",
    "code": "class Solution:\r\n    def powerfulIntegers(self, x: int, y: int, bound: int) -> List[int]:\r\n        ans = set()\r\n        a = 1\r\n        while a <= bound:\r\n            b = 1\r\n            while a + b <= bound:\r\n                ans.add(a + b)\r\n                b *= y\r\n                if y == 1:\r\n                    break\r\n            if x == 1:\r\n                break\r\n            a *= x\r\n        return list(ans)",
