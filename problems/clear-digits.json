    "problemName": "clear-digits",
    "language": "python3",
    "code": "class Solution:\r\n    def clearDigits(self, s: str) -> str:\r\n        stk = []\r\n        for c in s:\r\n            if c.isdigit():\r\n                stk.pop()\r\n            else:\r\n                stk.append(c)\r\n        return \"\".join(stk)",
