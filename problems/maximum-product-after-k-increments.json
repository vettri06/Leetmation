{
    "problemName": "maximum-product-after-k-increments",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumProduct(self, nums: List[int], k: int) -> int:\r\n        heapify(nums)\r\n        for _ in range(k):\r\n            heapreplace(nums, nums[0] + 1)\r\n        mod = 10**9 + 7\r\n        return reduce(lambda x, y: x * y % mod, nums)",
