    "problemName": "check-good-integer",
    "language": "python3",
    "code": "class Solution:\r\n    def checkGoodInteger(self, n: int) -> bool:\r\n        s = 0\r\n        while n:\r\n            n, x = divmod(n, 10)\r\n            s += x * (x - 1)\r\n        return s >= 50",
