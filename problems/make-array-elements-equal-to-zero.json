{
    "problemName": "make-array-elements-equal-to-zero",
    "language": "python3",
    "code": "class Solution:\r\n    def countValidSelections(self, nums: List[int]) -> int:\r\n        s = sum(nums)\r\n        ans = l = 0\r\n        for x in nums:\r\n            if x:\r\n                l += x\r\n            elif l * 2 == s:\r\n                ans += 2\r\n            elif abs(l * 2 - s) == 1:\r\n                ans += 1\r\n        return ans",
