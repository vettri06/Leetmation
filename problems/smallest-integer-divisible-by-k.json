    "code": "class Solution:\r\n    def smallestRepunitDivByK(self, k: int) -> int:\r\n        n = 1 % k\r\n        for i in range(1, k + 1):\r\n            if n == 0:\r\n                return i\r\n            n = (n * 10 + 1) % k\r\n        return -1",
