{
    "problemName": "integer-replacement",
    "language": "python3",
    "code": "class Solution:\r\n    def integerReplacement(self, n: int) -> int:\r\n        ans = 0\r\n        while n != 1:\r\n            if (n & 1) == 0:\r\n                n >>= 1\r\n            elif n != 3 and (n & 3) == 3:\r\n                n += 1\r\n            else:\r\n                n -= 1\r\n            ans += 1\r\n        return ans",
