{
    "problemName": "maximum-total-importance-of-roads",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumImportance(self, n: int, roads: List[List[int]]) -> int:\r\n        deg = [0] * n\r\n        for a, b in roads:\r\n            deg[a] += 1\r\n            deg[b] += 1\r\n        deg.sort()\r\n        return sum(i * v for i, v in enumerate(deg, 1))",
