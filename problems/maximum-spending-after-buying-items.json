{
    "problemName": "maximum-spending-after-buying-items",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSpending(self, values: List[List[int]]) -> int:\r\n        n = len(values[0])\r\n        pq = [(row[-1], i, n - 1) for i, row in enumerate(values)]\r\n        heapify(pq)\r\n        ans = d = 0\r\n        while pq:\r\n            d += 1\r\n            v, i, j = heappop(pq)\r\n            ans += v * d\r\n            if j:\r\n                heappush(pq, (values[i][j - 1], i, j - 1))\r\n        return ans",
