{
    "problemName": "find-the-smallest-balanced-index",
    "language": "python3",
    "code": "class Solution:\r\n    def smallestBalancedIndex(self, nums: list[int]) -> int:\r\n        s = sum(nums)\r\n        p = 1\r\n        for i in range(len(nums) - 1, -1, -1):\r\n            s -= nums[i]\r\n            if s == p:\r\n                return i\r\n            p *= nums[i]\r\n            if p >= s:\r\n                break\r\n        return -1",
