{
    "problemName": "construct-uniform-parity-array-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def uniformArray(self, nums1: list[int]) -> bool:\r\n        mn = inf\r\n        for x in nums1:\r\n            if x % 2:\r\n                mn = min(mn, x)\r\n        for x in nums1:\r\n            if x % 2 == 0 and mn != inf and x < mn:\r\n                return False\r\n        return True",
