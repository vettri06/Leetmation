    "language": "python3",
    "code": "class Solution:\r\n    def titleToNumber(self, columnTitle: str) -> int:\r\n        ans = 0\r\n        for c in map(ord, columnTitle):\r\n            ans = ans * 26 + c - ord(\"A\") + 1\r\n        return ans",
