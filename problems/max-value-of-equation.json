{
    "problemName": "max-value-of-equation",
    "language": "python3",
    "code": "class Solution:\r\n    def findMaxValueOfEquation(self, points: List[List[int]], k: int) -> int:\r\n        ans = -inf\r\n        pq = []\r\n        for x, y in points:\r\n            while pq and x - pq[0][1] > k:\r\n                heappop(pq)\r\n            if pq:\r\n                ans = max(ans, x + y - pq[0][0])\r\n            heappush(pq, (x - y, x))\r\n        return ans",
