    "problemName": "4-keys-keyboard",
    "language": "python3",
    "code": "class Solution:\r\n    def maxA(self, n: int) -> int:\r\n        dp = list(range(n + 1))\r\n        for i in range(3, n + 1):\r\n            for j in range(2, i - 1):\r\n                dp[i] = max(dp[i], dp[j - 1] * (i - j))\r\n        return dp[-1]",
