{
    "problemName": "friends-of-appropriate-ages",
    "language": "python3",
    "code": "class Solution:\r\n    def numFriendRequests(self, ages: List[int]) -> int:\r\n        cnt = [0] * 121\r\n        for x in ages:\r\n            cnt[x] += 1\r\n        ans = 0\r\n        for ax, x in enumerate(cnt):\r\n            for ay, y in enumerate(cnt):\r\n                if not (ay <= 0.5 * ax + 7 or ay > ax or (ay > 100 and ax < 100)):\r\n                    ans += x * (y - int(ax == ay))\r\n        return ans",
