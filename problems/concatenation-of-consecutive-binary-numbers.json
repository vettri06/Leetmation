    "problemName": "concatenation-of-consecutive-binary-numbers",
    "language": "python3",
    "code": "class Solution:\r\n    def concatenatedBinary(self, n: int) -> int:\r\n        mod = 10**9 + 7\r\n        ans = 0\r\n        for i in range(1, n + 1):\r\n            ans = (ans << i.bit_length() | i) % mod\r\n        return ans",
