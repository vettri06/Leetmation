    "problemName": "remove-covered-intervals",
    "language": "python3",
    "code": "class Solution:\r\n    def removeCoveredIntervals(self, intervals: List[List[int]]) -> int:\r\n        intervals.sort(key=lambda x: (x[0], -x[1]))\r\n        ans = 0\r\n        pre = -inf\r\n        for _, cur in intervals:\r\n            if cur > pre:\r\n                ans += 1\r\n                pre = cur\r\n        return ans",
