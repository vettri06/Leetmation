    "problemName": "removing-minimum-number-of-magic-beans",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumRemoval(self, beans: List[int]) -> int:\r\n        beans.sort()\r\n        s, n = sum(beans), len(beans)\r\n        return min(s - x * (n - i) for i, x in enumerate(beans))",
