    "problemName": "reorder-data-in-log-files",
    "language": "python3",
    "code": "class Solution:\r\n    def reorderLogFiles(self, logs: List[str]) -> List[str]:\r\n        def f(log: str):\r\n            id_, rest = log.split(\" \", 1)\r\n            return (0, rest, id_) if rest[0].isalpha() else (1,)\r\n\r\n        return sorted(logs, key=f)",
