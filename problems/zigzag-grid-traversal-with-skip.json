    "problemName": "zigzag-grid-traversal-with-skip",
    "language": "python3",
    "code": "class Solution:\r\n    def zigzagTraversal(self, grid: List[List[int]]) -> List[int]:\r\n        ok = True\r\n        ans = []\r\n        for i, row in enumerate(grid):\r\n            if i % 2:\r\n                row.reverse()\r\n            for x in row:\r\n                if ok:\r\n                    ans.append(x)\r\n                ok = not ok\r\n        return ans",
