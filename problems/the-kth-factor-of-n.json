{
    "problemName": "the-kth-factor-of-n",
    "language": "python3",
    "code": "class Solution:\r\n    def kthFactor(self, n: int, k: int) -> int:\r\n        for i in range(1, n + 1):\r\n            if n % i == 0:\r\n                k -= 1\r\n                if k == 0:\r\n                    return i\r\n        return -1",
