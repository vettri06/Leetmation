    "problemName": "one-edit-distance",
    "language": "python3",
    "code": "class Solution:\r\n    def isOneEditDistance(self, s: str, t: str) -> bool:\r\n        if len(s) < len(t):\r\n            return self.isOneEditDistance(t, s)\r\n        m, n = len(s), len(t)\r\n        if m - n > 1:\r\n            return False\r\n        for i, c in enumerate(t):\r\n            if c != s[i]:\r\n                return s[i + 1 :] == t[i + 1 :] if m == n else s[i + 1 :] == t[i:]\r\n        return m == n + 1",
