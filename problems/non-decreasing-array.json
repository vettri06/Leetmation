{
    "problemName": "non-decreasing-array",
    "language": "python3",
    "code": "class Solution:\r\n    def checkPossibility(self, nums: List[int]) -> bool:\r\n        def is_sorted(nums: List[int]) -> bool:\r\n            return all(a <= b for a, b in pairwise(nums))\r\n\r\n        n = len(nums)\r\n        for i in range(n - 1):\r\n            a, b = nums[i], nums[i + 1]\r\n            if a > b:\r\n                nums[i] = b\r\n                if is_sorted(nums):\r\n                    return True\r\n                nums[i] = nums[i + 1] = a\r\n                return is_sorted(nums)\r\n        return True",
