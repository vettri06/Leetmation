    "language": "python3",
    "code": "ps = []\r\nfor i in range(1, 10**5 + 1):\r\n    s = str(i)\r\n    t1 = s[::-1]\r\n    t2 = s[:-1][::-1]\r\n    ps.append(int(s + t1))\r\n    ps.append(int(s + t2))\r\nps.sort()\r\n\r\n\r\nclass Solution:\r\n    def minimumCost(self, nums: List[int]) -> int:\r\n        def f(x: int) -> int:\r\n            return sum(abs(v - x) for v in nums)\r\n\r\n        nums.sort()\r\n        i = bisect_left(ps, nums[len(nums) // 2])\r\n        return min(f(ps[j]) for j in range(i - 1, i + 2) if 0 <= j < len(ps))",
