    "problemName": "house-robber-iv",
    "language": "python3",
    "code": "class Solution:\r\n    def minCapability(self, nums: List[int], k: int) -> int:\r\n        def f(x):\r\n            cnt, j = 0, -2\r\n            for i, v in enumerate(nums):\r\n                if v > x or i == j + 1:\r\n                    continue\r\n                cnt += 1\r\n                j = i\r\n            return cnt >= k\r\n\r\n        return bisect_left(range(max(nums) + 1), True, key=f)",
