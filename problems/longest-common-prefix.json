    "problemName": "longest-common-prefix",
    "language": "python3",
    "code": "class Solution:\r\n    def longestCommonPrefix(self, strs: List[str]) -> str:\r\n        for i in range(len(strs[0])):\r\n            for s in strs[1:]:\r\n                if len(s) <= i or s[i] != strs[0][i]:\r\n                    return s[:i]\r\n        return strs[0]",
