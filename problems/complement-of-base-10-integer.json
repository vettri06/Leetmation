{
    "problemName": "complement-of-base-10-integer",
    "language": "python3",
    "code": "class Solution:\r\n    def bitwiseComplement(self, n: int) -> int:\r\n        if n == 0:\r\n            return 1\r\n        ans = i = 0\r\n        while n:\r\n            ans |= (n & 1 ^ 1) << i\r\n            i += 1\r\n            n >>= 1\r\n        return ans",
