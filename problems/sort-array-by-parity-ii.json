    "problemName": "sort-array-by-parity-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def sortArrayByParityII(self, nums: List[int]) -> List[int]:\r\n        n, j = len(nums), 1\r\n        for i in range(0, n, 2):\r\n            if nums[i] % 2:\r\n                while nums[j] % 2:\r\n                    j += 2\r\n                nums[i], nums[j] = nums[j], nums[i]\r\n        return nums",
