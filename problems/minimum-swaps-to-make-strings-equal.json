{
    "problemName": "minimum-swaps-to-make-strings-equal",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumSwap(self, s1: str, s2: str) -> int:\r\n        xy = yx = 0\r\n        for a, b in zip(s1, s2):\r\n            xy += a < b\r\n            yx += a > b\r\n        if (xy + yx) % 2:\r\n            return -1\r\n        return xy // 2 + yx // 2 + xy % 2 + yx % 2",
