    "code": "class SORTracker:\r\n    def __init__(self):\r\n        self.sl = SortedList()\r\n        self.i = -1\r\n\r\n    def add(self, name: str, score: int) -> None:\r\n        self.sl.add((-score, name))\r\n\r\n    def get(self) -> str:\r\n        self.i += 1\r\n        return self.sl[self.i][1]\r\n\r\n\r\n# Your SORTracker object will be instantiated and called as such:\r\n# obj = SORTracker()\r\n# obj.add(name,score)\r\n# param_2 = obj.get()",
