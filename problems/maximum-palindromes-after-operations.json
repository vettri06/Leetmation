{
    "problemName": "maximum-palindromes-after-operations",
    "language": "python3",
    "code": "class Solution:\r\n    def maxPalindromesAfterOperations(self, words: List[str]) -> int:\r\n        s = mask = 0\r\n        for w in words:\r\n            s += len(w)\r\n            for c in w:\r\n                mask ^= 1 << (ord(c) - ord(\"a\"))\r\n        s -= mask.bit_count()\r\n        words.sort(key=len)\r\n        ans = 0\r\n        for w in words:\r\n            s -= len(w) // 2 * 2\r\n            if s < 0:\r\n                break\r\n            ans += 1\r\n        return ans",
