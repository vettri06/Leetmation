    "problemName": "partition-array-according-to-given-pivot",
    "language": "python3",
    "code": "class Solution:\r\n    def pivotArray(self, nums: List[int], pivot: int) -> List[int]:\r\n        a, b, c = [], [], []\r\n        for x in nums:\r\n            if x < pivot:\r\n                a.append(x)\r\n            elif x == pivot:\r\n                b.append(x)\r\n            else:\r\n                c.append(x)\r\n        return a + b + c",
