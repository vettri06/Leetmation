{
    "problemName": "climbing-stairs-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def climbStairs(self, n: int, costs: List[int]) -> int:\r\n        n = len(costs)\r\n        f = [inf] * (n + 1)\r\n        f[0] = 0\r\n        for i, x in enumerate(costs, 1):\r\n            for j in range(i - 3, i):\r\n                if j >= 0:\r\n                    f[i] = min(f[i], f[j] + x + (i - j) ** 2)\r\n        return f[n]",
