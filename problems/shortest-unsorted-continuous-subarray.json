{
    "problemName": "shortest-unsorted-continuous-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def findUnsortedSubarray(self, nums: List[int]) -> int:\r\n        arr = sorted(nums)\r\n        l, r = 0, len(nums) - 1\r\n        while l <= r and nums[l] == arr[l]:\r\n            l += 1\r\n        while l <= r and nums[r] == arr[r]:\r\n            r -= 1\r\n        return r - l + 1",
