    "language": "python3",
    "code": "class Solution:\r\n    def countGoodNumbers(self, n: int) -> int:\r\n        mod = 10**9 + 7\r\n        return pow(5, (n + 1) >> 1, mod) * pow(4, n >> 1, mod) % mod",
