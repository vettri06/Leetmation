    "problemName": "remove-all-adjacent-duplicates-in-string",
    "language": "python3",
    "code": "class Solution:\r\n    def removeDuplicates(self, s: str) -> str:\r\n        stk = []\r\n        for c in s:\r\n            if stk and stk[-1] == c:\r\n                stk.pop()\r\n            else:\r\n                stk.append(c)\r\n        return ''.join(stk)",
