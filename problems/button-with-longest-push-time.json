    "problemName": "button-with-longest-push-time",
    "language": "python3",
    "code": "class Solution:\r\n    def buttonWithLongestTime(self, events: List[List[int]]) -> int:\r\n        ans, t = events[0]\r\n        for (_, t1), (i, t2) in pairwise(events):\r\n            d = t2 - t1\r\n            if d > t or (d == t and i < ans):\r\n                ans, t = i, d\r\n        return ans",
