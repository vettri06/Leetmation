    "problemName": "n-th-tribonacci-number",
    "language": "python3",
    "code": "class Solution:\r\n    def tribonacci(self, n: int) -> int:\r\n        a, b, c = 0, 1, 1\r\n        for _ in range(n):\r\n            a, b, c = b, c, a + b + c\r\n        return a",
