    "problemName": "strobogrammatic-number",
    "language": "python3",
    "code": "class Solution:\r\n    def isStrobogrammatic(self, num: str) -> bool:\r\n        d = [0, 1, -1, -1, -1, -1, 9, -1, 8, 6]\r\n        i, j = 0, len(num) - 1\r\n        while i <= j:\r\n            a, b = int(num[i]), int(num[j])\r\n            if d[a] != b:\r\n                return False\r\n            i, j = i + 1, j - 1\r\n        return True",
