    "problemName": "filter-characters-by-frequency",
    "language": "python3",
    "code": "class Solution:\r\n    def filterCharacters(self, s: str, k: int) -> str:\r\n        cnt = Counter(s)\r\n        ans = []\r\n        for c in s:\r\n            if cnt[c] < k:\r\n                ans.append(c)\r\n        return \"\".join(ans)",
