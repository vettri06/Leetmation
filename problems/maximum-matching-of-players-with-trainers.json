{
    "problemName": "maximum-matching-of-players-with-trainers",
    "language": "python3",
    "code": "class Solution:\r\n    def matchPlayersAndTrainers(self, players: List[int], trainers: List[int]) -> int:\r\n        players.sort()\r\n        trainers.sort()\r\n        j, n = 0, len(trainers)\r\n        for i, p in enumerate(players):\r\n            while j < n and trainers[j] < p:\r\n                j += 1\r\n            if j == n:\r\n                return i\r\n            j += 1\r\n        return len(players)",
