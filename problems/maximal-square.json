    "problemName": "maximal-square",
    "language": "python3",
    "code": "class Solution:\r\n    def maximalSquare(self, matrix: List[List[str]]) -> int:\r\n        m, n = len(matrix), len(matrix[0])\r\n        dp = [[0] * (n + 1) for _ in range(m + 1)]\r\n        mx = 0\r\n        for i in range(m):\r\n            for j in range(n):\r\n                if matrix[i][j] == '1':\r\n                    dp[i + 1][j + 1] = min(dp[i][j + 1], dp[i + 1][j], dp[i][j]) + 1\r\n                    mx = max(mx, dp[i + 1][j + 1])\r\n        return mx * mx",
