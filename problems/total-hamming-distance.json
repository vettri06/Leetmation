{
    "problemName": "total-hamming-distance",
    "language": "python3",
    "code": "class Solution:\r\n    def totalHammingDistance(self, nums: List[int]) -> int:\r\n        ans, n = 0, len(nums)\r\n        for i in range(32):\r\n            a = sum(x >> i & 1 for x in nums)\r\n            b = n - a\r\n            ans += a * b\r\n        return ans",
