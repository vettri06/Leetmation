    "problemName": "orderly-queue",
    "language": "python3",
    "code": "class Solution:\r\n    def orderlyQueue(self, s: str, k: int) -> str:\r\n        if k == 1:\r\n            ans = s\r\n            for _ in range(len(s) - 1):\r\n                s = s[1:] + s[0]\r\n                ans = min(ans, s)\r\n            return ans\r\n        return \"\".join(sorted(s))",
