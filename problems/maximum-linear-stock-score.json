    "problemName": "maximum-linear-stock-score",
    "language": "python3",
    "code": "class Solution:\r\n    def maxScore(self, prices: List[int]) -> int:\r\n        cnt = Counter()\r\n        for i, x in enumerate(prices):\r\n            cnt[x - i] += x\r\n        return max(cnt.values())",
