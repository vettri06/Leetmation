{
    "problemName": "score-of-parentheses",
    "language": "python3",
    "code": "class Solution:\r\n    def scoreOfParentheses(self, s: str) -> int:\r\n        ans = d = 0\r\n        for i, c in enumerate(s):\r\n            if c == '(':\r\n                d += 1\r\n            else:\r\n                d -= 1\r\n                if s[i - 1] == '(':\r\n                    ans += 1 << d\r\n        return ans",
