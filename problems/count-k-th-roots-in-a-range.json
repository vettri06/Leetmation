{
    "problemName": "count-k-th-roots-in-a-range",
    "language": "python3",
    "code": "class Solution:\r\n    def countKthRoots(self, l: int, r: int, k: int) -> int:\r\n        if k == 1:\r\n            return r - l + 1\r\n        ans = 0\r\n        for x in count():\r\n            y = x**k\r\n            if y > r:\r\n                break\r\n            if l <= y <= r:\r\n                ans += 1\r\n        return ans",
