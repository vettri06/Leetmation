{
    "problemName": "string-compression",
    "language": "python3",
    "code": "class Solution:\r\n    def compress(self, chars: List[str]) -> int:\r\n        i, k, n = 0, 0, len(chars)\r\n        while i < n:\r\n            j = i + 1\r\n            while j < n and chars[j] == chars[i]:\r\n                j += 1\r\n            chars[k] = chars[i]\r\n            k += 1\r\n            if j - i > 1:\r\n                cnt = str(j - i)\r\n                for c in cnt:\r\n                    chars[k] = c\r\n                    k += 1\r\n            i = j\r\n        return k",
