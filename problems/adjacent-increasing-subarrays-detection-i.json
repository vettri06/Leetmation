{
    "problemName": "adjacent-increasing-subarrays-detection-i",
    "language": "python3",
    "code": "class Solution:\r\n    def hasIncreasingSubarrays(self, nums: List[int], k: int) -> bool:\r\n        mx = pre = cur = 0\r\n        for i, x in enumerate(nums):\r\n            cur += 1\r\n            if i == len(nums) - 1 or x >= nums[i + 1]:\r\n                mx = max(mx, cur // 2, min(pre, cur))\r\n                pre, cur = cur, 0\r\n        return mx >= k",
