{
    "problemName": "length-of-the-longest-valid-substring",
    "language": "python3",
    "code": "class Solution:\r\n    def longestValidSubstring(self, word: str, forbidden: List[str]) -> int:\r\n        s = set(forbidden)\r\n        ans = i = 0\r\n        for j in range(len(word)):\r\n            for k in range(j, max(j - 10, i - 1), -1):\r\n                if word[k : j + 1] in s:\r\n                    i = k + 1\r\n                    break\r\n            ans = max(ans, j - i + 1)\r\n        return ans",
