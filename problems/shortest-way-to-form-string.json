    "problemName": "shortest-way-to-form-string",
    "language": "python3",
    "code": "class Solution:\r\n    def shortestWay(self, source: str, target: str) -> int:\r\n        def f(i, j):\r\n            while i < m and j < n:\r\n                if source[i] == target[j]:\r\n                    j += 1\r\n                i += 1\r\n            return j\r\n\r\n        m, n = len(source), len(target)\r\n        ans = j = 0\r\n        while j < n:\r\n            k = f(0, j)\r\n            if k == j:\r\n                return -1\r\n            j = k\r\n            ans += 1\r\n        return ans",
