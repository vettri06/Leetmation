{
    "problemName": "length-of-last-word",
    "language": "python3",
    "code": "class Solution:\r\n    def lengthOfLastWord(self, s: str) -> int:\r\n        i = len(s) - 1\r\n        while i >= 0 and s[i] == ' ':\r\n            i -= 1\r\n        j = i\r\n        while j >= 0 and s[j] != ' ':\r\n            j -= 1\r\n        return i - j",
