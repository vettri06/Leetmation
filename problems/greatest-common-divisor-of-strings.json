{
    "problemName": "greatest-common-divisor-of-strings",
    "language": "python3",
    "code": "class Solution:\r\n    def gcdOfStrings(self, str1: str, str2: str) -> str:\r\n        def check(a, b):\r\n            c = \"\"\r\n            while len(c) < len(b):\r\n                c += a\r\n            return c == b\r\n\r\n        for i in range(min(len(str1), len(str2)), 0, -1):\r\n            t = str1[:i]\r\n            if check(t, str1) and check(t, str2):\r\n                return t\r\n        return ''",
