{
    "problemName": "maximize-the-confusion-of-an-exam",
    "language": "python3",
    "code": "class Solution:\r\n    def maxConsecutiveAnswers(self, answerKey: str, k: int) -> int:\r\n        def f(c: str) -> int:\r\n            cnt = l = 0\r\n            for ch in answerKey:\r\n                cnt += ch == c\r\n                if cnt > k:\r\n                    cnt -= answerKey[l] == c\r\n                    l += 1\r\n            return len(answerKey) - l\r\n\r\n        return max(f(\"T\"), f(\"F\"))",
