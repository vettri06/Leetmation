{
    "problemName": "nth-digit",
    "language": "python3",
    "code": "class Solution:\r\n    def findNthDigit(self, n: int) -> int:\r\n        k, cnt = 1, 9\r\n        while k * cnt < n:\r\n            n -= k * cnt\r\n            k += 1\r\n            cnt *= 10\r\n        num = 10 ** (k - 1) + (n - 1) // k\r\n        idx = (n - 1) % k\r\n        return int(str(num)[idx])",
