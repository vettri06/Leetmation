    "language": "python3",
    "code": "class Solution:\r\n    def findLHS(self, nums: List[int]) -> int:\r\n        cnt = Counter(nums)\r\n        return max((c + cnt[x + 1] for x, c in cnt.items() if cnt[x + 1]), default=0)",
