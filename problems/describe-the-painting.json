{
    "problemName": "describe-the-painting",
    "language": "python3",
    "code": "class Solution:\r\n    def splitPainting(self, segments: List[List[int]]) -> List[List[int]]:\r\n        d = defaultdict(int)\r\n        for l, r, c in segments:\r\n            d[l] += c\r\n            d[r] -= c\r\n        s = sorted([[k, v] for k, v in d.items()])\r\n        n = len(s)\r\n        for i in range(1, n):\r\n            s[i][1] += s[i - 1][1]\r\n        return [[s[i][0], s[i + 1][0], s[i][1]] for i in range(n - 1) if s[i][1]]",
