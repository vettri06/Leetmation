{
    "problemName": "2-keys-keyboard",
    "language": "python3",
    "code": "class Solution:\r\n    def minSteps(self, n: int) -> int:\r\n        @cache\r\n        def dfs(n):\r\n            if n == 1:\r\n                return 0\r\n            i, ans = 2, n\r\n            while i * i <= n:\r\n                if n % i == 0:\r\n                    ans = min(ans, dfs(n // i) + i)\r\n                i += 1\r\n            return ans\r\n\r\n        return dfs(n)",
