{
    "problemName": "arithmetic-slices",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfArithmeticSlices(self, nums: List[int]) -> int:\r\n        ans = cnt = 0\r\n        d = 3000\r\n        for a, b in pairwise(nums):\r\n            if b - a == d:\r\n                cnt += 1\r\n            else:\r\n                d = b - a\r\n                cnt = 0\r\n            ans += cnt\r\n        return ans",
