    "problemName": "lexicographically-smallest-string-after-a-swap",
    "language": "python3",
    "code": "class Solution:\r\n    def getSmallestString(self, s: str) -> str:\r\n        for i, (a, b) in enumerate(pairwise(map(ord, s))):\r\n            if (a + b) % 2 == 0 and a > b:\r\n                return s[:i] + s[i + 1] + s[i] + s[i + 2 :]\r\n        return s",
