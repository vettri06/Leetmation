    "problemName": "search-a-2d-matrix-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def searchMatrix(self, matrix: List[List[int]], target: int) -> bool:\r\n        for row in matrix:\r\n            j = bisect_left(row, target)\r\n            if j < len(matrix[0]) and row[j] == target:\r\n                return True\r\n        return False",
