{
    "problemName": "merge-close-characters",
    "language": "python3",
    "code": "class Solution:\r\n    def mergeCharacters(self, s: str, k: int) -> str:\r\n        last = {}\r\n        ans = []\r\n        for c in s:\r\n            cur = len(ans)\r\n            if c in last and cur - last[c] <= k:\r\n                continue\r\n            ans.append(c)\r\n            last[c] = cur\r\n        return \"\".join(ans)",
