    "problemName": "summary-ranges",
    "language": "python3",
    "code": "class Solution:\r\n    def summaryRanges(self, nums: List[int]) -> List[str]:\r\n        def f(i: int, j: int) -> str:\r\n            return str(nums[i]) if i == j else f'{nums[i]}->{nums[j]}'\r\n\r\n        i = 0\r\n        n = len(nums)\r\n        ans = []\r\n        while i < n:\r\n            j = i\r\n            while j + 1 < n and nums[j + 1] == nums[j] + 1:\r\n                j += 1\r\n            ans.append(f(i, j))\r\n            i = j + 1\r\n        return ans",
