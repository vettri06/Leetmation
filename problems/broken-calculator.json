    "problemName": "broken-calculator",
    "language": "python3",
    "code": "class Solution:\r\n    def brokenCalc(self, startValue: int, target: int) -> int:\r\n        ans = 0\r\n        while startValue < target:\r\n            if target & 1:\r\n                target += 1\r\n            else:\r\n                target >>= 1\r\n            ans += 1\r\n        ans += startValue - target\r\n        return ans",
