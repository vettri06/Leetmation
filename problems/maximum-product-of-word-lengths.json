{
    "problemName": "maximum-product-of-word-lengths",
    "language": "python3",
    "code": "class Solution:\r\n    def maxProduct(self, words: List[str]) -> int:\r\n        mask = [0] * len(words)\r\n        ans = 0\r\n        for i, s in enumerate(words):\r\n            for c in s:\r\n                mask[i] |= 1 << (ord(c) - ord(\"a\"))\r\n            for j, t in enumerate(words[:i]):\r\n                if (mask[i] & mask[j]) == 0:\r\n                    ans = max(ans, len(s) * len(t))\r\n        return ans",
