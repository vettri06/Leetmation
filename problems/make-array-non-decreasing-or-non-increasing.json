{
    "problemName": "make-array-non-decreasing-or-non-increasing",
    "language": "python3",
    "code": "class Solution:\r\n    def convertArray(self, nums: List[int]) -> int:\r\n        def solve(nums):\r\n            n = len(nums)\r\n            f = [[0] * 1001 for _ in range(n + 1)]\r\n            for i, x in enumerate(nums, 1):\r\n                mi = inf\r\n                for j in range(1001):\r\n                    if mi > f[i - 1][j]:\r\n                        mi = f[i - 1][j]\r\n                    f[i][j] = mi + abs(x - j)\r\n            return min(f[n])\r\n\r\n        return min(solve(nums), solve(nums[::-1]))",
