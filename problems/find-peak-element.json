{
    "problemName": "find-peak-element",
    "language": "python3",
    "code": "class Solution:\r\n    def findPeakElement(self, nums: List[int]) -> int:\r\n        left, right = 0, len(nums) - 1\r\n        while left < right:\r\n            mid = (left + right) >> 1\r\n            if nums[mid] > nums[mid + 1]:\r\n                right = mid\r\n            else:\r\n                left = mid + 1\r\n        return left",
