{
    "problemName": "find-maximum-balanced-xor-subarray-length",
    "language": "python3",
    "code": "class Solution:\r\n    def maxBalancedSubarray(self, nums: List[int]) -> int:\r\n        d = {(0, 0): -1}\r\n        a = b = 0\r\n        ans = 0\r\n        for i, x in enumerate(nums):\r\n            a ^= x\r\n            b += 1 if x % 2 == 0 else -1\r\n            if (a, b) in d:\r\n                ans = max(ans, i - d[(a, b)])\r\n            else:\r\n                d[(a, b)] = i\r\n        return ans",
