    "problemName": "count-unguarded-cells-in-the-grid",
    "language": "python3",
    "code": "class Solution:\r\n    def countUnguarded(\r\n        self, m: int, n: int, guards: List[List[int]], walls: List[List[int]]\r\n    ) -> int:\r\n        g = [[0] * n for _ in range(m)]\r\n        for i, j in guards:\r\n            g[i][j] = 2\r\n        for i, j in walls:\r\n            g[i][j] = 2\r\n        dirs = (-1, 0, 1, 0, -1)\r\n        for i, j in guards:\r\n            for a, b in pairwise(dirs):\r\n                x, y = i, j\r\n                while 0 <= x + a < m and 0 <= y + b < n and g[x + a][y + b] < 2:\r\n                    x, y = x + a, y + b\r\n                    g[x][y] = 1\r\n        return sum(v == 0 for row in g for v in row)",
