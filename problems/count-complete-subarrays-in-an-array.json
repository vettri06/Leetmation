{
    "problemName": "count-complete-subarrays-in-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def countCompleteSubarrays(self, nums: List[int]) -> int:\r\n        cnt = len(set(nums))\r\n        ans, n = 0, len(nums)\r\n        for i in range(n):\r\n            s = set()\r\n            for x in nums[i:]:\r\n                s.add(x)\r\n                if len(s) == cnt:\r\n                    ans += 1\r\n        return ans",
