    "problemName": "generate-parentheses",
    "language": "python3",
    "code": "class Solution:\r\n    def generateParenthesis(self, n: int) -> List[str]:\r\n        def dfs(l: int, r: int, t: str):\r\n            if l > n or r > n or l < r:\r\n                return\r\n            if l == n and r == n:\r\n                ans.append(t)\r\n                return\r\n            dfs(l + 1, r, t + \"(\")\r\n            dfs(l, r + 1, t + \")\")\r\n\r\n        ans = []\r\n        dfs(0, 0, \"\")\r\n        return ans",
