{
    "problemName": "maximum-element-after-decreasing-and-rearranging",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumElementAfterDecrementingAndRearranging(self, arr: List[int]) -> int:\r\n        arr.sort()\r\n        arr[0] = 1\r\n        for i in range(1, len(arr)):\r\n            d = max(0, arr[i] - arr[i - 1] - 1)\r\n            arr[i] -= d\r\n        return max(arr)",
