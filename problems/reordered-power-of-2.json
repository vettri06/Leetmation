    "problemName": "reordered-power-of-2",
    "language": "python3",
    "code": "class Solution:\r\n    def reorderedPowerOf2(self, n: int) -> bool:\r\n        def f(x: int) -> List[int]:\r\n            cnt = [0] * 10\r\n            while x:\r\n                x, v = divmod(x, 10)\r\n                cnt[v] += 1\r\n            return cnt\r\n\r\n        target = f(n)\r\n        i = 1\r\n        while i <= 10**9:\r\n            if f(i) == target:\r\n                return True\r\n            i <<= 1\r\n        return False",
