{
    "problemName": "car-pooling",
    "language": "python3",
    "code": "class Solution:\r\n    def carPooling(self, trips: List[List[int]], capacity: int) -> bool:\r\n        mx = max(e[2] for e in trips)\r\n        d = [0] * (mx + 1)\r\n        for x, f, t in trips:\r\n            d[f] += x\r\n            d[t] -= x\r\n        return all(s <= capacity for s in accumulate(d))",
