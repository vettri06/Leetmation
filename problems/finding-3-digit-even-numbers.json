{
    "problemName": "finding-3-digit-even-numbers",
    "language": "python3",
    "code": "class Solution:\r\n    def findEvenNumbers(self, digits: List[int]) -> List[int]:\r\n        cnt = Counter(digits)\r\n        ans = []\r\n        for x in range(100, 1000, 2):\r\n            cnt1 = Counter()\r\n            y = x\r\n            while y:\r\n                y, v = divmod(y, 10)\r\n                cnt1[v] += 1\r\n            if all(cnt[i] >= cnt1[i] for i in range(10)):\r\n                ans.append(x)\r\n        return ans",
