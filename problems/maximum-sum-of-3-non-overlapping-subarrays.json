    "problemName": "maximum-sum-of-3-non-overlapping-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSumOfThreeSubarrays(self, nums: List[int], k: int) -> List[int]:\r\n        s = s1 = s2 = s3 = 0\r\n        mx1 = mx12 = 0\r\n        idx1, idx12 = 0, ()\r\n        ans = []\r\n        for i in range(k * 2, len(nums)):\r\n            s1 += nums[i - k * 2]\r\n            s2 += nums[i - k]\r\n            s3 += nums[i]\r\n            if i >= k * 3 - 1:\r\n                if s1 > mx1:\r\n                    mx1 = s1\r\n                    idx1 = i - k * 3 + 1\r\n                if mx1 + s2 > mx12:\r\n                    mx12 = mx1 + s2\r\n                    idx12 = (idx1, i - k * 2 + 1)\r\n                if mx12 + s3 > s:\r\n                    s = mx12 + s3\r\n                    ans = [*idx12, i - k + 1]\r\n                s1 -= nums[i - k * 3 + 1]\r\n                s2 -= nums[i - k * 2 + 1]\r\n                s3 -= nums[i - k + 1]\r\n        return ans",
