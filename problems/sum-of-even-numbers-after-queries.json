{
    "problemName": "sum-of-even-numbers-after-queries",
    "language": "python3",
    "code": "class Solution:\r\n    def sumEvenAfterQueries(\r\n        self, nums: List[int], queries: List[List[int]]\r\n    ) -> List[int]:\r\n        s = sum(x for x in nums if x % 2 == 0)\r\n        ans = []\r\n        for v, i in queries:\r\n            if nums[i] % 2 == 0:\r\n                s -= nums[i]\r\n            nums[i] += v\r\n            if nums[i] % 2 == 0:\r\n                s += nums[i]\r\n            ans.append(s)\r\n        return ans",
