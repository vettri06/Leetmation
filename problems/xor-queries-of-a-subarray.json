    "code": "class Solution:\r\n    def xorQueries(self, arr: List[int], queries: List[List[int]]) -> List[int]:\r\n        s = list(accumulate(arr, xor, initial=0))\r\n        return [s[r + 1] ^ s[l] for l, r in queries]",
