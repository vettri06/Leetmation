    "code": "class Solution:\r\n    def threeSum(self, nums: List[int]) -> List[List[int]]:\r\n        nums.sort()\r\n        n = len(nums)\r\n        ans = []\r\n        for i in range(n - 2):\r\n            if nums[i] > 0:\r\n                break\r\n            if i and nums[i] == nums[i - 1]:\r\n                continue\r\n            j, k = i + 1, n - 1\r\n            while j < k:\r\n                x = nums[i] + nums[j] + nums[k]\r\n                if x < 0:\r\n                    j += 1\r\n                elif x > 0:\r\n                    k -= 1\r\n                else:\r\n                    ans.append([nums[i], nums[j], nums[k]])\r\n                    j, k = j + 1, k - 1\r\n                    while j < k and nums[j] == nums[j - 1]:\r\n                        j += 1\r\n                    while j < k and nums[k] == nums[k + 1]:\r\n                        k -= 1\r\n        return ans",
