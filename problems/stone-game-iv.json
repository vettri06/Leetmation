    "problemName": "stone-game-iv",
    "language": "python3",
    "code": "class Solution:\r\n    def winnerSquareGame(self, n: int) -> bool:\r\n        @cache\r\n        def dfs(i: int) -> bool:\r\n            if i == 0:\r\n                return False\r\n            j = 1\r\n            while j * j <= i:\r\n                if not dfs(i - j * j):\r\n                    return True\r\n                j += 1\r\n            return False\r\n\r\n        return dfs(n)",
