    "problemName": "maximum-good-subarray-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumSubarraySum(self, nums: List[int], k: int) -> int:\r\n        ans = -inf\r\n        p = {nums[0]: 0}\r\n        s, n = 0, len(nums)\r\n        for i, x in enumerate(nums):\r\n            s += x\r\n            if x - k in p:\r\n                ans = max(ans, s - p[x - k])\r\n            if x + k in p:\r\n                ans = max(ans, s - p[x + k])\r\n            if i + 1 < n and (nums[i + 1] not in p or p[nums[i + 1]] > s):\r\n                p[nums[i + 1]] = s\r\n        return 0 if ans == -inf else ans",
