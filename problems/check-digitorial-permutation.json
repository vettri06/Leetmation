    "problemName": "check-digitorial-permutation",
    "language": "python3",
    "code": "@cache\r\ndef f(x: int) -> int:\r\n    if x < 2:\r\n        return 1\r\n    return x * f(x - 1)\r\n\r\n\r\nclass Solution:\r\n    def isDigitorialPermutation(self, n: int) -> bool:\r\n        x, y = 0, n\r\n        while y:\r\n            x += f(y % 10)\r\n            y //= 10\r\n        return sorted(str(x)) == sorted(str(n))",
