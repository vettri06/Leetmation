{
    "problemName": "majority-frequency-characters",
    "language": "python3",
    "code": "class Solution:\r\n    def majorityFrequencyGroup(self, s: str) -> str:\r\n        cnt = Counter(s)\r\n        f = defaultdict(list)\r\n        for c, v in cnt.items():\r\n            f[v].append(c)\r\n        mx = mv = 0\r\n        ans = []\r\n        for v, cs in f.items():\r\n            if mx < len(cs) or (mx == len(cs) and mv < v):\r\n                mx = len(cs)\r\n                mv = v\r\n                ans = cs\r\n        return \"\".join(ans)",
