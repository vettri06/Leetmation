    "problemName": "longest-uploaded-prefix",
    "language": "python3",
    "code": "class LUPrefix:\r\n    def __init__(self, n: int):\r\n        self.r = 0\r\n        self.s = set()\r\n\r\n    def upload(self, video: int) -> None:\r\n        self.s.add(video)\r\n        while self.r + 1 in self.s:\r\n            self.r += 1\r\n\r\n    def longest(self) -> int:\r\n        return self.r\r\n\r\n\r\n# Your LUPrefix object will be instantiated and called as such:\r\n# obj = LUPrefix(n)\r\n# obj.upload(video)\r\n# param_2 = obj.longest()",
