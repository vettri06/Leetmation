    "problemName": "student-attendance-record-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def checkRecord(self, n: int) -> int:\r\n        @cache\r\n        def dfs(i, j, k):\r\n            if i >= n:\r\n                return 1\r\n            ans = 0\r\n            if j == 0:\r\n                ans += dfs(i + 1, j + 1, 0)\r\n            if k < 2:\r\n                ans += dfs(i + 1, j, k + 1)\r\n            ans += dfs(i + 1, j, 0)\r\n            return ans % mod\r\n\r\n        mod = 10**9 + 7\r\n        ans = dfs(0, 0, 0)\r\n        dfs.cache_clear()\r\n        return ans",
