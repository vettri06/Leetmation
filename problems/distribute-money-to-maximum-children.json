{
    "problemName": "distribute-money-to-maximum-children",
    "language": "python3",
    "code": "class Solution:\r\n    def distMoney(self, money: int, children: int) -> int:\r\n        if money < children:\r\n            return -1\r\n        if money > 8 * children:\r\n            return children - 1\r\n        if money == 8 * children - 4:\r\n            return children - 2\r\n        # money-8x >= children-x, x <= (money-children)/7\r\n        return (money - children) // 7",
