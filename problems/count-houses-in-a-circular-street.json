{
    "problemName": "count-houses-in-a-circular-street",
    "language": "python3",
    "code": "# Definition for a street.\r\n# class Street:\r\n#     def openDoor(self):\r\n#         pass\r\n#     def closeDoor(self):\r\n#         pass\r\n#     def isDoorOpen(self):\r\n#         pass\r\n#     def moveRight(self):\r\n#         pass\r\n#     def moveLeft(self):\r\n#         pass\r\nclass Solution:\r\n    def houseCount(self, street: Optional[\"Street\"], k: int) -> int:\r\n        for _ in range(k):\r\n            street.openDoor()\r\n            street.moveLeft()\r\n        ans = 0\r\n        while street.isDoorOpen():\r\n            street.closeDoor()\r\n            street.moveLeft()\r\n            ans += 1\r\n        return ans",
