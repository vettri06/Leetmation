    "problemName": "number-of-boomerangs",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfBoomerangs(self, points: List[List[int]]) -> int:\r\n        ans = 0\r\n        for p1 in points:\r\n            cnt = Counter()\r\n            for p2 in points:\r\n                d = dist(p1, p2)\r\n                ans += cnt[d]\r\n                cnt[d] += 1\r\n        return ans << 1",
