{
    "problemName": "permutation-in-string",
    "language": "python3",
    "code": "class Solution:\r\n    def checkInclusion(self, s1: str, s2: str) -> bool:\r\n        cnt = Counter(s1)\r\n        need = len(cnt)\r\n        m = len(s1)\r\n        for i, c in enumerate(s2):\r\n            cnt[c] -= 1\r\n            if cnt[c] == 0:\r\n                need -= 1\r\n            if i >= m:\r\n                cnt[s2[i - m]] += 1\r\n                if cnt[s2[i - m]] == 1:\r\n                    need += 1\r\n            if need == 0:\r\n                return True\r\n        return False",
