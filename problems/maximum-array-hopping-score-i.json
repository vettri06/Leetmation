{
    "problemName": "maximum-array-hopping-score-i",
    "language": "python3",
    "code": "class Solution:\r\n    def maxScore(self, nums: List[int]) -> int:\r\n        @cache\r\n        def dfs(i: int) -> int:\r\n            return max(\r\n                [(j - i) * nums[j] + dfs(j) for j in range(i + 1, len(nums))] or [0]\r\n            )\r\n\r\n        return dfs(0)",
