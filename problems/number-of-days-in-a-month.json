    "problemName": "number-of-days-in-a-month",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfDays(self, year: int, month: int) -> int:\r\n        leap = (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)\r\n        days = [0, 31, 29 if leap else 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\r\n        return days[month]",
