{
    "problemName": "reverse-words-with-same-vowel-count",
    "language": "python3",
    "code": "class Solution:\r\n    def reverseWords(self, s: str) -> str:\r\n        def calc(w: str) -> int:\r\n            return sum(c in \"aeiou\" for c in w)\r\n\r\n        words = s.split()\r\n        cnt = calc(words[0])\r\n        ans = [words[0]]\r\n        for w in words[1:]:\r\n            if calc(w) == cnt:\r\n                ans.append(w[::-1])\r\n            else:\r\n                ans.append(w)\r\n        return \" \".join(ans)",
