{
    "problemName": "exclusive-time-of-functions",
    "language": "python3",
    "code": "class Solution:\r\n    def exclusiveTime(self, n: int, logs: List[str]) -> List[int]:\r\n        stk = []\r\n        ans = [0] * n\r\n        pre = 0\r\n        for log in logs:\r\n            i, op, t = log.split(\":\")\r\n            i, cur = int(i), int(t)\r\n            if op[0] == \"s\":\r\n                if stk:\r\n                    ans[stk[-1]] += cur - pre\r\n                stk.append(i)\r\n                pre = cur\r\n            else:\r\n                ans[stk.pop()] += cur - pre + 1\r\n                pre = cur + 1\r\n        return ans",
