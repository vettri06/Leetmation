{
    "problemName": "find-the-k-beauty-of-a-number",
    "language": "python3",
    "code": "class Solution:\r\n    def divisorSubstrings(self, num: int, k: int) -> int:\r\n        ans = 0\r\n        s = str(num)\r\n        for i in range(len(s) - k + 1):\r\n            t = int(s[i : i + k])\r\n            if t and num % t == 0:\r\n                ans += 1\r\n        return ans",
