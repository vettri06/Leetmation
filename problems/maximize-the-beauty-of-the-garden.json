{
    "problemName": "maximize-the-beauty-of-the-garden",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumBeauty(self, flowers: List[int]) -> int:\r\n        s = [0] * (len(flowers) + 1)\r\n        d = {}\r\n        ans = -inf\r\n        for i, v in enumerate(flowers):\r\n            if v in d:\r\n                ans = max(ans, s[i] - s[d[v] + 1] + v * 2)\r\n            else:\r\n                d[v] = i\r\n            s[i + 1] = s[i] + max(v, 0)\r\n        return ans",
