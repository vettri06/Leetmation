    "problemName": "subdomain-visit-count",
    "language": "python3",
    "code": "class Solution:\r\n    def subdomainVisits(self, cpdomains: List[str]) -> List[str]:\r\n        cnt = Counter()\r\n        for s in cpdomains:\r\n            v = int(s[: s.index(' ')])\r\n            for i, c in enumerate(s):\r\n                if c in ' .':\r\n                    cnt[s[i + 1 :]] += v\r\n        return [f'{v} {s}' for s, v in cnt.items()]",
