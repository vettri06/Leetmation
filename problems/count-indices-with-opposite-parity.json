    "problemName": "count-indices-with-opposite-parity",
    "language": "python3",
    "code": "class Solution:\r\n    def countOppositeParity(self, nums: list[int]) -> list[int]:\r\n        cnt = [0, 0]\r\n        for x in nums:\r\n            cnt[x & 1] += 1\r\n        ans = [0] * len(nums)\r\n        for i, x in enumerate(nums):\r\n            cnt[x & 1] -= 1\r\n            ans[i] = cnt[x & 1 ^ 1]\r\n        return ans",
