{
    "problemName": "degree-of-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def findShortestSubArray(self, nums: List[int]) -> int:\r\n        cnt = Counter(nums)\r\n        degree = cnt.most_common()[0][1]\r\n        left, right = {}, {}\r\n        for i, v in enumerate(nums):\r\n            if v not in left:\r\n                left[v] = i\r\n            right[v] = i\r\n        ans = inf\r\n        for v in nums:\r\n            if cnt[v] == degree:\r\n                t = right[v] - left[v] + 1\r\n                if ans > t:\r\n                    ans = t\r\n        return ans",
