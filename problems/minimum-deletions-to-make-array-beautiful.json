{
    "problemName": "minimum-deletions-to-make-array-beautiful",
    "language": "python3",
    "code": "class Solution:\r\n    def minDeletion(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        i = ans = 0\r\n        while i < n - 1:\r\n            if nums[i] == nums[i + 1]:\r\n                ans += 1\r\n                i += 1\r\n            else:\r\n                i += 2\r\n        ans += (n - ans) % 2\r\n        return ans",
