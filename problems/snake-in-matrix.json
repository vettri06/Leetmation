{
    "problemName": "snake-in-matrix",
    "language": "python3",
    "code": "class Solution:\r\n    def finalPositionOfSnake(self, n: int, commands: List[str]) -> int:\r\n        x = y = 0\r\n        for c in commands:\r\n            match c[0]:\r\n                case \"U\":\r\n                    x -= 1\r\n                case \"D\":\r\n                    x += 1\r\n                case \"L\":\r\n                    y -= 1\r\n                case \"R\":\r\n                    y += 1\r\n        return x * n + y",
