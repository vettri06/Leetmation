{
    "problemName": "pour-water",
    "language": "python3",
    "code": "class Solution:\r\n    def pourWater(self, heights: List[int], volume: int, k: int) -> List[int]:\r\n        for _ in range(volume):\r\n            for d in (-1, 1):\r\n                i = j = k\r\n                while 0 <= i + d < len(heights) and heights[i + d] <= heights[i]:\r\n                    if heights[i + d] < heights[i]:\r\n                        j = i + d\r\n                    i += d\r\n                if j != k:\r\n                    heights[j] += 1\r\n                    break\r\n            else:\r\n                heights[k] += 1\r\n        return heights",
