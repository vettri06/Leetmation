{
    "problemName": "sort-integers-by-binary-reflection",
    "language": "python3",
    "code": "class Solution:\r\n    def sortByReflection(self, nums: List[int]) -> List[int]:\r\n        def f(x: int) -> int:\r\n            y = 0\r\n            while x:\r\n                y = y << 1 | (x & 1)\r\n                x >>= 1\r\n            return y\r\n\r\n        nums.sort(key=lambda x: (f(x), x))\r\n        return nums",
