    "problemName": "maximum-xor-product",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumXorProduct(self, a: int, b: int, n: int) -> int:\r\n        mod = 10**9 + 7\r\n        ax, bx = (a >> n) << n, (b >> n) << n\r\n        for i in range(n - 1, -1, -1):\r\n            x = a >> i & 1\r\n            y = b >> i & 1\r\n            if x == y:\r\n                ax |= 1 << i\r\n                bx |= 1 << i\r\n            elif ax > bx:\r\n                bx |= 1 << i\r\n            else:\r\n                ax |= 1 << i\r\n        return ax * bx % mod",
