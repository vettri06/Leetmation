{
    "problemName": "number-of-lines-to-write-string",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfLines(self, widths: List[int], s: str) -> List[int]:\r\n        lines, last = 1, 0\r\n        for w in map(lambda c: widths[ord(c) - ord(\"a\")], s):\r\n            if last + w <= 100:\r\n                last += w\r\n            else:\r\n                lines += 1\r\n                last = w\r\n        return [lines, last]",
