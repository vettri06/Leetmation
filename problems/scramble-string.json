    "problemName": "scramble-string",
    "language": "python3",
    "code": "class Solution:\r\n    def isScramble(self, s1: str, s2: str) -> bool:\r\n        @cache\r\n        def dfs(i: int, j: int, k: int) -> bool:\r\n            if k == 1:\r\n                return s1[i] == s2[j]\r\n            for h in range(1, k):\r\n                if dfs(i, j, h) and dfs(i + h, j + h, k - h):\r\n                    return True\r\n                if dfs(i + h, j, k - h) and dfs(i, j + k - h, h):\r\n                    return True\r\n            return False\r\n\r\n        return dfs(0, 0, len(s1))",
