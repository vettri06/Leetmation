{
    "problemName": "palindromic-substrings",
    "language": "python3",
    "code": "class Solution:\r\n    def countSubstrings(self, s: str) -> int:\r\n        ans, n = 0, len(s)\r\n        for k in range(n * 2 - 1):\r\n            i, j = k // 2, (k + 1) // 2\r\n            while ~i and j < n and s[i] == s[j]:\r\n                ans += 1\r\n                i, j = i - 1, j + 1\r\n        return ans",
