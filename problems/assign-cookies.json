    "problemName": "assign-cookies",
    "language": "python3",
    "code": "class Solution:\r\n    def findContentChildren(self, g: List[int], s: List[int]) -> int:\r\n        g.sort()\r\n        s.sort()\r\n        j = 0\r\n        for i, x in enumerate(g):\r\n            while j < len(s) and s[j] < g[i]:\r\n                j += 1\r\n            if j >= len(s):\r\n                return i\r\n            j += 1\r\n        return len(g)",
