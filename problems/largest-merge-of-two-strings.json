{
    "problemName": "largest-merge-of-two-strings",
    "language": "python3",
    "code": "class Solution:\r\n    def largestMerge(self, word1: str, word2: str) -> str:\r\n        i = j = 0\r\n        ans = []\r\n        while i < len(word1) and j < len(word2):\r\n            if word1[i:] > word2[j:]:\r\n                ans.append(word1[i])\r\n                i += 1\r\n            else:\r\n                ans.append(word2[j])\r\n                j += 1\r\n        ans.append(word1[i:])\r\n        ans.append(word2[j:])\r\n        return \"\".join(ans)",
