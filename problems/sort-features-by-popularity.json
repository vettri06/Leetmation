    "problemName": "sort-features-by-popularity",
    "language": "python3",
    "code": "class Solution:\r\n    def sortFeatures(self, features: List[str], responses: List[str]) -> List[str]:\r\n        cnt = Counter()\r\n        for s in responses:\r\n            for w in set(s.split()):\r\n                cnt[w] += 1\r\n        return sorted(features, key=lambda w: -cnt[w])",
