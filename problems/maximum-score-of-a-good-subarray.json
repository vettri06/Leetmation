{
    "problemName": "maximum-score-of-a-good-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumScore(self, nums: List[int], k: int) -> int:\r\n        n = len(nums)\r\n        left = [-1] * n\r\n        right = [n] * n\r\n        stk = []\r\n        for i, v in enumerate(nums):\r\n            while stk and nums[stk[-1]] >= v:\r\n                stk.pop()\r\n            if stk:\r\n                left[i] = stk[-1]\r\n            stk.append(i)\r\n        stk = []\r\n        for i in range(n - 1, -1, -1):\r\n            v = nums[i]\r\n            while stk and nums[stk[-1]] > v:\r\n                stk.pop()\r\n            if stk:\r\n                right[i] = stk[-1]\r\n            stk.append(i)\r\n        ans = 0\r\n        for i, v in enumerate(nums):\r\n            if left[i] + 1 <= k <= right[i] - 1:\r\n                ans = max(ans, v * (right[i] - left[i] - 1))\r\n        return ans",
