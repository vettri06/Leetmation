{
    "problemName": "remove-letter-to-equalize-frequency",
    "language": "python3",
    "code": "class Solution:\r\n    def equalFrequency(self, word: str) -> bool:\r\n        cnt = Counter(word)\r\n        for c in cnt.keys():\r\n            cnt[c] -= 1\r\n            if len(set(v for v in cnt.values() if v)) == 1:\r\n                return True\r\n            cnt[c] += 1\r\n        return False",
