{
    "problemName": "append-k-integers-with-minimal-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def minimalKSum(self, nums: List[int], k: int) -> int:\r\n        nums.extend([0, 2 * 10**9])\r\n        nums.sort()\r\n        ans = 0\r\n        for a, b in pairwise(nums):\r\n            m = max(0, min(k, b - a - 1))\r\n            ans += (a + 1 + a + m) * m // 2\r\n            k -= m\r\n        return ans",
