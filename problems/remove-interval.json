    "problemName": "remove-interval",
    "language": "python3",
    "code": "class Solution:\r\n    def removeInterval(\r\n        self, intervals: List[List[int]], toBeRemoved: List[int]\r\n    ) -> List[List[int]]:\r\n        x, y = toBeRemoved\r\n        ans = []\r\n        for a, b in intervals:\r\n            if a >= y or b <= x:\r\n                ans.append([a, b])\r\n            else:\r\n                if a < x:\r\n                    ans.append([a, x])\r\n                if b > y:\r\n                    ans.append([y, b])\r\n        return ans",
