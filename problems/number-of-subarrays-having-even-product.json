    "problemName": "number-of-subarrays-having-even-product",
    "language": "python3",
    "code": "class Solution:\r\n    def evenProduct(self, nums: List[int]) -> int:\r\n        ans, last = 0, -1\r\n        for i, v in enumerate(nums):\r\n            if v % 2 == 0:\r\n                last = i\r\n            ans += last + 1\r\n        return ans",
