{
    "problemName": "substring-with-largest-variance",
    "language": "python3",
    "code": "class Solution:\r\n    def largestVariance(self, s: str) -> int:\r\n        ans = 0\r\n        for a, b in permutations(ascii_lowercase, 2):\r\n            if a == b:\r\n                continue\r\n            f = [0, -inf]\r\n            for c in s:\r\n                if c == a:\r\n                    f[0], f[1] = f[0] + 1, f[1] + 1\r\n                elif c == b:\r\n                    f[1] = max(f[1] - 1, f[0] - 1)\r\n                    f[0] = 0\r\n                if ans < f[1]:\r\n                    ans = f[1]\r\n        return ans",
