    "problemName": "brace-expansion-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def braceExpansionII(self, expression: str) -> List[str]:\r\n        def dfs(exp):\r\n            j = exp.find('}')\r\n            if j == -1:\r\n                s.add(exp)\r\n                return\r\n            i = exp.rfind('{', 0, j - 1)\r\n            a, c = exp[:i], exp[j + 1 :]\r\n            for b in exp[i + 1 : j].split(','):\r\n                dfs(a + b + c)\r\n\r\n        s = set()\r\n        dfs(expression)\r\n        return sorted(s)",
