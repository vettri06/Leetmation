    "problemName": "inorder-successor-in-bst",
    "language": "python3",
    "code": "# Definition for a binary tree node.\r\n# class TreeNode:\r\n#     def __init__(self, x):\r\n#         self.val = x\r\n#         self.left = None\r\n#         self.right = None\r\n\r\n\r\nclass Solution:\r\n    def inorderSuccessor(self, root: TreeNode, p: TreeNode) -> Optional[TreeNode]:\r\n        ans = None\r\n        while root:\r\n            if root.val > p.val:\r\n                ans = root\r\n                root = root.left\r\n            else:\r\n                root = root.right\r\n        return ans",
