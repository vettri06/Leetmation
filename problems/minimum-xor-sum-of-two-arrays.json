{
    "problemName": "minimum-xor-sum-of-two-arrays",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumXORSum(self, nums1: List[int], nums2: List[int]) -> int:\r\n        n = len(nums2)\r\n        f = [[inf] * (1 << n) for _ in range(n + 1)]\r\n        f[0][0] = 0\r\n        for i, x in enumerate(nums1, 1):\r\n            for j in range(1 << n):\r\n                for k in range(n):\r\n                    if j >> k & 1:\r\n                        f[i][j] = min(f[i][j], f[i - 1][j ^ (1 << k)] + (x ^ nums2[k]))\r\n        return f[-1][-1]",
    "problemId": 1879,
