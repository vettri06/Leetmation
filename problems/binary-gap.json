{
    "problemName": "binary-gap",
    "language": "python3",
    "code": "class Solution:\r\n    def binaryGap(self, n: int) -> int:\r\n        ans = 0\r\n        pre, cur = inf, 0\r\n        while n:\r\n            if n & 1:\r\n                ans = max(ans, cur - pre)\r\n                pre = cur\r\n            cur += 1\r\n            n >>= 1\r\n        return ans",
