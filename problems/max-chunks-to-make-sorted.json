    "language": "python3",
    "code": "class Solution:\r\n    def maxChunksToSorted(self, arr: List[int]) -> int:\r\n        mx = ans = 0\r\n        for i, v in enumerate(arr):\r\n            mx = max(mx, v)\r\n            if i == mx:\r\n                ans += 1\r\n        return ans",
