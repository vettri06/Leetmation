    "problemName": "strobogrammatic-number-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def findStrobogrammatic(self, n: int) -> List[str]:\r\n        def dfs(u):\r\n            if u == 0:\r\n                return ['']\r\n            if u == 1:\r\n                return ['0', '1', '8']\r\n            ans = []\r\n            for v in dfs(u - 2):\r\n                for l, r in ('11', '88', '69', '96'):\r\n                    ans.append(l + v + r)\r\n                if u != n:\r\n                    ans.append('0' + v + '0')\r\n            return ans\r\n\r\n        return dfs(n)",
