    "code": "class MyHashMap:\r\n    def __init__(self):\r\n        self.data = [-1] * 1000001\r\n\r\n    def put(self, key: int, value: int) -> None:\r\n        self.data[key] = value\r\n\r\n    def get(self, key: int) -> int:\r\n        return self.data[key]\r\n\r\n    def remove(self, key: int) -> None:\r\n        self.data[key] = -1\r\n\r\n\r\n# Your MyHashMap object will be instantiated and called as such:\r\n# obj = MyHashMap()\r\n# obj.put(key,value)\r\n# param_2 = obj.get(key)\r\n# obj.remove(key)",
