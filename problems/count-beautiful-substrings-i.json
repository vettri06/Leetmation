{
    "problemName": "count-beautiful-substrings-i",
    "language": "python3",
    "code": "class Solution:\r\n    def beautifulSubstrings(self, s: str, k: int) -> int:\r\n        n = len(s)\r\n        vs = set(\"aeiou\")\r\n        ans = 0\r\n        for i in range(n):\r\n            vowels = 0\r\n            for j in range(i, n):\r\n                vowels += s[j] in vs\r\n                consonants = j - i + 1 - vowels\r\n                if vowels == consonants and vowels * consonants % k == 0:\r\n                    ans += 1\r\n        return ans",
