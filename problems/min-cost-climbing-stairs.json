{
    "problemName": "min-cost-climbing-stairs",
    "language": "python3",
    "code": "class Solution:\r\n    def minCostClimbingStairs(self, cost: List[int]) -> int:\r\n        @cache\r\n        def dfs(i: int) -> int:\r\n            if i >= len(cost):\r\n                return 0\r\n            return cost[i] + min(dfs(i + 1), dfs(i + 2))\r\n\r\n        return min(dfs(0), dfs(1))",
