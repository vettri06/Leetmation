{
    "problemName": "calculate-digit-sum-of-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def digitSum(self, s: str, k: int) -> str:\r\n        while len(s) > k:\r\n            t = []\r\n            n = len(s)\r\n            for i in range(0, n, k):\r\n                x = 0\r\n                for j in range(i, min(i + k, n)):\r\n                    x += int(s[j])\r\n                t.append(str(x))\r\n            s = \"\".join(t)\r\n        return s",
