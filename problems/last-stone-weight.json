{
    "problemName": "last-stone-weight",
    "language": "python3",
    "code": "class Solution:\r\n    def lastStoneWeight(self, stones: List[int]) -> int:\r\n        h = [-x for x in stones]\r\n        heapify(h)\r\n        while len(h) > 1:\r\n            y, x = -heappop(h), -heappop(h)\r\n            if x != y:\r\n                heappush(h, x - y)\r\n        return 0 if not h else -h[0]",
