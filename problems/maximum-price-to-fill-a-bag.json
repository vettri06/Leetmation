{
    "problemName": "maximum-price-to-fill-a-bag",
    "language": "python3",
    "code": "class Solution:\r\n    def maxPrice(self, items: List[List[int]], capacity: int) -> float:\r\n        ans = 0\r\n        for p, w in sorted(items, key=lambda x: x[1] / x[0]):\r\n            v = min(w, capacity)\r\n            ans += v / w * p\r\n            capacity -= v\r\n        return -1 if capacity else ans",
