{
    "problemName": "divide-two-integers",
    "language": "python3",
    "code": "class Solution:\r\n    def divide(self, a: int, b: int) -> int:\r\n        if b == 1:\r\n            return a\r\n        if a == -(2**31) and b == -1:\r\n            return 2**31 - 1\r\n        sign = (a > 0 and b > 0) or (a < 0 and b < 0)\r\n        a = -a if a > 0 else a\r\n        b = -b if b > 0 else b\r\n        ans = 0\r\n        while a <= b:\r\n            x = b\r\n            cnt = 1\r\n            while x >= (-(2**30)) and a <= (x << 1):\r\n                x <<= 1\r\n                cnt <<= 1\r\n            a -= x\r\n            ans += cnt\r\n        return ans if sign else -ans",
