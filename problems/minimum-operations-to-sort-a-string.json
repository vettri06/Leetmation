{
    "problemName": "minimum-operations-to-sort-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def minOperations(self, s: str) -> int:\r\n        if all(a <= b for a, b in pairwise(s)):\r\n            return 0\r\n        if len(s) == 2:\r\n            return -1\r\n        mn, mx = min(s), max(s)\r\n        if s[0] == mn or s[-1] == mx:\r\n            return 1\r\n        if any(c in [mn, mx] for c in s[1:-1]):\r\n            return 2\r\n        return 3",
