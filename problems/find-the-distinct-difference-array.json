    "problemName": "find-the-distinct-difference-array",
    "language": "python3",
    "code": "class Solution:\r\n    def distinctDifferenceArray(self, nums: List[int]) -> List[int]:\r\n        n = len(nums)\r\n        suf = [0] * (n + 1)\r\n        s = set()\r\n        for i in range(n - 1, -1, -1):\r\n            s.add(nums[i])\r\n            suf[i] = len(s)\r\n        s.clear()\r\n        ans = [0] * n\r\n        for i, x in enumerate(nums):\r\n            s.add(x)\r\n            ans[i] = len(s) - suf[i + 1]\r\n        return ans",
