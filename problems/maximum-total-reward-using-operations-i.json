{
    "problemName": "maximum-total-reward-using-operations-i",
    "language": "python3",
    "code": "class Solution:\r\n    def maxTotalReward(self, rewardValues: List[int]) -> int:\r\n        @cache\r\n        def dfs(x: int) -> int:\r\n            i = bisect_right(rewardValues, x)\r\n            ans = 0\r\n            for v in rewardValues[i:]:\r\n                ans = max(ans, v + dfs(x + v))\r\n            return ans\r\n\r\n        rewardValues.sort()\r\n        return dfs(0)",
    "problemId": 3180,
