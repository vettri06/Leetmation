    "problemName": "score-validator",
    "language": "python3",
    "code": "class Solution:\r\n    def scoreValidator(self, events: list[str]) -> list[int]:\r\n        score = counter = 0\r\n        for event in events:\r\n            if event.isdigit():\r\n                score += int(event)\r\n            elif event == \"W\":\r\n                counter += 1\r\n                if counter == 10:\r\n                    break\r\n            else:\r\n                score += 1\r\n        return [score, counter]",
