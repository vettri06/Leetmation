{
    "problemName": "count-number-of-teams",
    "language": "python3",
    "code": "class Solution:\r\n    def numTeams(self, rating: List[int]) -> int:\r\n        ans, n = 0, len(rating)\r\n        for i, b in enumerate(rating):\r\n            l = sum(a < b for a in rating[:i])\r\n            r = sum(c > b for c in rating[i + 1 :])\r\n            ans += l * r\r\n            ans += (i - l) * (n - i - 1 - r)\r\n        return ans",
