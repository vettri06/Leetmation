{
    "problemName": "distance-between-bus-stops",
    "language": "python3",
    "code": "class Solution:\r\n    def distanceBetweenBusStops(\r\n        self, distance: List[int], start: int, destination: int\r\n    ) -> int:\r\n        s = sum(distance)\r\n        t, n = 0, len(distance)\r\n        while start != destination:\r\n            t += distance[start]\r\n            start = (start + 1) % n\r\n        return min(t, s - t)",
