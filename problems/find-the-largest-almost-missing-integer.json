{
    "problemName": "find-the-largest-almost-missing-integer",
    "language": "python3",
    "code": "class Solution:\r\n    def largestInteger(self, nums: List[int], k: int) -> int:\r\n        def f(k: int) -> int:\r\n            for i, x in enumerate(nums):\r\n                if i != k and x == nums[k]:\r\n                    return -1\r\n            return nums[k]\r\n\r\n        if k == 1:\r\n            cnt = Counter(nums)\r\n            return max((x for x, v in cnt.items() if v == 1), default=-1)\r\n        if k == len(nums):\r\n            return max(nums)\r\n        return max(f(0), f(len(nums) - 1))",
