{
    "problemName": "rotated-digits",
    "language": "python3",
    "code": "class Solution:\r\n    def rotatedDigits(self, n: int) -> int:\r\n        def check(x):\r\n            y, t = 0, x\r\n            k = 1\r\n            while t:\r\n                v = t % 10\r\n                if d[v] == -1:\r\n                    return False\r\n                y = d[v] * k + y\r\n                k *= 10\r\n                t //= 10\r\n            return x != y\r\n\r\n        d = [0, 1, 5, -1, -1, 2, 9, -1, 8, 6]\r\n        return sum(check(i) for i in range(1, n + 1))",
