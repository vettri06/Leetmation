    "problemName": "k-th-smallest-in-lexicographical-order",
    "language": "python3",
    "code": "class Solution:\r\n    def findKthNumber(self, n: int, k: int) -> int:\r\n        def count(curr):\r\n            next, cnt = curr + 1, 0\r\n            while curr <= n:\r\n                cnt += min(n - curr + 1, next - curr)\r\n                next, curr = next * 10, curr * 10\r\n            return cnt\r\n\r\n        curr = 1\r\n        k -= 1\r\n        while k:\r\n            cnt = count(curr)\r\n            if k >= cnt:\r\n                k -= cnt\r\n                curr += 1\r\n            else:\r\n                k -= 1\r\n                curr *= 10\r\n        return curr",
