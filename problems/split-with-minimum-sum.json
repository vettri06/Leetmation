{
    "problemName": "split-with-minimum-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def splitNum(self, num: int) -> int:\r\n        cnt = Counter()\r\n        n = 0\r\n        while num:\r\n            cnt[num % 10] += 1\r\n            num //= 10\r\n            n += 1\r\n        ans = [0] * 2\r\n        j = 0\r\n        for i in range(n):\r\n            while cnt[j] == 0:\r\n                j += 1\r\n            cnt[j] -= 1\r\n            ans[i & 1] = ans[i & 1] * 10 + j\r\n        return sum(ans)",
