{
    "problemName": "left-and-right-sum-differences",
    "language": "python3",
    "code": "class Solution:\r\n    def leftRightDifference(self, nums: List[int]) -> List[int]:\r\n        l, r = 0, sum(nums)\r\n        ans = []\r\n        for x in nums:\r\n            r -= x\r\n            ans.append(abs(l - r))\r\n            l += x\r\n        return ans",
