{
    "problemName": "total-appeal-of-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def appealSum(self, s: str) -> int:\r\n        ans = t = 0\r\n        pos = [-1] * 26\r\n        for i, c in enumerate(s):\r\n            c = ord(c) - ord('a')\r\n            t += i - pos[c]\r\n            ans += t\r\n            pos[c] = i\r\n        return ans",
