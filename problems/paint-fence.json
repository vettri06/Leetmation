    "problemName": "paint-fence",
    "language": "python3",
    "code": "class Solution:\r\n    def numWays(self, n: int, k: int) -> int:\r\n        f = [0] * n\r\n        g = [0] * n\r\n        f[0] = k\r\n        for i in range(1, n):\r\n            f[i] = (f[i - 1] + g[i - 1]) * (k - 1)\r\n            g[i] = f[i - 1]\r\n        return f[-1] + g[-1]",
