    "problemName": "path-with-maximum-minimum-value",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumMinimumPath(self, grid: List[List[int]]) -> int:\r\n        def find(x: int) -> int:\r\n            if p[x] != x:\r\n                p[x] = find(p[x])\r\n            return p[x]\r\n\r\n        m, n = len(grid), len(grid[0])\r\n        p = list(range(m * n))\r\n        q = [(v, i, j) for i, row in enumerate(grid) for j, v in enumerate(row)]\r\n        q.sort()\r\n        ans = 0\r\n        dirs = (-1, 0, 1, 0, -1)\r\n        vis = set()\r\n        while find(0) != find(m * n - 1):\r\n            v, i, j = q.pop()\r\n            ans = v\r\n            vis.add((i, j))\r\n            for a, b in pairwise(dirs):\r\n                x, y = i + a, j + b\r\n                if (x, y) in vis:\r\n                    p[find(i * n + j)] = find(x * n + y)\r\n        return ans",
