{
    "problemName": "consecutive-numbers-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def consecutiveNumbersSum(self, n: int) -> int:\r\n        n <<= 1\r\n        ans, k = 0, 1\r\n        while k * (k + 1) <= n:\r\n            if n % k == 0 and (n // k - k + 1) % 2 == 0:\r\n                ans += 1\r\n            k += 1\r\n        return ans",
