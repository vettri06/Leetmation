{
    "problemName": "adding-spaces-to-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def addSpaces(self, s: str, spaces: List[int]) -> str:\r\n        ans = []\r\n        j = 0\r\n        for i, c in enumerate(s):\r\n            if j < len(spaces) and i == spaces[j]:\r\n                ans.append(' ')\r\n                j += 1\r\n            ans.append(c)\r\n        return ''.join(ans)",
