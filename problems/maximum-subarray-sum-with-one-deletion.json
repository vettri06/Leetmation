    "problemName": "maximum-subarray-sum-with-one-deletion",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumSum(self, arr: List[int]) -> int:\r\n        n = len(arr)\r\n        left = [0] * n\r\n        right = [0] * n\r\n        s = 0\r\n        for i, x in enumerate(arr):\r\n            s = max(s, 0) + x\r\n            left[i] = s\r\n        s = 0\r\n        for i in range(n - 1, -1, -1):\r\n            s = max(s, 0) + arr[i]\r\n            right[i] = s\r\n        ans = max(left)\r\n        for i in range(1, n - 1):\r\n            ans = max(ans, left[i - 1] + right[i + 1])\r\n        return ans",
