    "problemName": "eliminate-maximum-number-of-monsters",
    "language": "python3",
    "code": "class Solution:\r\n    def eliminateMaximum(self, dist: List[int], speed: List[int]) -> int:\r\n        times = sorted((d - 1) // s for d, s in zip(dist, speed))\r\n        for i, t in enumerate(times):\r\n            if t < i:\r\n                return i\r\n        return len(times)",
