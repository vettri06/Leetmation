{
    "problemName": "minimum-index-of-a-valid-split",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumIndex(self, nums: List[int]) -> int:\r\n        x, cnt = Counter(nums).most_common(1)[0]\r\n        cur = 0\r\n        for i, v in enumerate(nums, 1):\r\n            if v == x:\r\n                cur += 1\r\n                if cur * 2 > i and (cnt - cur) * 2 > len(nums) - i:\r\n                    return i - 1\r\n        return -1",
