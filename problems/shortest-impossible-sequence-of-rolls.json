    "problemName": "shortest-impossible-sequence-of-rolls",
    "language": "python3",
    "code": "class Solution:\r\n    def shortestSequence(self, rolls: List[int], k: int) -> int:\r\n        ans = 1\r\n        s = set()\r\n        for v in rolls:\r\n            s.add(v)\r\n            if len(s) == k:\r\n                ans += 1\r\n                s.clear()\r\n        return ans",
