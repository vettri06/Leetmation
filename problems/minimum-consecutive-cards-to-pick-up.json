{
    "problemName": "minimum-consecutive-cards-to-pick-up",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumCardPickup(self, cards: List[int]) -> int:\r\n        last = {}\r\n        ans = inf\r\n        for i, x in enumerate(cards):\r\n            if x in last:\r\n                ans = min(ans, i - last[x] + 1)\r\n            last[x] = i\r\n        return -1 if ans == inf else ans",
