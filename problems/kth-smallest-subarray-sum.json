{
    "problemName": "kth-smallest-subarray-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def kthSmallestSubarraySum(self, nums: List[int], k: int) -> int:\r\n        def f(s):\r\n            t = j = 0\r\n            cnt = 0\r\n            for i, x in enumerate(nums):\r\n                t += x\r\n                while t > s:\r\n                    t -= nums[j]\r\n                    j += 1\r\n                cnt += i - j + 1\r\n            return cnt >= k\r\n\r\n        l, r = min(nums), sum(nums)\r\n        return l + bisect_left(range(l, r + 1), True, key=f)",
