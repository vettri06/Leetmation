{
    "problemName": "least-operators-to-express-number",
    "language": "python3",
    "code": "class Solution:\r\n    def leastOpsExpressTarget(self, x: int, target: int) -> int:\r\n        @cache\r\n        def dfs(v: int) -> int:\r\n            if x >= v:\r\n                return min(v * 2 - 1, 2 * (x - v))\r\n            k = 2\r\n            while x**k < v:\r\n                k += 1\r\n            if x**k - v < v:\r\n                return min(k + dfs(x**k - v), k - 1 + dfs(v - x ** (k - 1)))\r\n            return k - 1 + dfs(v - x ** (k - 1))\r\n\r\n        return dfs(target)",
