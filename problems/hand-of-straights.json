{
    "problemName": "hand-of-straights",
    "language": "python3",
    "code": "class Solution:\r\n    def isNStraightHand(self, hand: List[int], groupSize: int) -> bool:\r\n        if len(hand) % groupSize:\r\n            return False\r\n        cnt = Counter(hand)\r\n        for x in sorted(hand):\r\n            if cnt[x]:\r\n                for y in range(x, x + groupSize):\r\n                    if cnt[y] == 0:\r\n                        return False\r\n                    cnt[y] -= 1\r\n        return True",
