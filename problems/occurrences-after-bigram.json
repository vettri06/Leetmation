    "problemName": "occurrences-after-bigram",
    "language": "python3",
    "code": "class Solution:\r\n    def findOcurrences(self, text: str, first: str, second: str) -> List[str]:\r\n        words = text.split()\r\n        ans = []\r\n        for i in range(len(words) - 2):\r\n            a, b, c = words[i : i + 3]\r\n            if a == first and b == second:\r\n                ans.append(c)\r\n        return ans",
