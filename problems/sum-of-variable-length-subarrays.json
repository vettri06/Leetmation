    "problemName": "sum-of-variable-length-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def subarraySum(self, nums: List[int]) -> int:\r\n        s = list(accumulate(nums, initial=0))\r\n        return sum(s[i + 1] - s[max(0, i - x)] for i, x in enumerate(nums))",
