    "problemName": "jump-game-v",
    "language": "python3",
    "code": "class Solution:\r\n    def maxJumps(self, arr: List[int], d: int) -> int:\r\n        @cache\r\n        def dfs(i):\r\n            ans = 1\r\n            for j in range(i - 1, -1, -1):\r\n                if i - j > d or arr[j] >= arr[i]:\r\n                    break\r\n                ans = max(ans, 1 + dfs(j))\r\n            for j in range(i + 1, n):\r\n                if j - i > d or arr[j] >= arr[i]:\r\n                    break\r\n                ans = max(ans, 1 + dfs(j))\r\n            return ans\r\n\r\n        n = len(arr)\r\n        return max(dfs(i) for i in range(n))",
