{
    "problemName": "minimum-levels-to-gain-more-points",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumLevels(self, possible: List[int]) -> int:\r\n        s = sum(-1 if x == 0 else 1 for x in possible)\r\n        t = 0\r\n        for i, x in enumerate(possible[:-1], 1):\r\n            t += -1 if x == 0 else 1\r\n            if t > s - t:\r\n                return i\r\n        return -1",
