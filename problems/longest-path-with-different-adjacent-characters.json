{
    "problemName": "longest-path-with-different-adjacent-characters",
    "language": "python3",
    "code": "class Solution:\r\n    def longestPath(self, parent: List[int], s: str) -> int:\r\n        def dfs(i: int) -> int:\r\n            mx = 0\r\n            nonlocal ans\r\n            for j in g[i]:\r\n                x = dfs(j) + 1\r\n                if s[i] != s[j]:\r\n                    ans = max(ans, mx + x)\r\n                    mx = max(mx, x)\r\n            return mx\r\n\r\n        g = defaultdict(list)\r\n        for i in range(1, len(parent)):\r\n            g[parent[i]].append(i)\r\n        ans = 0\r\n        dfs(0)\r\n        return ans + 1",
