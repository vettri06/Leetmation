{
    "problemName": "multiply-strings",
    "language": "python3",
    "code": "class Solution:\r\n    def multiply(self, num1: str, num2: str) -> str:\r\n        if num1 == \"0\" or num2 == \"0\":\r\n            return \"0\"\r\n        m, n = len(num1), len(num2)\r\n        arr = [0] * (m + n)\r\n        for i in range(m - 1, -1, -1):\r\n            a = int(num1[i])\r\n            for j in range(n - 1, -1, -1):\r\n                b = int(num2[j])\r\n                arr[i + j + 1] += a * b\r\n        for i in range(m + n - 1, 0, -1):\r\n            arr[i - 1] += arr[i] // 10\r\n            arr[i] %= 10\r\n        i = 0 if arr[0] else 1\r\n        return \"\".join(str(x) for x in arr[i:])",
