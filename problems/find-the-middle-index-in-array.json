{
    "problemName": "find-the-middle-index-in-array",
    "language": "python3",
    "code": "class Solution:\r\n    def findMiddleIndex(self, nums: List[int]) -> int:\r\n        l, r = 0, sum(nums)\r\n        for i, x in enumerate(nums):\r\n            r -= x\r\n            if l == r:\r\n                return i\r\n            l += x\r\n        return -1",
