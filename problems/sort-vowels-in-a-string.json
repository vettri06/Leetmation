{
    "problemName": "sort-vowels-in-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def sortVowels(self, s: str) -> str:\r\n        vs = [c for c in s if c.lower() in \"aeiou\"]\r\n        vs.sort()\r\n        cs = list(s)\r\n        j = 0\r\n        for i, c in enumerate(cs):\r\n            if c.lower() in \"aeiou\":\r\n                cs[i] = vs[j]\r\n                j += 1\r\n        return \"\".join(cs)",
