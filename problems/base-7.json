    "problemName": "base-7",
    "language": "python3",
    "code": "class Solution:\r\n    def convertToBase7(self, num: int) -> str:\r\n        if num == 0:\r\n            return '0'\r\n        if num < 0:\r\n            return '-' + self.convertToBase7(-num)\r\n        ans = []\r\n        while num:\r\n            ans.append(str(num % 7))\r\n            num //= 7\r\n        return ''.join(ans[::-1])",
