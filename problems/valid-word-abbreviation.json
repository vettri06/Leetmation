    "problemName": "valid-word-abbreviation",
    "language": "python3",
    "code": "class Solution:\r\n    def validWordAbbreviation(self, word: str, abbr: str) -> bool:\r\n        m, n = len(word), len(abbr)\r\n        i = j = x = 0\r\n        while i < m and j < n:\r\n            if abbr[j].isdigit():\r\n                if abbr[j] == \"0\" and x == 0:\r\n                    return False\r\n                x = x * 10 + int(abbr[j])\r\n            else:\r\n                i += x\r\n                x = 0\r\n                if i >= m or word[i] != abbr[j]:\r\n                    return False\r\n                i += 1\r\n            j += 1\r\n        return i + x == m and j == n",
