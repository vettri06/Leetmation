{
    "problemName": "find-longest-awesome-substring",
    "language": "python3",
    "code": "class Solution:\r\n    def longestAwesome(self, s: str) -> int:\r\n        st = 0\r\n        d = {0: -1}\r\n        ans = 1\r\n        for i, c in enumerate(s):\r\n            v = int(c)\r\n            st ^= 1 << v\r\n            if st in d:\r\n                ans = max(ans, i - d[st])\r\n            else:\r\n                d[st] = i\r\n            for v in range(10):\r\n                if st ^ (1 << v) in d:\r\n                    ans = max(ans, i - d[st ^ (1 << v)])\r\n        return ans",
