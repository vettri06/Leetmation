{
    "problemName": "dice-roll-simulation",
    "language": "python3",
    "code": "class Solution:\r\n    def dieSimulator(self, n: int, rollMax: List[int]) -> int:\r\n        @cache\r\n        def dfs(i, j, x):\r\n            if i >= n:\r\n                return 1\r\n            ans = 0\r\n            for k in range(1, 7):\r\n                if k != j:\r\n                    ans += dfs(i + 1, k, 1)\r\n                elif x < rollMax[j - 1]:\r\n                    ans += dfs(i + 1, j, x + 1)\r\n            return ans % (10**9 + 7)\r\n\r\n        return dfs(0, 0, 0)",
