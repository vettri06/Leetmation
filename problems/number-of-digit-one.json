    "problemName": "number-of-digit-one",
    "language": "python3",
    "code": "class Solution:\r\n    def countDigitOne(self, n: int) -> int:\r\n        @cache\r\n        def dfs(i: int, cnt: int, limit: bool) -> int:\r\n            if i >= len(s):\r\n                return cnt\r\n            up = int(s[i]) if limit else 9\r\n            ans = 0\r\n            for j in range(up + 1):\r\n                ans += dfs(i + 1, cnt + (j == 1), limit and j == up)\r\n            return ans\r\n\r\n        s = str(n)\r\n        return dfs(0, 0, True)",
