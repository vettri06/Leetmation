    "problemName": "words-within-two-edits-of-dictionary",
    "language": "python3",
    "code": "class Solution:\r\n    def twoEditWords(self, queries: List[str], dictionary: List[str]) -> List[str]:\r\n        ans = []\r\n        for s in queries:\r\n            for t in dictionary:\r\n                if sum(a != b for a, b in zip(s, t)) < 3:\r\n                    ans.append(s)\r\n                    break\r\n        return ans",
