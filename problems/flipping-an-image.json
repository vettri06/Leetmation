{
    "problemName": "flipping-an-image",
    "language": "python3",
    "code": "class Solution:\r\n    def flipAndInvertImage(self, image: List[List[int]]) -> List[List[int]]:\r\n        n = len(image)\r\n        for row in image:\r\n            i, j = 0, n - 1\r\n            while i < j:\r\n                if row[i] == row[j]:\r\n                    row[i] ^= 1\r\n                    row[j] ^= 1\r\n                i, j = i + 1, j - 1\r\n            if i == j:\r\n                row[i] ^= 1\r\n        return image",
