    "problemName": "positions-of-large-groups",
    "language": "python3",
    "code": "class Solution:\r\n    def largeGroupPositions(self, s: str) -> List[List[int]]:\r\n        i, n = 0, len(s)\r\n        ans = []\r\n        while i < n:\r\n            j = i\r\n            while j < n and s[j] == s[i]:\r\n                j += 1\r\n            if j - i >= 3:\r\n                ans.append([i, j - 1])\r\n            i = j\r\n        return ans",
