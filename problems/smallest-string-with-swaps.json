    "code": "class Solution:\r\n    def smallestStringWithSwaps(self, s: str, pairs: List[List[int]]) -> str:\r\n        def find(x: int) -> int:\r\n            if p[x] != x:\r\n                p[x] = find(p[x])\r\n            return p[x]\r\n\r\n        n = len(s)\r\n        p = list(range(n))\r\n        for a, b in pairs:\r\n            p[find(a)] = find(b)\r\n        d = defaultdict(list)\r\n        for i, c in enumerate(s):\r\n            d[find(i)].append(c)\r\n        for i in d.keys():\r\n            d[i].sort(reverse=True)\r\n        return \"\".join(d[find(i)].pop() for i in range(n))",
