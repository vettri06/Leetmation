    "problemName": "replace-elements-in-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def arrayChange(self, nums: List[int], operations: List[List[int]]) -> List[int]:\r\n        d = {x: i for i, x in enumerate(nums)}\r\n        for x, y in operations:\r\n            nums[d[x]] = y\r\n            d[y] = d[x]\r\n        return nums",
