    "code": "class Solution:\r\n    def toHexspeak(self, num: str) -> str:\r\n        s = set('ABCDEFIO')\r\n        t = hex(int(num))[2:].upper().replace('0', 'O').replace('1', 'I')\r\n        return t if all(c in s for c in t) else 'ERROR'",
