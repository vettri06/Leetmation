    "problemName": "closest-equal-element-queries",
    "language": "python3",
    "code": "class Solution:\r\n    def solveQueries(self, nums: List[int], queries: List[int]) -> List[int]:\r\n        n = len(nums)\r\n        m = n << 1\r\n        d = [m] * m\r\n        left = {}\r\n        for i in range(m):\r\n            x = nums[i % n]\r\n            if x in left:\r\n                d[i] = min(d[i], i - left[x])\r\n            left[x] = i\r\n        right = {}\r\n        for i in range(m - 1, -1, -1):\r\n            x = nums[i % n]\r\n            if x in right:\r\n                d[i] = min(d[i], right[x] - i)\r\n            right[x] = i\r\n        for i in range(n):\r\n            d[i] = min(d[i], d[i + n])\r\n        return [-1 if d[i] >= n else d[i] for i in queries]",
