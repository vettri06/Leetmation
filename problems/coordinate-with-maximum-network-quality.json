{
    "problemName": "coordinate-with-maximum-network-quality",
    "language": "python3",
    "code": "class Solution:\r\n    def bestCoordinate(self, towers: List[List[int]], radius: int) -> List[int]:\r\n        mx = 0\r\n        ans = [0, 0]\r\n        for i in range(51):\r\n            for j in range(51):\r\n                t = 0\r\n                for x, y, q in towers:\r\n                    d = ((x - i) ** 2 + (y - j) ** 2) ** 0.5\r\n                    if d <= radius:\r\n                        t += floor(q / (1 + d))\r\n                if t > mx:\r\n                    mx = t\r\n                    ans = [i, j]\r\n        return ans",
