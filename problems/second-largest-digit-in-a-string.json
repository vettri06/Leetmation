{
    "problemName": "second-largest-digit-in-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def secondHighest(self, s: str) -> int:\r\n        a = b = -1\r\n        for c in s:\r\n            if c.isdigit():\r\n                v = int(c)\r\n                if v > a:\r\n                    a, b = v, a\r\n                elif b < v < a:\r\n                    b = v\r\n        return b",
