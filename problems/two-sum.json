    "problemName": "two-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def twoSum(self, nums: List[int], target: int) -> List[int]:\r\n        d = {}\r\n        for i, x in enumerate(nums):\r\n            if (y := target - x) in d:\r\n                return [d[y], i]\r\n            d[x] = i",
