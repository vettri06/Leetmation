    "problemName": "regular-expression-matching",
    "language": "python3",
    "code": "class Solution:\r\n    def isMatch(self, s: str, p: str) -> bool:\r\n        @cache\r\n        def dfs(i, j):\r\n            if j >= n:\r\n                return i == m\r\n            if j + 1 < n and p[j + 1] == '*':\r\n                return dfs(i, j + 2) or (\r\n                    i < m and (s[i] == p[j] or p[j] == '.') and dfs(i + 1, j)\r\n                )\r\n            return i < m and (s[i] == p[j] or p[j] == '.') and dfs(i + 1, j + 1)\r\n\r\n        m, n = len(s), len(p)\r\n        return dfs(0, 0)",
