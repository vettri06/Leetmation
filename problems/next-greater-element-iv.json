    "code": "class Solution:\r\n    def secondGreaterElement(self, nums: List[int]) -> List[int]:\r\n        arr = [(x, i) for i, x in enumerate(nums)]\r\n        arr.sort(key=lambda x: -x[0])\r\n        sl = SortedList()\r\n        n = len(nums)\r\n        ans = [-1] * n\r\n        for _, i in arr:\r\n            j = sl.bisect_right(i)\r\n            if j + 1 < len(sl):\r\n                ans[i] = nums[sl[j + 1]]\r\n            sl.add(i)\r\n        return ans",
