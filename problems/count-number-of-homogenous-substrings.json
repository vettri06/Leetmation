{
    "problemName": "count-number-of-homogenous-substrings",
    "language": "python3",
    "code": "class Solution:\r\n    def countHomogenous(self, s: str) -> int:\r\n        mod = 10**9 + 7\r\n        i, n = 0, len(s)\r\n        ans = 0\r\n        while i < n:\r\n            j = i\r\n            while j < n and s[j] == s[i]:\r\n                j += 1\r\n            cnt = j - i\r\n            ans += (1 + cnt) * cnt // 2\r\n            ans %= mod\r\n            i = j\r\n        return ans",
