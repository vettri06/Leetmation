{
    "problemName": "smallest-subsequence-of-distinct-characters",
    "language": "python3",
    "code": "class Solution:\r\n    def smallestSubsequence(self, s: str) -> str:\r\n        last = {c: i for i, c in enumerate(s)}\r\n        stk = []\r\n        vis = set()\r\n        for i, c in enumerate(s):\r\n            if c in vis:\r\n                continue\r\n            while stk and stk[-1] > c and last[stk[-1]] > i:\r\n                vis.remove(stk.pop())\r\n            stk.append(c)\r\n            vis.add(c)\r\n        return \"\".join(stk)",
