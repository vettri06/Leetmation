{
    "problemName": "maximum-swap",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumSwap(self, num: int) -> int:\r\n        s = list(str(num))\r\n        n = len(s)\r\n        d = list(range(n))\r\n        for i in range(n - 2, -1, -1):\r\n            if s[i] <= s[d[i + 1]]:\r\n                d[i] = d[i + 1]\r\n        for i, j in enumerate(d):\r\n            if s[i] < s[j]:\r\n                s[i], s[j] = s[j], s[i]\r\n                break\r\n        return int(''.join(s))",
