{
    "problemName": "surface-area-of-3d-shapes",
    "language": "python3",
    "code": "class Solution:\r\n    def surfaceArea(self, grid: List[List[int]]) -> int:\r\n        ans = 0\r\n        for i, row in enumerate(grid):\r\n            for j, v in enumerate(row):\r\n                if v:\r\n                    ans += 2 + v * 4\r\n                    if i:\r\n                        ans -= min(v, grid[i - 1][j]) * 2\r\n                    if j:\r\n                        ans -= min(v, grid[i][j - 1]) * 2\r\n        return ans",
