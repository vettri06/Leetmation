    "problemName": "removing-stars-from-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def removeStars(self, s: str) -> str:\r\n        ans = []\r\n        for c in s:\r\n            if c == '*':\r\n                ans.pop()\r\n            else:\r\n                ans.append(c)\r\n        return ''.join(ans)",
