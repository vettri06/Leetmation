{
    "problemName": "string-compression-iii",
    "language": "python3",
    "code": "class Solution:\r\n    def compressedString(self, word: str) -> str:\r\n        g = groupby(word)\r\n        ans = []\r\n        for c, v in g:\r\n            k = len(list(v))\r\n            while k:\r\n                x = min(9, k)\r\n                ans.append(str(x) + c)\r\n                k -= x\r\n        return \"\".join(ans)",
