    "problemName": "russian-doll-envelopes",
    "language": "python3",
    "code": "class Solution:\r\n    def maxEnvelopes(self, envelopes: List[List[int]]) -> int:\r\n        envelopes.sort(key=lambda x: (x[0], -x[1]))\r\n        d = [envelopes[0][1]]\r\n        for _, h in envelopes[1:]:\r\n            if h > d[-1]:\r\n                d.append(h)\r\n            else:\r\n                idx = bisect_left(d, h)\r\n                d[idx] = h\r\n        return len(d)",
