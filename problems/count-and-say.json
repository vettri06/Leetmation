    "problemName": "count-and-say",
    "language": "python3",
    "code": "class Solution:\r\n    def countAndSay(self, n: int) -> str:\r\n        s = '1'\r\n        for _ in range(n - 1):\r\n            i = 0\r\n            t = []\r\n            while i < len(s):\r\n                j = i\r\n                while j < len(s) and s[j] == s[i]:\r\n                    j += 1\r\n                t.append(str(j - i))\r\n                t.append(str(s[i]))\r\n                i = j\r\n            s = ''.join(t)\r\n        return s",
