    "problemName": "generalized-abbreviation",
    "language": "python3",
    "code": "class Solution:\r\n    def generateAbbreviations(self, word: str) -> List[str]:\r\n        def dfs(i: int) -> List[str]:\r\n            if i >= n:\r\n                return [\"\"]\r\n            ans = [word[i] + s for s in dfs(i + 1)]\r\n            for j in range(i + 1, n + 1):\r\n                for s in dfs(j + 1):\r\n                    ans.append(str(j - i) + (word[j] if j < n else \"\") + s)\r\n            return ans\r\n\r\n        n = len(word)\r\n        return dfs(0)",
