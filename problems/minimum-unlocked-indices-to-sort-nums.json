{
    "problemName": "minimum-unlocked-indices-to-sort-nums",
    "language": "python3",
    "code": "class Solution:\r\n    def minUnlockedIndices(self, nums: List[int], locked: List[int]) -> int:\r\n        n = len(nums)\r\n        first2 = first3 = n\r\n        last1 = last2 = -1\r\n        for i, x in enumerate(nums):\r\n            if x == 1:\r\n                last1 = i\r\n            elif x == 2:\r\n                first2 = min(first2, i)\r\n                last2 = i\r\n            else:\r\n                first3 = min(first3, i)\r\n        if first3 < last1:\r\n            return -1\r\n        return sum(\r\n            st and (first2 <= i < last1 or first3 <= i < last2)\r\n            for i, st in enumerate(locked)\r\n        )",
