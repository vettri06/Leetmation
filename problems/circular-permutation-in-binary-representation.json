    "language": "python3",
    "code": "class Solution:\r\n    def circularPermutation(self, n: int, start: int) -> List[int]:\r\n        g = [i ^ (i >> 1) for i in range(1 << n)]\r\n        j = g.index(start)\r\n        return g[j:] + g[:j]",
