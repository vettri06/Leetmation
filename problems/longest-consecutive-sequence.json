{
    "problemName": "longest-consecutive-sequence",
    "language": "python3",
    "code": "class Solution:\r\n    def longestConsecutive(self, nums: List[int]) -> int:\r\n        s = set(nums)\r\n        ans = 0\r\n        d = defaultdict(int)\r\n        for x in nums:\r\n            y = x\r\n            while y in s:\r\n                s.remove(y)\r\n                y += 1\r\n            d[x] = d[y] + y - x\r\n            ans = max(ans, d[x])\r\n        return ans",
