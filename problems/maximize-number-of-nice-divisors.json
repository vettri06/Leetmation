{
    "problemName": "maximize-number-of-nice-divisors",
    "language": "python3",
    "code": "class Solution:\r\n    def maxNiceDivisors(self, primeFactors: int) -> int:\r\n        mod = 10**9 + 7\r\n        if primeFactors < 4:\r\n            return primeFactors\r\n        if primeFactors % 3 == 0:\r\n            return pow(3, primeFactors // 3, mod) % mod\r\n        if primeFactors % 3 == 1:\r\n            return 4 * pow(3, primeFactors // 3 - 1, mod) % mod\r\n        return 2 * pow(3, primeFactors // 3, mod) % mod",
