{
    "problemName": "shortest-and-lexicographically-smallest-beautiful-string",
    "language": "python3",
    "code": "class Solution:\r\n    def shortestBeautifulSubstring(self, s: str, k: int) -> str:\r\n        n = len(s)\r\n        ans = \"\"\r\n        for i in range(n):\r\n            for j in range(i + k, n + 1):\r\n                t = s[i:j]\r\n                if t.count(\"1\") == k and (\r\n                    not ans or j - i < len(ans) or (j - i == len(ans) and t < ans)\r\n                ):\r\n                    ans = t\r\n        return ans",
