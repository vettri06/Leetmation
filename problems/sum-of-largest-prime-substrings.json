    "problemName": "sum-of-largest-prime-substrings",
    "language": "python3",
    "code": "class Solution:\r\n    def sumOfLargestPrimes(self, s: str) -> int:\r\n        def is_prime(x: int) -> bool:\r\n            if x < 2:\r\n                return False\r\n            return all(x % i for i in range(2, int(sqrt(x)) + 1))\r\n\r\n        st = set()\r\n        n = len(s)\r\n        for i in range(n):\r\n            x = 0\r\n            for j in range(i, n):\r\n                x = x * 10 + int(s[j])\r\n                if is_prime(x):\r\n                    st.add(x)\r\n        return sum(sorted(st)[-3:])",
