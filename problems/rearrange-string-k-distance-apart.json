    "problemName": "rearrange-string-k-distance-apart",
    "language": "python3",
    "code": "class Solution:\r\n    def rearrangeString(self, s: str, k: int) -> str:\r\n        cnt = Counter(s)\r\n        pq = [(-v, c) for c, v in cnt.items()]\r\n        heapify(pq)\r\n        q = deque()\r\n        ans = []\r\n        while pq:\r\n            v, c = heappop(pq)\r\n            ans.append(c)\r\n            q.append((v + 1, c))\r\n            if len(q) >= k:\r\n                e = q.popleft()\r\n                if e[0]:\r\n                    heappush(pq, e)\r\n        return \"\" if len(ans) < len(s) else \"\".join(ans)",
