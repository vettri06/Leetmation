    "problemName": "can-place-flowers",
    "language": "python3",
    "code": "class Solution:\r\n    def canPlaceFlowers(self, flowerbed: List[int], n: int) -> bool:\r\n        flowerbed = [0] + flowerbed + [0]\r\n        for i in range(1, len(flowerbed) - 1):\r\n            if sum(flowerbed[i - 1 : i + 2]) == 0:\r\n                flowerbed[i] = 1\r\n                n -= 1\r\n        return n <= 0",
