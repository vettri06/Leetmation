    "problemName": "satisfiability-of-equality-equations",
    "language": "python3",
    "code": "class Solution:\r\n    def equationsPossible(self, equations: List[str]) -> bool:\r\n        def find(x):\r\n            if p[x] != x:\r\n                p[x] = find(p[x])\r\n            return p[x]\r\n\r\n        p = list(range(26))\r\n        for e in equations:\r\n            a, b = ord(e[0]) - ord('a'), ord(e[-1]) - ord('a')\r\n            if e[1] == '=':\r\n                p[find(a)] = find(b)\r\n        for e in equations:\r\n            a, b = ord(e[0]) - ord('a'), ord(e[-1]) - ord('a')\r\n            if e[1] == '!' and find(a) == find(b):\r\n                return False\r\n        return True",
