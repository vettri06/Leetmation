    "problemName": "valid-anagram",
    "language": "python3",
    "code": "class Solution:\r\n    def isAnagram(self, s: str, t: str) -> bool:\r\n        if len(s) != len(t):\r\n            return False\r\n        cnt = Counter(s)\r\n        for c in t:\r\n            cnt[c] -= 1\r\n            if cnt[c] < 0:\r\n                return False\r\n        return True",
