    "language": "python3",
    "code": "class Solution:\r\n    def pancakeSort(self, arr: List[int]) -> List[int]:\r\n        def reverse(arr, j):\r\n            i = 0\r\n            while i < j:\r\n                arr[i], arr[j] = arr[j], arr[i]\r\n                i, j = i + 1, j - 1\r\n\r\n        n = len(arr)\r\n        ans = []\r\n        for i in range(n - 1, 0, -1):\r\n            j = i\r\n            while j > 0 and arr[j] != i + 1:\r\n                j -= 1\r\n            if j < i:\r\n                if j > 0:\r\n                    ans.append(j + 1)\r\n                    reverse(arr, j)\r\n                ans.append(i + 1)\r\n                reverse(arr, i)\r\n        return ans",
