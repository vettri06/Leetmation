    "code": "class Solution:\r\n    def findContestMatch(self, n: int) -> str:\r\n        s = [str(i + 1) for i in range(n)]\r\n        while n > 1:\r\n            for i in range(n >> 1):\r\n                s[i] = f\"({s[i]},{s[n - i - 1]})\"\r\n            n >>= 1\r\n        return s[0]",
