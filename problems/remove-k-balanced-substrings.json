{
    "problemName": "remove-k-balanced-substrings",
    "language": "python3",
    "code": "class Solution:\r\n    def removeSubstring(self, s: str, k: int) -> str:\r\n        stk = []\r\n        for c in s:\r\n            if stk and stk[-1][0] == c:\r\n                stk[-1][1] += 1\r\n            else:\r\n                stk.append([c, 1])\r\n            if c == \")\" and len(stk) > 1 and stk[-1][1] == k and stk[-2][1] >= k:\r\n                stk.pop()\r\n                stk[-1][1] -= k\r\n                if stk[-1][1] == 0:\r\n                    stk.pop()\r\n        return \"\".join(c * v for c, v in stk)",
