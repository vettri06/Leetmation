{
    "problemName": "check-array-formation-through-concatenation",
    "language": "python3",
    "code": "class Solution:\r\n    def canFormArray(self, arr: List[int], pieces: List[List[int]]) -> bool:\r\n        i = 0\r\n        while i < len(arr):\r\n            k = 0\r\n            while k < len(pieces) and pieces[k][0] != arr[i]:\r\n                k += 1\r\n            if k == len(pieces):\r\n                return False\r\n            j = 0\r\n            while j < len(pieces[k]) and arr[i] == pieces[k][j]:\r\n                i, j = i + 1, j + 1\r\n        return True",
