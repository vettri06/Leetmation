{
    "problemName": "angles-of-a-triangle",
    "language": "python3",
    "code": "class Solution:\r\n    def internalAngles(self, sides: list[int]) -> list[float]:\r\n        sides.sort()\r\n        a, b, c = sides\r\n        if a + b <= c:\r\n            return []\r\n        A = degrees(acos((b**2 + c**2 - a**2) / (2 * b * c)))\r\n        B = degrees(acos((a**2 + c**2 - b**2) / (2 * a * c)))\r\n        C = 180 - A - B\r\n        return [A, B, C]",
