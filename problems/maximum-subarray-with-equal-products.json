{
    "problemName": "maximum-subarray-with-equal-products",
    "language": "python3",
    "code": "class Solution:\r\n    def maxLength(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        ans = 0\r\n        max_p = lcm(*nums) * max(nums)\r\n        for i in range(n):\r\n            p, g, l = 1, 0, 1\r\n            for j in range(i, n):\r\n                p *= nums[j]\r\n                g = gcd(g, nums[j])\r\n                l = lcm(l, nums[j])\r\n                if p == g * l:\r\n                    ans = max(ans, j - i + 1)\r\n                if p > max_p:\r\n                    break\r\n        return ans",
