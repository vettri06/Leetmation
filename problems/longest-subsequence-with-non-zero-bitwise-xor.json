{
    "problemName": "longest-subsequence-with-non-zero-bitwise-xor",
    "language": "python3",
    "code": "class Solution:\r\n    def longestSubsequence(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        xor = cnt0 = 0\r\n        for x in nums:\r\n            xor ^= x\r\n            cnt0 += int(x == 0)\r\n        if xor:\r\n            return n\r\n        if cnt0 == n:\r\n            return 0\r\n        return n - 1",
