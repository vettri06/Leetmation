{
    "problemName": "maximum-product-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def maxProduct(self, nums: List[int]) -> int:\r\n        ans = f = g = nums[0]\r\n        for x in nums[1:]:\r\n            ff, gg = f, g\r\n            f = max(x, ff * x, gg * x)\r\n            g = min(x, ff * x, gg * x)\r\n            ans = max(ans, f)\r\n        return ans",
