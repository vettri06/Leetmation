    "code": "class Solution:\r\n    def uncommonFromSentences(self, s1: str, s2: str) -> List[str]:\r\n        cnt = Counter(s1.split()) + Counter(s2.split())\r\n        return [s for s, v in cnt.items() if v == 1]",
