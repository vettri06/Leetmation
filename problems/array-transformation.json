{
    "problemName": "array-transformation",
    "language": "python3",
    "code": "class Solution:\r\n    def transformArray(self, arr: List[int]) -> List[int]:\r\n        f = True\r\n        while f:\r\n            f = False\r\n            t = arr[:]\r\n            for i in range(1, len(t) - 1):\r\n                if t[i] > t[i - 1] and t[i] > t[i + 1]:\r\n                    arr[i] -= 1\r\n                    f = True\r\n                if t[i] < t[i - 1] and t[i] < t[i + 1]:\r\n                    arr[i] += 1\r\n                    f = True\r\n        return arr",
