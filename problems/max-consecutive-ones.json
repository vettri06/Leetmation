    "problemName": "max-consecutive-ones",
    "language": "python3",
    "code": "class Solution:\r\n    def findMaxConsecutiveOnes(self, nums: List[int]) -> int:\r\n        ans = cnt = 0\r\n        for x in nums:\r\n            if x:\r\n                cnt += 1\r\n                ans = max(ans, cnt)\r\n            else:\r\n                cnt = 0\r\n        return ans",
