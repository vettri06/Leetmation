    "language": "mysql",
    "code": "# Write your MySQL query statement below\r\nSELECT\r\n    ROUND(AVG(order_date = customer_pref_delivery_date) * 100, 2) AS immediate_percentage\r\nFROM Delivery\r\nWHERE\r\n    (customer_id, order_date) IN (\r\n        SELECT customer_id, MIN(order_date)\r\n        FROM Delivery\r\n        GROUP BY 1\r\n    );",
