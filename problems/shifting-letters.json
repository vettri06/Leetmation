    "problemName": "shifting-letters",
    "language": "python3",
    "code": "class Solution:\r\n    def shiftingLetters(self, s: str, shifts: List[int]) -> str:\r\n        n, t = len(s), 0\r\n        s = list(s)\r\n        for i in range(n - 1, -1, -1):\r\n            t += shifts[i]\r\n            j = (ord(s[i]) - ord(\"a\") + t) % 26\r\n            s[i] = ascii_lowercase[j]\r\n        return \"\".join(s)",
