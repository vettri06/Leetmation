{
    "problemName": "find-the-most-competitive-subsequence",
    "language": "python3",
    "code": "class Solution:\r\n    def mostCompetitive(self, nums: List[int], k: int) -> List[int]:\r\n        stk = []\r\n        n = len(nums)\r\n        for i, v in enumerate(nums):\r\n            while stk and stk[-1] > v and len(stk) + n - i > k:\r\n                stk.pop()\r\n            if len(stk) < k:\r\n                stk.append(v)\r\n        return stk",
