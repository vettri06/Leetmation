{
    "problemName": "remove-k-digits",
    "language": "python3",
    "code": "class Solution:\r\n    def removeKdigits(self, num: str, k: int) -> str:\r\n        stk = []\r\n        remain = len(num) - k\r\n        for c in num:\r\n            while k and stk and stk[-1] > c:\r\n                stk.pop()\r\n                k -= 1\r\n            stk.append(c)\r\n        return ''.join(stk[:remain]).lstrip('0') or '0'",
