{
    "problemName": "sliding-window-maximum",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSlidingWindow(self, nums: List[int], k: int) -> List[int]:\r\n        q = [(-v, i) for i, v in enumerate(nums[: k - 1])]\r\n        heapify(q)\r\n        ans = []\r\n        for i in range(k - 1, len(nums)):\r\n            heappush(q, (-nums[i], i))\r\n            while q[0][1] <= i - k:\r\n                heappop(q)\r\n            ans.append(-q[0][0])\r\n        return ans",
