    "problemName": "minimum-absolute-distance-between-mirror-pairs",
    "language": "python3",
    "code": "class Solution:\r\n    def minMirrorPairDistance(self, nums: List[int]) -> int:\r\n        def reverse(x: int) -> int:\r\n            y = 0\r\n            while x:\r\n                v = x % 10\r\n                y = y * 10 + v\r\n                x //= 10\r\n            return y\r\n\r\n        pos = {}\r\n        ans = inf\r\n        for i, x in enumerate(nums):\r\n            if x in pos:\r\n                ans = min(ans, i - pos[x])\r\n            pos[reverse(x)] = i\r\n        return -1 if ans == inf else ans",
