    "problemName": "intersection-of-multiple-arrays",
    "language": "python3",
    "code": "class Solution:\r\n    def intersection(self, nums: List[List[int]]) -> List[int]:\r\n        cnt = [0] * 1001\r\n        for arr in nums:\r\n            for x in arr:\r\n                cnt[x] += 1\r\n        return [x for x, v in enumerate(cnt) if v == len(nums)]",
