{
    "problemName": "count-pairs-of-similar-strings",
    "language": "python3",
    "code": "class Solution:\r\n    def similarPairs(self, words: List[str]) -> int:\r\n        ans = 0\r\n        cnt = Counter()\r\n        for s in words:\r\n            x = 0\r\n            for c in map(ord, s):\r\n                x |= 1 << (c - ord(\"a\"))\r\n            ans += cnt[x]\r\n            cnt[x] += 1\r\n        return ans",
