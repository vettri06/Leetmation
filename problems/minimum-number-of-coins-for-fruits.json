{
    "problemName": "minimum-number-of-coins-for-fruits",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumCoins(self, prices: List[int]) -> int:\r\n        @cache\r\n        def dfs(i: int) -> int:\r\n            if i * 2 >= len(prices):\r\n                return prices[i - 1]\r\n            return prices[i - 1] + min(dfs(j) for j in range(i + 1, i * 2 + 2))\r\n\r\n        return dfs(1)",
