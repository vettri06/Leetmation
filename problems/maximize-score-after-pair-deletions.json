    "language": "python3",
    "code": "class Solution:\r\n    def maxScore(self, nums: List[int]) -> int:\r\n        s = sum(nums)\r\n        if len(nums) & 1:\r\n            return s - min(nums)\r\n        return s - min(a + b for a, b in pairwise(nums))",
