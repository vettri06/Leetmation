    "problemName": "add-binary",
    "language": "python3",
    "code": "class Solution:\r\n    def addBinary(self, a: str, b: str) -> str:\r\n        ans = []\r\n        i, j, carry = len(a) - 1, len(b) - 1, 0\r\n        while i >= 0 or j >= 0 or carry:\r\n            carry += (0 if i < 0 else int(a[i])) + (0 if j < 0 else int(b[j]))\r\n            carry, v = divmod(carry, 2)\r\n            ans.append(str(v))\r\n            i, j = i - 1, j - 1\r\n        return \"\".join(ans[::-1])",
