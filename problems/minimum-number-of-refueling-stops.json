{
    "problemName": "minimum-number-of-refueling-stops",
    "language": "python3",
    "code": "class Solution:\r\n    def minRefuelStops(\r\n        self, target: int, startFuel: int, stations: List[List[int]]\r\n    ) -> int:\r\n        pq = []\r\n        ans = pre = 0\r\n        stations.append([target, 0])\r\n        for pos, fuel in stations:\r\n            dist = pos - pre\r\n            startFuel -= dist\r\n            while startFuel < 0 and pq:\r\n                startFuel -= heappop(pq)\r\n                ans += 1\r\n            if startFuel < 0:\r\n                return -1\r\n            heappush(pq, -fuel)\r\n            pre = pos\r\n        return ans",
