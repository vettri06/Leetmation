    "problemName": "flood-fill",
    "language": "python3",
    "code": "class Solution:\r\n    def floodFill(\r\n        self, image: List[List[int]], sr: int, sc: int, color: int\r\n    ) -> List[List[int]]:\r\n        def dfs(i: int, j: int):\r\n            image[i][j] = color\r\n            for a, b in pairwise(dirs):\r\n                x, y = i + a, j + b\r\n                if 0 <= x < len(image) and 0 <= y < len(image[0]) and image[x][y] == oc:\r\n                    dfs(x, y)\r\n\r\n        oc = image[sr][sc]\r\n        if oc != color:\r\n            dirs = (-1, 0, 1, 0, -1)\r\n            dfs(sr, sc)\r\n        return image",
