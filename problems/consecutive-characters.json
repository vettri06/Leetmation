    "problemName": "consecutive-characters",
    "language": "python3",
    "code": "class Solution:\r\n    def maxPower(self, s: str) -> int:\r\n        ans = t = 1\r\n        for a, b in pairwise(s):\r\n            if a == b:\r\n                t += 1\r\n                ans = max(ans, t)\r\n            else:\r\n                t = 1\r\n        return ans",
