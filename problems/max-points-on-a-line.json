{
    "problemName": "max-points-on-a-line",
    "language": "python3",
    "code": "class Solution:\r\n    def maxPoints(self, points: List[List[int]]) -> int:\r\n        n = len(points)\r\n        ans = 1\r\n        for i in range(n):\r\n            x1, y1 = points[i]\r\n            for j in range(i + 1, n):\r\n                x2, y2 = points[j]\r\n                cnt = 2\r\n                for k in range(j + 1, n):\r\n                    x3, y3 = points[k]\r\n                    a = (y2 - y1) * (x3 - x1)\r\n                    b = (y3 - y1) * (x2 - x1)\r\n                    cnt += a == b\r\n                ans = max(ans, cnt)\r\n        return ans",
