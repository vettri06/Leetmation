    "problemName": "minimum-path-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def minPathSum(self, grid: List[List[int]]) -> int:\r\n        m, n = len(grid), len(grid[0])\r\n        f = [[0] * n for _ in range(m)]\r\n        f[0][0] = grid[0][0]\r\n        for i in range(1, m):\r\n            f[i][0] = f[i - 1][0] + grid[i][0]\r\n        for j in range(1, n):\r\n            f[0][j] = f[0][j - 1] + grid[0][j]\r\n        for i in range(1, m):\r\n            for j in range(1, n):\r\n                f[i][j] = min(f[i - 1][j], f[i][j - 1]) + grid[i][j]\r\n        return f[-1][-1]",
