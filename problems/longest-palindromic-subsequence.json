{
    "problemName": "longest-palindromic-subsequence",
    "language": "python3",
    "code": "class Solution:\r\n    def longestPalindromeSubseq(self, s: str) -> int:\r\n        n = len(s)\r\n        dp = [[0] * n for _ in range(n)]\r\n        for i in range(n):\r\n            dp[i][i] = 1\r\n        for j in range(1, n):\r\n            for i in range(j - 1, -1, -1):\r\n                if s[i] == s[j]:\r\n                    dp[i][j] = dp[i + 1][j - 1] + 2\r\n                else:\r\n                    dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])\r\n        return dp[0][-1]",
