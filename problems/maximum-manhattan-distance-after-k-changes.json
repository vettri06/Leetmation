    "problemName": "maximum-manhattan-distance-after-k-changes",
    "language": "python3",
    "code": "class Solution:\r\n    def maxDistance(self, s: str, k: int) -> int:\r\n        def calc(a: str, b: str) -> int:\r\n            ans = mx = cnt = 0\r\n            for c in s:\r\n                if c == a or c == b:\r\n                    mx += 1\r\n                elif cnt < k:\r\n                    cnt += 1\r\n                    mx += 1\r\n                else:\r\n                    mx -= 1\r\n                ans = max(ans, mx)\r\n            return ans\r\n\r\n        a = calc(\"S\", \"E\")\r\n        b = calc(\"S\", \"W\")\r\n        c = calc(\"N\", \"E\")\r\n        d = calc(\"N\", \"W\")\r\n        return max(a, b, c, d)",
