    "language": "python3",
    "code": "class Solution:\r\n    def findPermutationDifference(self, s: str, t: str) -> int:\r\n        d = {c: i for i, c in enumerate(s)}\r\n        return sum(abs(d[c] - i) for i, c in enumerate(t))",
