    "problemName": "number-of-prefix-connected-groups",
    "language": "python3",
    "code": "class Solution:\r\n    def prefixConnected(self, words: List[str], k: int) -> int:\r\n        cnt = Counter()\r\n        for w in words:\r\n            if len(w) >= k:\r\n                cnt[w[:k]] += 1\r\n        return sum(v > 1 for v in cnt.values())",
