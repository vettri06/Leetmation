    "code": "class Solution:\r\n    def xorAllNums(self, nums1: List[int], nums2: List[int]) -> int:\r\n        ans = 0\r\n        if len(nums2) & 1:\r\n            for v in nums1:\r\n                ans ^= v\r\n        if len(nums1) & 1:\r\n            for v in nums2:\r\n                ans ^= v\r\n        return ans",
