    "problemName": "k-inverse-pairs-array",
    "language": "python3",
    "code": "class Solution:\r\n    def kInversePairs(self, n: int, k: int) -> int:\r\n        mod = 10**9 + 7\r\n        f = [1] + [0] * k\r\n        s = [0] * (k + 2)\r\n        for i in range(1, n + 1):\r\n            for j in range(1, k + 1):\r\n                f[j] = (s[j + 1] - s[max(0, j - (i - 1))]) % mod\r\n            for j in range(1, k + 2):\r\n                s[j] = (s[j - 1] + f[j - 1]) % mod\r\n        return f[k]",
