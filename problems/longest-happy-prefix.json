    "problemName": "longest-happy-prefix",
    "language": "python3",
    "code": "class Solution:\r\n    def longestPrefix(self, s: str) -> str:\r\n        for i in range(1, len(s)):\r\n            if s[:-i] == s[i:]:\r\n                return s[i:]\r\n        return ''",
