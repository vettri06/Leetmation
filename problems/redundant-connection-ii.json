    "code": "class Solution:\r\n    def findRedundantDirectedConnection(self, edges: List[List[int]]) -> List[int]:\r\n        def find(x: int) -> int:\r\n            if p[x] != x:\r\n                p[x] = find(p[x])\r\n            return p[x]\r\n\r\n        n = len(edges)\r\n        ind = [0] * n\r\n        for _, v in edges:\r\n            ind[v - 1] += 1\r\n        dup = [i for i, (_, v) in enumerate(edges) if ind[v - 1] == 2]\r\n        p = list(range(n))\r\n        if dup:\r\n            for i, (u, v) in enumerate(edges):\r\n                if i == dup[1]:\r\n                    continue\r\n                pu, pv = find(u - 1), find(v - 1)\r\n                if pu == pv:\r\n                    return edges[dup[0]]\r\n                p[pu] = pv\r\n            return edges[dup[1]]\r\n        for i, (u, v) in enumerate(edges):\r\n            pu, pv = find(u - 1), find(v - 1)\r\n            if pu == pv:\r\n                return edges[i]\r\n            p[pu] = pv",
