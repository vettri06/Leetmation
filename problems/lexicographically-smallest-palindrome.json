{
    "problemName": "lexicographically-smallest-palindrome",
    "language": "python3",
    "code": "class Solution:\r\n    def makeSmallestPalindrome(self, s: str) -> str:\r\n        cs = list(s)\r\n        i, j = 0, len(s) - 1\r\n        while i < j:\r\n            cs[i] = cs[j] = min(cs[i], cs[j])\r\n            i, j = i + 1, j - 1\r\n        return \"\".join(cs)",
