{
    "problemName": "replace-non-coprime-numbers-in-array",
    "language": "python3",
    "code": "class Solution:\r\n    def replaceNonCoprimes(self, nums: List[int]) -> List[int]:\r\n        stk = []\r\n        for x in nums:\r\n            stk.append(x)\r\n            while len(stk) > 1:\r\n                x, y = stk[-2:]\r\n                g = gcd(x, y)\r\n                if g == 1:\r\n                    break\r\n                stk.pop()\r\n                stk[-1] = x * y // g\r\n        return stk",
