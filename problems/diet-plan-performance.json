{
    "problemName": "diet-plan-performance",
    "language": "python3",
    "code": "class Solution:\r\n    def dietPlanPerformance(\r\n        self, calories: List[int], k: int, lower: int, upper: int\r\n    ) -> int:\r\n        s = list(accumulate(calories, initial=0))\r\n        ans, n = 0, len(calories)\r\n        for i in range(n - k + 1):\r\n            t = s[i + k] - s[i]\r\n            if t < lower:\r\n                ans -= 1\r\n            elif t > upper:\r\n                ans += 1\r\n        return ans",
