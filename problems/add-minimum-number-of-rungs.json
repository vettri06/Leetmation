    "language": "python3",
    "code": "class Solution:\r\n    def addRungs(self, rungs: List[int], dist: int) -> int:\r\n        rungs = [0] + rungs\r\n        return sum((b - a - 1) // dist for a, b in pairwise(rungs))",
