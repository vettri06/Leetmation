    "problemName": "circle-and-rectangle-overlapping",
    "language": "python3",
    "code": "class Solution:\r\n    def checkOverlap(\r\n        self,\r\n        radius: int,\r\n        xCenter: int,\r\n        yCenter: int,\r\n        x1: int,\r\n        y1: int,\r\n        x2: int,\r\n        y2: int,\r\n    ) -> bool:\r\n        def f(i: int, j: int, k: int) -> int:\r\n            if i <= k <= j:\r\n                return 0\r\n            return i - k if k < i else k - j\r\n\r\n        a = f(x1, x2, xCenter)\r\n        b = f(y1, y2, yCenter)\r\n        return a * a + b * b <= radius * radius",
