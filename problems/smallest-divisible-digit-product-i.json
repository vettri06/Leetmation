{
    "problemName": "smallest-divisible-digit-product-i",
    "language": "python3",
    "code": "class Solution:\r\n    def smallestNumber(self, n: int, t: int) -> int:\r\n        for i in count(n):\r\n            p = 1\r\n            x = i\r\n            while x:\r\n                p *= x % 10\r\n                x //= 10\r\n            if p % t == 0:\r\n                return i",
