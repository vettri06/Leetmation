{
    "problemName": "delete-columns-to-make-sorted-iii",
    "language": "python3",
    "code": "class Solution:\r\n    def minDeletionSize(self, strs: List[str]) -> int:\r\n        n = len(strs[0])\r\n        f = [1] * n\r\n        for i in range(n):\r\n            for j in range(i):\r\n                if all(s[j] <= s[i] for s in strs):\r\n                    f[i] = max(f[i], f[j] + 1)\r\n        return n - max(f)",
