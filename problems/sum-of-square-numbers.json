{
    "problemName": "sum-of-square-numbers",
    "language": "python3",
    "code": "class Solution:\r\n    def judgeSquareSum(self, c: int) -> bool:\r\n        a, b = 0, int(sqrt(c))\r\n        while a <= b:\r\n            s = a**2 + b**2\r\n            if s == c:\r\n                return True\r\n            if s < c:\r\n                a += 1\r\n            else:\r\n                b -= 1\r\n        return False",
