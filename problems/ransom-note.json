    "problemName": "ransom-note",
    "language": "python3",
    "code": "class Solution:\r\n    def canConstruct(self, ransomNote: str, magazine: str) -> bool:\r\n        cnt = Counter(magazine)\r\n        for c in ransomNote:\r\n            cnt[c] -= 1\r\n            if cnt[c] < 0:\r\n                return False\r\n        return True",
