    "problemName": "faulty-sensor",
    "language": "python3",
    "code": "class Solution:\r\n    def badSensor(self, sensor1: List[int], sensor2: List[int]) -> int:\r\n        i, n = 0, len(sensor1)\r\n        while i < n - 1:\r\n            if sensor1[i] != sensor2[i]:\r\n                break\r\n            i += 1\r\n        while i < n - 1:\r\n            if sensor1[i + 1] != sensor2[i]:\r\n                return 1\r\n            if sensor1[i] != sensor2[i + 1]:\r\n                return 2\r\n            i += 1\r\n        return -1",
