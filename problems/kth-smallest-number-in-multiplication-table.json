{
    "problemName": "kth-smallest-number-in-multiplication-table",
    "language": "python3",
    "code": "class Solution:\r\n    def findKthNumber(self, m: int, n: int, k: int) -> int:\r\n        left, right = 1, m * n\r\n        while left < right:\r\n            mid = (left + right) >> 1\r\n            cnt = 0\r\n            for i in range(1, m + 1):\r\n                cnt += min(mid // i, n)\r\n            if cnt >= k:\r\n                right = mid\r\n            else:\r\n                left = mid + 1\r\n        return left",
