{
    "problemName": "maximum-array-hopping-score-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def maxScore(self, nums: List[int]) -> int:\r\n        stk = []\r\n        for i, x in enumerate(nums):\r\n            while stk and nums[stk[-1]] <= x:\r\n                stk.pop()\r\n            stk.append(i)\r\n        ans = i = 0\r\n        for j in stk:\r\n            ans += nums[j] * (j - i)\r\n            i = j\r\n        return ans",
