    "problemName": "library-late-fee-calculator",
    "language": "python3",
    "code": "class Solution:\r\n    def lateFee(self, daysLate: List[int]) -> int:\r\n        def f(x: int) -> int:\r\n            if x == 1:\r\n                return 1\r\n            if x > 5:\r\n                return 3 * x\r\n            return 2 * x\r\n\r\n        return sum(f(x) for x in daysLate)",
