{
    "problemName": "number-of-ways-to-select-buildings",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfWays(self, s: str) -> int:\r\n        l = [0, 0]\r\n        r = [s.count(\"0\"), s.count(\"1\")]\r\n        ans = 0\r\n        for x in map(int, s):\r\n            r[x] -= 1\r\n            ans += l[x ^ 1] * r[x ^ 1]\r\n            l[x] += 1\r\n        return ans",
