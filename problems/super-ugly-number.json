{
    "problemName": "super-ugly-number",
    "language": "python3",
    "code": "class Solution:\r\n    def nthSuperUglyNumber(self, n: int, primes: List[int]) -> int:\r\n        q = [1]\r\n        x = 0\r\n        mx = (1 << 31) - 1\r\n        for _ in range(n):\r\n            x = heappop(q)\r\n            for k in primes:\r\n                if x <= mx // k:\r\n                    heappush(q, k * x)\r\n                if x % k == 0:\r\n                    break\r\n        return x",
