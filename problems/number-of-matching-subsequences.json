{
    "problemName": "number-of-matching-subsequences",
    "language": "python3",
    "code": "class Solution:\r\n    def numMatchingSubseq(self, s: str, words: List[str]) -> int:\r\n        d = defaultdict(deque)\r\n        for w in words:\r\n            d[w[0]].append(w)\r\n        ans = 0\r\n        for c in s:\r\n            for _ in range(len(d[c])):\r\n                t = d[c].popleft()\r\n                if len(t) == 1:\r\n                    ans += 1\r\n                else:\r\n                    d[t[1]].append(t[1:])\r\n        return ans",
