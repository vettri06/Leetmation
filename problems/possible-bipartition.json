    "code": "class Solution:\r\n    def possibleBipartition(self, n: int, dislikes: List[List[int]]) -> bool:\r\n        def dfs(i, c):\r\n            color[i] = c\r\n            for j in g[i]:\r\n                if color[j] == c:\r\n                    return False\r\n                if color[j] == 0 and not dfs(j, 3 - c):\r\n                    return False\r\n            return True\r\n\r\n        g = defaultdict(list)\r\n        color = [0] * n\r\n        for a, b in dislikes:\r\n            a, b = a - 1, b - 1\r\n            g[a].append(b)\r\n            g[b].append(a)\r\n        return all(c or dfs(i, 1) for i, c in enumerate(color))",
