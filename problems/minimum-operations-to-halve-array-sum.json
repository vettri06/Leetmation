{
    "problemName": "minimum-operations-to-halve-array-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def halveArray(self, nums: List[int]) -> int:\r\n        s = sum(nums) / 2\r\n        pq = []\r\n        for x in nums:\r\n            heappush(pq, -x)\r\n        ans = 0\r\n        while s > 0:\r\n            t = -heappop(pq) / 2\r\n            s -= t\r\n            heappush(pq, -t)\r\n            ans += 1\r\n        return ans",
