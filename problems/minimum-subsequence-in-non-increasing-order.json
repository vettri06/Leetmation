{
    "problemName": "minimum-subsequence-in-non-increasing-order",
    "language": "python3",
    "code": "class Solution:\r\n    def minSubsequence(self, nums: List[int]) -> List[int]:\r\n        ans = []\r\n        s, t = sum(nums), 0\r\n        for x in sorted(nums, reverse=True):\r\n            t += x\r\n            ans.append(x)\r\n            if t > s - t:\r\n                break\r\n        return ans",
