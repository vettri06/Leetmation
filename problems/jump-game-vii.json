    "problemName": "jump-game-vii",
    "language": "python3",
    "code": "class Solution:\r\n    def canReach(self, s: str, minJump: int, maxJump: int) -> bool:\r\n        n = len(s)\r\n        pre = [0] * (n + 1)\r\n        pre[1] = 1\r\n        f = [True] + [False] * (n - 1)\r\n        for i in range(1, n):\r\n            if s[i] == \"0\":\r\n                l, r = max(0, i - maxJump), i - minJump\r\n                f[i] = l <= r and pre[r + 1] - pre[l] > 0\r\n            pre[i + 1] = pre[i] + f[i]\r\n        return f[-1]",
