    "language": "python3",
    "code": "class Solution:\r\n    def findChampion(self, grid: List[List[int]]) -> int:\r\n        for i, row in enumerate(grid):\r\n            if all(x == 1 for j, x in enumerate(row) if i != j):\r\n                return i",
