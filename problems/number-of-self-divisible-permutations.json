{
    "problemName": "number-of-self-divisible-permutations",
    "language": "python3",
    "code": "class Solution:\r\n    def selfDivisiblePermutationCount(self, n: int) -> int:\r\n        @cache\r\n        def dfs(mask: int) -> int:\r\n            i = mask.bit_count() + 1\r\n            if i > n:\r\n                return 1\r\n            ans = 0\r\n            for j in range(1, n + 1):\r\n                if (mask >> j & 1) == 0 and gcd(i, j) == 1:\r\n                    ans += dfs(mask | 1 << j)\r\n            return ans\r\n\r\n        return dfs(0)",
