    "code": "class Solution:\r\n    def deleteTreeNodes(self, nodes: int, parent: List[int], value: List[int]) -> int:\r\n        def dfs(i):\r\n            s, m = value[i], 1\r\n            for j in g[i]:\r\n                t, n = dfs(j)\r\n                s += t\r\n                m += n\r\n            if s == 0:\r\n                m = 0\r\n            return (s, m)\r\n\r\n        g = defaultdict(list)\r\n        for i in range(1, nodes):\r\n            g[parent[i]].append(i)\r\n        return dfs(0)[1]",
