    "problemName": "ugly-number",
    "language": "python3",
    "code": "class Solution:\r\n    def isUgly(self, n: int) -> bool:\r\n        if n < 1:\r\n            return False\r\n        for x in [2, 3, 5]:\r\n            while n % x == 0:\r\n                n //= x\r\n        return n == 1",
