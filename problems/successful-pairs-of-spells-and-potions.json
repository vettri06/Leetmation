    "problemName": "successful-pairs-of-spells-and-potions",
    "language": "python3",
    "code": "class Solution:\r\n    def successfulPairs(\r\n        self, spells: List[int], potions: List[int], success: int\r\n    ) -> List[int]:\r\n        potions.sort()\r\n        m = len(potions)\r\n        return [m - bisect_left(potions, success / v) for v in spells]",
