{
    "problemName": "find-polygon-with-the-largest-perimeter",
    "language": "python3",
    "code": "class Solution:\r\n    def largestPerimeter(self, nums: List[int]) -> int:\r\n        nums.sort()\r\n        s = list(accumulate(nums, initial=0))\r\n        ans = -1\r\n        for k in range(3, len(nums) + 1):\r\n            if s[k - 1] > nums[k - 1]:\r\n                ans = max(ans, s[k])\r\n        return ans",
