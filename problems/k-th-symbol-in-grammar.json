{
    "problemName": "k-th-symbol-in-grammar",
    "language": "python3",
    "code": "class Solution:\r\n    def kthGrammar(self, n: int, k: int) -> int:\r\n        if n == 1:\r\n            return 0\r\n        if k <= (1 << (n - 2)):\r\n            return self.kthGrammar(n - 1, k)\r\n        return self.kthGrammar(n - 1, k - (1 << (n - 2))) ^ 1",
