    "problemName": "toss-strange-coins",
    "language": "python3",
    "code": "class Solution:\r\n    def probabilityOfHeads(self, prob: List[float], target: int) -> float:\r\n        n = len(prob)\r\n        f = [[0] * (target + 1) for _ in range(n + 1)]\r\n        f[0][0] = 1\r\n        for i, p in enumerate(prob, 1):\r\n            for j in range(min(i, target) + 1):\r\n                f[i][j] = (1 - p) * f[i - 1][j]\r\n                if j:\r\n                    f[i][j] += p * f[i - 1][j - 1]\r\n        return f[n][target]",
