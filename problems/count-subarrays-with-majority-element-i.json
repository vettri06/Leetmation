{
    "problemName": "count-subarrays-with-majority-element-i",
    "language": "python3",
    "code": "class Solution:\r\n    def countMajoritySubarrays(self, nums: List[int], target: int) -> int:\r\n        n = len(nums)\r\n        ans = 0\r\n        for i in range(n):\r\n            cnt = Counter()\r\n            for j in range(i, n):\r\n                k = j - i + 1\r\n                cnt[nums[j]] += 1\r\n                if cnt[target] > k // 2:\r\n                    ans += 1\r\n        return ans",
