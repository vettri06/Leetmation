    "code": "class Solution:\r\n    def twoOutOfThree(\r\n        self, nums1: List[int], nums2: List[int], nums3: List[int]\r\n    ) -> List[int]:\r\n        s1, s2, s3 = set(nums1), set(nums2), set(nums3)\r\n        return [i for i in range(1, 101) if (i in s1) + (i in s2) + (i in s3) > 1]",
