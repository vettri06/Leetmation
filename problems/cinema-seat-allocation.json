    "problemName": "cinema-seat-allocation",
    "language": "python3",
    "code": "class Solution:\r\n    def maxNumberOfFamilies(self, n: int, reservedSeats: List[List[int]]) -> int:\r\n        d = defaultdict(int)\r\n        for i, j in reservedSeats:\r\n            d[i] |= 1 << (10 - j)\r\n        masks = (0b0111100000, 0b0000011110, 0b0001111000)\r\n        ans = (n - len(d)) * 2\r\n        for x in d.values():\r\n            for mask in masks:\r\n                if (x & mask) == 0:\r\n                    x |= mask\r\n                    ans += 1\r\n        return ans",
