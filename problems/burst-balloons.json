    "problemName": "burst-balloons",
    "language": "python3",
    "code": "class Solution:\r\n    def maxCoins(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        arr = [1] + nums + [1]\r\n        f = [[0] * (n + 2) for _ in range(n + 2)]\r\n        for i in range(n - 1, -1, -1):\r\n            for j in range(i + 2, n + 2):\r\n                for k in range(i + 1, j):\r\n                    f[i][j] = max(f[i][j], f[i][k] + f[k][j] + arr[i] * arr[k] * arr[j])\r\n        return f[0][-1]",
