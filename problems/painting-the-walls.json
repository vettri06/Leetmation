    "problemName": "painting-the-walls",
    "language": "python3",
    "code": "class Solution:\r\n    def paintWalls(self, cost: List[int], time: List[int]) -> int:\r\n        @cache\r\n        def dfs(i: int, j: int) -> int:\r\n            if n - i <= j:\r\n                return 0\r\n            if i >= n:\r\n                return inf\r\n            return min(dfs(i + 1, j + time[i]) + cost[i], dfs(i + 1, j - 1))\r\n\r\n        n = len(cost)\r\n        return dfs(0, 0)",
