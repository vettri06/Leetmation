    "problemName": "projection-area-of-3d-shapes",
    "language": "python3",
    "code": "class Solution:\r\n    def projectionArea(self, grid: List[List[int]]) -> int:\r\n        xy = sum(v > 0 for row in grid for v in row)\r\n        yz = sum(max(row) for row in grid)\r\n        zx = sum(max(col) for col in zip(*grid))\r\n        return xy + yz + zx",
