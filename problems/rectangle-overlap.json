    "code": "class Solution:\r\n    def isRectangleOverlap(self, rec1: List[int], rec2: List[int]) -> bool:\r\n        x1, y1, x2, y2 = rec1\r\n        x3, y3, x4, y4 = rec2\r\n        return not (y3 >= y2 or y4 <= y1 or x3 >= x2 or x4 <= x1)",
