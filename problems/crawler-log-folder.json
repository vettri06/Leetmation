    "code": "class Solution:\r\n    def minOperations(self, logs: List[str]) -> int:\r\n        ans = 0\r\n        for v in logs:\r\n            if v == \"../\":\r\n                ans = max(0, ans - 1)\r\n            elif v[0] != \".\":\r\n                ans += 1\r\n        return ans",
