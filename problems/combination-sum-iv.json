    "language": "python3",
    "code": "class Solution:\r\n    def combinationSum4(self, nums: List[int], target: int) -> int:\r\n        f = [1] + [0] * target\r\n        for i in range(1, target + 1):\r\n            for x in nums:\r\n                if i >= x:\r\n                    f[i] += f[i - x]\r\n        return f[target]",
