    "problemName": "minimum-string-length-after-removing-substrings",
    "language": "python3",
    "code": "class Solution:\r\n    def minLength(self, s: str) -> int:\r\n        stk = [\"\"]\r\n        for c in s:\r\n            if (c == \"B\" and stk[-1] == \"A\") or (c == \"D\" and stk[-1] == \"C\"):\r\n                stk.pop()\r\n            else:\r\n                stk.append(c)\r\n        return len(stk) - 1",
