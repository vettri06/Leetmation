{
    "problemName": "continuous-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def continuousSubarrays(self, nums: List[int]) -> int:\r\n        ans = i = 0\r\n        sl = SortedList()\r\n        for x in nums:\r\n            sl.add(x)\r\n            while sl[-1] - sl[0] > 2:\r\n                sl.remove(nums[i])\r\n                i += 1\r\n            ans += len(sl)\r\n        return ans",
