{
    "problemName": "meeting-rooms-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def minMeetingRooms(self, intervals: List[List[int]]) -> int:\r\n        m = max(e[1] for e in intervals)\r\n        d = [0] * (m + 1)\r\n        for l, r in intervals:\r\n            d[l] += 1\r\n            d[r] -= 1\r\n        ans = s = 0\r\n        for v in d:\r\n            s += v\r\n            ans = max(ans, s)\r\n        return ans",
