    "problemName": "peak-index-in-a-mountain-array",
    "language": "python3",
    "code": "class Solution:\r\n    def peakIndexInMountainArray(self, arr: List[int]) -> int:\r\n        left, right = 1, len(arr) - 2\r\n        while left < right:\r\n            mid = (left + right) >> 1\r\n            if arr[mid] > arr[mid + 1]:\r\n                right = mid\r\n            else:\r\n                left = mid + 1\r\n        return left",
