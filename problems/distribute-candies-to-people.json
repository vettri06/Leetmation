{
    "problemName": "distribute-candies-to-people",
    "language": "python3",
    "code": "class Solution:\r\n    def distributeCandies(self, candies: int, num_people: int) -> List[int]:\r\n        ans = [0] * num_people\r\n        i = 0\r\n        while candies:\r\n            ans[i % num_people] += min(candies, i + 1)\r\n            candies -= min(candies, i + 1)\r\n            i += 1\r\n        return ans",
