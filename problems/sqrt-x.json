{
    "problemName": "sqrt-x",
    "language": "python3",
    "code": "class Solution:\r\n    def mySqrt(self, x: int) -> int:\r\n        l, r = 0, x\r\n        while l < r:\r\n            mid = (l + r + 1) >> 1\r\n            if mid > x // mid:\r\n                r = mid - 1\r\n            else:\r\n                l = mid\r\n        return l",
