    "problemName": "majority-element",
    "language": "python3",
    "code": "class Solution:\r\n    def majorityElement(self, nums: List[int]) -> int:\r\n        cnt = m = 0\r\n        for x in nums:\r\n            if cnt == 0:\r\n                m, cnt = x, 1\r\n            else:\r\n                cnt += 1 if m == x else -1\r\n        return m",
