    "problemName": "minimum-positive-sum-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumSumSubarray(self, nums: List[int], l: int, r: int) -> int:\r\n        n = len(nums)\r\n        ans = inf\r\n        for i in range(n):\r\n            s = 0\r\n            for j in range(i, n):\r\n                s += nums[j]\r\n                if l <= j - i + 1 <= r and s > 0:\r\n                    ans = min(ans, s)\r\n        return -1 if ans == inf else ans",
