{
    "problemName": "greatest-sum-divisible-by-three",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSumDivThree(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        f = [[-inf] * 3 for _ in range(n + 1)]\r\n        f[0][0] = 0\r\n        for i, x in enumerate(nums, 1):\r\n            for j in range(3):\r\n                f[i][j] = max(f[i - 1][j], f[i - 1][(j - x) % 3] + x)\r\n        return f[n][0]",
