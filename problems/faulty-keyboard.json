    "code": "class Solution:\r\n    def finalString(self, s: str) -> str:\r\n        t = []\r\n        for c in s:\r\n            if c == \"i\":\r\n                t = t[::-1]\r\n            else:\r\n                t.append(c)\r\n        return \"\".join(t)",
