{
    "problemName": "valid-mountain-array",
    "language": "python3",
    "code": "class Solution:\r\n    def validMountainArray(self, arr: List[int]) -> bool:\r\n        n = len(arr)\r\n        if n < 3:\r\n            return False\r\n        i, j = 0, n - 1\r\n        while i + 1 < n - 1 and arr[i] < arr[i + 1]:\r\n            i += 1\r\n        while j - 1 > 0 and arr[j - 1] > arr[j]:\r\n            j -= 1\r\n        return i == j",
