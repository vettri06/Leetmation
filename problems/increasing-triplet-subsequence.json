    "problemName": "increasing-triplet-subsequence",
    "language": "python3",
    "code": "class Solution:\r\n    def increasingTriplet(self, nums: List[int]) -> bool:\r\n        mi, mid = inf, inf\r\n        for num in nums:\r\n            if num > mid:\r\n                return True\r\n            if num <= mi:\r\n                mi = num\r\n            else:\r\n                mid = num\r\n        return False",
