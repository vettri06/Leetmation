{
    "problemName": "count-the-number-of-fair-pairs",
    "language": "python3",
    "code": "class Solution:\r\n    def countFairPairs(self, nums: List[int], lower: int, upper: int) -> int:\r\n        nums.sort()\r\n        ans = 0\r\n        for i, x in enumerate(nums):\r\n            j = bisect_left(nums, lower - x, lo=i + 1)\r\n            k = bisect_left(nums, upper - x + 1, lo=i + 1)\r\n            ans += k - j\r\n        return ans",
