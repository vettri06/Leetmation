{
    "problemName": "convert-a-number-to-hexadecimal",
    "language": "python3",
    "code": "class Solution:\r\n    def toHex(self, num: int) -> str:\r\n        if num == 0:\r\n            return '0'\r\n        chars = '0123456789abcdef'\r\n        s = []\r\n        for i in range(7, -1, -1):\r\n            x = (num >> (4 * i)) & 0xF\r\n            if s or x != 0:\r\n                s.append(chars[x])\r\n        return ''.join(s)",
