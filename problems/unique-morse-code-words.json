{
    "problemName": "unique-morse-code-words",
    "language": "python3",
    "code": "class Solution:\r\n    def uniqueMorseRepresentations(self, words: List[str]) -> int:\r\n        codes = [\r\n            \".-\",\r\n            \"-...\",\r\n            \"-.-.\",\r\n            \"-..\",\r\n            \".\",\r\n            \"..-.\",\r\n            \"--.\",\r\n            \"....\",\r\n            \"..\",\r\n            \".---\",\r\n            \"-.-\",\r\n            \".-..\",\r\n            \"--\",\r\n            \"-.\",\r\n            \"---\",\r\n            \".--.\",\r\n            \"--.-\",\r\n            \".-.\",\r\n            \"...\",\r\n            \"-\",\r\n            \"..-\",\r\n            \"...-\",\r\n            \".--\",\r\n            \"-..-\",\r\n            \"-.--\",\r\n            \"--..\",\r\n        ]\r\n        s = {''.join([codes[ord(c) - ord('a')] for c in word]) for word in words}\r\n        return len(s)",
