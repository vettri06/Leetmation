    "problemName": "check-balanced-string",
    "language": "python3",
    "code": "class Solution:\r\n    def isBalanced(self, num: str) -> bool:\r\n        f = [0, 0]\r\n        for i, x in enumerate(map(int, num)):\r\n            f[i & 1] += x\r\n        return f[0] == f[1]",
