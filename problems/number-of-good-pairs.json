    "code": "class Solution:\r\n    def numIdenticalPairs(self, nums: List[int]) -> int:\r\n        ans = 0\r\n        cnt = Counter()\r\n        for x in nums:\r\n            ans += cnt[x]\r\n            cnt[x] += 1\r\n        return ans",
