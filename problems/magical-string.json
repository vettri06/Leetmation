{
    "problemName": "magical-string",
    "language": "python3",
    "code": "class Solution:\r\n    def magicalString(self, n: int) -> int:\r\n        s = [1, 2, 2]\r\n        i = 2\r\n        while len(s) < n:\r\n            pre = s[-1]\r\n            cur = 3 - pre\r\n            s += [cur] * s[i]\r\n            i += 1\r\n        return s[:n].count(1)",
