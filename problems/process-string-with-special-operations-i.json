{
    "problemName": "process-string-with-special-operations-i",
    "language": "python3",
    "code": "class Solution:\r\n    def processStr(self, s: str) -> str:\r\n        result = []\r\n        for c in s:\r\n            if c.isalpha():\r\n                result.append(c)\r\n            elif c == \"*\" and result:\r\n                result.pop()\r\n            elif c == \"#\":\r\n                result.extend(result)\r\n            elif c == \"%\":\r\n                result.reverse()\r\n        return \"\".join(result)",
