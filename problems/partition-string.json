{
    "problemName": "partition-string",
    "language": "python3",
    "code": "class Solution:\r\n    def partitionString(self, s: str) -> List[str]:\r\n        vis = set()\r\n        ans = []\r\n        t = \"\"\r\n        for c in s:\r\n            t += c\r\n            if t not in vis:\r\n                vis.add(t)\r\n                ans.append(t)\r\n                t = \"\"\r\n        return ans",
