    "problemName": "house-robber",
    "language": "python3",
    "code": "class Solution:\r\n    def rob(self, nums: List[int]) -> int:\r\n        @cache\r\n        def dfs(i: int) -> int:\r\n            if i >= len(nums):\r\n                return 0\r\n            return max(nums[i] + dfs(i + 2), dfs(i + 1))\r\n\r\n        return dfs(0)",
