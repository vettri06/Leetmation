{
    "problemName": "count-vowels-permutation",
    "language": "python3",
    "code": "class Solution:\r\n    def countVowelPermutation(self, n: int) -> int:\r\n        f = [1] * 5\r\n        mod = 10**9 + 7\r\n        for _ in range(n - 1):\r\n            g = [0] * 5\r\n            g[0] = (f[1] + f[2] + f[4]) % mod\r\n            g[1] = (f[0] + f[2]) % mod\r\n            g[2] = (f[1] + f[3]) % mod\r\n            g[3] = f[2]\r\n            g[4] = (f[2] + f[3]) % mod\r\n            f = g\r\n        return sum(f) % mod",
