    "problemName": "number-of-provinces",
    "language": "python3",
    "code": "class Solution:\r\n    def findCircleNum(self, isConnected: List[List[int]]) -> int:\r\n        def dfs(i: int):\r\n            vis[i] = True\r\n            for j, x in enumerate(isConnected[i]):\r\n                if not vis[j] and x:\r\n                    dfs(j)\r\n\r\n        n = len(isConnected)\r\n        vis = [False] * n\r\n        ans = 0\r\n        for i in range(n):\r\n            if not vis[i]:\r\n                dfs(i)\r\n                ans += 1\r\n        return ans",
