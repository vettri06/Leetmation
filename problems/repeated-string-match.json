{
    "problemName": "repeated-string-match",
    "language": "python3",
    "code": "class Solution:\r\n    def repeatedStringMatch(self, a: str, b: str) -> int:\r\n        m, n = len(a), len(b)\r\n        ans = ceil(n / m)\r\n        t = [a] * ans\r\n        for _ in range(3):\r\n            if b in ''.join(t):\r\n                return ans\r\n            ans += 1\r\n            t.append(a)\r\n        return -1",
