{
    "problemName": "hash-divided-string",
    "language": "python3",
    "code": "class Solution:\r\n    def stringHash(self, s: str, k: int) -> str:\r\n        ans = []\r\n        for i in range(0, len(s), k):\r\n            t = 0\r\n            for j in range(i, i + k):\r\n                t += ord(s[j]) - ord(\"a\")\r\n            hashedChar = t % 26\r\n            ans.append(chr(ord(\"a\") + hashedChar))\r\n        return \"\".join(ans)",
