{
    "problemName": "find-the-derangement-of-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def findDerangement(self, n: int) -> int:\r\n        mod = 10**9 + 7\r\n        f = [1] + [0] * n\r\n        for i in range(2, n + 1):\r\n            f[i] = (i - 1) * (f[i - 1] + f[i - 2]) % mod\r\n        return f[n]",
