    "problemName": "distribute-elements-into-two-arrays-i",
    "language": "python3",
    "code": "class Solution:\r\n    def resultArray(self, nums: List[int]) -> List[int]:\r\n        arr1 = [nums[0]]\r\n        arr2 = [nums[1]]\r\n        for x in nums[2:]:\r\n            if arr1[-1] > arr2[-1]:\r\n                arr1.append(x)\r\n            else:\r\n                arr2.append(x)\r\n        return arr1 + arr2",
