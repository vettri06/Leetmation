    "problemName": "stone-game-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def stoneGameII(self, piles: List[int]) -> int:\r\n        @cache\r\n        def dfs(i, m):\r\n            if m * 2 >= n - i:\r\n                return s[n] - s[i]\r\n            return max(\r\n                s[n] - s[i] - dfs(i + x, max(m, x)) for x in range(1, m << 1 | 1)\r\n            )\r\n\r\n        n = len(piles)\r\n        s = list(accumulate(piles, initial=0))\r\n        return dfs(0, 1)",
