{
    "problemName": "bitwise-or-of-all-subsequence-sums",
    "language": "python3",
    "code": "class Solution:\r\n    def subsequenceSumOr(self, nums: List[int]) -> int:\r\n        cnt = [0] * 64\r\n        ans = 0\r\n        for v in nums:\r\n            for i in range(31):\r\n                if (v >> i) & 1:\r\n                    cnt[i] += 1\r\n        for i in range(63):\r\n            if cnt[i]:\r\n                ans |= 1 << i\r\n            cnt[i + 1] += cnt[i] // 2\r\n        return ans",
