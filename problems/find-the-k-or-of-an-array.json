{
    "problemName": "find-the-k-or-of-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def findKOr(self, nums: List[int], k: int) -> int:\r\n        ans = 0\r\n        for i in range(32):\r\n            cnt = sum(x >> i & 1 for x in nums)\r\n            if cnt >= k:\r\n                ans |= 1 << i\r\n        return ans",
