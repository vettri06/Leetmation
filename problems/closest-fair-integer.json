{
    "problemName": "closest-fair-integer",
    "language": "python3",
    "code": "class Solution:\r\n    def closestFair(self, n: int) -> int:\r\n        a = b = k = 0\r\n        t = n\r\n        while t:\r\n            if (t % 10) & 1:\r\n                a += 1\r\n            else:\r\n                b += 1\r\n            t //= 10\r\n            k += 1\r\n        if k & 1:\r\n            x = 10**k\r\n            y = int('1' * (k >> 1) or '0')\r\n            return x + y\r\n        if a == b:\r\n            return n\r\n        return self.closestFair(n + 1)",
    "problemId": 2417,
    "title": "Closest Fair Integer",
