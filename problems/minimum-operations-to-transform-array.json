{
    "problemName": "minimum-operations-to-transform-array",
    "language": "python3",
    "code": "class Solution:\r\n    def minOperations(self, nums1: List[int], nums2: List[int]) -> int:\r\n        ans = 1\r\n        ok = False\r\n        d = inf\r\n        for x, y in zip(nums1, nums2):\r\n            if x < y:\r\n                x, y = y, x\r\n            ans += x - y\r\n            d = min(d, abs(x - nums2[-1]), abs(y - nums2[-1]))\r\n            ok = ok or y <= nums2[-1] <= x\r\n        if not ok:\r\n            ans += d\r\n        return ans",
