{
    "problemName": "count-strictly-increasing-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def countSubarrays(self, nums: List[int]) -> int:\r\n        ans = cnt = 1\r\n        for x, y in pairwise(nums):\r\n            if x < y:\r\n                cnt += 1\r\n            else:\r\n                cnt = 1\r\n            ans += cnt\r\n        return ans",
