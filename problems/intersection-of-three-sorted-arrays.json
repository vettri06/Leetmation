    "code": "class Solution:\r\n    def arraysIntersection(\r\n        self, arr1: List[int], arr2: List[int], arr3: List[int]\r\n    ) -> List[int]:\r\n        cnt = Counter(arr1 + arr2 + arr3)\r\n        return [x for x in arr1 if cnt[x] == 3]",
