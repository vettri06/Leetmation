    "problemName": "jump-game-vi",
    "language": "python3",
    "code": "class Solution:\r\n    def maxResult(self, nums: List[int], k: int) -> int:\r\n        n = len(nums)\r\n        f = [0] * n\r\n        q = deque([0])\r\n        for i in range(n):\r\n            if i - q[0] > k:\r\n                q.popleft()\r\n            f[i] = nums[i] + f[q[0]]\r\n            while q and f[q[-1]] <= f[i]:\r\n                q.pop()\r\n            q.append(i)\r\n        return f[-1]",
