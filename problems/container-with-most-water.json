{
    "problemName": "container-with-most-water",
    "language": "python3",
    "code": "class Solution:\r\n    def maxArea(self, height: List[int]) -> int:\r\n        l, r = 0, len(height) - 1\r\n        ans = 0\r\n        while l < r:\r\n            t = min(height[l], height[r]) * (r - l)\r\n            ans = max(ans, t)\r\n            if height[l] < height[r]:\r\n                l += 1\r\n            else:\r\n                r -= 1\r\n        return ans",
