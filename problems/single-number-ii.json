{
    "problemName": "single-number-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def singleNumber(self, nums: List[int]) -> int:\r\n        ans = 0\r\n        for i in range(32):\r\n            cnt = sum(num >> i & 1 for num in nums)\r\n            if cnt % 3:\r\n                if i == 31:\r\n                    ans -= 1 << i\r\n                else:\r\n                    ans |= 1 << i\r\n        return ans",
