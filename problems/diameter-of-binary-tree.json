{
    "problemName": "diameter-of-binary-tree",
    "language": "python3",
    "code": "# Definition for a binary tree node.\r\n# class TreeNode:\r\n#     def __init__(self, val=0, left=None, right=None):\r\n#         self.val = val\r\n#         self.left = left\r\n#         self.right = right\r\nclass Solution:\r\n    def diameterOfBinaryTree(self, root: Optional[TreeNode]) -> int:\r\n        def dfs(root: Optional[TreeNode]) -> int:\r\n            if root is None:\r\n                return 0\r\n            l, r = dfs(root.left), dfs(root.right)\r\n            nonlocal ans\r\n            ans = max(ans, l + r)\r\n            return 1 + max(l, r)\r\n\r\n        ans = 0\r\n        dfs(root)\r\n        return ans",
