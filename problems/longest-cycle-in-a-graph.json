{
    "problemName": "longest-cycle-in-a-graph",
    "language": "python3",
    "code": "class Solution:\r\n    def longestCycle(self, edges: List[int]) -> int:\r\n        n = len(edges)\r\n        vis = [False] * n\r\n        ans = -1\r\n        for i in range(n):\r\n            if vis[i]:\r\n                continue\r\n            j = i\r\n            cycle = []\r\n            while j != -1 and not vis[j]:\r\n                vis[j] = True\r\n                cycle.append(j)\r\n                j = edges[j]\r\n            if j == -1:\r\n                continue\r\n            m = len(cycle)\r\n            k = next((k for k in range(m) if cycle[k] == j), inf)\r\n            ans = max(ans, m - k)\r\n        return ans",
