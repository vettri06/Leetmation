{
    "problemName": "number-of-music-playlists",
    "language": "python3",
    "code": "class Solution:\r\n    def numMusicPlaylists(self, n: int, goal: int, k: int) -> int:\r\n        mod = 10**9 + 7\r\n        f = [[0] * (n + 1) for _ in range(goal + 1)]\r\n        f[0][0] = 1\r\n        for i in range(1, goal + 1):\r\n            for j in range(1, n + 1):\r\n                f[i][j] = f[i - 1][j - 1] * (n - j + 1)\r\n                if j > k:\r\n                    f[i][j] += f[i - 1][j] * (j - k)\r\n                f[i][j] %= mod\r\n        return f[goal][n]",
