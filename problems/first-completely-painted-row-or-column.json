    "problemName": "first-completely-painted-row-or-column",
    "language": "python3",
    "code": "class Solution:\r\n    def firstCompleteIndex(self, arr: List[int], mat: List[List[int]]) -> int:\r\n        m, n = len(mat), len(mat[0])\r\n        idx = {}\r\n        for i in range(m):\r\n            for j in range(n):\r\n                idx[mat[i][j]] = (i, j)\r\n        row = [0] * m\r\n        col = [0] * n\r\n        for k in range(len(arr)):\r\n            i, j = idx[arr[k]]\r\n            row[i] += 1\r\n            col[j] += 1\r\n            if row[i] == n or col[j] == m:\r\n                return k",
