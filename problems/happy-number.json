{
    "problemName": "happy-number",
    "language": "python3",
    "code": "class Solution:\r\n    def isHappy(self, n: int) -> bool:\r\n        vis = set()\r\n        while n != 1 and n not in vis:\r\n            vis.add(n)\r\n            x = 0\r\n            while n:\r\n                n, v = divmod(n, 10)\r\n                x += v * v\r\n            n = x\r\n        return n == 1",
