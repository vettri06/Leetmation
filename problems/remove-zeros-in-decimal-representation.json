{
    "problemName": "remove-zeros-in-decimal-representation",
    "language": "python3",
    "code": "class Solution:\r\n    def removeZeros(self, n: int) -> int:\r\n        k = 1\r\n        ans = 0\r\n        while n:\r\n            x = n % 10\r\n            if x:\r\n                ans = k * x + ans\r\n                k *= 10\r\n            n //= 10\r\n        return ans",
