{
    "problemName": "sum-of-all-odd-length-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def sumOddLengthSubarrays(self, arr: List[int]) -> int:\r\n        n = len(arr)\r\n        f = [0] * n\r\n        g = [0] * n\r\n        ans = f[0] = arr[0]\r\n        for i in range(1, n):\r\n            f[i] = g[i - 1] + arr[i] * (i // 2 + 1)\r\n            g[i] = f[i - 1] + arr[i] * ((i + 1) // 2)\r\n            ans += f[i]\r\n        return ans",
