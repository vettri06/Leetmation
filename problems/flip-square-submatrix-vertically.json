{
    "problemName": "flip-square-submatrix-vertically",
    "language": "python3",
    "code": "class Solution:\r\n    def reverseSubmatrix(\r\n        self, grid: List[List[int]], x: int, y: int, k: int\r\n    ) -> List[List[int]]:\r\n        for i in range(x, x + k // 2):\r\n            i2 = x + k - 1 - (i - x)\r\n            for j in range(y, y + k):\r\n                grid[i][j], grid[i2][j] = grid[i2][j], grid[i][j]\r\n        return grid",
