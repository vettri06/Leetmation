{
    "problemName": "maximum-distance-in-arrays",
    "language": "python3",
    "code": "class Solution:\r\n    def maxDistance(self, arrays: List[List[int]]) -> int:\r\n        ans = 0\r\n        mi, mx = arrays[0][0], arrays[0][-1]\r\n        for arr in arrays[1:]:\r\n            a, b = abs(arr[0] - mx), abs(arr[-1] - mi)\r\n            ans = max(ans, a, b)\r\n            mi = min(mi, arr[0])\r\n            mx = max(mx, arr[-1])\r\n        return ans",
