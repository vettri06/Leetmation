{
    "problemName": "minimum-time-to-kill-all-monsters",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumTime(self, power: List[int]) -> int:\r\n        @cache\r\n        def dfs(mask: int) -> int:\r\n            if mask == 0:\r\n                return 0\r\n            ans = inf\r\n            gain = 1 + (n - mask.bit_count())\r\n            for i, x in enumerate(power):\r\n                if mask >> i & 1:\r\n                    ans = min(ans, dfs(mask ^ (1 << i)) + (x + gain - 1) // gain)\r\n            return ans\r\n\r\n        n = len(power)\r\n        return dfs((1 << n) - 1)",
    "problemId": 2403,
