    "code": "import pandas as pd\r\n\r\n\r\ndef find_products(products: pd.DataFrame) -> pd.DataFrame:\r\n    filtered = products[\r\n        products[\"name\"].str.contains(r\"(^|[^0-9])[0-9]{3}([^0-9]|$)\", regex=True)\r\n    ]\r\n    return filtered.sort_values(by=\"product_id\")",
