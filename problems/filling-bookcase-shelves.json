{
    "problemName": "filling-bookcase-shelves",
    "language": "python3",
    "code": "class Solution:\r\n    def minHeightShelves(self, books: List[List[int]], shelfWidth: int) -> int:\r\n        n = len(books)\r\n        f = [0] * (n + 1)\r\n        for i, (w, h) in enumerate(books, 1):\r\n            f[i] = f[i - 1] + h\r\n            for j in range(i - 1, 0, -1):\r\n                w += books[j - 1][0]\r\n                if w > shelfWidth:\r\n                    break\r\n                h = max(h, books[j - 1][1])\r\n                f[i] = min(f[i], f[j - 1] + h)\r\n        return f[n]",
