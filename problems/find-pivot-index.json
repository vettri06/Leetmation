{
    "problemName": "find-pivot-index",
    "language": "python3",
    "code": "class Solution:\r\n    def pivotIndex(self, nums: List[int]) -> int:\r\n        left, right = 0, sum(nums)\r\n        for i, x in enumerate(nums):\r\n            right -= x\r\n            if left == right:\r\n                return i\r\n            left += x\r\n        return -1",
