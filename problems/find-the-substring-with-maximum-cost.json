{
    "problemName": "find-the-substring-with-maximum-cost",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumCostSubstring(self, s: str, chars: str, vals: List[int]) -> int:\r\n        d = {c: v for c, v in zip(chars, vals)}\r\n        ans = tot = mi = 0\r\n        for c in s:\r\n            v = d.get(c, ord(c) - ord('a') + 1)\r\n            tot += v\r\n            ans = max(ans, tot - mi)\r\n            mi = min(mi, tot)\r\n        return ans",
