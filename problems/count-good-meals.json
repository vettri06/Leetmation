{
    "problemName": "count-good-meals",
    "language": "python3",
    "code": "class Solution:\r\n    def countPairs(self, deliciousness: List[int]) -> int:\r\n        mod = 10**9 + 7\r\n        mx = max(deliciousness) << 1\r\n        cnt = Counter()\r\n        ans = 0\r\n        for d in deliciousness:\r\n            s = 1\r\n            while s <= mx:\r\n                ans = (ans + cnt[s - d]) % mod\r\n                s <<= 1\r\n            cnt[d] += 1\r\n        return ans",
