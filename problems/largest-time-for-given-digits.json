    "problemName": "largest-time-for-given-digits",
    "language": "python3",
    "code": "class Solution:\r\n    def largestTimeFromDigits(self, arr: List[int]) -> str:\r\n        cnt = [0] * 10\r\n        for v in arr:\r\n            cnt[v] += 1\r\n        for h in range(23, -1, -1):\r\n            for m in range(59, -1, -1):\r\n                t = [0] * 10\r\n                t[h // 10] += 1\r\n                t[h % 10] += 1\r\n                t[m // 10] += 1\r\n                t[m % 10] += 1\r\n                if cnt == t:\r\n                    return f'{h:02}:{m:02}'\r\n        return ''",
