    "code": "class Solution:\r\n    def maxNumberOfBalloons(self, text: str) -> int:\r\n        cnt = Counter(text)\r\n        cnt['o'] >>= 1\r\n        cnt['l'] >>= 1\r\n        return min(cnt[c] for c in 'balon')",
