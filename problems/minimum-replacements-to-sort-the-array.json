{
    "problemName": "minimum-replacements-to-sort-the-array",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumReplacement(self, nums: List[int]) -> int:\r\n        ans = 0\r\n        n = len(nums)\r\n        mx = nums[-1]\r\n        for i in range(n - 2, -1, -1):\r\n            if nums[i] <= mx:\r\n                mx = nums[i]\r\n                continue\r\n            k = (nums[i] + mx - 1) // mx\r\n            ans += k - 1\r\n            mx = nums[i] // k\r\n        return ans",
