    "problemName": "race-car",
    "language": "python3",
    "code": "class Solution:\r\n    def racecar(self, target: int) -> int:\r\n        dp = [0] * (target + 1)\r\n        for i in range(1, target + 1):\r\n            k = i.bit_length()\r\n            if i == 2**k - 1:\r\n                dp[i] = k\r\n                continue\r\n            dp[i] = dp[2**k - 1 - i] + k + 1\r\n            for j in range(k - 1):\r\n                dp[i] = min(dp[i], dp[i - (2 ** (k - 1) - 2**j)] + k - 1 + j + 2)\r\n        return dp[target]",
