{
    "problemName": "swapping-nodes-in-a-linked-list",
    "language": "python3",
    "code": "# Definition for singly-linked list.\r\n# class ListNode:\r\n#     def __init__(self, val=0, next=None):\r\n#         self.val = val\r\n#         self.next = next\r\nclass Solution:\r\n    def swapNodes(self, head: Optional[ListNode], k: int) -> Optional[ListNode]:\r\n        fast = slow = head\r\n        for _ in range(k - 1):\r\n            fast = fast.next\r\n        p = fast\r\n        while fast.next:\r\n            fast, slow = fast.next, slow.next\r\n        q = slow\r\n        p.val, q.val = q.val, p.val\r\n        return head",
