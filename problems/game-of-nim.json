{
    "problemName": "game-of-nim",
    "language": "python3",
    "code": "class Solution:\r\n    def nimGame(self, piles: List[int]) -> bool:\r\n        @cache\r\n        def dfs(st):\r\n            lst = list(st)\r\n            for i, x in enumerate(lst):\r\n                for j in range(1, x + 1):\r\n                    lst[i] -= j\r\n                    if not dfs(tuple(lst)):\r\n                        return True\r\n                    lst[i] += j\r\n            return False\r\n\r\n        return dfs(tuple(piles))",
