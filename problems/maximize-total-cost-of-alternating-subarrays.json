{
    "problemName": "maximize-total-cost-of-alternating-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumTotalCost(self, nums: List[int]) -> int:\r\n        @cache\r\n        def dfs(i: int, j: int) -> int:\r\n            if i >= len(nums):\r\n                return 0\r\n            ans = nums[i] + dfs(i + 1, 1)\r\n            if j == 1:\r\n                ans = max(ans, -nums[i] + dfs(i + 1, 0))\r\n            return ans\r\n\r\n        return dfs(0, 0)",
