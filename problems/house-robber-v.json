{
    "problemName": "house-robber-v",
    "language": "python3",
    "code": "class Solution:\r\n    def rob(self, nums: List[int], colors: List[int]) -> int:\r\n        n = len(nums)\r\n        f, g = 0, nums[0]\r\n        for i in range(1, n):\r\n            if colors[i - 1] == colors[i]:\r\n                f, g = max(f, g), f + nums[i]\r\n            else:\r\n                f, g = max(f, g), max(f, g) + nums[i]\r\n        return max(f, g)",
