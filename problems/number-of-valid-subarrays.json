{
    "problemName": "number-of-valid-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def validSubarrays(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        right = [n] * n\r\n        stk = []\r\n        for i in range(n - 1, -1, -1):\r\n            while stk and nums[stk[-1]] >= nums[i]:\r\n                stk.pop()\r\n            if stk:\r\n                right[i] = stk[-1]\r\n            stk.append(i)\r\n        return sum(j - i for i, j in enumerate(right))",
