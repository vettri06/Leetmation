    "code": "class Solution:\r\n    def isCircularSentence(self, sentence: str) -> bool:\r\n        ss = sentence.split()\r\n        n = len(ss)\r\n        return all(s[-1] == ss[(i + 1) % n][0] for i, s in enumerate(ss))",
