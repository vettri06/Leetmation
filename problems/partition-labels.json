    "problemName": "partition-labels",
    "language": "python3",
    "code": "class Solution:\r\n    def partitionLabels(self, s: str) -> List[int]:\r\n        last = {c: i for i, c in enumerate(s)}\r\n        mx = j = 0\r\n        ans = []\r\n        for i, c in enumerate(s):\r\n            mx = max(mx, last[c])\r\n            if mx == i:\r\n                ans.append(i - j + 1)\r\n                j = i + 1\r\n        return ans",
