    "problemName": "decode-xored-permutation",
    "language": "python3",
    "code": "class Solution:\r\n    def decode(self, encoded: List[int]) -> List[int]:\r\n        n = len(encoded) + 1\r\n        a = b = 0\r\n        for i in range(0, n - 1, 2):\r\n            a ^= encoded[i]\r\n        for i in range(1, n + 1):\r\n            b ^= i\r\n        perm = [0] * n\r\n        perm[-1] = a ^ b\r\n        for i in range(n - 2, -1, -1):\r\n            perm[i] = encoded[i] ^ perm[i + 1]\r\n        return perm",
