    "problemName": "valid-parentheses",
    "language": "python3",
    "code": "class Solution:\r\n    def isValid(self, s: str) -> bool:\r\n        stk = []\r\n        d = {'()', '[]', '{}'}\r\n        for c in s:\r\n            if c in '({[':\r\n                stk.append(c)\r\n            elif not stk or stk.pop() + c not in d:\r\n                return False\r\n        return not stk",
