{
    "problemName": "apply-discount-to-prices",
    "language": "python3",
    "code": "class Solution:\r\n    def discountPrices(self, sentence: str, discount: int) -> str:\r\n        ans = []\r\n        for w in sentence.split():\r\n            if w[0] == '$' and w[1:].isdigit():\r\n                w = f'${int(w[1:]) * (1 - discount / 100):.2f}'\r\n            ans.append(w)\r\n        return ' '.join(ans)",
