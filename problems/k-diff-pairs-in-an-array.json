{
    "problemName": "k-diff-pairs-in-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def findPairs(self, nums: List[int], k: int) -> int:\r\n        ans = set()\r\n        vis = set()\r\n        for x in nums:\r\n            if x - k in vis:\r\n                ans.add(x - k)\r\n            if x + k in vis:\r\n                ans.add(x)\r\n            vis.add(x)\r\n        return len(ans)",
