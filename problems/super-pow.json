    "language": "python3",
    "code": "class Solution:\r\n    def superPow(self, a: int, b: List[int]) -> int:\r\n        mod = 1337\r\n        ans = 1\r\n        for e in b[::-1]:\r\n            ans = ans * pow(a, e, mod) % mod\r\n            a = pow(a, 10, mod)\r\n        return ans",
