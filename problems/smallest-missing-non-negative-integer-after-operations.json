    "language": "python3",
    "code": "class Solution:\r\n    def findSmallestInteger(self, nums: List[int], value: int) -> int:\r\n        cnt = Counter(x % value for x in nums)\r\n        for i in range(len(nums) + 1):\r\n            if cnt[i % value] == 0:\r\n                return i\r\n            cnt[i % value] -= 1",
