    "problemName": "minimum-time-to-build-blocks",
    "language": "python3",
    "code": "class Solution:\r\n    def minBuildTime(self, blocks: List[int], split: int) -> int:\r\n        heapify(blocks)\r\n        while len(blocks) > 1:\r\n            heappop(blocks)\r\n            heappush(blocks, heappop(blocks) + split)\r\n        return blocks[0]",
