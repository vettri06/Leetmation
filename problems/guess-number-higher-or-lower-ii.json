{
    "problemName": "guess-number-higher-or-lower-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def getMoneyAmount(self, n: int) -> int:\r\n        f = [[0] * (n + 1) for _ in range(n + 1)]\r\n        for i in range(n - 1, 0, -1):\r\n            for j in range(i + 1, n + 1):\r\n                f[i][j] = j + f[i][j - 1]\r\n                for k in range(i, j):\r\n                    f[i][j] = min(f[i][j], max(f[i][k - 1], f[k + 1][j]) + k)\r\n        return f[1][n]",
