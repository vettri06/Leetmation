    "problemName": "destroying-asteroids",
    "language": "python3",
    "code": "class Solution:\r\n    def asteroidsDestroyed(self, mass: int, asteroids: List[int]) -> bool:\r\n        asteroids.sort()\r\n        for x in asteroids:\r\n            if mass < x:\r\n                return False\r\n            mass += x\r\n        return True",
