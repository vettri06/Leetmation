{
    "problemName": "minimize-maximum-of-array",
    "language": "python3",
    "code": "class Solution:\r\n    def minimizeArrayValue(self, nums: List[int]) -> int:\r\n        def check(mx):\r\n            d = 0\r\n            for x in nums[:0:-1]:\r\n                d = max(0, d + x - mx)\r\n            return nums[0] + d <= mx\r\n\r\n        left, right = 0, max(nums)\r\n        while left < right:\r\n            mid = (left + right) >> 1\r\n            if check(mid):\r\n                right = mid\r\n            else:\r\n                left = mid + 1\r\n        return left",
