{
    "problemName": "maximum-score-after-splitting-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def maxScore(self, s: str) -> int:\r\n        l, r = 0, s.count(\"1\")\r\n        ans = 0\r\n        for x in s[:-1]:\r\n            l += int(x) ^ 1\r\n            r -= int(x)\r\n            ans = max(ans, l + r)\r\n        return ans",
