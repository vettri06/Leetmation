{
    "problemName": "number-of-sub-arrays-with-odd-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def numOfSubarrays(self, arr: List[int]) -> int:\r\n        mod = 10**9 + 7\r\n        cnt = [1, 0]\r\n        ans = s = 0\r\n        for x in arr:\r\n            s += x\r\n            ans = (ans + cnt[s & 1 ^ 1]) % mod\r\n            cnt[s & 1] += 1\r\n        return ans",
