    "code": "class Solution:\r\n    def permute(self, nums: List[int]) -> List[List[int]]:\r\n        def dfs(i: int):\r\n            if i >= n:\r\n                ans.append(t[:])\r\n                return\r\n            for j, x in enumerate(nums):\r\n                if not vis[j]:\r\n                    vis[j] = True\r\n                    t[i] = x\r\n                    dfs(i + 1)\r\n                    vis[j] = False\r\n\r\n        n = len(nums)\r\n        vis = [False] * n\r\n        t = [0] * n\r\n        ans = []\r\n        dfs(0)\r\n        return ans",
