{
    "problemName": "sum-of-good-numbers",
    "language": "python3",
    "code": "class Solution:\r\n    def sumOfGoodNumbers(self, nums: List[int], k: int) -> int:\r\n        ans = 0\r\n        for i, x in enumerate(nums):\r\n            if i >= k and x <= nums[i - k]:\r\n                continue\r\n            if i + k < len(nums) and x <= nums[i + k]:\r\n                continue\r\n            ans += x\r\n        return ans",
