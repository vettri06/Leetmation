{
    "problemName": "maximum-alternating-subsequence-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def maxAlternatingSum(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        f = [0] * (n + 1)\r\n        g = [0] * (n + 1)\r\n        for i, x in enumerate(nums, 1):\r\n            f[i] = max(g[i - 1] - x, f[i - 1])\r\n            g[i] = max(f[i - 1] + x, g[i - 1])\r\n        return max(f[n], g[n])",
