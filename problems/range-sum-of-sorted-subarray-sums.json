    "problemName": "range-sum-of-sorted-subarray-sums",
    "language": "python3",
    "code": "class Solution:\r\n    def rangeSum(self, nums: List[int], n: int, left: int, right: int) -> int:\r\n        arr = []\r\n        for i in range(n):\r\n            s = 0\r\n            for j in range(i, n):\r\n                s += nums[j]\r\n                arr.append(s)\r\n        arr.sort()\r\n        mod = 10**9 + 7\r\n        return sum(arr[left - 1 : right]) % mod",
