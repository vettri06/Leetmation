    "problemName": "two-best-non-overlapping-events",
    "language": "python3",
    "code": "class Solution:\r\n    def maxTwoEvents(self, events: List[List[int]]) -> int:\r\n        events.sort()\r\n        n = len(events)\r\n        f = [events[-1][2]] * n\r\n        for i in range(n - 2, -1, -1):\r\n            f[i] = max(f[i + 1], events[i][2])\r\n        ans = 0\r\n        for _, e, v in events:\r\n            idx = bisect_right(events, e, key=lambda x: x[0])\r\n            if idx < n:\r\n                v += f[idx]\r\n            ans = max(ans, v)\r\n        return ans",
