    "problemName": "first-matching-character-from-both-ends",
    "language": "python3",
    "code": "class Solution:\r\n    def firstMatchingIndex(self, s: str) -> int:\r\n        for i in range(len(s) // 2 + 1):\r\n            if s[i] == s[-i - 1]:\r\n                return i\r\n        return -1",
