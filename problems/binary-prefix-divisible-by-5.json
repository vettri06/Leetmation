    "code": "class Solution:\r\n    def prefixesDivBy5(self, nums: List[int]) -> List[bool]:\r\n        ans = []\r\n        x = 0\r\n        for v in nums:\r\n            x = (x << 1 | v) % 5\r\n            ans.append(x == 0)\r\n        return ans",
