{
    "problemName": "distinct-subsequences",
    "language": "python3",
    "code": "class Solution:\r\n    def numDistinct(self, s: str, t: str) -> int:\r\n        m, n = len(s), len(t)\r\n        f = [[0] * (n + 1) for _ in range(m + 1)]\r\n        for i in range(m + 1):\r\n            f[i][0] = 1\r\n        for i, a in enumerate(s, 1):\r\n            for j, b in enumerate(t, 1):\r\n                f[i][j] = f[i - 1][j]\r\n                if a == b:\r\n                    f[i][j] += f[i - 1][j - 1]\r\n        return f[m][n]",
