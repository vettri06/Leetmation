    "problemName": "maximum-gcd-sum-of-a-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def maxGcdSum(self, nums: List[int], k: int) -> int:\r\n        s = list(accumulate(nums, initial=0))\r\n        f = []\r\n        ans = 0\r\n        for i, v in enumerate(nums):\r\n            g = []\r\n            for j, x in f:\r\n                y = gcd(x, v)\r\n                if not g or g[-1][1] != y:\r\n                    g.append((j, y))\r\n            f = g\r\n            f.append((i, v))\r\n            for j, x in f:\r\n                if i - j + 1 >= k:\r\n                    ans = max(ans, (s[i + 1] - s[j]) * x)\r\n        return ans",
