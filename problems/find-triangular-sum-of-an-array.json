{
    "problemName": "find-triangular-sum-of-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def triangularSum(self, nums: List[int]) -> int:\r\n        for k in range(len(nums) - 1, 0, -1):\r\n            for i in range(k):\r\n                nums[i] = (nums[i] + nums[i + 1]) % 10\r\n        return nums[0]",
