    "problemName": "two-furthest-houses-with-different-colors",
    "language": "python3",
    "code": "class Solution:\r\n    def maxDistance(self, colors: List[int]) -> int:\r\n        n = len(colors)\r\n        if colors[0] != colors[-1]:\r\n            return n - 1\r\n        i, j = 1, n - 2\r\n        while colors[i] == colors[0]:\r\n            i += 1\r\n        while colors[j] == colors[0]:\r\n            j -= 1\r\n        return max(n - i - 1, j)",
