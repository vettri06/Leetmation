{
    "problemName": "maximum-transactions-without-negative-balance",
    "language": "python3",
    "code": "class Solution:\r\n    def maxTransactions(self, transactions: List[int]) -> int:\r\n        st = SortedList()\r\n        s = 0\r\n        ans = len(transactions)\r\n        for x in transactions:\r\n            s += x\r\n            st.add(x)\r\n            while s < 0:\r\n                y = st.pop(0)\r\n                s -= y\r\n                ans -= 1\r\n        return ans",
