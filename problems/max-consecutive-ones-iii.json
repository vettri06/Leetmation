{
    "problemName": "max-consecutive-ones-iii",
    "language": "python3",
    "code": "class Solution:\r\n    def longestOnes(self, nums: List[int], k: int) -> int:\r\n        l = cnt = 0\r\n        for x in nums:\r\n            cnt += x ^ 1\r\n            if cnt > k:\r\n                cnt -= nums[l] ^ 1\r\n                l += 1\r\n        return len(nums) - l",
