    "code": "class Solution:\r\n    def minProductSum(self, nums1: List[int], nums2: List[int]) -> int:\r\n        nums1.sort()\r\n        nums2.sort(reverse=True)\r\n        return sum(x * y for x, y in zip(nums1, nums2))",
