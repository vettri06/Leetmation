    "problemName": "nth-magical-number",
    "language": "python3",
    "code": "class Solution:\r\n    def nthMagicalNumber(self, n: int, a: int, b: int) -> int:\r\n        mod = 10**9 + 7\r\n        c = lcm(a, b)\r\n        r = (a + b) * n\r\n        return bisect_left(range(r), x=n, key=lambda x: x // a + x // b - x // c) % mod",
