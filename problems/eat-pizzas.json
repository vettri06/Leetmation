    "problemName": "eat-pizzas",
    "language": "python3",
    "code": "class Solution:\r\n    def maxWeight(self, pizzas: List[int]) -> int:\r\n        days = len(pizzas) // 4\r\n        pizzas.sort()\r\n        odd = (days + 1) // 2\r\n        even = days - odd\r\n        ans = sum(pizzas[-odd:])\r\n        i = len(pizzas) - odd - 2\r\n        for _ in range(even):\r\n            ans += pizzas[i]\r\n            i -= 2\r\n        return ans",
