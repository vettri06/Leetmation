    "code": "class Solution:\r\n    def maxScoreSightseeingPair(self, values: List[int]) -> int:\r\n        ans = mx = 0\r\n        for j, x in enumerate(values):\r\n            ans = max(ans, mx + x - j)\r\n            mx = max(mx, x + j)\r\n        return ans",
