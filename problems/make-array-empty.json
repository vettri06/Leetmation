    "problemName": "make-array-empty",
    "language": "python3",
    "code": "class Solution:\r\n    def countOperationsToEmptyArray(self, nums: List[int]) -> int:\r\n        pos = {x: i for i, x in enumerate(nums)}\r\n        nums.sort()\r\n        sl = SortedList()\r\n        ans = pos[nums[0]] + 1\r\n        n = len(nums)\r\n        for k, (a, b) in enumerate(pairwise(nums)):\r\n            i, j = pos[a], pos[b]\r\n            d = j - i - sl.bisect(j) + sl.bisect(i)\r\n            ans += d + (n - k) * int(i > j)\r\n            sl.add(i)\r\n        return ans",
