{
    "problemName": "k-th-nearest-obstacle-queries",
    "language": "python3",
    "code": "class Solution:\r\n    def resultsArray(self, queries: List[List[int]], k: int) -> List[int]:\r\n        ans = []\r\n        pq = []\r\n        for i, (x, y) in enumerate(queries):\r\n            heappush(pq, -(abs(x) + abs(y)))\r\n            if i >= k:\r\n                heappop(pq)\r\n            ans.append(-pq[0] if i >= k - 1 else -1)\r\n        return ans",
