    "code": "class Solution:\r\n    def clearStars(self, s: str) -> str:\r\n        g = defaultdict(list)\r\n        n = len(s)\r\n        rem = [False] * n\r\n        for i, c in enumerate(s):\r\n            if c == \"*\":\r\n                rem[i] = True\r\n                for a in ascii_lowercase:\r\n                    if g[a]:\r\n                        rem[g[a].pop()] = True\r\n                        break\r\n            else:\r\n                g[c].append(i)\r\n        return \"\".join(c for i, c in enumerate(s) if not rem[i])",
