    "problemName": "kth-distinct-string-in-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def kthDistinct(self, arr: List[str], k: int) -> str:\r\n        cnt = Counter(arr)\r\n        for s in arr:\r\n            if cnt[s] == 1:\r\n                k -= 1\r\n                if k == 0:\r\n                    return s\r\n        return \"\"",
