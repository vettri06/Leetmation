{
    "problemName": "reverse-linked-list",
    "language": "python3",
    "code": "# Definition for singly-linked list.\r\n# class ListNode:\r\n#     def __init__(self, val=0, next=None):\r\n#         self.val = val\r\n#         self.next = next\r\nclass Solution:\r\n    def reverseList(self, head: ListNode) -> ListNode:\r\n        dummy = ListNode()\r\n        curr = head\r\n        while curr:\r\n            next = curr.next\r\n            curr.next = dummy.next\r\n            dummy.next = curr\r\n            curr = next\r\n        return dummy.next",
