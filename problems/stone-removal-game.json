    "code": "class Solution:\r\n    def canAliceWin(self, n: int) -> bool:\r\n        x, k = 10, 0\r\n        while n >= x:\r\n            n -= x\r\n            x -= 1\r\n            k += 1\r\n        return k % 2 == 1",
