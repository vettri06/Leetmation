{
    "problemName": "search-insert-position",
    "language": "python3",
    "code": "class Solution:\r\n    def searchInsert(self, nums: List[int], target: int) -> int:\r\n        l, r = 0, len(nums)\r\n        while l < r:\r\n            mid = (l + r) >> 1\r\n            if nums[mid] >= target:\r\n                r = mid\r\n            else:\r\n                l = mid + 1\r\n        return l",
