    "problemName": "find-the-duplicate-number",
    "language": "python3",
    "code": "class Solution:\r\n    def findDuplicate(self, nums: List[int]) -> int:\r\n        def f(x: int) -> bool:\r\n            return sum(v <= x for v in nums) > x\r\n\r\n        return bisect_left(range(len(nums)), True, key=f)",
