    "problemName": "count-the-number-of-k-free-subsets",
    "language": "python3",
    "code": "class Solution:\r\n    def countTheNumOfKFreeSubsets(self, nums: List[int], k: int) -> int:\r\n        nums.sort()\r\n        g = defaultdict(list)\r\n        for x in nums:\r\n            g[x % k].append(x)\r\n        ans = 1\r\n        for arr in g.values():\r\n            m = len(arr)\r\n            f = [0] * (m + 1)\r\n            f[0] = 1\r\n            f[1] = 2\r\n            for i in range(2, m + 1):\r\n                if arr[i - 1] - arr[i - 2] == k:\r\n                    f[i] = f[i - 1] + f[i - 2]\r\n                else:\r\n                    f[i] = f[i - 1] * 2\r\n            ans *= f[m]\r\n        return ans",
