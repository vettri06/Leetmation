    "problemName": "remove-stones-to-minimize-the-total",
    "language": "python3",
    "code": "class Solution:\r\n    def minStoneSum(self, piles: List[int], k: int) -> int:\r\n        pq = [-x for x in piles]\r\n        heapify(pq)\r\n        for _ in range(k):\r\n            heapreplace(pq, pq[0] // 2)\r\n        return -sum(pq)",
