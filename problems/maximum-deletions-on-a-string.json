{
    "problemName": "maximum-deletions-on-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def deleteString(self, s: str) -> int:\r\n        @cache\r\n        def dfs(i: int) -> int:\r\n            if i == n:\r\n                return 0\r\n            ans = 1\r\n            for j in range(1, (n - i) // 2 + 1):\r\n                if s[i : i + j] == s[i + j : i + j + j]:\r\n                    ans = max(ans, 1 + dfs(i + j))\r\n            return ans\r\n\r\n        n = len(s)\r\n        return dfs(0)",
