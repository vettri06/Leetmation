{
    "problemName": "get-maximum-in-generated-array",
    "language": "python3",
    "code": "class Solution:\r\n    def getMaximumGenerated(self, n: int) -> int:\r\n        if n < 2:\r\n            return n\r\n        nums = [0] * (n + 1)\r\n        nums[1] = 1\r\n        for i in range(2, n + 1):\r\n            nums[i] = nums[i >> 1] if i % 2 == 0 else nums[i >> 1] + nums[(i >> 1) + 1]\r\n        return max(nums)",
