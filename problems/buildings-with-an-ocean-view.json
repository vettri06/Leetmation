    "language": "python3",
    "code": "class Solution:\r\n    def findBuildings(self, heights: List[int]) -> List[int]:\r\n        ans = []\r\n        mx = 0\r\n        for i in range(len(heights) - 1, -1, -1):\r\n            if heights[i] > mx:\r\n                ans.append(i)\r\n                mx = heights[i]\r\n        return ans[::-1]",
