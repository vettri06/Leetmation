    "language": "python3",
    "code": "class Solution:\r\n    def maxCount(self, m: int, n: int, ops: List[List[int]]) -> int:\r\n        for a, b in ops:\r\n            m = min(m, a)\r\n            n = min(n, b)\r\n        return m * n",
