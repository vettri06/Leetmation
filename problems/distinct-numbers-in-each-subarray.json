{
    "problemName": "distinct-numbers-in-each-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def distinctNumbers(self, nums: List[int], k: int) -> List[int]:\r\n        cnt = Counter(nums[:k])\r\n        ans = [len(cnt)]\r\n        for i in range(k, len(nums)):\r\n            cnt[nums[i]] += 1\r\n            cnt[nums[i - k]] -= 1\r\n            if cnt[nums[i - k]] == 0:\r\n                cnt.pop(nums[i - k])\r\n            ans.append(len(cnt))\r\n        return ans",
