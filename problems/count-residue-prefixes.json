    "problemName": "count-residue-prefixes",
    "language": "python3",
    "code": "class Solution:\r\n    def residuePrefixes(self, s: str) -> int:\r\n        st = set()\r\n        ans = 0\r\n        for i, c in enumerate(s, 1):\r\n            st.add(c)\r\n            if len(st) == i % 3:\r\n                ans += 1\r\n        return ans",
