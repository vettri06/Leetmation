{
    "problemName": "apply-operations-to-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def applyOperations(self, nums: List[int]) -> List[int]:\r\n        n = len(nums)\r\n        for i in range(n - 1):\r\n            if nums[i] == nums[i + 1]:\r\n                nums[i] <<= 1\r\n                nums[i + 1] = 0\r\n        ans = [0] * n\r\n        i = 0\r\n        for x in nums:\r\n            if x:\r\n                ans[i] = x\r\n                i += 1\r\n        return ans",
