    "problemName": "single-row-keyboard",
    "language": "python3",
    "code": "class Solution:\r\n    def calculateTime(self, keyboard: str, word: str) -> int:\r\n        pos = {c: i for i, c in enumerate(keyboard)}\r\n        ans = i = 0\r\n        for c in word:\r\n            ans += abs(pos[c] - i)\r\n            i = pos[c]\r\n        return ans",
