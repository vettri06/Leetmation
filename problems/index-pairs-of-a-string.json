    "problemName": "index-pairs-of-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def indexPairs(self, text: str, words: List[str]) -> List[List[int]]:\r\n        words = set(words)\r\n        n = len(text)\r\n        return [\r\n            [i, j] for i in range(n) for j in range(i, n) if text[i : j + 1] in words\r\n        ]",
