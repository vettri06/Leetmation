{
    "problemName": "reformat-date",
    "language": "python3",
    "code": "class Solution:\r\n    def reformatDate(self, date: str) -> str:\r\n        s = date.split()\r\n        s.reverse()\r\n        months = \" JanFebMarAprMayJunJulAugSepOctNovDec\"\r\n        s[1] = str(months.index(s[1]) // 3 + 1).zfill(2)\r\n        s[2] = s[2][:-2].zfill(2)\r\n        return \"-\".join(s)",
