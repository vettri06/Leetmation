    "code": "class Solution:\r\n    def isIdealPermutation(self, nums: List[int]) -> bool:\r\n        mx = 0\r\n        for i in range(2, len(nums)):\r\n            if (mx := max(mx, nums[i - 2])) > nums[i]:\r\n                return False\r\n        return True",
