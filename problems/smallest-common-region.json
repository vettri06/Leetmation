{
    "problemName": "smallest-common-region",
    "language": "python3",
    "code": "class Solution:\r\n    def findSmallestRegion(\r\n        self, regions: List[List[str]], region1: str, region2: str\r\n    ) -> str:\r\n        g = {}\r\n        for r in regions:\r\n            x = r[0]\r\n            for y in r[1:]:\r\n                g[y] = x\r\n        s = set()\r\n        x = region1\r\n        while x in g:\r\n            s.add(x)\r\n            x = g[x]\r\n        x = region2\r\n        while x in g and x not in s:\r\n            x = g[x]\r\n        return x",
