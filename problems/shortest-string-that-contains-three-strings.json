    "problemName": "shortest-string-that-contains-three-strings",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumString(self, a: str, b: str, c: str) -> str:\r\n        def f(s: str, t: str) -> str:\r\n            if s in t:\r\n                return t\r\n            if t in s:\r\n                return s\r\n            m, n = len(s), len(t)\r\n            for i in range(min(m, n), 0, -1):\r\n                if s[-i:] == t[:i]:\r\n                    return s + t[i:]\r\n            return s + t\r\n\r\n        ans = \"\"\r\n        for a, b, c in permutations((a, b, c)):\r\n            s = f(f(a, b), c)\r\n            if ans == \"\" or len(s) < len(ans) or (len(s) == len(ans) and s < ans):\r\n                ans = s\r\n        return ans",
