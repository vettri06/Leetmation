{
    "problemName": "next-greater-numerically-balanced-number",
    "language": "python3",
    "code": "class Solution:\r\n    def nextBeautifulNumber(self, n: int) -> int:\r\n        for x in count(n + 1):\r\n            y = x\r\n            cnt = [0] * 10\r\n            while y:\r\n                y, v = divmod(y, 10)\r\n                cnt[v] += 1\r\n            if all(v == 0 or i == v for i, v in enumerate(cnt)):\r\n                return x",
