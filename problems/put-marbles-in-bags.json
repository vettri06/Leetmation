    "code": "class Solution:\r\n    def putMarbles(self, weights: List[int], k: int) -> int:\r\n        arr = sorted(a + b for a, b in pairwise(weights))\r\n        return sum(arr[len(arr) - k + 1 :]) - sum(arr[: k - 1])",
