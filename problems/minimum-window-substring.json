{
    "problemName": "minimum-window-substring",
    "language": "python3",
    "code": "class Solution:\r\n    def minWindow(self, s: str, t: str) -> str:\r\n        need = Counter(t)\r\n        window = Counter()\r\n        cnt = l = 0\r\n        k, mi = -1, inf\r\n        for r, c in enumerate(s):\r\n            window[c] += 1\r\n            if need[c] >= window[c]:\r\n                cnt += 1\r\n            while cnt == len(t):\r\n                if r - l + 1 < mi:\r\n                    mi = r - l + 1\r\n                    k = l\r\n                if need[s[l]] >= window[s[l]]:\r\n                    cnt -= 1\r\n                window[s[l]] -= 1\r\n                l += 1\r\n        return \"\" if k < 0 else s[k : k + mi]",
