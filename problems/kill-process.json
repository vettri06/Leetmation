    "code": "class Solution:\r\n    def killProcess(self, pid: List[int], ppid: List[int], kill: int) -> List[int]:\r\n        def dfs(i: int):\r\n            ans.append(i)\r\n            for j in g[i]:\r\n                dfs(j)\r\n\r\n        g = defaultdict(list)\r\n        for i, p in zip(pid, ppid):\r\n            g[p].append(i)\r\n        ans = []\r\n        dfs(kill)\r\n        return ans",
