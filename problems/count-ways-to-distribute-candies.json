{
    "problemName": "count-ways-to-distribute-candies",
    "language": "python3",
    "code": "class Solution:\r\n    def waysToDistribute(self, n: int, k: int) -> int:\r\n        mod = 10**9 + 7\r\n        f = [[0] * (k + 1) for _ in range(n + 1)]\r\n        f[0][0] = 1\r\n        for i in range(1, n + 1):\r\n            for j in range(1, k + 1):\r\n                f[i][j] = (f[i - 1][j] * j + f[i - 1][j - 1]) % mod\r\n        return f[n][k]",
