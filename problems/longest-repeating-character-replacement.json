{
    "problemName": "longest-repeating-character-replacement",
    "language": "python3",
    "code": "class Solution:\r\n    def characterReplacement(self, s: str, k: int) -> int:\r\n        cnt = Counter()\r\n        l = mx = 0\r\n        for r, c in enumerate(s):\r\n            cnt[c] += 1\r\n            mx = max(mx, cnt[c])\r\n            if r - l + 1 - mx > k:\r\n                cnt[s[l]] -= 1\r\n                l += 1\r\n        return len(s) - l",
