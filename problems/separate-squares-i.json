    "problemName": "separate-squares-i",
    "language": "python3",
    "code": "class Solution:\r\n    def separateSquares(self, squares: List[List[int]]) -> float:\r\n        def check(y1: float) -> bool:\r\n            t = 0\r\n            for _, y, l in squares:\r\n                if y < y1:\r\n                    t += l * min(y1 - y, l)\r\n            return t >= s / 2\r\n\r\n        s = sum(a[2] * a[2] for a in squares)\r\n        l, r = 0, max(a[1] + a[2] for a in squares)\r\n        eps = 1e-5\r\n        while r - l > eps:\r\n            mid = (l + r) / 2\r\n            if check(mid):\r\n                r = mid\r\n            else:\r\n                l = mid\r\n        return r",
