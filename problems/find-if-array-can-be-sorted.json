{
    "problemName": "find-if-array-can-be-sorted",
    "language": "python3",
    "code": "class Solution:\r\n    def canSortArray(self, nums: List[int]) -> bool:\r\n        pre_mx = 0\r\n        i, n = 0, len(nums)\r\n        while i < n:\r\n            cnt = nums[i].bit_count()\r\n            j = i + 1\r\n            mi = mx = nums[i]\r\n            while j < n and nums[j].bit_count() == cnt:\r\n                mi = min(mi, nums[j])\r\n                mx = max(mx, nums[j])\r\n                j += 1\r\n            if pre_mx > mi:\r\n                return False\r\n            pre_mx = mx\r\n            i = j\r\n        return True",
