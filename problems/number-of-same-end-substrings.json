{
    "problemName": "number-of-same-end-substrings",
    "language": "python3",
    "code": "class Solution:\r\n    def sameEndSubstringCount(self, s: str, queries: List[List[int]]) -> List[int]:\r\n        n = len(s)\r\n        cs = set(s)\r\n        cnt = {c: [0] * (n + 1) for c in cs}\r\n        for i, a in enumerate(s, 1):\r\n            for c in cs:\r\n                cnt[c][i] = cnt[c][i - 1]\r\n            cnt[a][i] += 1\r\n        ans = []\r\n        for l, r in queries:\r\n            t = r - l + 1\r\n            for c in cs:\r\n                x = cnt[c][r + 1] - cnt[c][l]\r\n                t += x * (x - 1) // 2\r\n            ans.append(t)\r\n        return ans",
