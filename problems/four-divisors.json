    "problemName": "four-divisors",
    "language": "python3",
    "code": "class Solution:\r\n    def sumFourDivisors(self, nums: List[int]) -> int:\r\n        def f(x: int) -> int:\r\n            i = 2\r\n            cnt, s = 2, x + 1\r\n            while i <= x // i:\r\n                if x % i == 0:\r\n                    cnt += 1\r\n                    s += i\r\n                    if i * i != x:\r\n                        cnt += 1\r\n                        s += x // i\r\n                i += 1\r\n            return s if cnt == 4 else 0\r\n\r\n        return sum(f(x) for x in nums)",
