    "problemName": "palindrome-partitioning-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def minCut(self, s: str) -> int:\r\n        n = len(s)\r\n        g = [[True] * n for _ in range(n)]\r\n        for i in range(n - 1, -1, -1):\r\n            for j in range(i + 1, n):\r\n                g[i][j] = s[i] == s[j] and g[i + 1][j - 1]\r\n        f = list(range(n))\r\n        for i in range(1, n):\r\n            for j in range(i + 1):\r\n                if g[j][i]:\r\n                    f[i] = min(f[i], 1 + f[j - 1] if j else 0)\r\n        return f[-1]",
