    "problemName": "movement-of-robots",
    "language": "python3",
    "code": "class Solution:\r\n    def sumDistance(self, nums: List[int], s: str, d: int) -> int:\r\n        mod = 10**9 + 7\r\n        for i, c in enumerate(s):\r\n            nums[i] += d if c == \"R\" else -d\r\n        nums.sort()\r\n        ans = s = 0\r\n        for i, x in enumerate(nums):\r\n            ans += i * x - s\r\n            s += x\r\n        return ans % mod",
