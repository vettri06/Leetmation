{
    "problemName": "making-file-names-unique",
    "language": "python3",
    "code": "class Solution:\r\n    def getFolderNames(self, names: List[str]) -> List[str]:\r\n        d = defaultdict(int)\r\n        for i, name in enumerate(names):\r\n            if name in d:\r\n                k = d[name]\r\n                while f'{name}({k})' in d:\r\n                    k += 1\r\n                d[name] = k + 1\r\n                names[i] = f'{name}({k})'\r\n            d[names[i]] = 1\r\n        return names",
