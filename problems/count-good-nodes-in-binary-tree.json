{
    "problemName": "count-good-nodes-in-binary-tree",
    "language": "python3",
    "code": "# Definition for a binary tree node.\r\n# class TreeNode:\r\n#     def __init__(self, val=0, left=None, right=None):\r\n#         self.val = val\r\n#         self.left = left\r\n#         self.right = right\r\nclass Solution:\r\n    def goodNodes(self, root: TreeNode) -> int:\r\n        def dfs(root: TreeNode, mx: int):\r\n            if root is None:\r\n                return\r\n            nonlocal ans\r\n            if mx <= root.val:\r\n                ans += 1\r\n                mx = root.val\r\n            dfs(root.left, mx)\r\n            dfs(root.right, mx)\r\n\r\n        ans = 0\r\n        dfs(root, -1000000)\r\n        return ans",
