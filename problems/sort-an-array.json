    "problemName": "sort-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def sortArray(self, nums: List[int]) -> List[int]:\r\n        def quick_sort(l, r):\r\n            if l >= r:\r\n                return\r\n            x = nums[randint(l, r)]\r\n            i, j, k = l - 1, r + 1, l\r\n            while k < j:\r\n                if nums[k] < x:\r\n                    nums[i + 1], nums[k] = nums[k], nums[i + 1]\r\n                    i, k = i + 1, k + 1\r\n                elif nums[k] > x:\r\n                    j -= 1\r\n                    nums[j], nums[k] = nums[k], nums[j]\r\n                else:\r\n                    k = k + 1\r\n            quick_sort(l, i)\r\n            quick_sort(j, r)\r\n\r\n        quick_sort(0, len(nums) - 1)\r\n        return nums",
