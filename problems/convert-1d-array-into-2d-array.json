    "code": "class Solution:\r\n    def construct2DArray(self, original: List[int], m: int, n: int) -> List[List[int]]:\r\n        if m * n != len(original):\r\n            return []\r\n        return [original[i : i + n] for i in range(0, m * n, n)]",
