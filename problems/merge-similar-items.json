    "problemName": "merge-similar-items",
    "language": "python3",
    "code": "class Solution:\r\n    def mergeSimilarItems(\r\n        self, items1: List[List[int]], items2: List[List[int]]\r\n    ) -> List[List[int]]:\r\n        cnt = Counter()\r\n        for v, w in chain(items1, items2):\r\n            cnt[v] += w\r\n        return sorted(cnt.items())",
