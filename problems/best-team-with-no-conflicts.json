{
    "problemName": "best-team-with-no-conflicts",
    "language": "python3",
    "code": "class Solution:\r\n    def bestTeamScore(self, scores: List[int], ages: List[int]) -> int:\r\n        arr = sorted(zip(scores, ages))\r\n        n = len(arr)\r\n        f = [0] * n\r\n        for i, (score, age) in enumerate(arr):\r\n            for j in range(i):\r\n                if age >= arr[j][1]:\r\n                    f[i] = max(f[i], f[j])\r\n            f[i] += score\r\n        return max(f)",
