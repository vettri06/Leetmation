{
    "problemName": "sum-of-all-subset-xor-totals",
    "language": "python3",
    "code": "class Solution:\r\n    def subsetXORSum(self, nums: List[int]) -> int:\r\n        ans, n = 0, len(nums)\r\n        for i in range(1 << n):\r\n            s = 0\r\n            for j in range(n):\r\n                if i >> j & 1:\r\n                    s ^= nums[j]\r\n            ans += s\r\n        return ans",
