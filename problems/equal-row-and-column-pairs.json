    "problemName": "equal-row-and-column-pairs",
    "language": "python3",
    "code": "class Solution:\r\n    def equalPairs(self, grid: List[List[int]]) -> int:\r\n        n = len(grid)\r\n        ans = 0\r\n        for i in range(n):\r\n            for j in range(n):\r\n                ans += all(grid[i][k] == grid[k][j] for k in range(n))\r\n        return ans",
