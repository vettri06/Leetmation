{
    "problemName": "fixed-point",
    "language": "python3",
    "code": "class Solution:\r\n    def fixedPoint(self, arr: List[int]) -> int:\r\n        left, right = 0, len(arr) - 1\r\n        while left < right:\r\n            mid = (left + right) >> 1\r\n            if arr[mid] >= mid:\r\n                right = mid\r\n            else:\r\n                left = mid + 1\r\n        return left if arr[left] == left else -1",
