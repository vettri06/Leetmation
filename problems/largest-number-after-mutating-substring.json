{
    "problemName": "largest-number-after-mutating-substring",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumNumber(self, num: str, change: List[int]) -> str:\r\n        s = list(num)\r\n        changed = False\r\n        for i, c in enumerate(s):\r\n            d = str(change[int(c)])\r\n            if changed and d < c:\r\n                break\r\n            if d > c:\r\n                changed = True\r\n                s[i] = d\r\n        return \"\".join(s)",
