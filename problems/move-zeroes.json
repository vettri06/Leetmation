    "language": "python3",
    "code": "class Solution:\r\n    def moveZeroes(self, nums: List[int]) -> None:\r\n        k = 0\r\n        for i, x in enumerate(nums):\r\n            if x:\r\n                nums[k], nums[i] = nums[i], nums[k]\r\n                k += 1",
