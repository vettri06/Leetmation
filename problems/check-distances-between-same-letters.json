{
    "problemName": "check-distances-between-same-letters",
    "language": "python3",
    "code": "class Solution:\r\n    def checkDistances(self, s: str, distance: List[int]) -> bool:\r\n        d = defaultdict(int)\r\n        for i, c in enumerate(map(ord, s), 1):\r\n            j = c - ord(\"a\")\r\n            if d[j] and i - d[j] - 1 != distance[j]:\r\n                return False\r\n            d[j] = i\r\n        return True",
