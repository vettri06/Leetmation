{
    "problemName": "transform-array-by-parity",
    "language": "python3",
    "code": "class Solution:\r\n    def transformArray(self, nums: List[int]) -> List[int]:\r\n        even = sum(x % 2 == 0 for x in nums)\r\n        for i in range(even):\r\n            nums[i] = 0\r\n        for i in range(even, len(nums)):\r\n            nums[i] = 1\r\n        return nums",
