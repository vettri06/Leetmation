    "problemName": "next-greater-node-in-linked-list",
    "language": "python3",
    "code": "# Definition for singly-linked list.\r\n# class ListNode:\r\n#     def __init__(self, val=0, next=None):\r\n#         self.val = val\r\n#         self.next = next\r\nclass Solution:\r\n    def nextLargerNodes(self, head: Optional[ListNode]) -> List[int]:\r\n        nums = []\r\n        while head:\r\n            nums.append(head.val)\r\n            head = head.next\r\n        stk = []\r\n        n = len(nums)\r\n        ans = [0] * n\r\n        for i in range(n - 1, -1, -1):\r\n            while stk and stk[-1] <= nums[i]:\r\n                stk.pop()\r\n            if stk:\r\n                ans[i] = stk[-1]\r\n            stk.append(nums[i])\r\n        return ans",
