    "problemName": "maximum-hamming-distances",
    "language": "python3",
    "code": "class Solution:\r\n    def maxHammingDistances(self, nums: List[int], m: int) -> List[int]:\r\n        dist = [-1] * (1 << m)\r\n        for x in nums:\r\n            dist[x] = 0\r\n        q = nums\r\n        k = 1\r\n        while q:\r\n            t = []\r\n            for x in q:\r\n                for i in range(m):\r\n                    y = x ^ (1 << i)\r\n                    if dist[y] == -1:\r\n                        t.append(y)\r\n                        dist[y] = k\r\n            q = t\r\n            k += 1\r\n        return [m - dist[x ^ ((1 << m) - 1)] for x in nums]",
