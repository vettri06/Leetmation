{
    "problemName": "minimum-cost-to-cut-a-stick",
    "language": "python3",
    "code": "class Solution:\r\n    def minCost(self, n: int, cuts: List[int]) -> int:\r\n        cuts.extend([0, n])\r\n        cuts.sort()\r\n        m = len(cuts)\r\n        f = [[0] * m for _ in range(m)]\r\n        for l in range(2, m):\r\n            for i in range(m - l):\r\n                j = i + l\r\n                f[i][j] = inf\r\n                for k in range(i + 1, j):\r\n                    f[i][j] = min(f[i][j], f[i][k] + f[k][j] + cuts[j] - cuts[i])\r\n        return f[0][-1]",
