{
    "problemName": "count-valid-word-occurrences",
    "language": "python3",
    "code": "class Solution:\r\n    def countWordOccurrences(self, chunks: list[str], queries: list[str]) -> list[int]:\r\n        s = \"\".join(chunks)\r\n        n = len(s)\r\n        cnt = defaultdict(int)\r\n        i = 0\r\n        while i < n:\r\n            if s[i] in \" -\":\r\n                i += 1\r\n                continue\r\n            j = i\r\n            while (\r\n                j < n\r\n                and s[j] != \" \"\r\n                and (s[j] != \"-\" or (j + 1 < n and s[j + 1] not in \" -\"))\r\n            ):\r\n                j += 1\r\n            cnt[s[i:j]] += 1\r\n            i = j\r\n        return [cnt[q] for q in queries]",
