{
    "problemName": "odd-even-linked-list",
    "language": "python3",
    "code": "# Definition for singly-linked list.\r\n# class ListNode:\r\n#     def __init__(self, val=0, next=None):\r\n#         self.val = val\r\n#         self.next = next\r\nclass Solution:\r\n    def oddEvenList(self, head: Optional[ListNode]) -> Optional[ListNode]:\r\n        if head is None:\r\n            return None\r\n        a = head\r\n        b = c = head.next\r\n        while b and b.next:\r\n            a.next = b.next\r\n            a = a.next\r\n            b.next = a.next\r\n            b = b.next\r\n        a.next = c\r\n        return head",
