    "problemName": "maximum-score-after-binary-swaps",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumScore(self, nums: List[int], s: str) -> int:\r\n        ans = 0\r\n        pq = []\r\n        for x, c in zip(nums, s):\r\n            heappush(pq, -x)\r\n            if c == \"1\":\r\n                ans -= heappop(pq)\r\n        return ans",
