{
    "problemName": "battleships-in-a-board",
    "language": "python3",
    "code": "class Solution:\r\n    def countBattleships(self, board: List[List[str]]) -> int:\r\n        m, n = len(board), len(board[0])\r\n        ans = 0\r\n        for i in range(m):\r\n            for j in range(n):\r\n                if board[i][j] == '.':\r\n                    continue\r\n                if i > 0 and board[i - 1][j] == 'X':\r\n                    continue\r\n                if j > 0 and board[i][j - 1] == 'X':\r\n                    continue\r\n                ans += 1\r\n        return ans",
