    "code": "class Foo:\r\n    def __init__(self):\r\n        self.l2 = threading.Lock()\r\n        self.l3 = threading.Lock()\r\n        self.l2.acquire()\r\n        self.l3.acquire()\r\n\r\n    def first(self, printFirst: 'Callable[[], None]') -> None:\r\n        printFirst()\r\n        self.l2.release()\r\n\r\n    def second(self, printSecond: 'Callable[[], None]') -> None:\r\n        self.l2.acquire()\r\n        printSecond()\r\n        self.l3.release()\r\n\r\n    def third(self, printThird: 'Callable[[], None]') -> None:\r\n        self.l3.acquire()\r\n        printThird()",
