    "problemName": "camelcase-matching",
    "language": "python3",
    "code": "class Solution:\r\n    def camelMatch(self, queries: List[str], pattern: str) -> List[bool]:\r\n        def check(s, t):\r\n            m, n = len(s), len(t)\r\n            i = j = 0\r\n            while j < n:\r\n                while i < m and s[i] != t[j] and s[i].islower():\r\n                    i += 1\r\n                if i == m or s[i] != t[j]:\r\n                    return False\r\n                i, j = i + 1, j + 1\r\n            while i < m and s[i].islower():\r\n                i += 1\r\n            return i == m\r\n\r\n        return [check(q, pattern) for q in queries]",
