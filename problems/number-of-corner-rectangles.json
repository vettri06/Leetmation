{
    "problemName": "number-of-corner-rectangles",
    "language": "python3",
    "code": "class Solution:\r\n    def countCornerRectangles(self, grid: List[List[int]]) -> int:\r\n        ans = 0\r\n        cnt = Counter()\r\n        n = len(grid[0])\r\n        for row in grid:\r\n            for i, c1 in enumerate(row):\r\n                if c1:\r\n                    for j in range(i + 1, n):\r\n                        if row[j]:\r\n                            ans += cnt[(i, j)]\r\n                            cnt[(i, j)] += 1\r\n        return ans",
