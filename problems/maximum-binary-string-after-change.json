{
    "problemName": "maximum-binary-string-after-change",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumBinaryString(self, binary: str) -> str:\r\n        k = binary.find('0')\r\n        if k == -1:\r\n            return binary\r\n        k += binary[k + 1 :].count('0')\r\n        return '1' * k + '0' + '1' * (len(binary) - k - 1)",
