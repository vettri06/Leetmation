    "problemName": "couples-holding-hands",
    "language": "python3",
    "code": "class Solution:\r\n    def minSwapsCouples(self, row: List[int]) -> int:\r\n        def find(x: int) -> int:\r\n            if p[x] != x:\r\n                p[x] = find(p[x])\r\n            return p[x]\r\n\r\n        n = len(row) >> 1\r\n        p = list(range(n))\r\n        for i in range(0, len(row), 2):\r\n            a, b = row[i] >> 1, row[i + 1] >> 1\r\n            p[find(a)] = find(b)\r\n        return n - sum(i == find(i) for i in range(n))",
