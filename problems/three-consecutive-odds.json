    "language": "python3",
    "code": "class Solution:\r\n    def threeConsecutiveOdds(self, arr: List[int]) -> bool:\r\n        cnt = 0\r\n        for x in arr:\r\n            if x & 1:\r\n                cnt += 1\r\n                if cnt == 3:\r\n                    return True\r\n            else:\r\n                cnt = 0\r\n        return False",
