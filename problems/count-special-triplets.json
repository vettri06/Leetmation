{
    "problemName": "count-special-triplets",
    "language": "python3",
    "code": "class Solution:\r\n    def specialTriplets(self, nums: List[int]) -> int:\r\n        left = Counter()\r\n        right = Counter(nums)\r\n        ans = 0\r\n        mod = 10**9 + 7\r\n        for x in nums:\r\n            right[x] -= 1\r\n            ans = (ans + left[x * 2] * right[x * 2] % mod) % mod\r\n            left[x] += 1\r\n        return ans",
