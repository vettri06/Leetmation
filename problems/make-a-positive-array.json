{
    "problemName": "make-a-positive-array",
    "language": "python3",
    "code": "class Solution:\r\n    def makeArrayPositive(self, nums: List[int]) -> int:\r\n        l = -1\r\n        ans = pre_mx = s = 0\r\n        for r, x in enumerate(nums):\r\n            s += x\r\n            if r - l > 2 and s <= pre_mx:\r\n                ans += 1\r\n                l = r\r\n                pre_mx = s = 0\r\n            elif r - l >= 2:\r\n                pre_mx = max(pre_mx, s - x - nums[r - 1])\r\n        return ans",
