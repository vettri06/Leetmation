{
    "problemName": "maximize-sum-of-squares-of-digits",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSumOfSquares(self, num: int, sum: int) -> str:\r\n        if num * 9 < sum:\r\n            return \"\"\r\n        k, s = divmod(sum, 9)\r\n        ans = \"9\" * k\r\n        if s:\r\n            ans += digits[s]\r\n        ans += \"0\" * (num - len(ans))\r\n        return ans",
