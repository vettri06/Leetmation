{
    "problemName": "count-the-number-of-good-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def countGood(self, nums: List[int], k: int) -> int:\r\n        cnt = Counter()\r\n        ans = cur = 0\r\n        i = 0\r\n        for x in nums:\r\n            cur += cnt[x]\r\n            cnt[x] += 1\r\n            while cur - cnt[nums[i]] + 1 >= k:\r\n                cnt[nums[i]] -= 1\r\n                cur -= cnt[nums[i]]\r\n                i += 1\r\n            if cur >= k:\r\n                ans += i + 1\r\n        return ans",
