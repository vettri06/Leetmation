    "problemName": "delete-and-earn",
    "language": "python3",
    "code": "class Solution:\r\n    def deleteAndEarn(self, nums: List[int]) -> int:\r\n        mx = -inf\r\n        for num in nums:\r\n            mx = max(mx, num)\r\n        total = [0] * (mx + 1)\r\n        for num in nums:\r\n            total[num] += num\r\n        first = total[0]\r\n        second = max(total[0], total[1])\r\n        for i in range(2, mx + 1):\r\n            cur = max(first + total[i], second)\r\n            first = second\r\n            second = cur\r\n        return second",
