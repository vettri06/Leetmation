{
    "problemName": "find-palindrome-with-fixed-length",
    "language": "python3",
    "code": "class Solution:\r\n    def kthPalindrome(self, queries: List[int], intLength: int) -> List[int]:\r\n        l = (intLength + 1) >> 1\r\n        start, end = 10 ** (l - 1), 10**l - 1\r\n        ans = []\r\n        for q in queries:\r\n            v = start + q - 1\r\n            if v > end:\r\n                ans.append(-1)\r\n                continue\r\n            s = str(v)\r\n            s += s[::-1][intLength % 2 :]\r\n            ans.append(int(s))\r\n        return ans",
