{
    "problemName": "distinct-points-reachable-after-substring-removal",
    "language": "python3",
    "code": "class Solution:\r\n    def distinctPoints(self, s: str, k: int) -> int:\r\n        n = len(s)\r\n        f = [0] * (n + 1)\r\n        g = [0] * (n + 1)\r\n        x = y = 0\r\n        for i, c in enumerate(s, 1):\r\n            if c == \"U\":\r\n                y += 1\r\n            elif c == \"D\":\r\n                y -= 1\r\n            elif c == \"L\":\r\n                x -= 1\r\n            else:\r\n                x += 1\r\n            f[i] = x\r\n            g[i] = y\r\n        st = set()\r\n        for i in range(k, n + 1):\r\n            a = f[n] - (f[i] - f[i - k])\r\n            b = g[n] - (g[i] - g[i - k])\r\n            st.add((a, b))\r\n        return len(st)",
