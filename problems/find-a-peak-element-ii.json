{
    "problemName": "find-a-peak-element-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def findPeakGrid(self, mat: List[List[int]]) -> List[int]:\r\n        l, r = 0, len(mat) - 1\r\n        while l < r:\r\n            mid = (l + r) >> 1\r\n            j = mat[mid].index(max(mat[mid]))\r\n            if mat[mid][j] > mat[mid + 1][j]:\r\n                r = mid\r\n            else:\r\n                l = mid + 1\r\n        return [l, mat[l].index(max(mat[l]))]",
