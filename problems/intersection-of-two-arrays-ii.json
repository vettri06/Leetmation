    "problemName": "intersection-of-two-arrays-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def intersect(self, nums1: List[int], nums2: List[int]) -> List[int]:\r\n        cnt = Counter(nums1)\r\n        ans = []\r\n        for x in nums2:\r\n            if cnt[x]:\r\n                ans.append(x)\r\n                cnt[x] -= 1\r\n        return ans",
