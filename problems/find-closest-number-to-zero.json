    "problemName": "find-closest-number-to-zero",
    "language": "python3",
    "code": "class Solution:\r\n    def findClosestNumber(self, nums: List[int]) -> int:\r\n        ans, d = 0, inf\r\n        for x in nums:\r\n            if (y := abs(x)) < d or (y == d and x > ans):\r\n                ans, d = x, y\r\n        return ans",
