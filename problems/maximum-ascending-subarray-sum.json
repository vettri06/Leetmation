{
    "problemName": "maximum-ascending-subarray-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def maxAscendingSum(self, nums: List[int]) -> int:\r\n        ans = t = 0\r\n        for i, v in enumerate(nums):\r\n            if i == 0 or v > nums[i - 1]:\r\n                t += v\r\n                ans = max(ans, t)\r\n            else:\r\n                t = v\r\n        return ans",
