    "problemName": "minimum-number-game",
    "language": "python3",
    "code": "class Solution:\r\n    def numberGame(self, nums: List[int]) -> List[int]:\r\n        heapify(nums)\r\n        ans = []\r\n        while nums:\r\n            a, b = heappop(nums), heappop(nums)\r\n            ans.append(b)\r\n            ans.append(a)\r\n        return ans",
