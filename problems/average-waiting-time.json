{
    "problemName": "average-waiting-time",
    "language": "python3",
    "code": "class Solution:\r\n    def averageWaitingTime(self, customers: List[List[int]]) -> float:\r\n        tot = t = 0\r\n        for a, b in customers:\r\n            t = max(t, a) + b\r\n            tot += t - a\r\n        return tot / len(customers)",
