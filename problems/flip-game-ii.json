    "problemName": "flip-game-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def canWin(self, currentState: str) -> bool:\r\n        @cache\r\n        def dfs(mask):\r\n            for i in range(n - 1):\r\n                if (mask & (1 << i)) == 0 or (mask & (1 << (i + 1)) == 0):\r\n                    continue\r\n                if dfs(mask ^ (1 << i) ^ (1 << (i + 1))):\r\n                    continue\r\n                return True\r\n            return False\r\n\r\n        mask, n = 0, len(currentState)\r\n        for i, c in enumerate(currentState):\r\n            if c == '+':\r\n                mask |= 1 << i\r\n        return dfs(mask)",
