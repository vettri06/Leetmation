{
    "problemName": "count-dominant-indices",
    "language": "python3",
    "code": "class Solution:\r\n    def dominantIndices(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        ans = 0\r\n        suf = nums[-1]\r\n        for i in range(n - 2, -1, -1):\r\n            if nums[i] > suf / (n - i - 1):\r\n                ans += 1\r\n            suf += nums[i]\r\n        return ans",
