{
    "problemName": "sum-of-matrix-after-queries",
    "language": "python3",
    "code": "class Solution:\r\n    def matrixSumQueries(self, n: int, queries: List[List[int]]) -> int:\r\n        row = set()\r\n        col = set()\r\n        ans = 0\r\n        for t, i, v in queries[::-1]:\r\n            if t == 0:\r\n                if i not in row:\r\n                    ans += v * (n - len(col))\r\n                    row.add(i)\r\n            else:\r\n                if i not in col:\r\n                    ans += v * (n - len(row))\r\n                    col.add(i)\r\n        return ans",
