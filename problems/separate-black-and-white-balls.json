    "language": "python3",
    "code": "class Solution:\r\n    def minimumSteps(self, s: str) -> int:\r\n        n = len(s)\r\n        ans = cnt = 0\r\n        for i in range(n - 1, -1, -1):\r\n            if s[i] == '1':\r\n                cnt += 1\r\n                ans += n - i - cnt\r\n        return ans",
