{
    "problemName": "make-the-string-great",
    "language": "python3",
    "code": "class Solution:\r\n    def makeGood(self, s: str) -> str:\r\n        stk = []\r\n        for c in s:\r\n            if not stk or abs(ord(stk[-1]) - ord(c)) != 32:\r\n                stk.append(c)\r\n            else:\r\n                stk.pop()\r\n        return \"\".join(stk)",
