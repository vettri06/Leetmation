    "problemName": "maximum-star-sum-of-a-graph",
    "language": "python3",
    "code": "class Solution:\r\n    def maxStarSum(self, vals: List[int], edges: List[List[int]], k: int) -> int:\r\n        g = defaultdict(list)\r\n        for a, b in edges:\r\n            if vals[b] > 0:\r\n                g[a].append(vals[b])\r\n            if vals[a] > 0:\r\n                g[b].append(vals[a])\r\n        for bs in g.values():\r\n            bs.sort(reverse=True)\r\n        return max(v + sum(g[i][:k]) for i, v in enumerate(vals))",
