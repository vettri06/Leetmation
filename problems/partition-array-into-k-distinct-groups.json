    "code": "class Solution:\r\n    def partitionArray(self, nums: List[int], k: int) -> bool:\r\n        m, mod = divmod(len(nums), k)\r\n        if mod:\r\n            return False\r\n        return max(Counter(nums).values()) <= m",
