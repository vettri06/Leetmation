    "language": "python3",
    "code": "class Solution:\r\n    def reverseString(self, s: List[str]) -> None:\r\n        i, j = 0, len(s) - 1\r\n        while i < j:\r\n            s[i], s[j] = s[j], s[i]\r\n            i, j = i + 1, j - 1",
