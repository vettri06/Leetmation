{
    "problemName": "smallest-all-ones-multiple",
    "language": "python3",
    "code": "class Solution:\r\n    def minAllOneMultiple(self, k: int) -> int:\r\n        if k % 2 == 0:\r\n            return -1\r\n        x = 1 % k\r\n        ans = 1\r\n        for _ in range(k):\r\n            x = (x * 10 + 1) % k\r\n            ans += 1\r\n            if x == 0:\r\n                return ans\r\n        return -1",
