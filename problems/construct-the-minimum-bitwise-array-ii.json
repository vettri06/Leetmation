{
    "problemName": "construct-the-minimum-bitwise-array-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def minBitwiseArray(self, nums: List[int]) -> List[int]:\r\n        ans = []\r\n        for x in nums:\r\n            if x == 2:\r\n                ans.append(-1)\r\n            else:\r\n                for i in range(1, 32):\r\n                    if x >> i & 1 ^ 1:\r\n                        ans.append(x ^ 1 << (i - 1))\r\n                        break\r\n        return ans",
