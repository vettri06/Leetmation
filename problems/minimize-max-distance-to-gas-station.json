{
    "problemName": "minimize-max-distance-to-gas-station",
    "language": "python3",
    "code": "class Solution:\r\n    def minmaxGasDist(self, stations: List[int], k: int) -> float:\r\n        def check(x):\r\n            return sum(int((b - a) / x) for a, b in pairwise(stations)) <= k\r\n\r\n        left, right = 0, 1e8\r\n        while right - left > 1e-6:\r\n            mid = (left + right) / 2\r\n            if check(mid):\r\n                right = mid\r\n            else:\r\n                left = mid\r\n        return left",
