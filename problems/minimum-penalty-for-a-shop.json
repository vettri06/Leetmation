    "problemName": "minimum-penalty-for-a-shop",
    "language": "python3",
    "code": "class Solution:\r\n    def bestClosingTime(self, customers: str) -> int:\r\n        ans = 0\r\n        mn = cost = customers.count(\"Y\")\r\n        for j, c in enumerate(customers, 1):\r\n            cost += 1 if c == \"N\" else -1\r\n            if cost < mn:\r\n                ans, mn = j, cost\r\n        return ans",
