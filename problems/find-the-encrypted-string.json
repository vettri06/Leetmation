    "problemName": "find-the-encrypted-string",
    "language": "python3",
    "code": "class Solution:\r\n    def getEncryptedString(self, s: str, k: int) -> str:\r\n        cs = list(s)\r\n        n = len(s)\r\n        for i in range(n):\r\n            cs[i] = s[(i + k) % n]\r\n        return \"\".join(cs)",
