    "problemName": "next-greater-element-iii",
    "language": "python3",
    "code": "class Solution:\r\n    def nextGreaterElement(self, n: int) -> int:\r\n        cs = list(str(n))\r\n        n = len(cs)\r\n        i, j = n - 2, n - 1\r\n        while i >= 0 and cs[i] >= cs[i + 1]:\r\n            i -= 1\r\n        if i < 0:\r\n            return -1\r\n        while cs[i] >= cs[j]:\r\n            j -= 1\r\n        cs[i], cs[j] = cs[j], cs[i]\r\n        cs[i + 1 :] = cs[i + 1 :][::-1]\r\n        ans = int(''.join(cs))\r\n        return -1 if ans > 2**31 - 1 else ans",
