    "problemName": "minimum-index-sum-of-common-elements",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumSum(self, nums1: List[int], nums2: List[int]) -> int:\r\n        d = {}\r\n        for i, x in enumerate(nums2):\r\n            if x not in d:\r\n                d[x] = i\r\n        ans = inf\r\n        for i, x in enumerate(nums1):\r\n            if x in d:\r\n                ans = min(ans, i + d[x])\r\n        return -1 if ans == inf else ans",
