    "problemName": "make-the-prefix-sum-non-negative",
    "language": "python3",
    "code": "class Solution:\r\n    def makePrefSumNonNegative(self, nums: List[int]) -> int:\r\n        h = []\r\n        ans = s = 0\r\n        for x in nums:\r\n            s += x\r\n            if x < 0:\r\n                heappush(h, x)\r\n            while s < 0:\r\n                s -= heappop(h)\r\n                ans += 1\r\n        return ans",
