{
    "problemName": "continuous-subarray-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def checkSubarraySum(self, nums: List[int], k: int) -> bool:\r\n        d = {0: -1}\r\n        s = 0\r\n        for i, x in enumerate(nums):\r\n            s = (s + x) % k\r\n            if s not in d:\r\n                d[s] = i\r\n            elif i - d[s] > 1:\r\n                return True\r\n        return False",
