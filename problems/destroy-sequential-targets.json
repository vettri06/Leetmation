{
    "problemName": "destroy-sequential-targets",
    "language": "python3",
    "code": "class Solution:\r\n    def destroyTargets(self, nums: List[int], space: int) -> int:\r\n        cnt = Counter(v % space for v in nums)\r\n        ans = mx = 0\r\n        for v in nums:\r\n            t = cnt[v % space]\r\n            if t > mx or (t == mx and v < ans):\r\n                ans = v\r\n                mx = t\r\n        return ans",
