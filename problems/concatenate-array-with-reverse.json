    "problemName": "concatenate-array-with-reverse",
    "language": "python3",
    "code": "class Solution:\r\n    def concatWithReverse(self, nums: list[int]) -> list[int]:\r\n        n = len(nums)\r\n        ans = [0] * (2 * n)\r\n        for i, x in enumerate(nums):\r\n            ans[i] = x\r\n            ans[i + n] = nums[n - i - 1]\r\n        return ans",
