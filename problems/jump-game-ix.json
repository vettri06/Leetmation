    "problemName": "jump-game-ix",
    "language": "python3",
    "code": "class Solution:\r\n    def maxValue(self, nums: List[int]) -> List[int]:\r\n        n = len(nums)\r\n        ans = [0] * n\r\n        pre_max = [nums[0]] * n\r\n        for i in range(1, n):\r\n            pre_max[i] = max(pre_max[i - 1], nums[i])\r\n        suf_min = inf\r\n        for i in range(n - 1, -1, -1):\r\n            ans[i] = ans[i + 1] if pre_max[i] > suf_min else pre_max[i]\r\n            suf_min = min(suf_min, nums[i])\r\n        return ans",
