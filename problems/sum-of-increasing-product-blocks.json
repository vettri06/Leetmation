{
    "problemName": "sum-of-increasing-product-blocks",
    "language": "python3",
    "code": "class Solution:\r\n    def sumOfBlocks(self, n: int) -> int:\r\n        ans = 0\r\n        mod = 10**9 + 7\r\n        k = 1\r\n        for i in range(1, n + 1):\r\n            x = 1\r\n            for j in range(k, k + i):\r\n                x = (x * j) % mod\r\n            ans = (ans + x) % mod\r\n            k += i\r\n        return ans",
