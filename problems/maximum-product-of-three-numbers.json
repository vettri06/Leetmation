{
    "problemName": "maximum-product-of-three-numbers",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumProduct(self, nums: List[int]) -> int:\r\n        nums.sort()\r\n        a = nums[-1] * nums[-2] * nums[-3]\r\n        b = nums[-1] * nums[0] * nums[1]\r\n        return max(a, b)",
