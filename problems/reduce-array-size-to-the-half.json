    "problemName": "reduce-array-size-to-the-half",
    "language": "python3",
    "code": "class Solution:\r\n    def minSetSize(self, arr: List[int]) -> int:\r\n        cnt = Counter(arr)\r\n        ans = m = 0\r\n        for _, v in cnt.most_common():\r\n            m += v\r\n            ans += 1\r\n            if m * 2 >= len(arr):\r\n                break\r\n        return ans",
