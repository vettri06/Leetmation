    "problemName": "numbers-with-same-consecutive-differences",
    "language": "python3",
    "code": "class Solution:\r\n    def numsSameConsecDiff(self, n: int, k: int) -> List[int]:\r\n        def dfs(x: int):\r\n            if x >= boundary:\r\n                ans.append(x)\r\n                return\r\n            last = x % 10\r\n            if last + k <= 9:\r\n                dfs(x * 10 + last + k)\r\n            if last - k >= 0 and k != 0:\r\n                dfs(x * 10 + last - k)\r\n\r\n        ans = []\r\n        boundary = 10 ** (n - 1)\r\n        for i in range(1, 10):\r\n            dfs(i)\r\n        return ans",
