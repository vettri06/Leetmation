    "problemName": "find-k-th-smallest-pair-distance",
    "language": "python3",
    "code": "class Solution:\r\n    def smallestDistancePair(self, nums: List[int], k: int) -> int:\r\n        def count(dist):\r\n            cnt = 0\r\n            for i, b in enumerate(nums):\r\n                a = b - dist\r\n                j = bisect_left(nums, a, 0, i)\r\n                cnt += i - j\r\n            return cnt\r\n\r\n        nums.sort()\r\n        return bisect_left(range(nums[-1] - nums[0]), k, key=count)",
