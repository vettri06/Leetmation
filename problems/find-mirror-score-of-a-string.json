{
    "problemName": "find-mirror-score-of-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def calculateScore(self, s: str) -> int:\r\n        d = defaultdict(list)\r\n        ans = 0\r\n        for i, x in enumerate(s):\r\n            y = chr(ord(\"a\") + ord(\"z\") - ord(x))\r\n            if d[y]:\r\n                j = d[y].pop()\r\n                ans += i - j\r\n            else:\r\n                d[x].append(i)\r\n        return ans",
