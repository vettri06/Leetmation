{
    "problemName": "find-the-longest-equal-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def longestEqualSubarray(self, nums: List[int], k: int) -> int:\r\n        cnt = Counter()\r\n        l = 0\r\n        mx = 0\r\n        for r, x in enumerate(nums):\r\n            cnt[x] += 1\r\n            mx = max(mx, cnt[x])\r\n            if r - l + 1 - mx > k:\r\n                cnt[nums[l]] -= 1\r\n                l += 1\r\n        return mx",
