    "problemName": "valid-digit-number",
    "language": "python3",
    "code": "class Solution:\r\n    def validDigit(self, n: int, x: int) -> bool:\r\n        has_x = False\r\n        while n > 9:\r\n            has_x = has_x or n % 10 == x\r\n            n //= 10\r\n        return has_x and n != x",
