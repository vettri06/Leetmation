{
    "problemName": "maximum-subsequence-score",
    "language": "python3",
    "code": "class Solution:\r\n    def maxScore(self, nums1: List[int], nums2: List[int], k: int) -> int:\r\n        nums = sorted(zip(nums2, nums1), reverse=True)\r\n        q = []\r\n        ans = s = 0\r\n        for a, b in nums:\r\n            s += b\r\n            heappush(q, b)\r\n            if len(q) == k:\r\n                ans = max(ans, s * a)\r\n                s -= heappop(q)\r\n        return ans",
