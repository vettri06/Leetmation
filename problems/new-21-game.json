{
    "problemName": "new-21-game",
    "language": "python3",
    "code": "class Solution:\r\n    def new21Game(self, n: int, k: int, maxPts: int) -> float:\r\n        @cache\r\n        def dfs(i: int) -> float:\r\n            if i >= k:\r\n                return int(i <= n)\r\n            if i == k - 1:\r\n                return min(n - k + 1, maxPts) / maxPts\r\n            return dfs(i + 1) + (dfs(i + 1) - dfs(i + maxPts + 1)) / maxPts\r\n\r\n        return dfs(0)",
