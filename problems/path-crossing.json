{
    "problemName": "path-crossing",
    "language": "python3",
    "code": "class Solution:\r\n    def isPathCrossing(self, path: str) -> bool:\r\n        i = j = 0\r\n        vis = {(0, 0)}\r\n        for c in path:\r\n            match c:\r\n                case 'N':\r\n                    i -= 1\r\n                case 'S':\r\n                    i += 1\r\n                case 'E':\r\n                    j += 1\r\n                case 'W':\r\n                    j -= 1\r\n            if (i, j) in vis:\r\n                return True\r\n            vis.add((i, j))\r\n        return False",
