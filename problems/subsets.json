    "code": "class Solution:\r\n    def subsets(self, nums: List[int]) -> List[List[int]]:\r\n        def dfs(i: int):\r\n            if i == len(nums):\r\n                ans.append(t[:])\r\n                return\r\n            dfs(i + 1)\r\n            t.append(nums[i])\r\n            dfs(i + 1)\r\n            t.pop()\r\n\r\n        ans = []\r\n        t = []\r\n        dfs(0)\r\n        return ans",
