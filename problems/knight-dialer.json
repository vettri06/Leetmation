    "problemName": "knight-dialer",
    "language": "python3",
    "code": "class Solution:\r\n    def knightDialer(self, n: int) -> int:\r\n        f = [1] * 10\r\n        for _ in range(n - 1):\r\n            g = [0] * 10\r\n            g[0] = f[4] + f[6]\r\n            g[1] = f[6] + f[8]\r\n            g[2] = f[7] + f[9]\r\n            g[3] = f[4] + f[8]\r\n            g[4] = f[0] + f[3] + f[9]\r\n            g[6] = f[0] + f[1] + f[7]\r\n            g[7] = f[2] + f[6]\r\n            g[8] = f[1] + f[3]\r\n            g[9] = f[2] + f[4]\r\n            f = g\r\n        return sum(f) % (10**9 + 7)",
