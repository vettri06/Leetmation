{
    "problemName": "maximum-score-from-removing-stones",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumScore(self, a: int, b: int, c: int) -> int:\r\n        s = sorted([a, b, c])\r\n        ans = 0\r\n        while s[1]:\r\n            ans += 1\r\n            s[1] -= 1\r\n            s[2] -= 1\r\n            s.sort()\r\n        return ans",
