{
    "problemName": "number-of-excellent-pairs",
    "language": "python3",
    "code": "class Solution:\r\n    def countExcellentPairs(self, nums: List[int], k: int) -> int:\r\n        s = set(nums)\r\n        ans = 0\r\n        cnt = Counter()\r\n        for v in s:\r\n            cnt[v.bit_count()] += 1\r\n        for v in s:\r\n            t = v.bit_count()\r\n            for i, x in cnt.items():\r\n                if t + i >= k:\r\n                    ans += x\r\n        return ans",
