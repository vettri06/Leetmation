{
    "problemName": "maximum-earnings-from-taxi",
    "language": "python3",
    "code": "class Solution:\r\n    def maxTaxiEarnings(self, n: int, rides: List[List[int]]) -> int:\r\n        @cache\r\n        def dfs(i: int) -> int:\r\n            if i >= len(rides):\r\n                return 0\r\n            st, ed, tip = rides[i]\r\n            j = bisect_left(rides, ed, lo=i + 1, key=lambda x: x[0])\r\n            return max(dfs(i + 1), dfs(j) + ed - st + tip)\r\n\r\n        rides.sort()\r\n        return dfs(0)",
