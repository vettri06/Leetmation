{
    "problemName": "sentence-screen-fitting",
    "language": "python3",
    "code": "class Solution:\r\n    def wordsTyping(self, sentence: List[str], rows: int, cols: int) -> int:\r\n        s = \" \".join(sentence) + \" \"\r\n        m = len(s)\r\n        cur = 0\r\n        for _ in range(rows):\r\n            cur += cols\r\n            if s[cur % m] == \" \":\r\n                cur += 1\r\n            while cur and s[(cur - 1) % m] != \" \":\r\n                cur -= 1\r\n        return cur // m",
