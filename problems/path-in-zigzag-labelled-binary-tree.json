    "problemName": "path-in-zigzag-labelled-binary-tree",
    "language": "python3",
    "code": "class Solution:\r\n    def pathInZigZagTree(self, label: int) -> List[int]:\r\n        x = i = 1\r\n        while (x << 1) <= label:\r\n            x <<= 1\r\n            i += 1\r\n        ans = [0] * i\r\n        while i:\r\n            ans[i - 1] = label\r\n            label = ((1 << (i - 1)) + (1 << i) - 1 - label) >> 1\r\n            i -= 1\r\n        return ans",
