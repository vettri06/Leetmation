{
    "problemName": "total-distance-traveled",
    "language": "python3",
    "code": "class Solution:\r\n    def distanceTraveled(self, mainTank: int, additionalTank: int) -> int:\r\n        ans = cur = 0\r\n        while mainTank:\r\n            cur += 1\r\n            ans += 10\r\n            mainTank -= 1\r\n            if cur % 5 == 0 and additionalTank:\r\n                additionalTank -= 1\r\n                mainTank += 1\r\n        return ans",
