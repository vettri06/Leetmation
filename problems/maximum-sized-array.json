    "code": "mx = 1330\r\nf = [0] * mx\r\nfor i in range(1, mx):\r\n    f[i] = f[i - 1] + i\r\n    for j in range(i):\r\n        f[i] += 2 * (i | j)\r\n\r\n\r\nclass Solution:\r\n    def maxSizedArray(self, s: int) -> int:\r\n        l, r = 1, mx\r\n        while l < r:\r\n            m = (l + r + 1) >> 1\r\n            if f[m - 1] * (m - 1) * m // 2 <= s:\r\n                l = m\r\n            else:\r\n                r = m - 1\r\n        return l",
