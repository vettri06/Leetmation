{
    "problemName": "minimum-genetic-mutation",
    "language": "python3",
    "code": "class Solution:\r\n    def minMutation(self, startGene: str, endGene: str, bank: List[str]) -> int:\r\n        q = deque([(startGene, 0)])\r\n        vis = {startGene}\r\n        while q:\r\n            gene, depth = q.popleft()\r\n            if gene == endGene:\r\n                return depth\r\n            for nxt in bank:\r\n                diff = sum(a != b for a, b in zip(gene, nxt))\r\n                if diff == 1 and nxt not in vis:\r\n                    q.append((nxt, depth + 1))\r\n                    vis.add(nxt)\r\n        return -1",
