{
    "problemName": "minimum-falling-path-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def minFallingPathSum(self, matrix: List[List[int]]) -> int:\r\n        n = len(matrix)\r\n        f = [0] * n\r\n        for row in matrix:\r\n            g = [0] * n\r\n            for j, x in enumerate(row):\r\n                l, r = max(0, j - 1), min(n, j + 2)\r\n                g[j] = min(f[l:r]) + x\r\n            f = g\r\n        return min(f)",
