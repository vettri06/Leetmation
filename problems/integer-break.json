{
    "problemName": "integer-break",
    "language": "python3",
    "code": "class Solution:\r\n    def integerBreak(self, n: int) -> int:\r\n        f = [1] * (n + 1)\r\n        for i in range(2, n + 1):\r\n            for j in range(1, i):\r\n                f[i] = max(f[i], f[i - j] * j, (i - j) * j)\r\n        return f[n]",
