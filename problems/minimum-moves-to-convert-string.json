    "language": "python3",
    "code": "class Solution:\r\n    def minimumMoves(self, s: str) -> int:\r\n        ans = i = 0\r\n        while i < len(s):\r\n            if s[i] == \"X\":\r\n                ans += 1\r\n                i += 3\r\n            else:\r\n                i += 1\r\n        return ans",
