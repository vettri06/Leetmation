    "problemName": "unique-length-3-palindromic-subsequences",
    "language": "python3",
    "code": "class Solution:\r\n    def countPalindromicSubsequence(self, s: str) -> int:\r\n        ans = 0\r\n        for c in ascii_lowercase:\r\n            l, r = s.find(c), s.rfind(c)\r\n            if r - l > 1:\r\n                ans += len(set(s[l + 1 : r]))\r\n        return ans",
