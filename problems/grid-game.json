    "problemName": "grid-game",
    "language": "python3",
    "code": "class Solution:\r\n    def gridGame(self, grid: List[List[int]]) -> int:\r\n        ans = inf\r\n        s1, s2 = sum(grid[0]), 0\r\n        for j, v in enumerate(grid[0]):\r\n            s1 -= v\r\n            ans = min(ans, max(s1, s2))\r\n            s2 += grid[1][j]\r\n        return ans",
