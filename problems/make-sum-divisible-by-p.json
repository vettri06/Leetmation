{
    "problemName": "make-sum-divisible-by-p",
    "language": "python3",
    "code": "class Solution:\r\n    def minSubarray(self, nums: List[int], p: int) -> int:\r\n        k = sum(nums) % p\r\n        if k == 0:\r\n            return 0\r\n        last = {0: -1}\r\n        cur = 0\r\n        ans = len(nums)\r\n        for i, x in enumerate(nums):\r\n            cur = (cur + x) % p\r\n            target = (cur - k + p) % p\r\n            if target in last:\r\n                ans = min(ans, i - last[target])\r\n            last[cur] = i\r\n        return -1 if ans == len(nums) else ans",
