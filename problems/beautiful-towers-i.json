{
    "problemName": "beautiful-towers-i",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumSumOfHeights(self, maxHeights: List[int]) -> int:\r\n        ans, n = 0, len(maxHeights)\r\n        for i, x in enumerate(maxHeights):\r\n            y = t = x\r\n            for j in range(i - 1, -1, -1):\r\n                y = min(y, maxHeights[j])\r\n                t += y\r\n            y = x\r\n            for j in range(i + 1, n):\r\n                y = min(y, maxHeights[j])\r\n                t += y\r\n            ans = max(ans, t)\r\n        return ans",
