{
    "problemName": "take-gifts-from-the-richest-pile",
    "language": "python3",
    "code": "class Solution:\r\n    def pickGifts(self, gifts: List[int], k: int) -> int:\r\n        h = [-v for v in gifts]\r\n        heapify(h)\r\n        for _ in range(k):\r\n            heapreplace(h, -int(sqrt(-h[0])))\r\n        return -sum(h)",
