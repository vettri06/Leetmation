{
    "problemName": "furthest-building-you-can-reach",
    "language": "python3",
    "code": "class Solution:\r\n    def furthestBuilding(self, heights: List[int], bricks: int, ladders: int) -> int:\r\n        h = []\r\n        for i, a in enumerate(heights[:-1]):\r\n            b = heights[i + 1]\r\n            d = b - a\r\n            if d > 0:\r\n                heappush(h, d)\r\n                if len(h) > ladders:\r\n                    bricks -= heappop(h)\r\n                    if bricks < 0:\r\n                        return i\r\n        return len(heights) - 1",
