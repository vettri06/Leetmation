{
    "problemName": "find-the-longest-semi-repetitive-substring",
    "language": "python3",
    "code": "class Solution:\r\n    def longestSemiRepetitiveSubstring(self, s: str) -> int:\r\n        ans, n = 1, len(s)\r\n        cnt = j = 0\r\n        for i in range(1, n):\r\n            cnt += s[i] == s[i - 1]\r\n            while cnt > 1:\r\n                cnt -= s[j] == s[j + 1]\r\n                j += 1\r\n            ans = max(ans, i - j + 1)\r\n        return ans",
