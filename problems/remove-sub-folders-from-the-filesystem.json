{
    "problemName": "remove-sub-folders-from-the-filesystem",
    "language": "python3",
    "code": "class Solution:\r\n    def removeSubfolders(self, folder: List[str]) -> List[str]:\r\n        folder.sort()\r\n        ans = [folder[0]]\r\n        for f in folder[1:]:\r\n            m, n = len(ans[-1]), len(f)\r\n            if m >= n or not (ans[-1] == f[:m] and f[m] == '/'):\r\n                ans.append(f)\r\n        return ans",
