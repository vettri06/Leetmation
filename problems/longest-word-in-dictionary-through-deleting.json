    "problemName": "longest-word-in-dictionary-through-deleting",
    "language": "python3",
    "code": "class Solution:\r\n    def findLongestWord(self, s: str, dictionary: List[str]) -> str:\r\n        def check(s: str, t: str) -> bool:\r\n            m, n = len(s), len(t)\r\n            i = j = 0\r\n            while i < m and j < n:\r\n                if s[i] == t[j]:\r\n                    i += 1\r\n                j += 1\r\n            return i == m\r\n\r\n        ans = \"\"\r\n        for t in dictionary:\r\n            if check(t, s) and (len(ans) < len(t) or (len(ans) == len(t) and ans > t)):\r\n                ans = t\r\n        return ans",
