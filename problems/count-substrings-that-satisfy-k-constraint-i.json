{
    "problemName": "count-substrings-that-satisfy-k-constraint-i",
    "language": "python3",
    "code": "class Solution:\r\n    def countKConstraintSubstrings(self, s: str, k: int) -> int:\r\n        cnt = [0, 0]\r\n        ans = l = 0\r\n        for r, x in enumerate(map(int, s)):\r\n            cnt[x] += 1\r\n            while cnt[0] > k and cnt[1] > k:\r\n                cnt[int(s[l])] -= 1\r\n                l += 1\r\n            ans += r - l + 1\r\n        return ans",
