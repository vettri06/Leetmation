{
    "problemName": "maximal-score-after-applying-k-operations",
    "language": "python3",
    "code": "class Solution:\r\n    def maxKelements(self, nums: List[int], k: int) -> int:\r\n        h = [-v for v in nums]\r\n        heapify(h)\r\n        ans = 0\r\n        for _ in range(k):\r\n            v = -heappop(h)\r\n            ans += v\r\n            heappush(h, -(ceil(v / 3)))\r\n        return ans",
