    "problemName": "minimum-time-to-make-rope-colorful",
    "language": "python3",
    "code": "class Solution:\r\n    def minCost(self, colors: str, neededTime: List[int]) -> int:\r\n        ans = i = 0\r\n        n = len(colors)\r\n        while i < n:\r\n            j = i\r\n            s = mx = 0\r\n            while j < n and colors[j] == colors[i]:\r\n                s += neededTime[j]\r\n                if mx < neededTime[j]:\r\n                    mx = neededTime[j]\r\n                j += 1\r\n            if j - i > 1:\r\n                ans += s - mx\r\n            i = j\r\n        return ans",
