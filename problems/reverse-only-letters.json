{
    "problemName": "reverse-only-letters",
    "language": "python3",
    "code": "class Solution:\r\n    def reverseOnlyLetters(self, s: str) -> str:\r\n        cs = list(s)\r\n        i, j = 0, len(cs) - 1\r\n        while i < j:\r\n            while i < j and not cs[i].isalpha():\r\n                i += 1\r\n            while i < j and not cs[j].isalpha():\r\n                j -= 1\r\n            if i < j:\r\n                cs[i], cs[j] = cs[j], cs[i]\r\n                i, j = i + 1, j - 1\r\n        return \"\".join(cs)",
