    "problemName": "knight-probability-in-chessboard",
    "language": "python3",
    "code": "class Solution:\r\n    def knightProbability(self, n: int, k: int, row: int, column: int) -> float:\r\n        f = [[[0] * n for _ in range(n)] for _ in range(k + 1)]\r\n        for i in range(n):\r\n            for j in range(n):\r\n                f[0][i][j] = 1\r\n        for h in range(1, k + 1):\r\n            for i in range(n):\r\n                for j in range(n):\r\n                    for a, b in pairwise((-2, -1, 2, 1, -2, 1, 2, -1, -2)):\r\n                        x, y = i + a, j + b\r\n                        if 0 <= x < n and 0 <= y < n:\r\n                            f[h][i][j] += f[h - 1][x][y] / 8\r\n        return f[k][row][column]",
