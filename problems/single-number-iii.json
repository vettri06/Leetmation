    "problemName": "single-number-iii",
    "language": "python3",
    "code": "class Solution:\r\n    def singleNumber(self, nums: List[int]) -> List[int]:\r\n        xs = reduce(xor, nums)\r\n        a = 0\r\n        lb = xs & -xs\r\n        for x in nums:\r\n            if x & lb:\r\n                a ^= x\r\n        b = xs ^ a\r\n        return [a, b]",
