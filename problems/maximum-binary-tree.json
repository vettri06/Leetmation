{
    "problemName": "maximum-binary-tree",
    "language": "python3",
    "code": "# Definition for a binary tree node.\r\n# class TreeNode:\r\n#     def __init__(self, val=0, left=None, right=None):\r\n#         self.val = val\r\n#         self.left = left\r\n#         self.right = right\r\nclass Solution:\r\n    def constructMaximumBinaryTree(self, nums: List[int]) -> Optional[TreeNode]:\r\n        def dfs(nums):\r\n            if not nums:\r\n                return None\r\n            val = max(nums)\r\n            i = nums.index(val)\r\n            root = TreeNode(val)\r\n            root.left = dfs(nums[:i])\r\n            root.right = dfs(nums[i + 1 :])\r\n            return root\r\n\r\n        return dfs(nums)",
