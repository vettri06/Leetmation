{
    "problemName": "minimum-common-value",
    "language": "python3",
    "code": "class Solution:\r\n    def getCommon(self, nums1: List[int], nums2: List[int]) -> int:\r\n        i = j = 0\r\n        m, n = len(nums1), len(nums2)\r\n        while i < m and j < n:\r\n            if nums1[i] == nums2[j]:\r\n                return nums1[i]\r\n            if nums1[i] < nums2[j]:\r\n                i += 1\r\n            else:\r\n                j += 1\r\n        return -1",
