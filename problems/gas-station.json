    "problemName": "gas-station",
    "language": "python3",
    "code": "class Solution:\r\n    def canCompleteCircuit(self, gas: List[int], cost: List[int]) -> int:\r\n        n = len(gas)\r\n        i = j = n - 1\r\n        cnt = s = 0\r\n        while cnt < n:\r\n            s += gas[j] - cost[j]\r\n            cnt += 1\r\n            j = (j + 1) % n\r\n            while s < 0 and cnt < n:\r\n                i -= 1\r\n                s += gas[i] - cost[i]\r\n                cnt += 1\r\n        return -1 if s < 0 else i",
