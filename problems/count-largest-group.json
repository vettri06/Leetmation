    "problemName": "count-largest-group",
    "language": "python3",
    "code": "class Solution:\r\n    def countLargestGroup(self, n: int) -> int:\r\n        cnt = Counter()\r\n        ans = mx = 0\r\n        for i in range(1, n + 1):\r\n            s = 0\r\n            while i:\r\n                s += i % 10\r\n                i //= 10\r\n            cnt[s] += 1\r\n            if mx < cnt[s]:\r\n                mx = cnt[s]\r\n                ans = 1\r\n            elif mx == cnt[s]:\r\n                ans += 1\r\n        return ans",
