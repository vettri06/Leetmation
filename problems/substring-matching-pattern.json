{
    "problemName": "substring-matching-pattern",
    "language": "python3",
    "code": "class Solution:\r\n    def hasMatch(self, s: str, p: str) -> bool:\r\n        i = 0\r\n        for t in p.split(\"*\"):\r\n            j = s.find(t, i)\r\n            if j == -1:\r\n                return False\r\n            i = j + len(t)\r\n        return True",
