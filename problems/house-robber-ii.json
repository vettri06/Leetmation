{
    "problemName": "house-robber-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def rob(self, nums: List[int]) -> int:\r\n        def _rob(nums):\r\n            f = g = 0\r\n            for x in nums:\r\n                f, g = max(f, g), f + x\r\n            return max(f, g)\r\n\r\n        if len(nums) == 1:\r\n            return nums[0]\r\n        return max(_rob(nums[1:]), _rob(nums[:-1]))",
