{
    "problemName": "reverse-vowels-of-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def reverseVowels(self, s: str) -> str:\r\n        vowels = \"aeiouAEIOU\"\r\n        i, j = 0, len(s) - 1\r\n        cs = list(s)\r\n        while i < j:\r\n            while i < j and cs[i] not in vowels:\r\n                i += 1\r\n            while i < j and cs[j] not in vowels:\r\n                j -= 1\r\n            if i < j:\r\n                cs[i], cs[j] = cs[j], cs[i]\r\n                i, j = i + 1, j - 1\r\n        return \"\".join(cs)",
