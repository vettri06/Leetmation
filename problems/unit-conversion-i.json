    "code": "class Solution:\r\n    def baseUnitConversions(self, conversions: List[List[int]]) -> List[int]:\r\n        def dfs(s: int, mul: int) -> None:\r\n            ans[s] = mul\r\n            for t, w in g[s]:\r\n                dfs(t, mul * w % mod)\r\n\r\n        mod = 10**9 + 7\r\n        n = len(conversions) + 1\r\n        g = [[] for _ in range(n)]\r\n        for s, t, w in conversions:\r\n            g[s].append((t, w))\r\n        ans = [0] * n\r\n        dfs(0, 1)\r\n        return ans",
