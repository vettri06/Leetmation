{
    "problemName": "maximum-sum-score-of-array",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumSumScore(self, nums: List[int]) -> int:\r\n        l, r = 0, sum(nums)\r\n        ans = -inf\r\n        for x in nums:\r\n            l += x\r\n            ans = max(ans, l, r)\r\n            r -= x\r\n        return ans",
