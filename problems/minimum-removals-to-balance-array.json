{
    "problemName": "minimum-removals-to-balance-array",
    "language": "python3",
    "code": "class Solution:\r\n    def minRemoval(self, nums: List[int], k: int) -> int:\r\n        nums.sort()\r\n        cnt = 0\r\n        for i, x in enumerate(nums):\r\n            j = bisect_right(nums, k * x)\r\n            cnt = max(cnt, j - i)\r\n        return len(nums) - cnt",
