{
    "problemName": "armstrong-number",
    "language": "python3",
    "code": "class Solution:\r\n    def isArmstrong(self, n: int) -> bool:\r\n        k = len(str(n))\r\n        s, x = 0, n\r\n        while x:\r\n            s += (x % 10) ** k\r\n            x //= 10\r\n        return s == n",
