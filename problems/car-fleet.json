{
    "problemName": "car-fleet",
    "language": "python3",
    "code": "class Solution:\r\n    def carFleet(self, target: int, position: List[int], speed: List[int]) -> int:\r\n        idx = sorted(range(len(position)), key=lambda i: position[i])\r\n        ans = pre = 0\r\n        for i in idx[::-1]:\r\n            t = (target - position[i]) / speed[i]\r\n            if t > pre:\r\n                ans += 1\r\n                pre = t\r\n        return ans",
