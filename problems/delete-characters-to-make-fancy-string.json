    "problemName": "delete-characters-to-make-fancy-string",
    "language": "python3",
    "code": "class Solution:\r\n    def makeFancyString(self, s: str) -> str:\r\n        ans = []\r\n        for i, c in enumerate(s):\r\n            if i < 2 or c != s[i - 1] or c != s[i - 2]:\r\n                ans.append(c)\r\n        return \"\".join(ans)",
