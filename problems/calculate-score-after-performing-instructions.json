{
    "problemName": "calculate-score-after-performing-instructions",
    "language": "python3",
    "code": "class Solution:\r\n    def calculateScore(self, instructions: List[str], values: List[int]) -> int:\r\n        n = len(values)\r\n        vis = [False] * n\r\n        ans = i = 0\r\n        while 0 <= i < n and not vis[i]:\r\n            vis[i] = True\r\n            if instructions[i][0] == \"a\":\r\n                ans += values[i]\r\n                i += 1\r\n            else:\r\n                i = i + values[i]\r\n        return ans",
