{
    "problemName": "letter-tile-possibilities",
    "language": "python3",
    "code": "class Solution:\r\n    def numTilePossibilities(self, tiles: str) -> int:\r\n        def dfs(cnt: Counter) -> int:\r\n            ans = 0\r\n            for i, x in cnt.items():\r\n                if x > 0:\r\n                    ans += 1\r\n                    cnt[i] -= 1\r\n                    ans += dfs(cnt)\r\n                    cnt[i] += 1\r\n            return ans\r\n\r\n        cnt = Counter(tiles)\r\n        return dfs(cnt)",
