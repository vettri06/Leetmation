{
    "problemName": "rearrange-array-elements-by-sign",
    "language": "python3",
    "code": "class Solution:\r\n    def rearrangeArray(self, nums: List[int]) -> List[int]:\r\n        ans = [0] * len(nums)\r\n        i, j = 0, 1\r\n        for x in nums:\r\n            if x > 0:\r\n                ans[i] = x\r\n                i += 2\r\n            else:\r\n                ans[j] = x\r\n                j += 2\r\n        return ans",
