    "problemName": "angle-between-hands-of-a-clock",
    "language": "python3",
    "code": "class Solution:\r\n    def angleClock(self, hour: int, minutes: int) -> float:\r\n        h = 30 * hour + 0.5 * minutes\r\n        m = 6 * minutes\r\n        diff = abs(h - m)\r\n        return min(diff, 360 - diff)",
