    "problemName": "building-boxes",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumBoxes(self, n: int) -> int:\r\n        s, k = 0, 1\r\n        while s + k * (k + 1) // 2 <= n:\r\n            s += k * (k + 1) // 2\r\n            k += 1\r\n        k -= 1\r\n        ans = k * (k + 1) // 2\r\n        k = 1\r\n        while s < n:\r\n            ans += 1\r\n            s += k\r\n            k += 1\r\n        return ans",
