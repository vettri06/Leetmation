    "problemName": "reverse-string-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def reverseStr(self, s: str, k: int) -> str:\r\n        cs = list(s)\r\n        for i in range(0, len(cs), 2 * k):\r\n            cs[i : i + k] = reversed(cs[i : i + k])\r\n        return \"\".join(cs)",
