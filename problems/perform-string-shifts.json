    "problemName": "perform-string-shifts",
    "language": "python3",
    "code": "class Solution:\r\n    def stringShift(self, s: str, shift: List[List[int]]) -> str:\r\n        x = sum((b if a else -b) for a, b in shift)\r\n        x %= len(s)\r\n        return s[-x:] + s[:-x]",
