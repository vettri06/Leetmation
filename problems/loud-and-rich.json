    "code": "class Solution:\r\n    def loudAndRich(self, richer: List[List[int]], quiet: List[int]) -> List[int]:\r\n        def dfs(i: int):\r\n            if ans[i] != -1:\r\n                return\r\n            ans[i] = i\r\n            for j in g[i]:\r\n                dfs(j)\r\n                if quiet[ans[j]] < quiet[ans[i]]:\r\n                    ans[i] = ans[j]\r\n\r\n        g = defaultdict(list)\r\n        for a, b in richer:\r\n            g[b].append(a)\r\n        n = len(quiet)\r\n        ans = [-1] * n\r\n        for i in range(n):\r\n            dfs(i)\r\n        return ans",
