{
    "problemName": "shifting-letters-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def shiftingLetters(self, s: str, shifts: List[List[int]]) -> str:\r\n        n = len(s)\r\n        d = [0] * (n + 1)\r\n        for i, j, v in shifts:\r\n            if v == 0:\r\n                v = -1\r\n            d[i] += v\r\n            d[j + 1] -= v\r\n        for i in range(1, n + 1):\r\n            d[i] += d[i - 1]\r\n        return ''.join(\r\n            chr(ord('a') + (ord(s[i]) - ord('a') + d[i] + 26) % 26) for i in range(n)\r\n        )",
