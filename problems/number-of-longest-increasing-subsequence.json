{
    "problemName": "number-of-longest-increasing-subsequence",
    "language": "python3",
    "code": "class Solution:\r\n    def findNumberOfLIS(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        f = [1] * n\r\n        cnt = [1] * n\r\n        mx = 0\r\n        for i in range(n):\r\n            for j in range(i):\r\n                if nums[j] < nums[i]:\r\n                    if f[i] < f[j] + 1:\r\n                        f[i] = f[j] + 1\r\n                        cnt[i] = cnt[j]\r\n                    elif f[i] == f[j] + 1:\r\n                        cnt[i] += cnt[j]\r\n            if mx < f[i]:\r\n                mx = f[i]\r\n                ans = cnt[i]\r\n            elif mx == f[i]:\r\n                ans += cnt[i]\r\n        return ans",
