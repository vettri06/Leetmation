    "problemName": "number-of-equivalent-domino-pairs",
    "language": "python3",
    "code": "class Solution:\r\n    def numEquivDominoPairs(self, dominoes: List[List[int]]) -> int:\r\n        cnt = Counter()\r\n        ans = 0\r\n        for a, b in dominoes:\r\n            x = a * 10 + b if a < b else b * 10 + a\r\n            ans += cnt[x]\r\n            cnt[x] += 1\r\n        return ans",
