{
    "problemName": "rings-and-rods",
    "language": "python3",
    "code": "class Solution:\r\n    def countPoints(self, rings: str) -> int:\r\n        mask = [0] * 10\r\n        d = {\"R\": 1, \"G\": 2, \"B\": 4}\r\n        for i in range(0, len(rings), 2):\r\n            c = rings[i]\r\n            j = int(rings[i + 1])\r\n            mask[j] |= d[c]\r\n        return mask.count(7)",
