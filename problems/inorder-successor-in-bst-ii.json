{
    "problemName": "inorder-successor-in-bst-ii",
    "language": "python3",
    "code": "\"\"\"\r\n# Definition for a Node.\r\nclass Node:\r\n    def __init__(self, val):\r\n        self.val = val\r\n        self.left = None\r\n        self.right = None\r\n        self.parent = None\r\n\"\"\"\r\n\r\n\r\nclass Solution:\r\n    def inorderSuccessor(self, node: \"Node\") -> \"Optional[Node]\":\r\n        if node.right:\r\n            node = node.right\r\n            while node.left:\r\n                node = node.left\r\n            return node\r\n        while node.parent and node.parent.right is node:\r\n            node = node.parent\r\n        return node.parent",
