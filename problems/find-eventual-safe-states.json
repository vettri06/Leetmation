    "problemName": "find-eventual-safe-states",
    "language": "python3",
    "code": "class Solution:\r\n    def eventualSafeNodes(self, graph: List[List[int]]) -> List[int]:\r\n        rg = defaultdict(list)\r\n        indeg = [0] * len(graph)\r\n        for i, vs in enumerate(graph):\r\n            for j in vs:\r\n                rg[j].append(i)\r\n            indeg[i] = len(vs)\r\n        q = deque([i for i, v in enumerate(indeg) if v == 0])\r\n        while q:\r\n            i = q.popleft()\r\n            for j in rg[i]:\r\n                indeg[j] -= 1\r\n                if indeg[j] == 0:\r\n                    q.append(j)\r\n        return [i for i, v in enumerate(indeg) if v == 0]",
