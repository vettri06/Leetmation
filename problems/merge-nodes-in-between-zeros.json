{
    "problemName": "merge-nodes-in-between-zeros",
    "language": "python3",
    "code": "# Definition for singly-linked list.\r\n# class ListNode:\r\n#     def __init__(self, val=0, next=None):\r\n#         self.val = val\r\n#         self.next = next\r\nclass Solution:\r\n    def mergeNodes(self, head: Optional[ListNode]) -> Optional[ListNode]:\r\n        dummy = tail = ListNode()\r\n        s = 0\r\n        cur = head.next\r\n        while cur:\r\n            if cur.val:\r\n                s += cur.val\r\n            else:\r\n                tail.next = ListNode(s)\r\n                tail = tail.next\r\n                s = 0\r\n            cur = cur.next\r\n        return dummy.next",
