    "problemName": "minimum-time-to-complete-trips",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumTime(self, time: List[int], totalTrips: int) -> int:\r\n        mx = min(time) * totalTrips\r\n        return bisect_left(\r\n            range(mx), totalTrips, key=lambda x: sum(x // v for v in time)\r\n        )",
