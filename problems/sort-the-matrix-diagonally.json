    "problemName": "sort-the-matrix-diagonally",
    "language": "python3",
    "code": "class Solution:\r\n    def diagonalSort(self, mat: List[List[int]]) -> List[List[int]]:\r\n        m, n = len(mat), len(mat[0])\r\n        g = [[] for _ in range(m + n)]\r\n        for i, row in enumerate(mat):\r\n            for j, x in enumerate(row):\r\n                g[m - i + j].append(x)\r\n        for e in g:\r\n            e.sort(reverse=True)\r\n        for i in range(m):\r\n            for j in range(n):\r\n                mat[i][j] = g[m - i + j].pop()\r\n        return mat",
