    "language": "python3",
    "code": "class Solution:\r\n    def findOrder(self, numCourses: int, prerequisites: List[List[int]]) -> List[int]:\r\n        g = defaultdict(list)\r\n        indeg = [0] * numCourses\r\n        for a, b in prerequisites:\r\n            g[b].append(a)\r\n            indeg[a] += 1\r\n        ans = []\r\n        q = deque(i for i, x in enumerate(indeg) if x == 0)\r\n        while q:\r\n            i = q.popleft()\r\n            ans.append(i)\r\n            for j in g[i]:\r\n                indeg[j] -= 1\r\n                if indeg[j] == 0:\r\n                    q.append(j)\r\n        return ans if len(ans) == numCourses else []",
