    "language": "python3",
    "code": "class Solution:\r\n    def repeatedCharacter(self, s: str) -> str:\r\n        cnt = Counter()\r\n        for c in s:\r\n            cnt[c] += 1\r\n            if cnt[c] == 2:\r\n                return c",
