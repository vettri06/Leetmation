{
    "problemName": "reformat-the-string",
    "language": "python3",
    "code": "class Solution:\r\n    def reformat(self, s: str) -> str:\r\n        a = [c for c in s if c.islower()]\r\n        b = [c for c in s if c.isdigit()]\r\n        if abs(len(a) - len(b)) > 1:\r\n            return ''\r\n        if len(a) < len(b):\r\n            a, b = b, a\r\n        ans = []\r\n        for x, y in zip(a, b):\r\n            ans.append(x + y)\r\n        if len(a) > len(b):\r\n            ans.append(a[-1])\r\n        return ''.join(ans)",
