{
    "problemName": "sorting-three-groups",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumOperations(self, nums: List[int]) -> int:\r\n        f = [0] * 3\r\n        for x in nums:\r\n            g = [0] * 3\r\n            if x == 1:\r\n                g[0] = f[0]\r\n                g[1] = min(f[:2]) + 1\r\n                g[2] = min(f) + 1\r\n            elif x == 2:\r\n                g[0] = f[0] + 1\r\n                g[1] = min(f[:2])\r\n                g[2] = min(f) + 1\r\n            else:\r\n                g[0] = f[0] + 1\r\n                g[1] = min(f[:2]) + 1\r\n                g[2] = min(f)\r\n            f = g\r\n        return min(f)",
