{
    "problemName": "find-longest-self-contained-substring",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSubstringLength(self, s: str) -> int:\r\n        first, last = {}, {}\r\n        for i, c in enumerate(s):\r\n            if c not in first:\r\n                first[c] = i\r\n            last[c] = i\r\n        ans, n = -1, len(s)\r\n        for c, i in first.items():\r\n            mx = last[c]\r\n            for j in range(i, n):\r\n                a, b = first[s[j]], last[s[j]]\r\n                if a < i:\r\n                    break\r\n                mx = max(mx, b)\r\n                if mx == j and j - i + 1 < n:\r\n                    ans = max(ans, j - i + 1)\r\n        return ans",
