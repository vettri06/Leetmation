    "problemName": "shift-distance-between-two-strings",
    "language": "python3",
    "code": "class Solution:\r\n    def shiftDistance(\r\n        self, s: str, t: str, nextCost: List[int], previousCost: List[int]\r\n    ) -> int:\r\n        m = 26\r\n        s1 = [0] * (m << 1 | 1)\r\n        s2 = [0] * (m << 1 | 1)\r\n        for i in range(m << 1):\r\n            s1[i + 1] = s1[i] + nextCost[i % m]\r\n            s2[i + 1] = s2[i] + previousCost[(i + 1) % m]\r\n        ans = 0\r\n        for a, b in zip(s, t):\r\n            x, y = ord(a) - ord(\"a\"), ord(b) - ord(\"a\")\r\n            c1 = s1[y + m if y < x else y] - s1[x]\r\n            c2 = s2[x + m if x < y else x] - s2[y]\r\n            ans += min(c1, c2)\r\n        return ans",
