{
    "problemName": "perfect-squares",
    "language": "python3",
    "code": "class Solution:\r\n    def numSquares(self, n: int) -> int:\r\n        m = int(sqrt(n))\r\n        f = [[inf] * (n + 1) for _ in range(m + 1)]\r\n        f[0][0] = 0\r\n        for i in range(1, m + 1):\r\n            for j in range(n + 1):\r\n                f[i][j] = f[i - 1][j]\r\n                if j >= i * i:\r\n                    f[i][j] = min(f[i][j], f[i][j - i * i] + 1)\r\n        return f[m][n]",
