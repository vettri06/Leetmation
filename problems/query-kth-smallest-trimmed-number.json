    "problemName": "query-kth-smallest-trimmed-number",
    "language": "python3",
    "code": "class Solution:\r\n    def smallestTrimmedNumbers(\r\n        self, nums: List[str], queries: List[List[int]]\r\n    ) -> List[int]:\r\n        ans = []\r\n        for k, trim in queries:\r\n            t = sorted((v[-trim:], i) for i, v in enumerate(nums))\r\n            ans.append(t[k - 1][1])\r\n        return ans",
