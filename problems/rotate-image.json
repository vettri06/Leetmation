    "problemName": "rotate-image",
    "language": "python3",
    "code": "class Solution:\r\n    def rotate(self, matrix: List[List[int]]) -> None:\r\n        n = len(matrix)\r\n        for i in range(n >> 1):\r\n            for j in range(n):\r\n                matrix[i][j], matrix[n - i - 1][j] = matrix[n - i - 1][j], matrix[i][j]\r\n        for i in range(n):\r\n            for j in range(i):\r\n                matrix[i][j], matrix[j][i] = matrix[j][i], matrix[i][j]",
