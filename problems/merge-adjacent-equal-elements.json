{
    "problemName": "merge-adjacent-equal-elements",
    "language": "python3",
    "code": "class Solution:\r\n    def mergeAdjacent(self, nums: List[int]) -> List[int]:\r\n        stk = []\r\n        for x in nums:\r\n            stk.append(x)\r\n            while len(stk) > 1 and stk[-1] == stk[-2]:\r\n                stk.append(stk.pop() + stk.pop())\r\n        return stk",
