    "problemName": "count-common-words-with-one-occurrence",
    "language": "python3",
    "code": "class Solution:\r\n    def countWords(self, words1: List[str], words2: List[str]) -> int:\r\n        cnt1 = Counter(words1)\r\n        cnt2 = Counter(words2)\r\n        return sum(v == 1 and cnt2[w] == 1 for w, v in cnt1.items())",
