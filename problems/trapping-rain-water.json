    "problemName": "trapping-rain-water",
    "language": "python3",
    "code": "class Solution:\r\n    def trap(self, height: List[int]) -> int:\r\n        n = len(height)\r\n        left = [height[0]] * n\r\n        right = [height[-1]] * n\r\n        for i in range(1, n):\r\n            left[i] = max(left[i - 1], height[i])\r\n            right[n - i - 1] = max(right[n - i], height[n - i - 1])\r\n        return sum(min(l, r) - h for l, r, h in zip(left, right, height))",
