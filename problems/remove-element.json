{
    "problemName": "remove-element",
    "language": "python3",
    "code": "class Solution:\r\n    def removeElement(self, nums: List[int], val: int) -> int:\r\n        k = 0\r\n        for x in nums:\r\n            if x != val:\r\n                nums[k] = x\r\n                k += 1\r\n        return k",
