{
    "problemName": "find-original-array-from-doubled-array",
    "language": "python3",
    "code": "class Solution:\r\n    def findOriginalArray(self, changed: List[int]) -> List[int]:\r\n        changed.sort()\r\n        cnt = Counter(changed)\r\n        ans = []\r\n        for x in changed:\r\n            if cnt[x] == 0:\r\n                continue\r\n            cnt[x] -= 1\r\n            if cnt[x << 1] <= 0:\r\n                return []\r\n            cnt[x << 1] -= 1\r\n            ans.append(x)\r\n        return ans",
