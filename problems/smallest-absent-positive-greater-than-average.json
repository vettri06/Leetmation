    "problemName": "smallest-absent-positive-greater-than-average",
    "language": "python3",
    "code": "class Solution:\r\n    def smallestAbsent(self, nums: List[int]) -> int:\r\n        s = set(nums)\r\n        ans = max(1, sum(nums) // len(nums) + 1)\r\n        while ans in s:\r\n            ans += 1\r\n        return ans",
