    "problemName": "reverse-bits",
    "language": "python3",
    "code": "class Solution:\r\n    def reverseBits(self, n: int) -> int:\r\n        ans = 0\r\n        for i in range(32):\r\n            ans |= (n & 1) << (31 - i)\r\n            n >>= 1\r\n        return ans",
