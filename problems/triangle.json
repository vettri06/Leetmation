{
    "problemName": "triangle",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumTotal(self, triangle: List[List[int]]) -> int:\r\n        n = len(triangle)\r\n        f = [[0] * (n + 1) for _ in range(n + 1)]\r\n        for i in range(n - 1, -1, -1):\r\n            for j in range(i + 1):\r\n                f[i][j] = min(f[i + 1][j], f[i + 1][j + 1]) + triangle[i][j]\r\n        return f[0][0]",
