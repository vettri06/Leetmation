    "problemName": "smallest-pair-with-different-frequencies",
    "language": "python3",
    "code": "class Solution:\r\n    def minDistinctFreqPair(self, nums: list[int]) -> list[int]:\r\n        cnt = Counter(nums)\r\n        x = min(cnt.keys())\r\n        min_y = inf\r\n        for y in cnt.keys():\r\n            if y < min_y and cnt[x] != cnt[y]:\r\n                min_y = y\r\n        return [-1, -1] if min_y == inf else [x, min_y]",
