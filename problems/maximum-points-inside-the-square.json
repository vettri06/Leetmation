    "problemName": "maximum-points-inside-the-square",
    "language": "python3",
    "code": "class Solution:\r\n    def maxPointsInsideSquare(self, points: List[List[int]], s: str) -> int:\r\n        g = defaultdict(list)\r\n        for i, (x, y) in enumerate(points):\r\n            g[max(abs(x), abs(y))].append(i)\r\n        vis = set()\r\n        ans = 0\r\n        for d in sorted(g):\r\n            idx = g[d]\r\n            for i in idx:\r\n                if s[i] in vis:\r\n                    return ans\r\n                vis.add(s[i])\r\n            ans += len(idx)\r\n        return ans",
