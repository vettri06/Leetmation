    "code": "class Solution:\r\n    def restoreString(self, s: str, indices: List[int]) -> str:\r\n        ans = [None] * len(s)\r\n        for c, j in zip(s, indices):\r\n            ans[j] = c\r\n        return \"\".join(ans)",
