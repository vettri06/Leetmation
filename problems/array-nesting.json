{
    "problemName": "array-nesting",
    "language": "python3",
    "code": "class Solution:\r\n    def arrayNesting(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        vis = [False] * n\r\n        res = 0\r\n        for i in range(n):\r\n            if vis[i]:\r\n                continue\r\n            cur, m = nums[i], 1\r\n            vis[cur] = True\r\n            while nums[cur] != nums[i]:\r\n                cur = nums[cur]\r\n                m += 1\r\n                vis[cur] = True\r\n            res = max(res, m)\r\n        return res",
