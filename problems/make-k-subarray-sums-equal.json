{
    "problemName": "make-k-subarray-sums-equal",
    "language": "python3",
    "code": "class Solution:\r\n    def makeSubKSumEqual(self, arr: List[int], k: int) -> int:\r\n        n = len(arr)\r\n        g = gcd(n, k)\r\n        ans = 0\r\n        for i in range(g):\r\n            t = sorted(arr[i:n:g])\r\n            mid = t[len(t) >> 1]\r\n            ans += sum(abs(x - mid) for x in t)\r\n        return ans",
