{
    "problemName": "next-greater-element-i",
    "language": "python3",
    "code": "class Solution:\r\n    def nextGreaterElement(self, nums1: List[int], nums2: List[int]) -> List[int]:\r\n        stk = []\r\n        d = {}\r\n        for x in nums2[::-1]:\r\n            while stk and stk[-1] < x:\r\n                stk.pop()\r\n            if stk:\r\n                d[x] = stk[-1]\r\n            stk.append(x)\r\n        return [d.get(x, -1) for x in nums1]",
