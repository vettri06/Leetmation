{
    "problemName": "calculate-amount-paid-in-taxes",
    "language": "python3",
    "code": "class Solution:\r\n    def calculateTax(self, brackets: List[List[int]], income: int) -> float:\r\n        ans = prev = 0\r\n        for upper, percent in brackets:\r\n            ans += max(0, min(income, upper) - prev) * percent\r\n            prev = upper\r\n        return ans / 100",
