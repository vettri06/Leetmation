    "problemName": "monotone-increasing-digits",
    "language": "python3",
    "code": "class Solution:\r\n    def monotoneIncreasingDigits(self, n: int) -> int:\r\n        s = list(str(n))\r\n        i = 1\r\n        while i < len(s) and s[i - 1] <= s[i]:\r\n            i += 1\r\n        if i < len(s):\r\n            while i and s[i - 1] > s[i]:\r\n                s[i - 1] = str(int(s[i - 1]) - 1)\r\n                i -= 1\r\n            i += 1\r\n            while i < len(s):\r\n                s[i] = '9'\r\n                i += 1\r\n        return int(''.join(s))",
