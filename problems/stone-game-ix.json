    "problemName": "stone-game-ix",
    "language": "python3",
    "code": "class Solution:\r\n    def stoneGameIX(self, stones: List[int]) -> bool:\r\n        def check(cnt: List[int]) -> bool:\r\n            if cnt[1] == 0:\r\n                return False\r\n            cnt[1] -= 1\r\n            r = 1 + min(cnt[1], cnt[2]) * 2 + cnt[0]\r\n            if cnt[1] > cnt[2]:\r\n                cnt[1] -= 1\r\n                r += 1\r\n            return r % 2 == 1 and cnt[1] != cnt[2]\r\n\r\n        c1 = [0] * 3\r\n        for x in stones:\r\n            c1[x % 3] += 1\r\n        c2 = [c1[0], c1[2], c1[1]]\r\n        return check(c1) or check(c2)",
