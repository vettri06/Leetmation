{
    "problemName": "maximize-sum-of-device-ratings",
    "language": "python3",
    "code": "class Solution:\r\n    def maxRatings(self, units: List[List[int]]) -> int:\r\n        n = len(units[0])\r\n        if n == 1:\r\n            return sum(x[0] for x in units)\r\n\r\n        ans = 0\r\n        mn = mn2 = inf\r\n        for x in units:\r\n            x.sort()\r\n            ans += x[1]\r\n            mn2 = min(mn2, x[1])\r\n            mn = min(mn, x[0])\r\n        ans -= mn2 - mn\r\n        return ans",
