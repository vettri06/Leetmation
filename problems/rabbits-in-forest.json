    "problemName": "rabbits-in-forest",
    "language": "python3",
    "code": "class Solution:\r\n    def numRabbits(self, answers: List[int]) -> int:\r\n        cnt = Counter(answers)\r\n        ans = 0\r\n        for x, v in cnt.items():\r\n            group = x + 1\r\n            ans += (v + group - 1) // group * group\r\n        return ans",
