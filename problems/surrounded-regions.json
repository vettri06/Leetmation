    "problemName": "surrounded-regions",
    "language": "python3",
    "code": "class Solution:\r\n    def solve(self, board: List[List[str]]) -> None:\r\n        def dfs(i: int, j: int):\r\n            if not (0 <= i < m and 0 <= j < n and board[i][j] == \"O\"):\r\n                return\r\n            board[i][j] = \".\"\r\n            for a, b in pairwise((-1, 0, 1, 0, -1)):\r\n                dfs(i + a, j + b)\r\n\r\n        m, n = len(board), len(board[0])\r\n        for i in range(m):\r\n            dfs(i, 0)\r\n            dfs(i, n - 1)\r\n        for j in range(n):\r\n            dfs(0, j)\r\n            dfs(m - 1, j)\r\n        for i in range(m):\r\n            for j in range(n):\r\n                if board[i][j] == \".\":\r\n                    board[i][j] = \"O\"\r\n                elif board[i][j] == \"O\":\r\n                    board[i][j] = \"X\"",
