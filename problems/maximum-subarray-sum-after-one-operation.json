{
    "problemName": "maximum-subarray-sum-after-one-operation",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSumAfterOperation(self, nums: List[int]) -> int:\r\n        f = g = 0\r\n        ans = -inf\r\n        for x in nums:\r\n            ff = max(f, 0) + x\r\n            gg = max(max(f, 0) + x * x, g + x)\r\n            f, g = ff, gg\r\n            ans = max(ans, f, g)\r\n        return ans",
