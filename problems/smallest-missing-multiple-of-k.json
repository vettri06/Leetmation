{
    "problemName": "smallest-missing-multiple-of-k",
    "language": "python3",
    "code": "class Solution:\r\n    def missingMultiple(self, nums: List[int], k: int) -> int:\r\n        s = set(nums)\r\n        for i in count(1):\r\n            x = k * i\r\n            if x not in s:\r\n                return x",
