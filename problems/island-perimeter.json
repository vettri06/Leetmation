    "problemName": "island-perimeter",
    "language": "python3",
    "code": "class Solution:\r\n    def islandPerimeter(self, grid: List[List[int]]) -> int:\r\n        m, n = len(grid), len(grid[0])\r\n        ans = 0\r\n        for i in range(m):\r\n            for j in range(n):\r\n                if grid[i][j] == 1:\r\n                    ans += 4\r\n                    if i < m - 1 and grid[i + 1][j] == 1:\r\n                        ans -= 2\r\n                    if j < n - 1 and grid[i][j + 1] == 1:\r\n                        ans -= 2\r\n        return ans",
