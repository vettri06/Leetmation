    "problemName": "maximum-performance-of-a-team",
    "language": "python3",
    "code": "class Solution:\r\n    def maxPerformance(\r\n        self, n: int, speed: List[int], efficiency: List[int], k: int\r\n    ) -> int:\r\n        t = sorted(zip(speed, efficiency), key=lambda x: -x[1])\r\n        ans = tot = 0\r\n        mod = 10**9 + 7\r\n        h = []\r\n        for s, e in t:\r\n            tot += s\r\n            ans = max(ans, tot * e)\r\n            heappush(h, s)\r\n            if len(h) == k:\r\n                tot -= heappop(h)\r\n        return ans % mod",
