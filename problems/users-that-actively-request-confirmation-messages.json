    "language": "mysql",
    "code": "SELECT DISTINCT user_id\r\nFROM\r\n    Confirmations AS c1\r\n    JOIN Confirmations AS c2 USING (user_id)\r\nWHERE\r\n    c1.time_stamp < c2.time_stamp\r\n    AND TIMESTAMPDIFF(SECOND, c1.time_stamp, c2.time_stamp) <= 24 * 60 * 60;",
