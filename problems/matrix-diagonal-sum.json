{
    "problemName": "matrix-diagonal-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def diagonalSum(self, mat: List[List[int]]) -> int:\r\n        ans = 0\r\n        n = len(mat)\r\n        for i, row in enumerate(mat):\r\n            j = n - i - 1\r\n            ans += row[i] + (0 if j == i else row[j])\r\n        return ans",
