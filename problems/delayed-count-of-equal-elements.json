{
    "problemName": "delayed-count-of-equal-elements",
    "language": "python3",
    "code": "class Solution:\r\n    def delayedCount(self, nums: List[int], k: int) -> List[int]:\r\n        n = len(nums)\r\n        cnt = Counter()\r\n        ans = [0] * n\r\n        for i in range(n - k - 2, -1, -1):\r\n            cnt[nums[i + k + 1]] += 1\r\n            ans[i] = cnt[nums[i]]\r\n        return ans",
