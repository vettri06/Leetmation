    "language": "python3",
    "code": "class Solution:\r\n    def distinctAverages(self, nums: List[int]) -> int:\r\n        nums.sort()\r\n        return len(set(nums[i] + nums[-i - 1] for i in range(len(nums) >> 1)))",
