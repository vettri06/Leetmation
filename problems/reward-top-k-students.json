{
    "problemName": "reward-top-k-students",
    "language": "python3",
    "code": "class Solution:\r\n    def topStudents(\r\n        self,\r\n        positive_feedback: List[str],\r\n        negative_feedback: List[str],\r\n        report: List[str],\r\n        student_id: List[int],\r\n        k: int,\r\n    ) -> List[int]:\r\n        ps = set(positive_feedback)\r\n        ns = set(negative_feedback)\r\n        arr = []\r\n        for sid, r in zip(student_id, report):\r\n            t = 0\r\n            for w in r.split():\r\n                if w in ps:\r\n                    t += 3\r\n                elif w in ns:\r\n                    t -= 1\r\n            arr.append((t, sid))\r\n        arr.sort(key=lambda x: (-x[0], x[1]))\r\n        return [v[1] for v in arr[:k]]",
