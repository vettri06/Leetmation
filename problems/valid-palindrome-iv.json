    "code": "class Solution:\r\n    def makePalindrome(self, s: str) -> bool:\r\n        i, j = 0, len(s) - 1\r\n        cnt = 0\r\n        while i < j:\r\n            cnt += s[i] != s[j]\r\n            i, j = i + 1, j - 1\r\n        return cnt <= 2",
