{
    "problemName": "unique-paths",
    "language": "python3",
    "code": "class Solution:\r\n    def uniquePaths(self, m: int, n: int) -> int:\r\n        f = [[0] * n for _ in range(m)]\r\n        f[0][0] = 1\r\n        for i in range(m):\r\n            for j in range(n):\r\n                if i:\r\n                    f[i][j] += f[i - 1][j]\r\n                if j:\r\n                    f[i][j] += f[i][j - 1]\r\n        return f[-1][-1]",
