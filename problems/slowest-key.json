    "problemName": "slowest-key",
    "language": "python3",
    "code": "class Solution:\r\n    def slowestKey(self, releaseTimes: List[int], keysPressed: str) -> str:\r\n        ans = keysPressed[0]\r\n        mx = releaseTimes[0]\r\n        for i in range(1, len(keysPressed)):\r\n            d = releaseTimes[i] - releaseTimes[i - 1]\r\n            if d > mx or (d == mx and ord(keysPressed[i]) > ord(ans)):\r\n                mx = d\r\n                ans = keysPressed[i]\r\n        return ans",
