{
    "problemName": "count-substrings-with-k-frequency-characters-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfSubstrings(self, s: str, k: int) -> int:\r\n        cnt = Counter()\r\n        ans = l = 0\r\n        for c in s:\r\n            cnt[c] += 1\r\n            while cnt[c] >= k:\r\n                cnt[s[l]] -= 1\r\n                l += 1\r\n            ans += l\r\n        return ans",
