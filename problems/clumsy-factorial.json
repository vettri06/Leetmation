{
    "problemName": "clumsy-factorial",
    "language": "python3",
    "code": "class Solution:\r\n    def clumsy(self, n: int) -> int:\r\n        k = 0\r\n        stk = [n]\r\n        for x in range(n - 1, 0, -1):\r\n            if k == 0:\r\n                stk.append(stk.pop() * x)\r\n            elif k == 1:\r\n                stk.append(int(stk.pop() / x))\r\n            elif k == 2:\r\n                stk.append(x)\r\n            else:\r\n                stk.append(-x)\r\n            k = (k + 1) % 4\r\n        return sum(stk)",
