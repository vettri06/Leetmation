{
    "problemName": "sum-of-subarray-ranges",
    "language": "python3",
    "code": "class Solution:\r\n    def subArrayRanges(self, nums: List[int]) -> int:\r\n        ans, n = 0, len(nums)\r\n        for i in range(n - 1):\r\n            mi = mx = nums[i]\r\n            for j in range(i + 1, n):\r\n                mi = min(mi, nums[j])\r\n                mx = max(mx, nums[j])\r\n                ans += mx - mi\r\n        return ans",
