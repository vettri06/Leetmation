{
    "problemName": "maximize-points-after-choosing-k-tasks",
    "language": "python3",
    "code": "class Solution:\r\n    def maxPoints(self, technique1: List[int], technique2: List[int], k: int) -> int:\r\n        n = len(technique1)\r\n        idx = sorted(range(n), key=lambda i: -(technique1[i] - technique2[i]))\r\n        ans = sum(technique2)\r\n        for i in idx[:k]:\r\n            ans -= technique2[i]\r\n            ans += technique1[i]\r\n        for i in idx[k:]:\r\n            if technique1[i] >= technique2[i]:\r\n                ans -= technique2[i]\r\n                ans += technique1[i]\r\n        return ans",
