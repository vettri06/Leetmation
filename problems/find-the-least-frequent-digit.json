{
    "problemName": "find-the-least-frequent-digit",
    "language": "python3",
    "code": "class Solution:\r\n    def getLeastFrequentDigit(self, n: int) -> int:\r\n        cnt = [0] * 10\r\n        while n:\r\n            n, x = divmod(n, 10)\r\n            cnt[x] += 1\r\n        ans, f = 0, inf\r\n        for x, v in enumerate(cnt):\r\n            if 0 < v < f:\r\n                f = v\r\n                ans = x\r\n        return ans",
