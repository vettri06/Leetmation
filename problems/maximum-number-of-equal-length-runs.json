    "language": "python3",
    "code": "class Solution:\r\n    def maxSameLengthRuns(self, s: str) -> int:\r\n        cnt = Counter()\r\n        for _, g in groupby(s):\r\n            cnt[len(list(g))] += 1\r\n        return max(cnt.values())",
