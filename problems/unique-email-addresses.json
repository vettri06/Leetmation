{
    "problemName": "unique-email-addresses",
    "language": "python3",
    "code": "class Solution:\r\n    def numUniqueEmails(self, emails: List[str]) -> int:\r\n        s = set()\r\n        for email in emails:\r\n            local, domain = email.split(\"@\")\r\n            t = []\r\n            for c in local:\r\n                if c == \".\":\r\n                    continue\r\n                if c == \"+\":\r\n                    break\r\n                t.append(c)\r\n            s.add(\"\".join(t) + \"@\" + domain)\r\n        return len(s)",
