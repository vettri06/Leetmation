{
    "problemName": "binary-trees-with-factors",
    "language": "python3",
    "code": "class Solution:\r\n    def numFactoredBinaryTrees(self, arr: List[int]) -> int:\r\n        mod = 10**9 + 7\r\n        n = len(arr)\r\n        arr.sort()\r\n        idx = {v: i for i, v in enumerate(arr)}\r\n        f = [1] * n\r\n        for i, a in enumerate(arr):\r\n            for j in range(i):\r\n                b = arr[j]\r\n                if a % b == 0 and (c := (a // b)) in idx:\r\n                    f[i] = (f[i] + f[j] * f[idx[c]]) % mod\r\n        return sum(f) % mod",
