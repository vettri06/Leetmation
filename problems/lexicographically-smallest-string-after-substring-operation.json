{
    "problemName": "lexicographically-smallest-string-after-substring-operation",
    "language": "python3",
    "code": "class Solution:\r\n    def smallestString(self, s: str) -> str:\r\n        n = len(s)\r\n        i = 0\r\n        while i < n and s[i] == \"a\":\r\n            i += 1\r\n        if i == n:\r\n            return s[:-1] + \"z\"\r\n        j = i\r\n        while j < n and s[j] != \"a\":\r\n            j += 1\r\n        return s[:i] + \"\".join(chr(ord(c) - 1) for c in s[i:j]) + s[j:]",
