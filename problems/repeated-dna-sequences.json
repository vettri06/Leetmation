    "problemName": "repeated-dna-sequences",
    "language": "python3",
    "code": "class Solution:\r\n    def findRepeatedDnaSequences(self, s: str) -> List[str]:\r\n        cnt = Counter()\r\n        ans = []\r\n        for i in range(len(s) - 10 + 1):\r\n            t = s[i : i + 10]\r\n            cnt[t] += 1\r\n            if cnt[t] == 2:\r\n                ans.append(t)\r\n        return ans",
