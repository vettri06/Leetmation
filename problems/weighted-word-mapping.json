    "code": "class Solution:\r\n    def mapWordWeights(self, words: List[str], weights: List[int]) -> str:\r\n        ans = []\r\n        for w in words:\r\n            s = sum(weights[ord(c) - ord('a')] for c in w)\r\n            ans.append(ascii_lowercase[25 - s % 26])\r\n        return ''.join(ans)",
