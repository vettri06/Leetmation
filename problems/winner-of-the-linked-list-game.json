{
    "problemName": "winner-of-the-linked-list-game",
    "language": "python3",
    "code": "# Definition for singly-linked list.\r\n# class ListNode:\r\n#     def __init__(self, val=0, next=None):\r\n#         self.val = val\r\n#         self.next = next\r\nclass Solution:\r\n    def gameResult(self, head: Optional[ListNode]) -> str:\r\n        odd = even = 0\r\n        while head:\r\n            a = head.val\r\n            b = head.next.val\r\n            odd += a < b\r\n            even += a > b\r\n            head = head.next.next\r\n        if odd > even:\r\n            return \"Odd\"\r\n        if odd < even:\r\n            return \"Even\"\r\n        return \"Tie\"",
    "problemId": 3062,
