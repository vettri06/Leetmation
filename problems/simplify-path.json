{
    "problemName": "simplify-path",
    "language": "python3",
    "code": "class Solution:\r\n    def simplifyPath(self, path: str) -> str:\r\n        stk = []\r\n        for s in path.split('/'):\r\n            if not s or s == '.':\r\n                continue\r\n            if s == '..':\r\n                if stk:\r\n                    stk.pop()\r\n            else:\r\n                stk.append(s)\r\n        return '/' + '/'.join(stk)",
