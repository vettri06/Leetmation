{
    "problemName": "optimal-partition-of-string",
    "language": "python3",
    "code": "class Solution:\r\n    def partitionString(self, s: str) -> int:\r\n        ans, mask = 1, 0\r\n        for x in map(lambda c: ord(c) - ord(\"a\"), s):\r\n            if mask >> x & 1:\r\n                ans += 1\r\n                mask = 0\r\n            mask |= 1 << x\r\n        return ans",
