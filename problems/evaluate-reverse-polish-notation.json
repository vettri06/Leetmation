{
    "problemName": "evaluate-reverse-polish-notation",
    "language": "python3",
    "code": "import operator\r\n\r\n\r\nclass Solution:\r\n    def evalRPN(self, tokens: List[str]) -> int:\r\n        opt = {\r\n            \"+\": operator.add,\r\n            \"-\": operator.sub,\r\n            \"*\": operator.mul,\r\n            \"/\": operator.truediv,\r\n        }\r\n        s = []\r\n        for token in tokens:\r\n            if token in opt:\r\n                s.append(int(opt[token](s.pop(-2), s.pop(-1))))\r\n            else:\r\n                s.append(int(token))\r\n        return s[0]",
