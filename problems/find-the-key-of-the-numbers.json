{
    "problemName": "find-the-key-of-the-numbers",
    "language": "python3",
    "code": "class Solution:\r\n    def generateKey(self, num1: int, num2: int, num3: int) -> int:\r\n        ans, k = 0, 1\r\n        for _ in range(4):\r\n            x = min(num1 // k % 10, num2 // k % 10, num3 // k % 10)\r\n            ans += x * k\r\n            k *= 10\r\n        return ans",
