{
    "problemName": "alternating-groups-i",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfAlternatingGroups(self, colors: List[int]) -> int:\r\n        k = 3\r\n        n = len(colors)\r\n        ans = cnt = 0\r\n        for i in range(n << 1):\r\n            if i and colors[i % n] == colors[(i - 1) % n]:\r\n                cnt = 1\r\n            else:\r\n                cnt += 1\r\n            ans += i >= n and cnt >= k\r\n        return ans",
