    "problemName": "calculate-money-in-leetcode-bank",
    "language": "python3",
    "code": "class Solution:\r\n    def totalMoney(self, n: int) -> int:\r\n        k, b = divmod(n, 7)\r\n        s1 = (28 + 28 + 7 * (k - 1)) * k // 2\r\n        s2 = (k + 1 + k + 1 + b - 1) * b // 2\r\n        return s1 + s2",
