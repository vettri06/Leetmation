{
    "problemName": "minimum-additions-to-make-valid-string",
    "language": "python3",
    "code": "class Solution:\r\n    def addMinimum(self, word: str) -> int:\r\n        s = 'abc'\r\n        ans, n = 0, len(word)\r\n        i = j = 0\r\n        while j < n:\r\n            if word[j] != s[i]:\r\n                ans += 1\r\n            else:\r\n                j += 1\r\n            i = (i + 1) % 3\r\n        if word[-1] != 'c':\r\n            ans += 1 if word[-1] == 'b' else 2\r\n        return ans",
