{
    "problemName": "find-the-sum-of-encrypted-integers",
    "language": "python3",
    "code": "class Solution:\r\n    def sumOfEncryptedInt(self, nums: List[int]) -> int:\r\n        def encrypt(x: int) -> int:\r\n            mx = p = 0\r\n            while x:\r\n                x, v = divmod(x, 10)\r\n                mx = max(mx, v)\r\n                p = p * 10 + 1\r\n            return mx * p\r\n\r\n        return sum(encrypt(x) for x in nums)",
