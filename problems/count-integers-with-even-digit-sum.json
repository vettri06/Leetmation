{
    "problemName": "count-integers-with-even-digit-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def countEven(self, num: int) -> int:\r\n        ans = 0\r\n        for x in range(1, num + 1):\r\n            s = 0\r\n            while x:\r\n                s += x % 10\r\n                x //= 10\r\n            ans += s % 2 == 0\r\n        return ans",
