{
    "problemName": "longest-repeating-substring",
    "language": "python3",
    "code": "class Solution:\r\n    def longestRepeatingSubstring(self, s: str) -> int:\r\n        n = len(s)\r\n        f = [[0] * n for _ in range(n)]\r\n        ans = 0\r\n        for i in range(1, n):\r\n            for j in range(i):\r\n                if s[i] == s[j]:\r\n                    f[i][j] = 1 + (f[i - 1][j - 1] if j else 0)\r\n                    ans = max(ans, f[i][j])\r\n        return ans",
