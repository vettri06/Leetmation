{
    "problemName": "reverse-integer",
    "language": "python3",
    "code": "class Solution:\r\n    def reverse(self, x: int) -> int:\r\n        ans = 0\r\n        mi, mx = -(2**31), 2**31 - 1\r\n        while x:\r\n            if ans < mi // 10 + 1 or ans > mx // 10:\r\n                return 0\r\n            y = x % 10\r\n            if x < 0 and y > 0:\r\n                y -= 10\r\n            ans = ans * 10 + y\r\n            x = (x - y) // 10\r\n        return ans",
