{
    "problemName": "unique-binary-search-trees",
    "language": "python3",
    "code": "class Solution:\r\n    def numTrees(self, n: int) -> int:\r\n        f = [1] + [0] * n\r\n        for i in range(n + 1):\r\n            for j in range(i):\r\n                f[i] += f[j] * f[i - j - 1]\r\n        return f[n]",
