{
    "problemName": "count-lattice-points-inside-a-circle",
    "language": "python3",
    "code": "class Solution:\r\n    def countLatticePoints(self, circles: List[List[int]]) -> int:\r\n        ans = 0\r\n        mx = max(x + r for x, _, r in circles)\r\n        my = max(y + r for _, y, r in circles)\r\n        for i in range(mx + 1):\r\n            for j in range(my + 1):\r\n                for x, y, r in circles:\r\n                    dx, dy = i - x, j - y\r\n                    if dx * dx + dy * dy <= r * r:\r\n                        ans += 1\r\n                        break\r\n        return ans",
