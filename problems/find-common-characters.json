{
    "problemName": "find-common-characters",
    "language": "python3",
    "code": "class Solution:\r\n    def commonChars(self, words: List[str]) -> List[str]:\r\n        cnt = Counter(words[0])\r\n        for w in words:\r\n            t = Counter(w)\r\n            for c in cnt:\r\n                cnt[c] = min(cnt[c], t[c])\r\n        return list(cnt.elements())",
