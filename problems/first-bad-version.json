{
    "problemName": "first-bad-version",
    "language": "python3",
    "code": "# The isBadVersion API is already defined for you.\r\n# def isBadVersion(version: int) -> bool:\r\n\r\n\r\nclass Solution:\r\n    def firstBadVersion(self, n: int) -> int:\r\n        l, r = 1, n\r\n        while l < r:\r\n            mid = (l + r) >> 1\r\n            if isBadVersion(mid):\r\n                r = mid\r\n            else:\r\n                l = mid + 1\r\n        return l",
