    "problemName": "minimum-cost-to-split-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def minCost(self, nums: List[int], k: int) -> int:\r\n        @cache\r\n        def dfs(i):\r\n            if i >= n:\r\n                return 0\r\n            cnt = Counter()\r\n            one = 0\r\n            ans = inf\r\n            for j in range(i, n):\r\n                cnt[nums[j]] += 1\r\n                if cnt[nums[j]] == 1:\r\n                    one += 1\r\n                elif cnt[nums[j]] == 2:\r\n                    one -= 1\r\n                ans = min(ans, k + j - i + 1 - one + dfs(j + 1))\r\n            return ans\r\n\r\n        n = len(nums)\r\n        return dfs(0)",
