{
    "problemName": "count-substrings-without-repeating-character",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfSpecialSubstrings(self, s: str) -> int:\r\n        cnt = Counter()\r\n        ans = j = 0\r\n        for i, c in enumerate(s):\r\n            cnt[c] += 1\r\n            while cnt[c] > 1:\r\n                cnt[s[j]] -= 1\r\n                j += 1\r\n            ans += i - j + 1\r\n        return ans",
