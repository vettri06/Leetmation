{
    "problemName": "valid-permutations-for-di-sequence",
    "language": "python3",
    "code": "class Solution:\r\n    def numPermsDISequence(self, s: str) -> int:\r\n        mod = 10**9 + 7\r\n        n = len(s)\r\n        f = [[0] * (n + 1) for _ in range(n + 1)]\r\n        f[0][0] = 1\r\n        for i, c in enumerate(s, 1):\r\n            if c == \"D\":\r\n                for j in range(i + 1):\r\n                    for k in range(j, i):\r\n                        f[i][j] = (f[i][j] + f[i - 1][k]) % mod\r\n            else:\r\n                for j in range(i + 1):\r\n                    for k in range(j):\r\n                        f[i][j] = (f[i][j] + f[i - 1][k]) % mod\r\n        return sum(f[n][j] for j in range(n + 1)) % mod",
