    "problemName": "sum-game",
    "language": "python3",
    "code": "class Solution:\r\n    def sumGame(self, num: str) -> bool:\r\n        n = len(num)\r\n        cnt1 = num[: n // 2].count(\"?\")\r\n        cnt2 = num[n // 2 :].count(\"?\")\r\n        s1 = sum(int(x) for x in num[: n // 2] if x != \"?\")\r\n        s2 = sum(int(x) for x in num[n // 2 :] if x != \"?\")\r\n        return (cnt1 + cnt2) % 2 == 1 or s1 - s2 != 9 * (cnt2 - cnt1) // 2",
