{
    "problemName": "decoded-string-at-index",
    "language": "python3",
    "code": "class Solution:\r\n    def decodeAtIndex(self, s: str, k: int) -> str:\r\n        m = 0\r\n        for c in s:\r\n            if c.isdigit():\r\n                m *= int(c)\r\n            else:\r\n                m += 1\r\n        for c in s[::-1]:\r\n            k %= m\r\n            if k == 0 and c.isalpha():\r\n                return c\r\n            if c.isdigit():\r\n                m //= int(c)\r\n            else:\r\n                m -= 1",
