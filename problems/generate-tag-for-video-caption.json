    "code": "class Solution:\r\n    def generateTag(self, caption: str) -> str:\r\n        words = [s.capitalize() for s in caption.split()]\r\n        if words:\r\n            words[0] = words[0].lower()\r\n        return \"#\" + \"\".join(words)[:99]",
