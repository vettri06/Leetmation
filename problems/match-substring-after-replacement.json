{
    "problemName": "match-substring-after-replacement",
    "language": "python3",
    "code": "class Solution:\r\n    def matchReplacement(self, s: str, sub: str, mappings: List[List[str]]) -> bool:\r\n        d = defaultdict(set)\r\n        for a, b in mappings:\r\n            d[a].add(b)\r\n        for i in range(len(s) - len(sub) + 1):\r\n            if all(a == b or a in d[b] for a, b in zip(s[i : i + len(sub)], sub)):\r\n                return True\r\n        return False",
