    "language": "python3",
    "code": "class Solution:\r\n    def toGoatLatin(self, sentence: str) -> str:\r\n        ans = []\r\n        for i, word in enumerate(sentence.split()):\r\n            if word.lower()[0] not in ['a', 'e', 'i', 'o', 'u']:\r\n                word = word[1:] + word[0]\r\n            word += 'ma'\r\n            word += 'a' * (i + 1)\r\n            ans.append(word)\r\n        return ' '.join(ans)",
