    "problemName": "queue-reconstruction-by-height",
    "language": "python3",
    "code": "class Solution:\r\n    def reconstructQueue(self, people: List[List[int]]) -> List[List[int]]:\r\n        people.sort(key=lambda x: (-x[0], x[1]))\r\n        ans = []\r\n        for p in people:\r\n            ans.insert(p[1], p)\r\n        return ans",
