{
    "problemName": "number-of-subarrays-with-bounded-maximum",
    "language": "python3",
    "code": "class Solution:\r\n    def numSubarrayBoundedMax(self, nums: List[int], left: int, right: int) -> int:\r\n        def f(x):\r\n            cnt = t = 0\r\n            for v in nums:\r\n                t = 0 if v > x else t + 1\r\n                cnt += t\r\n            return cnt\r\n\r\n        return f(right) - f(left - 1)",
