{
    "problemName": "minimum-moves-to-make-array-complementary",
    "language": "python3",
    "code": "class Solution:\r\n    def minMoves(self, nums: List[int], limit: int) -> int:\r\n        d = [0] * (2 * limit + 2)\r\n        n = len(nums)\r\n        for i in range(n // 2):\r\n            x, y = nums[i], nums[-i - 1]\r\n            if x > y:\r\n                x, y = y, x\r\n            d[2] += 2\r\n            d[x + 1] -= 2\r\n            d[x + 1] += 1\r\n            d[x + y] -= 1\r\n            d[x + y + 1] += 1\r\n            d[y + limit + 1] -= 1\r\n            d[y + limit + 1] += 2\r\n        return min(accumulate(d[2:]))",
