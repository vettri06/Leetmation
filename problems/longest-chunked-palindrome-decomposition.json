{
    "problemName": "longest-chunked-palindrome-decomposition",
    "language": "python3",
    "code": "class Solution:\r\n    def longestDecomposition(self, text: str) -> int:\r\n        ans = 0\r\n        i, j = 0, len(text) - 1\r\n        while i <= j:\r\n            k = 1\r\n            ok = False\r\n            while i + k - 1 < j - k + 1:\r\n                if text[i : i + k] == text[j - k + 1 : j + 1]:\r\n                    ans += 2\r\n                    i += k\r\n                    j -= k\r\n                    ok = True\r\n                    break\r\n                k += 1\r\n            if not ok:\r\n                ans += 1\r\n                break\r\n        return ans",
