{
    "problemName": "reorganize-string",
    "language": "python3",
    "code": "class Solution:\r\n    def reorganizeString(self, s: str) -> str:\r\n        n = len(s)\r\n        cnt = Counter(s)\r\n        mx = max(cnt.values())\r\n        if mx > (n + 1) // 2:\r\n            return ''\r\n        i = 0\r\n        ans = [None] * n\r\n        for k, v in cnt.most_common():\r\n            while v:\r\n                ans[i] = k\r\n                v -= 1\r\n                i += 2\r\n                if i >= n:\r\n                    i = 1\r\n        return ''.join(ans)",
