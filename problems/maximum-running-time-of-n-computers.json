{
    "problemName": "maximum-running-time-of-n-computers",
    "language": "python3",
    "code": "class Solution:\r\n    def maxRunTime(self, n: int, batteries: List[int]) -> int:\r\n        l, r = 0, sum(batteries)\r\n        while l < r:\r\n            mid = (l + r + 1) >> 1\r\n            if sum(min(x, mid) for x in batteries) >= n * mid:\r\n                l = mid\r\n            else:\r\n                r = mid - 1\r\n        return l",
