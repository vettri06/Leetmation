    "problemName": "longest-uncommon-subsequence-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def findLUSlength(self, strs: List[str]) -> int:\r\n        def check(s: str, t: str):\r\n            i = j = 0\r\n            while i < len(s) and j < len(t):\r\n                if s[i] == t[j]:\r\n                    i += 1\r\n                j += 1\r\n            return i == len(s)\r\n\r\n        ans = -1\r\n        for i, s in enumerate(strs):\r\n            for j, t in enumerate(strs):\r\n                if i != j and check(s, t):\r\n                    break\r\n            else:\r\n                ans = max(ans, len(s))\r\n        return ans",
