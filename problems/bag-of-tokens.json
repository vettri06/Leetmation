{
    "problemName": "bag-of-tokens",
    "language": "python3",
    "code": "class Solution:\r\n    def bagOfTokensScore(self, tokens: List[int], power: int) -> int:\r\n        tokens.sort()\r\n        ans = score = 0\r\n        i, j = 0, len(tokens) - 1\r\n        while i <= j:\r\n            if power >= tokens[i]:\r\n                power -= tokens[i]\r\n                score, i = score + 1, i + 1\r\n                ans = max(ans, score)\r\n            elif score:\r\n                power += tokens[j]\r\n                score, j = score - 1, j - 1\r\n            else:\r\n                break\r\n        return ans",
