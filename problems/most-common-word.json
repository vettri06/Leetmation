    "problemName": "most-common-word",
    "language": "python3",
    "code": "class Solution:\r\n    def mostCommonWord(self, paragraph: str, banned: List[str]) -> str:\r\n        s = set(banned)\r\n        p = Counter(re.findall('[a-z]+', paragraph.lower()))\r\n        return next(word for word, _ in p.most_common() if word not in s)",
