{
    "problemName": "maximum-product-of-two-digits",
    "language": "python3",
    "code": "class Solution:\r\n    def maxProduct(self, n: int) -> int:\r\n        a = b = 0\r\n        while n:\r\n            n, x = divmod(n, 10)\r\n            if a < x:\r\n                a, b = x, a\r\n            elif b < x:\r\n                b = x\r\n        return a * b",
