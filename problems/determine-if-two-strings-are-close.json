    "language": "python3",
    "code": "class Solution:\r\n    def closeStrings(self, word1: str, word2: str) -> bool:\r\n        cnt1, cnt2 = Counter(word1), Counter(word2)\r\n        return sorted(cnt1.values()) == sorted(cnt2.values()) and set(\r\n            cnt1.keys()\r\n        ) == set(cnt2.keys())",
