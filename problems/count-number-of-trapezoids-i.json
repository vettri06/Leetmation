{
    "problemName": "count-number-of-trapezoids-i",
    "language": "python3",
    "code": "class Solution:\r\n    def countTrapezoids(self, points: List[List[int]]) -> int:\r\n        mod = 10**9 + 7\r\n        cnt = Counter(p[1] for p in points)\r\n        ans = s = 0\r\n        for v in cnt.values():\r\n            t = v * (v - 1) // 2\r\n            ans = (ans + s * t) % mod\r\n            s += t\r\n        return ans",
