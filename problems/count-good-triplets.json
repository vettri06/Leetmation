{
    "problemName": "count-good-triplets",
    "language": "python3",
    "code": "class Solution:\r\n    def countGoodTriplets(self, arr: List[int], a: int, b: int, c: int) -> int:\r\n        ans, n = 0, len(arr)\r\n        for i in range(n):\r\n            for j in range(i + 1, n):\r\n                for k in range(j + 1, n):\r\n                    ans += (\r\n                        abs(arr[i] - arr[j]) <= a\r\n                        and abs(arr[j] - arr[k]) <= b\r\n                        and abs(arr[i] - arr[k]) <= c\r\n                    )\r\n        return ans",
