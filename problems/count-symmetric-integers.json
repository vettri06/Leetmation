{
    "problemName": "count-symmetric-integers",
    "language": "python3",
    "code": "class Solution:\r\n    def countSymmetricIntegers(self, low: int, high: int) -> int:\r\n        def f(x: int) -> bool:\r\n            s = str(x)\r\n            if len(s) & 1:\r\n                return False\r\n            n = len(s) // 2\r\n            return sum(map(int, s[:n])) == sum(map(int, s[n:]))\r\n\r\n        return sum(f(x) for x in range(low, high + 1))",
