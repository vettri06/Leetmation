{
    "problemName": "number-of-subsequences-with-odd-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def subsequenceCount(self, nums: List[int]) -> int:\r\n        mod = 10**9 + 7\r\n        f = [0] * 2\r\n        for x in nums:\r\n            if x % 2:\r\n                f[0], f[1] = (f[0] + f[1]) % mod, (f[0] + f[1] + 1) % mod\r\n            else:\r\n                f[0], f[1] = (f[0] + f[0] + 1) % mod, (f[1] + f[1]) % mod\r\n        return f[1]",
    "problemId": 3247,
