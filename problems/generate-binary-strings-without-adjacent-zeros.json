    "problemName": "generate-binary-strings-without-adjacent-zeros",
    "language": "python3",
    "code": "class Solution:\r\n    def validStrings(self, n: int) -> List[str]:\r\n        def dfs(i: int):\r\n            if i >= n:\r\n                ans.append(\"\".join(t))\r\n                return\r\n            for j in range(2):\r\n                if (j == 0 and (i == 0 or t[i - 1] == \"1\")) or j == 1:\r\n                    t.append(str(j))\r\n                    dfs(i + 1)\r\n                    t.pop()\r\n\r\n        ans = []\r\n        t = []\r\n        dfs(0)\r\n        return ans",
