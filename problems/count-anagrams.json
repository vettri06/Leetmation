    "problemName": "count-anagrams",
    "language": "python3",
    "code": "class Solution:\r\n    def countAnagrams(self, s: str) -> int:\r\n        mod = 10**9 + 7\r\n        ans = mul = 1\r\n        for w in s.split():\r\n            cnt = Counter()\r\n            for i, c in enumerate(w, 1):\r\n                cnt[c] += 1\r\n                mul = mul * cnt[c] % mod\r\n                ans = ans * i % mod\r\n        return ans * pow(mul, -1, mod) % mod",
