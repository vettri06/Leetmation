{
    "problemName": "minimum-increment-to-make-array-unique",
    "language": "python3",
    "code": "class Solution:\r\n    def minIncrementForUnique(self, nums: List[int]) -> int:\r\n        nums.sort()\r\n        ans, y = 0, -1\r\n        for x in nums:\r\n            y = max(y + 1, x)\r\n            ans += y - x\r\n        return ans",
