    "problemName": "special-permutations",
    "language": "python3",
    "code": "class Solution:\r\n    def specialPerm(self, nums: List[int]) -> int:\r\n        mod = 10**9 + 7\r\n        n = len(nums)\r\n        m = 1 << n\r\n        f = [[0] * n for _ in range(m)]\r\n        for i in range(1, m):\r\n            for j, x in enumerate(nums):\r\n                if i >> j & 1:\r\n                    ii = i ^ (1 << j)\r\n                    if ii == 0:\r\n                        f[i][j] = 1\r\n                        continue\r\n                    for k, y in enumerate(nums):\r\n                        if x % y == 0 or y % x == 0:\r\n                            f[i][j] = (f[i][j] + f[ii][k]) % mod\r\n        return sum(f[-1]) % mod",
