    "language": "python3",
    "code": "class Solution:\r\n    def isOneBitCharacter(self, bits: List[int]) -> bool:\r\n        i, n = 0, len(bits)\r\n        while i < n - 1:\r\n            i += bits[i] + 1\r\n        return i == n - 1",
