    "problemName": "find-maximum-number-of-string-pairs",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumNumberOfStringPairs(self, words: List[str]) -> int:\r\n        cnt = Counter()\r\n        ans = 0\r\n        for w in words:\r\n            ans += cnt[w[::-1]]\r\n            cnt[w] += 1\r\n        return ans",
