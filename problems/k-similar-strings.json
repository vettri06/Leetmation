    "code": "class Solution:\r\n    def kSimilarity(self, s1: str, s2: str) -> int:\r\n        def next(s):\r\n            i = 0\r\n            while s[i] == s2[i]:\r\n                i += 1\r\n            res = []\r\n            for j in range(i + 1, n):\r\n                if s[j] == s2[i] and s[j] != s2[j]:\r\n                    res.append(s2[: i + 1] + s[i + 1 : j] + s[i] + s[j + 1 :])\r\n            return res\r\n\r\n        q = deque([s1])\r\n        vis = {s1}\r\n        ans, n = 0, len(s1)\r\n        while 1:\r\n            for _ in range(len(q)):\r\n                s = q.popleft()\r\n                if s == s2:\r\n                    return ans\r\n                for nxt in next(s):\r\n                    if nxt not in vis:\r\n                        vis.add(nxt)\r\n                        q.append(nxt)\r\n            ans += 1",
