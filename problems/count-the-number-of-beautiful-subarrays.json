    "problemName": "count-the-number-of-beautiful-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def beautifulSubarrays(self, nums: List[int]) -> int:\r\n        cnt = Counter({0: 1})\r\n        ans = mask = 0\r\n        for x in nums:\r\n            mask ^= x\r\n            ans += cnt[mask]\r\n            cnt[mask] += 1\r\n        return ans",
