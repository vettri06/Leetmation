{
    "problemName": "mice-and-cheese",
    "language": "python3",
    "code": "class Solution:\r\n    def miceAndCheese(self, reward1: List[int], reward2: List[int], k: int) -> int:\r\n        n = len(reward1)\r\n        idx = sorted(range(n), key=lambda i: reward1[i] - reward2[i], reverse=True)\r\n        return sum(reward1[i] for i in idx[:k]) + sum(reward2[i] for i in idx[k:])",
