{
    "problemName": "password-strength",
    "language": "python3",
    "code": "class Solution:\r\n    def passwordStrength(self, password: str) -> int:\r\n        st = set(password)\r\n        ans = 0\r\n        for ch in st:\r\n            if ch.islower():\r\n                ans += 1\r\n            elif ch.isupper():\r\n                ans += 2\r\n            elif ch.isdigit():\r\n                ans += 3\r\n            else:\r\n                ans += 5\r\n        return ans",
