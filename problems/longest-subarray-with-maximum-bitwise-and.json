    "problemName": "longest-subarray-with-maximum-bitwise-and",
    "language": "python3",
    "code": "class Solution:\r\n    def longestSubarray(self, nums: List[int]) -> int:\r\n        mx = max(nums)\r\n        ans = cnt = 0\r\n        for x in nums:\r\n            if x == mx:\r\n                cnt += 1\r\n                ans = max(ans, cnt)\r\n            else:\r\n                cnt = 0\r\n        return ans",
