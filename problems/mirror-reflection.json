    "problemName": "mirror-reflection",
    "language": "python3",
    "code": "class Solution:\r\n    def mirrorReflection(self, p: int, q: int) -> int:\r\n        g = gcd(p, q)\r\n        p = (p // g) % 2\r\n        q = (q // g) % 2\r\n        if p == 1 and q == 1:\r\n            return 1\r\n        return 0 if p == 1 else 2",
