{
    "problemName": "minimum-addition-to-make-integer-beautiful",
    "language": "python3",
    "code": "class Solution:\r\n    def makeIntegerBeautiful(self, n: int, target: int) -> int:\r\n        def f(x: int) -> int:\r\n            y = 0\r\n            while x:\r\n                y += x % 10\r\n                x //= 10\r\n            return y\r\n\r\n        x = 0\r\n        while f(n + x) > target:\r\n            y = n + x\r\n            p = 10\r\n            while y % 10 == 0:\r\n                y //= 10\r\n                p *= 10\r\n            x = (y // 10 + 1) * p - n\r\n        return x",
