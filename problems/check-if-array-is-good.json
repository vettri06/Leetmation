    "problemName": "check-if-array-is-good",
    "language": "python3",
    "code": "class Solution:\r\n    def isGood(self, nums: List[int]) -> bool:\r\n        cnt = Counter(nums)\r\n        n = len(nums) - 1\r\n        return cnt[n] == 2 and all(cnt[i] for i in range(1, n))",
