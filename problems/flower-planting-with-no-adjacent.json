    "problemName": "flower-planting-with-no-adjacent",
    "language": "python3",
    "code": "class Solution:\r\n    def gardenNoAdj(self, n: int, paths: List[List[int]]) -> List[int]:\r\n        g = defaultdict(list)\r\n        for x, y in paths:\r\n            x, y = x - 1, y - 1\r\n            g[x].append(y)\r\n            g[y].append(x)\r\n        ans = [0] * n\r\n        for x in range(n):\r\n            used = {ans[y] for y in g[x]}\r\n            for c in range(1, 5):\r\n                if c not in used:\r\n                    ans[x] = c\r\n                    break\r\n        return ans",
