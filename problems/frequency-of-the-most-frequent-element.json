    "problemName": "frequency-of-the-most-frequent-element",
    "language": "python3",
    "code": "class Solution:\r\n    def maxFrequency(self, nums: List[int], k: int) -> int:\r\n        def check(m: int) -> bool:\r\n            for i in range(m, n + 1):\r\n                if nums[i - 1] * m - (s[i] - s[i - m]) <= k:\r\n                    return True\r\n            return False\r\n\r\n        n = len(nums)\r\n        nums.sort()\r\n        s = list(accumulate(nums, initial=0))\r\n        l, r = 1, n\r\n        while l < r:\r\n            mid = (l + r + 1) >> 1\r\n            if check(mid):\r\n                l = mid\r\n            else:\r\n                r = mid - 1\r\n        return l",
