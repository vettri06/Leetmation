    "problemName": "first-element-with-unique-frequency",
    "language": "python3",
    "code": "class Solution:\r\n    def firstUniqueFreq(self, nums: List[int]) -> int:\r\n        cnt = Counter(nums)\r\n        freq = Counter(cnt.values())\r\n        for x in nums:\r\n            if freq[cnt[x]] == 1:\r\n                return x\r\n        return -1",
