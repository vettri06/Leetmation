{
    "problemName": "minimum-array-end",
    "language": "python3",
    "code": "class Solution:\r\n    def minEnd(self, n: int, x: int) -> int:\r\n        n -= 1\r\n        ans = x\r\n        for i in range(31):\r\n            if x >> i & 1 ^ 1:\r\n                ans |= (n & 1) << i\r\n                n >>= 1\r\n        ans |= n << 31\r\n        return ans",
