{
    "problemName": "k-th-smallest-prime-fraction",
    "language": "python3",
    "code": "class Solution:\r\n    def kthSmallestPrimeFraction(self, arr: List[int], k: int) -> List[int]:\r\n        h = [(1 / y, 0, j + 1) for j, y in enumerate(arr[1:])]\r\n        heapify(h)\r\n        for _ in range(k - 1):\r\n            _, i, j = heappop(h)\r\n            if i + 1 < j:\r\n                heappush(h, (arr[i + 1] / arr[j], i + 1, j))\r\n        return [arr[h[0][1]], arr[h[0][2]]]",
