{
    "problemName": "self-dividing-numbers",
    "language": "python3",
    "code": "class Solution:\r\n    def selfDividingNumbers(self, left: int, right: int) -> List[int]:\r\n        def check(x: int) -> bool:\r\n            y = x\r\n            while y:\r\n                if y % 10 == 0 or x % (y % 10):\r\n                    return False\r\n                y //= 10\r\n            return True\r\n\r\n        return [x for x in range(left, right + 1) if check(x)]",
