    "problemName": "fizz-buzz",
    "language": "python3",
    "code": "class Solution:\r\n    def fizzBuzz(self, n: int) -> List[str]:\r\n        ans = []\r\n        for i in range(1, n + 1):\r\n            if i % 15 == 0:\r\n                ans.append('FizzBuzz')\r\n            elif i % 3 == 0:\r\n                ans.append('Fizz')\r\n            elif i % 5 == 0:\r\n                ans.append('Buzz')\r\n            else:\r\n                ans.append(str(i))\r\n        return ans",
