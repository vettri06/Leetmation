{
    "problemName": "maximum-area-of-longest-diagonal-rectangle",
    "language": "python3",
    "code": "class Solution:\r\n    def areaOfMaxDiagonal(self, dimensions: List[List[int]]) -> int:\r\n        ans = mx = 0\r\n        for l, w in dimensions:\r\n            t = l**2 + w**2\r\n            if mx < t:\r\n                mx = t\r\n                ans = l * w\r\n            elif mx == t:\r\n                ans = max(ans, l * w)\r\n        return ans",
