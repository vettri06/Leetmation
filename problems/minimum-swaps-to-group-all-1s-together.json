{
    "problemName": "minimum-swaps-to-group-all-1s-together",
    "language": "python3",
    "code": "class Solution:\r\n    def minSwaps(self, data: List[int]) -> int:\r\n        k = data.count(1)\r\n        mx = t = sum(data[:k])\r\n        for i in range(k, len(data)):\r\n            t += data[i]\r\n            t -= data[i - k]\r\n            mx = max(mx, t)\r\n        return k - mx",
