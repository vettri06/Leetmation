{
    "problemName": "node-with-highest-edge-score",
    "language": "python3",
    "code": "class Solution:\r\n    def edgeScore(self, edges: List[int]) -> int:\r\n        ans = 0\r\n        cnt = [0] * len(edges)\r\n        for i, j in enumerate(edges):\r\n            cnt[j] += i\r\n            if cnt[ans] < cnt[j] or (cnt[ans] == cnt[j] and j < ans):\r\n                ans = j\r\n        return ans",
