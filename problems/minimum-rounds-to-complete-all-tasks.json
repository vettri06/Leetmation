{
    "problemName": "minimum-rounds-to-complete-all-tasks",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumRounds(self, tasks: List[int]) -> int:\r\n        cnt = Counter(tasks)\r\n        ans = 0\r\n        for v in cnt.values():\r\n            if v == 1:\r\n                return -1\r\n            ans += v // 3 + (v % 3 != 0)\r\n        return ans",
