{
    "problemName": "longest-increasing-subsequence",
    "language": "python3",
    "code": "class Solution:\r\n    def lengthOfLIS(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        f = [1] * n\r\n        for i in range(1, n):\r\n            for j in range(i):\r\n                if nums[j] < nums[i]:\r\n                    f[i] = max(f[i], f[j] + 1)\r\n        return max(f)",
