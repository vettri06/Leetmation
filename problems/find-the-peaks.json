    "language": "python3",
    "code": "class Solution:\r\n    def findPeaks(self, mountain: List[int]) -> List[int]:\r\n        return [\r\n            i\r\n            for i in range(1, len(mountain) - 1)\r\n            if mountain[i - 1] < mountain[i] > mountain[i + 1]\r\n        ]",
