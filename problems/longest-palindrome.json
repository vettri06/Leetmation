    "problemName": "longest-palindrome",
    "language": "python3",
    "code": "class Solution:\r\n    def longestPalindrome(self, s: str) -> int:\r\n        cnt = Counter(s)\r\n        ans = sum(v // 2 * 2 for v in cnt.values())\r\n        ans += int(ans < len(s))\r\n        return ans",
