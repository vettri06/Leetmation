    "problemName": "monotonic-array",
    "language": "python3",
    "code": "class Solution:\r\n    def isMonotonic(self, nums: List[int]) -> bool:\r\n        asc = all(a <= b for a, b in pairwise(nums))\r\n        desc = all(a >= b for a, b in pairwise(nums))\r\n        return asc or desc",
