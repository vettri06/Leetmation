    "problemName": "single-element-in-a-sorted-array",
    "language": "python3",
    "code": "class Solution:\r\n    def singleNonDuplicate(self, nums: List[int]) -> int:\r\n        l, r = 0, len(nums) - 1\r\n        while l < r:\r\n            mid = (l + r) >> 1\r\n            if nums[mid] != nums[mid ^ 1]:\r\n                r = mid\r\n            else:\r\n                l = mid + 1\r\n        return nums[l]",
