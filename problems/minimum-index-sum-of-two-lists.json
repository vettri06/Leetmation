{
    "problemName": "minimum-index-sum-of-two-lists",
    "language": "python3",
    "code": "class Solution:\r\n    def findRestaurant(self, list1: List[str], list2: List[str]) -> List[str]:\r\n        d = {s: i for i, s in enumerate(list2)}\r\n        ans = []\r\n        mi = inf\r\n        for i, s in enumerate(list1):\r\n            if s in d:\r\n                j = d[s]\r\n                if i + j < mi:\r\n                    mi = i + j\r\n                    ans = [s]\r\n                elif i + j == mi:\r\n                    ans.append(s)\r\n        return ans",
