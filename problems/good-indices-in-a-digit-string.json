    "problemName": "good-indices-in-a-digit-string",
    "language": "python3",
    "code": "class Solution:\r\n    def goodIndices(self, s: str) -> List[int]:\r\n        ans = []\r\n        for i in range(len(s)):\r\n            t = str(i)\r\n            k = len(t)\r\n            if s[i + 1 - k : i + 1] == t:\r\n                ans.append(i)\r\n        return ans",
