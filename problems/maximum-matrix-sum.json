{
    "problemName": "maximum-matrix-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def maxMatrixSum(self, matrix: List[List[int]]) -> int:\r\n        mi = inf\r\n        s = cnt = 0\r\n        for row in matrix:\r\n            for x in row:\r\n                cnt += x < 0\r\n                y = abs(x)\r\n                mi = min(mi, y)\r\n                s += y\r\n        return s if cnt % 2 == 0 else s - mi * 2",
