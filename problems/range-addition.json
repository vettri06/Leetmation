{
    "problemName": "range-addition",
    "language": "python3",
    "code": "class Solution:\r\n    def getModifiedArray(self, length: int, updates: List[List[int]]) -> List[int]:\r\n        d = [0] * length\r\n        for l, r, c in updates:\r\n            d[l] += c\r\n            if r + 1 < length:\r\n                d[r + 1] -= c\r\n        return list(accumulate(d))",
