    "problemName": "watering-plants-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumRefill(self, plants: List[int], capacityA: int, capacityB: int) -> int:\r\n        a, b = capacityA, capacityB\r\n        ans = 0\r\n        i, j = 0, len(plants) - 1\r\n        while i < j:\r\n            if a < plants[i]:\r\n                ans += 1\r\n                a = capacityA\r\n            a -= plants[i]\r\n            if b < plants[j]:\r\n                ans += 1\r\n                b = capacityB\r\n            b -= plants[j]\r\n            i, j = i + 1, j - 1\r\n        ans += i == j and max(a, b) < plants[i]\r\n        return ans",
