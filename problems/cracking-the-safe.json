{
    "problemName": "cracking-the-safe",
    "language": "python3",
    "code": "class Solution:\r\n    def crackSafe(self, n: int, k: int) -> str:\r\n        def dfs(u):\r\n            for x in range(k):\r\n                e = u * 10 + x\r\n                if e not in vis:\r\n                    vis.add(e)\r\n                    v = e % mod\r\n                    dfs(v)\r\n                    ans.append(str(x))\r\n\r\n        mod = 10 ** (n - 1)\r\n        vis = set()\r\n        ans = []\r\n        dfs(0)\r\n        ans.append(\"0\" * (n - 1))\r\n        return \"\".join(ans)",
