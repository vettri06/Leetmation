    "language": "python3",
    "code": "class Solution:\r\n    def digitFrequencyScore(self, n: int) -> int:\r\n        ans = 0\r\n        while n:\r\n            n, x = divmod(n, 10)\r\n            ans += x\r\n        return ans",
