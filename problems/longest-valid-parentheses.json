{
    "problemName": "longest-valid-parentheses",
    "language": "python3",
    "code": "class Solution:\r\n    def longestValidParentheses(self, s: str) -> int:\r\n        n = len(s)\r\n        f = [0] * (n + 1)\r\n        for i, c in enumerate(s, 1):\r\n            if c == \")\":\r\n                if i > 1 and s[i - 2] == \"(\":\r\n                    f[i] = f[i - 2] + 2\r\n                else:\r\n                    j = i - f[i - 1] - 1\r\n                    if j and s[j - 1] == \"(\":\r\n                        f[i] = f[i - 1] + 2 + f[j - 1]\r\n        return max(f)",
    "problemId": 32,
