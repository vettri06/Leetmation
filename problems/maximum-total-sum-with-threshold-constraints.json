    "problemName": "maximum-total-sum-with-threshold-constraints",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSum(self, nums: List[int], threshold: List[int]) -> int:\r\n        n = len(nums)\r\n        idx = sorted(range(n), key=lambda i: threshold[i])\r\n        sl = SortedList()\r\n        step = 1\r\n        ans = i = 0\r\n        while True:\r\n            while i < n and threshold[idx[i]] <= step:\r\n                sl.add(nums[idx[i]])\r\n                i += 1\r\n            if not sl:\r\n                break\r\n            ans += sl.pop()\r\n            step += 1\r\n        return ans",
