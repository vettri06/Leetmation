    "problemName": "maximum-alternating-subarray-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumAlternatingSubarraySum(self, nums: List[int]) -> int:\r\n        ans = f = g = -inf\r\n        for x in nums:\r\n            f, g = max(g, 0) + x, f - x\r\n            ans = max(ans, f, g)\r\n        return ans",
