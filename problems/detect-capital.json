    "code": "class Solution:\r\n    def detectCapitalUse(self, word: str) -> bool:\r\n        cnt = sum(c.isupper() for c in word)\r\n        return cnt == 0 or cnt == len(word) or (cnt == 1 and word[0].isupper())",
