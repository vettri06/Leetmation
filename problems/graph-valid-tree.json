{
    "problemName": "graph-valid-tree",
    "language": "python3",
    "code": "class Solution:\r\n    def validTree(self, n: int, edges: List[List[int]]) -> bool:\r\n        def find(x: int) -> int:\r\n            if p[x] != x:\r\n                p[x] = find(p[x])\r\n            return p[x]\r\n\r\n        p = list(range(n))\r\n        for a, b in edges:\r\n            pa, pb = find(a), find(b)\r\n            if pa == pb:\r\n                return False\r\n            p[pa] = pb\r\n            n -= 1\r\n        return n == 1",
