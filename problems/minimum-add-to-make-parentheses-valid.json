{
    "problemName": "minimum-add-to-make-parentheses-valid",
    "language": "python3",
    "code": "class Solution:\r\n    def minAddToMakeValid(self, s: str) -> int:\r\n        stk = []\r\n        for c in s:\r\n            if c == ')' and stk and stk[-1] == '(':\r\n                stk.pop()\r\n            else:\r\n                stk.append(c)\r\n        return len(stk)",
