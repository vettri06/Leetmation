{
    "problemName": "lexicographically-smallest-string-after-reverse",
    "language": "python3",
    "code": "class Solution:\r\n    def lexSmallest(self, s: str) -> str:\r\n        ans = s\r\n        for k in range(1, len(s) + 1):\r\n            t1 = s[:k][::-1] + s[k:]\r\n            t2 = s[:-k] + s[-k:][::-1]\r\n            ans = min(ans, t1, t2)\r\n        return ans",
