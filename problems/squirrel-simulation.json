{
    "problemName": "squirrel-simulation",
    "language": "python3",
    "code": "class Solution:\r\n    def minDistance(\r\n        self,\r\n        height: int,\r\n        width: int,\r\n        tree: List[int],\r\n        squirrel: List[int],\r\n        nuts: List[List[int]],\r\n    ) -> int:\r\n        tr, tc = tree\r\n        sr, sc = squirrel\r\n        s = sum(abs(r - tr) + abs(c - tc) for r, c in nuts) * 2\r\n        ans = inf\r\n        for r, c in nuts:\r\n            a = abs(r - tr) + abs(c - tc)\r\n            b = abs(r - sr) + abs(c - sc)\r\n            ans = min(ans, s - a + b)\r\n        return ans",
