    "problemName": "perfect-number",
    "language": "python3",
    "code": "class Solution:\r\n    def checkPerfectNumber(self, num: int) -> bool:\r\n        if num == 1:\r\n            return False\r\n        s, i = 1, 2\r\n        while i <= num // i:\r\n            if num % i == 0:\r\n                s += i\r\n                if i != num // i:\r\n                    s += num // i\r\n            i += 1\r\n        return s == num",
