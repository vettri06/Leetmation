    "language": "python3",
    "code": "class Solution:\r\n    def isConsecutive(self, nums: List[int]) -> bool:\r\n        mi, mx = min(nums), max(nums)\r\n        return len(set(nums)) == mx - mi + 1 == len(nums)",
