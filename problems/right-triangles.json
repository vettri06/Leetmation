    "problemName": "right-triangles",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfRightTriangles(self, grid: List[List[int]]) -> int:\r\n        rows = [0] * len(grid)\r\n        cols = [0] * len(grid[0])\r\n        for i, row in enumerate(grid):\r\n            for j, x in enumerate(row):\r\n                rows[i] += x\r\n                cols[j] += x\r\n        ans = 0\r\n        for i, row in enumerate(grid):\r\n            for j, x in enumerate(row):\r\n                if x:\r\n                    ans += (rows[i] - 1) * (cols[j] - 1)\r\n        return ans",
