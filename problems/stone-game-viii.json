    "problemName": "stone-game-viii",
    "language": "python3",
    "code": "class Solution:\r\n    def stoneGameVIII(self, stones: List[int]) -> int:\r\n        @cache\r\n        def dfs(i: int) -> int:\r\n            if i >= len(stones) - 1:\r\n                return s[-1]\r\n            return max(dfs(i + 1), s[i] - dfs(i + 1))\r\n\r\n        s = list(accumulate(stones))\r\n        return dfs(1)",
