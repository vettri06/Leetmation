{
    "problemName": "maximum-absolute-sum-of-any-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def maxAbsoluteSum(self, nums: List[int]) -> int:\r\n        f = g = 0\r\n        ans = 0\r\n        for x in nums:\r\n            f = max(f, 0) + x\r\n            g = min(g, 0) + x\r\n            ans = max(ans, f, abs(g))\r\n        return ans",
