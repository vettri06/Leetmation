{
    "problemName": "minimize-the-maximum-difference-of-pairs",
    "language": "python3",
    "code": "class Solution:\r\n    def minimizeMax(self, nums: List[int], p: int) -> int:\r\n        def check(diff: int) -> bool:\r\n            cnt = i = 0\r\n            while i < len(nums) - 1:\r\n                if nums[i + 1] - nums[i] <= diff:\r\n                    cnt += 1\r\n                    i += 2\r\n                else:\r\n                    i += 1\r\n            return cnt >= p\r\n\r\n        nums.sort()\r\n        return bisect_left(range(nums[-1] - nums[0] + 1), True, key=check)",
