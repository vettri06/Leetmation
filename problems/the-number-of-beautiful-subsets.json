    "problemName": "the-number-of-beautiful-subsets",
    "language": "python3",
    "code": "class Solution:\r\n    def beautifulSubsets(self, nums: List[int], k: int) -> int:\r\n        def dfs(i: int) -> None:\r\n            nonlocal ans\r\n            if i >= len(nums):\r\n                ans += 1\r\n                return\r\n            dfs(i + 1)\r\n            if cnt[nums[i] + k] == 0 and cnt[nums[i] - k] == 0:\r\n                cnt[nums[i]] += 1\r\n                dfs(i + 1)\r\n                cnt[nums[i]] -= 1\r\n\r\n        ans = -1\r\n        cnt = Counter()\r\n        dfs(0)\r\n        return ans",
