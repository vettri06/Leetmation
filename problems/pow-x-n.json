{
    "problemName": "pow-x-n",
    "language": "python3",
    "code": "class Solution:\r\n    def myPow(self, x: float, n: int) -> float:\r\n        def qpow(a: float, n: int) -> float:\r\n            ans = 1\r\n            while n:\r\n                if n & 1:\r\n                    ans *= a\r\n                a *= a\r\n                n >>= 1\r\n            return ans\r\n\r\n        return qpow(x, n) if n >= 0 else 1 / qpow(x, -n)",
