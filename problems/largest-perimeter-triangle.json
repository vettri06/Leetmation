{
    "problemName": "largest-perimeter-triangle",
    "language": "python3",
    "code": "class Solution:\r\n    def largestPerimeter(self, nums: List[int]) -> int:\r\n        nums.sort()\r\n        for i in range(len(nums) - 1, 1, -1):\r\n            if (c := nums[i - 1] + nums[i - 2]) > nums[i]:\r\n                return c + nums[i]\r\n        return 0",
