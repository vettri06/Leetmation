    "language": "python3",
    "code": "class Solution:\r\n    def findRightInterval(self, intervals: List[List[int]]) -> List[int]:\r\n        n = len(intervals)\r\n        ans = [-1] * n\r\n        arr = sorted((st, i) for i, (st, _) in enumerate(intervals))\r\n        for i, (_, ed) in enumerate(intervals):\r\n            j = bisect_left(arr, (ed, -inf))\r\n            if j < n:\r\n                ans[i] = arr[j][1]\r\n        return ans",
