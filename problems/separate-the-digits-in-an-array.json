{
    "problemName": "separate-the-digits-in-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def separateDigits(self, nums: List[int]) -> List[int]:\r\n        ans = []\r\n        for x in nums:\r\n            t = []\r\n            while x:\r\n                t.append(x % 10)\r\n                x //= 10\r\n            ans.extend(t[::-1])\r\n        return ans",
