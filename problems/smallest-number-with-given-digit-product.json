{
    "problemName": "smallest-number-with-given-digit-product",
    "language": "python3",
    "code": "class Solution:\r\n    def smallestNumber(self, n: int) -> str:\r\n        cnt = [0] * 10\r\n        for i in range(9, 1, -1):\r\n            while n % i == 0:\r\n                n //= i\r\n                cnt[i] += 1\r\n        if n > 1:\r\n            return \"-1\"\r\n        ans = \"\".join(str(i) * cnt[i] for i in range(2, 10))\r\n        return ans if ans else \"1\"",
