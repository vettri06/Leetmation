{
    "problemName": "validate-stack-sequences",
    "language": "python3",
    "code": "class Solution:\r\n    def validateStackSequences(self, pushed: List[int], popped: List[int]) -> bool:\r\n        stk = []\r\n        i = 0\r\n        for x in pushed:\r\n            stk.append(x)\r\n            while stk and stk[-1] == popped[i]:\r\n                stk.pop()\r\n                i += 1\r\n        return i == len(popped)",
