    "problemName": "flip-game",
    "language": "python3",
    "code": "class Solution:\r\n    def generatePossibleNextMoves(self, currentState: str) -> List[str]:\r\n        s = list(currentState)\r\n        ans = []\r\n        for i, (a, b) in enumerate(pairwise(s)):\r\n            if a == b == \"+\":\r\n                s[i] = s[i + 1] = \"-\"\r\n                ans.append(\"\".join(s))\r\n                s[i] = s[i + 1] = \"+\"\r\n        return ans",
