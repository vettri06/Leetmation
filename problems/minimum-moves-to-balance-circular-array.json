{
    "problemName": "minimum-moves-to-balance-circular-array",
    "language": "python3",
    "code": "class Solution:\r\n    def minMoves(self, balance: List[int]) -> int:\r\n        if sum(balance) < 0:\r\n            return -1\r\n        mn = min(balance)\r\n        if mn >= 0:\r\n            return 0\r\n        need = -mn\r\n        i = balance.index(mn)\r\n        n = len(balance)\r\n        ans = 0\r\n        for j in range(1, n):\r\n            a = balance[(i - j + n) % n]\r\n            b = balance[(i + j - n) % n]\r\n            c1 = min(a, need)\r\n            need -= c1\r\n            ans += c1 * j\r\n            c2 = min(b, need)\r\n            need -= c2\r\n            ans += c2 * j\r\n        return ans",
