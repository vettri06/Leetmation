    "problemName": "split-array-into-consecutive-subsequences",
    "language": "python3",
    "code": "class Solution:\r\n    def isPossible(self, nums: List[int]) -> bool:\r\n        d = defaultdict(list)\r\n        for v in nums:\r\n            if h := d[v - 1]:\r\n                heappush(d[v], heappop(h) + 1)\r\n            else:\r\n                heappush(d[v], 1)\r\n        return all(not v or v and v[0] > 2 for v in d.values())",
