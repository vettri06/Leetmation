{
    "problemName": "maximize-expression-of-three-elements",
    "language": "python3",
    "code": "class Solution:\r\n    def maximizeExpressionOfThree(self, nums: List[int]) -> int:\r\n        a = b = -inf\r\n        c = inf\r\n        for x in nums:\r\n            if x < c:\r\n                c = x\r\n            if x >= a:\r\n                a, b = x, a\r\n            elif x > b:\r\n                b = x\r\n        return a + b - c",
