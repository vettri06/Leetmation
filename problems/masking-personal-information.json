    "problemName": "masking-personal-information",
    "language": "python3",
    "code": "class Solution:\r\n    def maskPII(self, s: str) -> str:\r\n        if s[0].isalpha():\r\n            s = s.lower()\r\n            return s[0] + '*****' + s[s.find('@') - 1 :]\r\n        s = ''.join(c for c in s if c.isdigit())\r\n        cnt = len(s) - 10\r\n        suf = '***-***-' + s[-4:]\r\n        return suf if cnt == 0 else f'+{\"*\" * cnt}-{suf}'",
