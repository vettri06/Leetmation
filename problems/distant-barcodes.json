    "problemName": "distant-barcodes",
    "language": "python3",
    "code": "class Solution:\r\n    def rearrangeBarcodes(self, barcodes: List[int]) -> List[int]:\r\n        cnt = Counter(barcodes)\r\n        barcodes.sort(key=lambda x: (-cnt[x], x))\r\n        n = len(barcodes)\r\n        ans = [0] * len(barcodes)\r\n        ans[::2] = barcodes[: (n + 1) // 2]\r\n        ans[1::2] = barcodes[(n + 1) // 2 :]\r\n        return ans",
