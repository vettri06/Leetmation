{
    "problemName": "count-nice-pairs-in-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def countNicePairs(self, nums: List[int]) -> int:\r\n        def rev(x):\r\n            y = 0\r\n            while x:\r\n                y = y * 10 + x % 10\r\n                x //= 10\r\n            return y\r\n\r\n        cnt = Counter(x - rev(x) for x in nums)\r\n        mod = 10**9 + 7\r\n        return sum(v * (v - 1) // 2 for v in cnt.values()) % mod",
