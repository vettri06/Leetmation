    "language": "python3",
    "code": "class Solution:\r\n    def sortSentence(self, s: str) -> str:\r\n        ws = s.split()\r\n        ans = [None] * len(ws)\r\n        for w in ws:\r\n            ans[int(w[-1]) - 1] = w[:-1]\r\n        return \" \".join(ans)",
