{
    "problemName": "minimum-path-cost-in-a-grid",
    "language": "python3",
    "code": "class Solution:\r\n    def minPathCost(self, grid: List[List[int]], moveCost: List[List[int]]) -> int:\r\n        m, n = len(grid), len(grid[0])\r\n        f = grid[0]\r\n        for i in range(1, m):\r\n            g = [inf] * n\r\n            for j in range(n):\r\n                for k in range(n):\r\n                    g[j] = min(g[j], f[k] + moveCost[grid[i - 1][k]][j] + grid[i][j])\r\n            f = g\r\n        return min(f)",
    "problemId": 2304,
