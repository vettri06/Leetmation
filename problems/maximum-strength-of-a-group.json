{
    "problemName": "maximum-strength-of-a-group",
    "language": "python3",
    "code": "class Solution:\r\n    def maxStrength(self, nums: List[int]) -> int:\r\n        ans = -inf\r\n        for i in range(1, 1 << len(nums)):\r\n            t = 1\r\n            for j, x in enumerate(nums):\r\n                if i >> j & 1:\r\n                    t *= x\r\n            ans = max(ans, t)\r\n        return ans",
