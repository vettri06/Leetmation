{
    "problemName": "compute-decimal-representation",
    "language": "python3",
    "code": "class Solution:\r\n    def decimalRepresentation(self, n: int) -> List[int]:\r\n        ans = []\r\n        p = 1\r\n        while n:\r\n            n, v = divmod(n, 10)\r\n            if v:\r\n                ans.append(p * v)\r\n            p *= 10\r\n        ans.reverse()\r\n        return ans",
