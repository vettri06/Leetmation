    "problemName": "reveal-cards-in-increasing-order",
    "language": "python3",
    "code": "class Solution:\r\n    def deckRevealedIncreasing(self, deck: List[int]) -> List[int]:\r\n        q = deque()\r\n        for v in sorted(deck, reverse=True):\r\n            if q:\r\n                q.appendleft(q.pop())\r\n            q.appendleft(v)\r\n        return list(q)",
