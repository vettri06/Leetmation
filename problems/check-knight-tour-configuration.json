{
    "problemName": "check-knight-tour-configuration",
    "language": "python3",
    "code": "class Solution:\r\n    def checkValidGrid(self, grid: List[List[int]]) -> bool:\r\n        if grid[0][0]:\r\n            return False\r\n        n = len(grid)\r\n        pos = [None] * (n * n)\r\n        for i in range(n):\r\n            for j in range(n):\r\n                pos[grid[i][j]] = (i, j)\r\n        for (x1, y1), (x2, y2) in pairwise(pos):\r\n            dx, dy = abs(x1 - x2), abs(y1 - y2)\r\n            ok = (dx == 1 and dy == 2) or (dx == 2 and dy == 1)\r\n            if not ok:\r\n                return False\r\n        return True",
