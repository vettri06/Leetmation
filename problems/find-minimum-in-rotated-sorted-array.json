    "problemName": "find-minimum-in-rotated-sorted-array",
    "language": "python3",
    "code": "class Solution:\r\n    def findMin(self, nums: List[int]) -> int:\r\n        l, r = 0, len(nums) - 1\r\n        while l < r:\r\n            mid = (l + r) >> 1\r\n            if nums[mid] > nums[-1]:\r\n                l = mid + 1\r\n            else:\r\n                r = mid\r\n        return nums[l]",
