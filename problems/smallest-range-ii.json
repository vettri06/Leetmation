    "problemName": "smallest-range-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def smallestRangeII(self, nums: List[int], k: int) -> int:\r\n        nums.sort()\r\n        ans = nums[-1] - nums[0]\r\n        for i in range(1, len(nums)):\r\n            mi = min(nums[0] + k, nums[i] - k)\r\n            mx = max(nums[i - 1] + k, nums[-1] - k)\r\n            ans = min(ans, mx - mi)\r\n        return ans",
