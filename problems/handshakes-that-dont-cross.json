{
    "problemName": "handshakes-that-dont-cross",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfWays(self, numPeople: int) -> int:\r\n        @cache\r\n        def dfs(i: int) -> int:\r\n            if i < 2:\r\n                return 1\r\n            ans = 0\r\n            for l in range(0, i, 2):\r\n                r = i - l - 2\r\n                ans += dfs(l) * dfs(r)\r\n                ans %= mod\r\n            return ans\r\n\r\n        mod = 10**9 + 7\r\n        return dfs(numPeople)",
