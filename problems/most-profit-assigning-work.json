{
    "problemName": "most-profit-assigning-work",
    "language": "python3",
    "code": "class Solution:\r\n    def maxProfitAssignment(\r\n        self, difficulty: List[int], profit: List[int], worker: List[int]\r\n    ) -> int:\r\n        worker.sort()\r\n        jobs = sorted(zip(difficulty, profit))\r\n        ans = mx = i = 0\r\n        for w in worker:\r\n            while i < len(jobs) and jobs[i][0] <= w:\r\n                mx = max(mx, jobs[i][1])\r\n                i += 1\r\n            ans += mx\r\n        return ans",
