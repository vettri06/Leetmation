    "problemName": "line-reflection",
    "language": "python3",
    "code": "class Solution:\r\n    def isReflected(self, points: List[List[int]]) -> bool:\r\n        min_x, max_x = inf, -inf\r\n        point_set = set()\r\n        for x, y in points:\r\n            min_x = min(min_x, x)\r\n            max_x = max(max_x, x)\r\n            point_set.add((x, y))\r\n        s = min_x + max_x\r\n        return all((s - x, y) in point_set for x, y in points)",
