{
    "problemName": "check-if-matrix-is-x-matrix",
    "language": "python3",
    "code": "class Solution:\r\n    def checkXMatrix(self, grid: List[List[int]]) -> bool:\r\n        for i, row in enumerate(grid):\r\n            for j, v in enumerate(row):\r\n                if i == j or i + j == len(grid) - 1:\r\n                    if v == 0:\r\n                        return False\r\n                elif v:\r\n                    return False\r\n        return True",
