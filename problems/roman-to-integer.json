    "problemName": "roman-to-integer",
    "language": "python3",
    "code": "class Solution:\r\n    def romanToInt(self, s: str) -> int:\r\n        d = {'I': 1, 'V': 5, 'X': 10, 'L': 50, 'C': 100, 'D': 500, 'M': 1000}\r\n        return sum((-1 if d[a] < d[b] else 1) * d[a] for a, b in pairwise(s)) + d[s[-1]]",
