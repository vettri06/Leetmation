{
    "problemName": "smallest-stable-index-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def firstStableIndex(self, nums: list[int], k: int) -> int:\r\n        n = len(nums)\r\n        right = [nums[-1]] * n\r\n        for i in range(n - 2, -1, -1):\r\n            right[i] = min(right[i + 1], nums[i])\r\n        left = 0\r\n        for i, x in enumerate(nums):\r\n            left = max(left, x)\r\n            if left - right[i] <= k:\r\n                return i\r\n        return -1",
