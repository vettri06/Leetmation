    "problemName": "time-needed-to-inform-all-employees",
    "language": "python3",
    "code": "class Solution:\r\n    def numOfMinutes(\r\n        self, n: int, headID: int, manager: List[int], informTime: List[int]\r\n    ) -> int:\r\n        def dfs(i: int) -> int:\r\n            ans = 0\r\n            for j in g[i]:\r\n                ans = max(ans, dfs(j) + informTime[i])\r\n            return ans\r\n\r\n        g = defaultdict(list)\r\n        for i, x in enumerate(manager):\r\n            g[x].append(i)\r\n        return dfs(headID)",
