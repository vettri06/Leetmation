{
    "problemName": "mirror-frequency-distance",
    "language": "python3",
    "code": "class Solution:\r\n    def mirrorFrequency(self, s: str) -> int:\r\n        freq = Counter(s)\r\n        ans = 0\r\n        vis = set()\r\n        for c, v in freq.items():\r\n            m = (\r\n                chr(ord(\"a\") + 25 - (ord(c) - ord(\"a\")))\r\n                if c.isalpha()\r\n                else str(9 - int(c))\r\n            )\r\n            if m in vis:\r\n                continue\r\n            vis.add(c)\r\n            ans += abs(v - freq[m])\r\n        return ans",
