{
    "problemName": "number-of-pairs-of-interchangeable-rectangles",
    "language": "python3",
    "code": "class Solution:\r\n    def interchangeableRectangles(self, rectangles: List[List[int]]) -> int:\r\n        ans = 0\r\n        cnt = Counter()\r\n        for w, h in rectangles:\r\n            g = gcd(w, h)\r\n            w, h = w // g, h // g\r\n            ans += cnt[(w, h)]\r\n            cnt[(w, h)] += 1\r\n        return ans",
