{
    "problemName": "type-of-triangle",
    "language": "python3",
    "code": "class Solution:\r\n    def triangleType(self, nums: List[int]) -> str:\r\n        nums.sort()\r\n        if nums[0] + nums[1] <= nums[2]:\r\n            return \"none\"\r\n        if nums[0] == nums[2]:\r\n            return \"equilateral\"\r\n        if nums[0] == nums[1] or nums[1] == nums[2]:\r\n            return \"isosceles\"\r\n        return \"scalene\"",
