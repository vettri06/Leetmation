    "problemName": "partition-to-k-equal-sum-subsets",
    "language": "python3",
    "code": "class Solution:\r\n    def canPartitionKSubsets(self, nums: List[int], k: int) -> bool:\r\n        def dfs(i: int) -> bool:\r\n            if i == len(nums):\r\n                return True\r\n            for j in range(k):\r\n                if j and cur[j] == cur[j - 1]:\r\n                    continue\r\n                cur[j] += nums[i]\r\n                if cur[j] <= s and dfs(i + 1):\r\n                    return True\r\n                cur[j] -= nums[i]\r\n            return False\r\n\r\n        s, mod = divmod(sum(nums), k)\r\n        if mod:\r\n            return False\r\n        cur = [0] * k\r\n        nums.sort(reverse=True)\r\n        return dfs(0)",
