{
    "problemName": "maximum-difference-score-in-a-grid",
    "language": "python3",
    "code": "class Solution:\r\n    def maxScore(self, grid: List[List[int]]) -> int:\r\n        f = [[0] * len(grid[0]) for _ in range(len(grid))]\r\n        ans = -inf\r\n        for i, row in enumerate(grid):\r\n            for j, x in enumerate(row):\r\n                mi = inf\r\n                if i:\r\n                    mi = min(mi, f[i - 1][j])\r\n                if j:\r\n                    mi = min(mi, f[i][j - 1])\r\n                ans = max(ans, x - mi)\r\n                f[i][j] = min(x, mi)\r\n        return ans",
