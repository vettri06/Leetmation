{
    "problemName": "maximum-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSubArray(self, nums: List[int]) -> int:\r\n        ans = f = nums[0]\r\n        for x in nums[1:]:\r\n            f = max(f, 0) + x\r\n            ans = max(ans, f)\r\n        return ans",
