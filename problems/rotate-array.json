{
    "problemName": "rotate-array",
    "language": "python3",
    "code": "class Solution:\r\n    def rotate(self, nums: List[int], k: int) -> None:\r\n        def reverse(i: int, j: int):\r\n            while i < j:\r\n                nums[i], nums[j] = nums[j], nums[i]\r\n                i, j = i + 1, j - 1\r\n\r\n        n = len(nums)\r\n        k %= n\r\n        reverse(0, n - 1)\r\n        reverse(0, k - 1)\r\n        reverse(k, n - 1)",
