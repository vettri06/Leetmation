{
    "problemName": "range-product-queries-of-powers",
    "language": "python3",
    "code": "class Solution:\r\n    def productQueries(self, n: int, queries: List[List[int]]) -> List[int]:\r\n        powers = []\r\n        while n:\r\n            x = n & -n\r\n            powers.append(x)\r\n            n -= x\r\n        mod = 10**9 + 7\r\n        ans = []\r\n        for l, r in queries:\r\n            x = 1\r\n            for i in range(l, r + 1):\r\n                x = x * powers[i] % mod\r\n            ans.append(x)\r\n        return ans",
