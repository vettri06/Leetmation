{
    "problemName": "removing-minimum-and-maximum-from-array",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumDeletions(self, nums: List[int]) -> int:\r\n        mi = mx = 0\r\n        for i, num in enumerate(nums):\r\n            if num < nums[mi]:\r\n                mi = i\r\n            if num > nums[mx]:\r\n                mx = i\r\n        if mi > mx:\r\n            mi, mx = mx, mi\r\n        return min(mx + 1, len(nums) - mi, mi + 1 + len(nums) - mx)",
