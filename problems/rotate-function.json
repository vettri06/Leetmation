{
    "problemName": "rotate-function",
    "language": "python3",
    "code": "class Solution:\r\n    def maxRotateFunction(self, nums: List[int]) -> int:\r\n        f = sum(i * v for i, v in enumerate(nums))\r\n        n, s = len(nums), sum(nums)\r\n        ans = f\r\n        for i in range(1, n):\r\n            f = f + s - n * nums[n - i]\r\n            ans = max(ans, f)\r\n        return ans",
