    "problemName": "exactly-one-consecutive-set-bits-pair",
    "language": "python3",
    "code": "class Solution:\r\n    def consecutiveSetBits(self, n: int) -> bool:\r\n        pre = 0\r\n        vis = False\r\n        while n:\r\n            cur = n & 1\r\n            if pre == cur == 1:\r\n                if vis:\r\n                    return False\r\n                vis = True\r\n            pre = cur\r\n            n = n >> 1\r\n        return vis",
