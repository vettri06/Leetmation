    "problemName": "zero-array-transformation-i",
    "language": "python3",
    "code": "class Solution:\r\n    def isZeroArray(self, nums: List[int], queries: List[List[int]]) -> bool:\r\n        d = [0] * (len(nums) + 1)\r\n        for l, r in queries:\r\n            d[l] += 1\r\n            d[r + 1] -= 1\r\n        s = 0\r\n        for x, y in zip(nums, d):\r\n            s += y\r\n            if x > s:\r\n                return False\r\n        return True",
