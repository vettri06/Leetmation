{
    "problemName": "coin-change-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def change(self, amount: int, coins: List[int]) -> int:\r\n        m, n = len(coins), amount\r\n        f = [[0] * (n + 1) for _ in range(m + 1)]\r\n        f[0][0] = 1\r\n        for i, x in enumerate(coins, 1):\r\n            for j in range(n + 1):\r\n                f[i][j] = f[i - 1][j]\r\n                if j >= x:\r\n                    f[i][j] += f[i][j - x]\r\n        return f[m][n]",
