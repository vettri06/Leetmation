    "problemName": "maximum-odd-binary-number",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumOddBinaryNumber(self, s: str) -> str:\r\n        cnt = s.count(\"1\")\r\n        return \"1\" * (cnt - 1) + (len(s) - cnt) * \"0\" + \"1\"",
