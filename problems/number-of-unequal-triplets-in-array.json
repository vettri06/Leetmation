{
    "problemName": "number-of-unequal-triplets-in-array",
    "language": "python3",
    "code": "class Solution:\r\n    def unequalTriplets(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        ans = 0\r\n        for i in range(n):\r\n            for j in range(i + 1, n):\r\n                for k in range(j + 1, n):\r\n                    ans += (\r\n                        nums[i] != nums[j] and nums[j] != nums[k] and nums[i] != nums[k]\r\n                    )\r\n        return ans",
