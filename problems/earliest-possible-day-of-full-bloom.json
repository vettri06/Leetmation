    "problemName": "earliest-possible-day-of-full-bloom",
    "language": "python3",
    "code": "class Solution:\r\n    def earliestFullBloom(self, plantTime: List[int], growTime: List[int]) -> int:\r\n        ans = t = 0\r\n        for pt, gt in sorted(zip(plantTime, growTime), key=lambda x: -x[1]):\r\n            t += pt\r\n            ans = max(ans, t + gt)\r\n        return ans",
