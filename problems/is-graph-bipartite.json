{
    "problemName": "is-graph-bipartite",
    "language": "python3",
    "code": "class Solution:\r\n    def isBipartite(self, graph: List[List[int]]) -> bool:\r\n        def dfs(a: int, c: int) -> bool:\r\n            color[a] = c\r\n            for b in graph[a]:\r\n                if color[b] == c or (color[b] == 0 and not dfs(b, -c)):\r\n                    return False\r\n            return True\r\n\r\n        n = len(graph)\r\n        color = [0] * n\r\n        for i in range(n):\r\n            if color[i] == 0 and not dfs(i, 1):\r\n                return False\r\n        return True",
