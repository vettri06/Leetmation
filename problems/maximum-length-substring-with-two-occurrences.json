{
    "problemName": "maximum-length-substring-with-two-occurrences",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumLengthSubstring(self, s: str) -> int:\r\n        cnt = Counter()\r\n        ans = i = 0\r\n        for j, c in enumerate(s):\r\n            cnt[c] += 1\r\n            while cnt[c] > 2:\r\n                cnt[s[i]] -= 1\r\n                i += 1\r\n            ans = max(ans, j - i + 1)\r\n        return ans",
