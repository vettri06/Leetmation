    "code": "class Solution:\r\n    def partition(self, s: str) -> List[List[str]]:\r\n        def dfs(i: int):\r\n            if i == n:\r\n                ans.append(t[:])\r\n                return\r\n            for j in range(i, n):\r\n                if f[i][j]:\r\n                    t.append(s[i : j + 1])\r\n                    dfs(j + 1)\r\n                    t.pop()\r\n\r\n        n = len(s)\r\n        f = [[True] * n for _ in range(n)]\r\n        for i in range(n - 1, -1, -1):\r\n            for j in range(i + 1, n):\r\n                f[i][j] = s[i] == s[j] and f[i + 1][j - 1]\r\n        ans = []\r\n        t = []\r\n        dfs(0)\r\n        return ans",
