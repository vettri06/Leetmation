{
    "problemName": "verifying-an-alien-dictionary",
    "language": "python3",
    "code": "class Solution:\r\n    def isAlienSorted(self, words: List[str], order: str) -> bool:\r\n        m = {c: i for i, c in enumerate(order)}\r\n        for i in range(20):\r\n            prev = -1\r\n            valid = True\r\n            for x in words:\r\n                curr = -1 if i >= len(x) else m[x[i]]\r\n                if prev > curr:\r\n                    return False\r\n                if prev == curr:\r\n                    valid = False\r\n                prev = curr\r\n            if valid:\r\n                return True\r\n        return True",
