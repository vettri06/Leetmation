{
    "problemName": "maximum-size-subarray-sum-equals-k",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSubArrayLen(self, nums: List[int], k: int) -> int:\r\n        d = {0: -1}\r\n        ans = s = 0\r\n        for i, x in enumerate(nums):\r\n            s += x\r\n            if s - k in d:\r\n                ans = max(ans, i - d[s - k])\r\n            if s not in d:\r\n                d[s] = i\r\n        return ans",
