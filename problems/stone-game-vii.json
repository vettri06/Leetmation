    "language": "python3",
    "code": "class Solution:\r\n    def stoneGameVII(self, stones: List[int]) -> int:\r\n        @cache\r\n        def dfs(i: int, j: int) -> int:\r\n            if i > j:\r\n                return 0\r\n            a = s[j + 1] - s[i + 1] - dfs(i + 1, j)\r\n            b = s[j] - s[i] - dfs(i, j - 1)\r\n            return max(a, b)\r\n\r\n        s = list(accumulate(stones, initial=0))\r\n        ans = dfs(0, len(stones) - 1)\r\n        dfs.cache_clear()\r\n        return ans",
