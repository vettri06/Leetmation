{
    "problemName": "brightest-position-on-street",
    "language": "python3",
    "code": "class Solution:\r\n    def brightestPosition(self, lights: List[List[int]]) -> int:\r\n        d = defaultdict(int)\r\n        for i, j in lights:\r\n            l, r = i - j, i + j\r\n            d[l] += 1\r\n            d[r + 1] -= 1\r\n        ans = s = mx = 0\r\n        for k in sorted(d):\r\n            s += d[k]\r\n            if mx < s:\r\n                mx = s\r\n                ans = k\r\n        return ans",
