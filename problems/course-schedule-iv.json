    "problemName": "course-schedule-iv",
    "language": "python3",
    "code": "class Solution:\r\n    def checkIfPrerequisite(\r\n        self, n: int, prerequisites: List[List[int]], queries: List[List[int]]\r\n    ) -> List[bool]:\r\n        f = [[False] * n for _ in range(n)]\r\n        for a, b in prerequisites:\r\n            f[a][b] = True\r\n        for k in range(n):\r\n            for i in range(n):\r\n                for j in range(n):\r\n                    if f[i][k] and f[k][j]:\r\n                        f[i][j] = True\r\n        return [f[a][b] for a, b in queries]",
