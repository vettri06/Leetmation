{
    "problemName": "minimum-cost-to-make-arrays-identical",
    "language": "python3",
    "code": "class Solution:\r\n    def minCost(self, arr: List[int], brr: List[int], k: int) -> int:\r\n        c1 = sum(abs(a - b) for a, b in zip(arr, brr))\r\n        arr.sort()\r\n        brr.sort()\r\n        c2 = k + sum(abs(a - b) for a, b in zip(arr, brr))\r\n        return min(c1, c2)",
