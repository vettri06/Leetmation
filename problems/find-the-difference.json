    "problemName": "find-the-difference",
    "language": "python3",
    "code": "class Solution:\r\n    def findTheDifference(self, s: str, t: str) -> str:\r\n        cnt = Counter(s)\r\n        for c in t:\r\n            cnt[c] -= 1\r\n            if cnt[c] < 0:\r\n                return c",
