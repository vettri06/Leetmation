{
    "problemName": "number-of-unique-good-subsequences",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfUniqueGoodSubsequences(self, binary: str) -> int:\r\n        f = g = 0\r\n        ans = 0\r\n        mod = 10**9 + 7\r\n        for c in binary:\r\n            if c == \"0\":\r\n                g = (g + f) % mod\r\n                ans = 1\r\n            else:\r\n                f = (f + g + 1) % mod\r\n        ans = (ans + f + g) % mod\r\n        return ans",
