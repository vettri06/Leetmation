    "problemName": "combination-sum-iii",
    "language": "python3",
    "code": "class Solution:\r\n    def combinationSum3(self, k: int, n: int) -> List[List[int]]:\r\n        def dfs(i: int, s: int):\r\n            if s == 0:\r\n                if len(t) == k:\r\n                    ans.append(t[:])\r\n                return\r\n            if i > 9 or i > s or len(t) >= k:\r\n                return\r\n            t.append(i)\r\n            dfs(i + 1, s - i)\r\n            t.pop()\r\n            dfs(i + 1, s)\r\n\r\n        ans = []\r\n        t = []\r\n        dfs(1, n)\r\n        return ans",
