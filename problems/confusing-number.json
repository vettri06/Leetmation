    "problemName": "confusing-number",
    "language": "python3",
    "code": "class Solution:\r\n    def confusingNumber(self, n: int) -> bool:\r\n        x, y = n, 0\r\n        d = [0, 1, -1, -1, -1, -1, 9, -1, 8, 6]\r\n        while x:\r\n            x, v = divmod(x, 10)\r\n            if d[v] < 0:\r\n                return False\r\n            y = y * 10 + d[v]\r\n        return y != n",
