    "problemName": "course-schedule",
    "language": "python3",
    "code": "class Solution:\r\n    def canFinish(self, numCourses: int, prerequisites: List[List[int]]) -> bool:\r\n        g = [[] for _ in range(numCourses)]\r\n        indeg = [0] * numCourses\r\n        for a, b in prerequisites:\r\n            g[b].append(a)\r\n            indeg[a] += 1\r\n        q = [i for i, x in enumerate(indeg) if x == 0]\r\n        for i in q:\r\n            numCourses -= 1\r\n            for j in g[i]:\r\n                indeg[j] -= 1\r\n                if indeg[j] == 0:\r\n                    q.append(j)\r\n        return numCourses == 0",
