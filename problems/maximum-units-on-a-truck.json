{
    "problemName": "maximum-units-on-a-truck",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumUnits(self, boxTypes: List[List[int]], truckSize: int) -> int:\r\n        ans = 0\r\n        for a, b in sorted(boxTypes, key=lambda x: -x[1]):\r\n            ans += b * min(truckSize, a)\r\n            truckSize -= a\r\n            if truckSize <= 0:\r\n                break\r\n        return ans",
