{
    "problemName": "maximize-profit-from-task-assignment",
    "language": "python3",
    "code": "class Solution:\r\n    def maxProfit(self, workers: List[int], tasks: List[List[int]]) -> int:\r\n        d = defaultdict(SortedList)\r\n        for skill, profit in tasks:\r\n            d[skill].add(profit)\r\n        ans = 0\r\n        for skill in workers:\r\n            if not d[skill]:\r\n                continue\r\n            ans += d[skill].pop()\r\n        mx = 0\r\n        for ls in d.values():\r\n            if ls:\r\n                mx = max(mx, ls[-1])\r\n        ans += mx\r\n        return ans",
