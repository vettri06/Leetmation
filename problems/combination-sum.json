    "problemName": "combination-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def combinationSum(self, candidates: List[int], target: int) -> List[List[int]]:\r\n        def dfs(i: int, s: int):\r\n            if s == 0:\r\n                ans.append(t[:])\r\n                return\r\n            if s < candidates[i]:\r\n                return\r\n            for j in range(i, len(candidates)):\r\n                t.append(candidates[j])\r\n                dfs(j, s - candidates[j])\r\n                t.pop()\r\n\r\n        candidates.sort()\r\n        t = []\r\n        ans = []\r\n        dfs(0, target)\r\n        return ans",
