    "code": "# Write your MySQL query statement below\r\nWITH\r\n    T AS (\r\n        SELECT\r\n            minute,\r\n            SUM(order_count) OVER (\r\n                ORDER BY minute\r\n                ROWS 5 PRECEDING\r\n            ) AS total_orders\r\n        FROM Orders\r\n    )\r\nSELECT minute / 6 AS interval_no, total_orders\r\nFROM T\r\nWHERE minute % 6 = 0;",
