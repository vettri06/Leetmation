    "code": "class Solution:\r\n    def trimTrailingVowels(self, s: str) -> str:\r\n        i = len(s) - 1\r\n        while i >= 0 and s[i] in \"aeiou\":\r\n            i -= 1\r\n        return s[: i + 1]",
