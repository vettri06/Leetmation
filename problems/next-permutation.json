    "problemName": "next-permutation",
    "language": "python3",
    "code": "class Solution:\r\n    def nextPermutation(self, nums: List[int]) -> None:\r\n        n = len(nums)\r\n        i = next((i for i in range(n - 2, -1, -1) if nums[i] < nums[i + 1]), -1)\r\n        if ~i:\r\n            j = next((j for j in range(n - 1, i, -1) if nums[j] > nums[i]))\r\n            nums[i], nums[j] = nums[j], nums[i]\r\n        nums[i + 1 :] = nums[i + 1 :][::-1]",
