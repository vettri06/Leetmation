    "problemName": "find-resultant-array-after-removing-anagrams",
    "language": "python3",
    "code": "class Solution:\r\n    def removeAnagrams(self, words: List[str]) -> List[str]:\r\n        def check(s: str, t: str) -> bool:\r\n            if len(s) != len(t):\r\n                return True\r\n            cnt = Counter(s)\r\n            for c in t:\r\n                cnt[c] -= 1\r\n                if cnt[c] < 0:\r\n                    return True\r\n            return False\r\n\r\n        return [words[0]] + [t for s, t in pairwise(words) if check(s, t)]",
