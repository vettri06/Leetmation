{
    "problemName": "license-key-formatting",
    "language": "python3",
    "code": "class Solution:\r\n    def licenseKeyFormatting(self, s: str, k: int) -> str:\r\n        n = len(s)\r\n        cnt = (n - s.count(\"-\")) % k or k\r\n        ans = []\r\n        for i, c in enumerate(s):\r\n            if c == \"-\":\r\n                continue\r\n            ans.append(c.upper())\r\n            cnt -= 1\r\n            if cnt == 0:\r\n                cnt = k\r\n                if i != n - 1:\r\n                    ans.append(\"-\")\r\n        return \"\".join(ans).rstrip(\"-\")",
