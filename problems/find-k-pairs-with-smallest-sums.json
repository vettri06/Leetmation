    "problemName": "find-k-pairs-with-smallest-sums",
    "language": "python3",
    "code": "class Solution:\r\n    def kSmallestPairs(\r\n        self, nums1: List[int], nums2: List[int], k: int\r\n    ) -> List[List[int]]:\r\n        q = [[u + nums2[0], i, 0] for i, u in enumerate(nums1[:k])]\r\n        heapify(q)\r\n        ans = []\r\n        while q and k > 0:\r\n            _, i, j = heappop(q)\r\n            ans.append([nums1[i], nums2[j]])\r\n            k -= 1\r\n            if j + 1 < len(nums2):\r\n                heappush(q, [nums1[i] + nums2[j + 1], i, j + 1])\r\n        return ans",
