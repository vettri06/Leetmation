    "problemName": "lonely-pixel-i",
    "language": "python3",
    "code": "class Solution:\r\n    def findLonelyPixel(self, picture: List[List[str]]) -> int:\r\n        rows = [0] * len(picture)\r\n        cols = [0] * len(picture[0])\r\n        for i, row in enumerate(picture):\r\n            for j, x in enumerate(row):\r\n                if x == \"B\":\r\n                    rows[i] += 1\r\n                    cols[j] += 1\r\n        ans = 0\r\n        for i, row in enumerate(picture):\r\n            for j, x in enumerate(row):\r\n                if x == \"B\" and rows[i] == 1 and cols[j] == 1:\r\n                    ans += 1\r\n        return ans",
