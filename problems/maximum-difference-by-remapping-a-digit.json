    "problemName": "maximum-difference-by-remapping-a-digit",
    "language": "python3",
    "code": "class Solution:\r\n    def minMaxDifference(self, num: int) -> int:\r\n        s = str(num)\r\n        mi = int(s.replace(s[0], '0'))\r\n        for c in s:\r\n            if c != '9':\r\n                return int(s.replace(c, '9')) - mi\r\n        return num - mi",
