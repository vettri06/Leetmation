{
    "problemName": "find-the-town-judge",
    "language": "python3",
    "code": "class Solution:\r\n    def findJudge(self, n: int, trust: List[List[int]]) -> int:\r\n        cnt1 = [0] * (n + 1)\r\n        cnt2 = [0] * (n + 1)\r\n        for a, b in trust:\r\n            cnt1[a] += 1\r\n            cnt2[b] += 1\r\n        for i in range(1, n + 1):\r\n            if cnt1[i] == 0 and cnt2[i] == n - 1:\r\n                return i\r\n        return -1",
