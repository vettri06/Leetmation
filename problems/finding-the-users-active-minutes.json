    "problemName": "finding-the-users-active-minutes",
    "language": "python3",
    "code": "class Solution:\r\n    def findingUsersActiveMinutes(self, logs: List[List[int]], k: int) -> List[int]:\r\n        d = defaultdict(set)\r\n        for i, t in logs:\r\n            d[i].add(t)\r\n        ans = [0] * k\r\n        for ts in d.values():\r\n            ans[len(ts) - 1] += 1\r\n        return ans",
