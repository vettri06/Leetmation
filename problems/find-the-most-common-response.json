{
    "problemName": "find-the-most-common-response",
    "language": "python3",
    "code": "class Solution:\r\n    def findCommonResponse(self, responses: List[List[str]]) -> str:\r\n        cnt = Counter()\r\n        for ws in responses:\r\n            for w in set(ws):\r\n                cnt[w] += 1\r\n        ans = responses[0][0]\r\n        for w, x in cnt.items():\r\n            if cnt[ans] < x or (cnt[ans] == x and w < ans):\r\n                ans = w\r\n        return ans",
