    "problemName": "prime-subtraction-operation",
    "language": "python3",
    "code": "class Solution:\r\n    def primeSubOperation(self, nums: List[int]) -> bool:\r\n        p = []\r\n        for i in range(2, max(nums)):\r\n            for j in p:\r\n                if i % j == 0:\r\n                    break\r\n            else:\r\n                p.append(i)\r\n\r\n        n = len(nums)\r\n        for i in range(n - 2, -1, -1):\r\n            if nums[i] < nums[i + 1]:\r\n                continue\r\n            j = bisect_right(p, nums[i] - nums[i + 1])\r\n            if j == len(p) or p[j] >= nums[i]:\r\n                return False\r\n            nums[i] -= p[j]\r\n        return True",
