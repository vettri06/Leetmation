    "problemName": "water-bottles",
    "language": "python3",
    "code": "class Solution:\r\n    def numWaterBottles(self, numBottles: int, numExchange: int) -> int:\r\n        ans = numBottles\r\n        while numBottles >= numExchange:\r\n            numBottles -= numExchange - 1\r\n            ans += 1\r\n        return ans",
