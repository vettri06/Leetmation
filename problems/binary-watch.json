    "problemName": "binary-watch",
    "language": "python3",
    "code": "class Solution:\r\n    def readBinaryWatch(self, turnedOn: int) -> List[str]:\r\n        return [\r\n            '{:d}:{:02d}'.format(i, j)\r\n            for i in range(12)\r\n            for j in range(60)\r\n            if (bin(i) + bin(j)).count('1') == turnedOn\r\n        ]",
