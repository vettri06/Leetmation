    "problemName": "minimum-knight-moves",
    "language": "python3",
    "code": "class Solution:\r\n    def minKnightMoves(self, x: int, y: int) -> int:\r\n        q = deque([(0, 0)])\r\n        ans = 0\r\n        vis = {(0, 0)}\r\n        dirs = ((-2, 1), (-1, 2), (1, 2), (2, 1), (2, -1), (1, -2), (-1, -2), (-2, -1))\r\n        while q:\r\n            for _ in range(len(q)):\r\n                i, j = q.popleft()\r\n                if (i, j) == (x, y):\r\n                    return ans\r\n                for a, b in dirs:\r\n                    c, d = i + a, j + b\r\n                    if (c, d) not in vis:\r\n                        vis.add((c, d))\r\n                        q.append((c, d))\r\n            ans += 1\r\n        return -1",
