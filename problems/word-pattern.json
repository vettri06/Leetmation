{
    "problemName": "word-pattern",
    "language": "python3",
    "code": "class Solution:\r\n    def wordPattern(self, pattern: str, s: str) -> bool:\r\n        ws = s.split()\r\n        if len(pattern) != len(ws):\r\n            return False\r\n        d1 = {}\r\n        d2 = {}\r\n        for a, b in zip(pattern, ws):\r\n            if (a in d1 and d1[a] != b) or (b in d2 and d2[b] != a):\r\n                return False\r\n            d1[a] = b\r\n            d2[b] = a\r\n        return True",
