{
    "problemName": "reverse-degree-of-a-string",
    "language": "python3",
    "code": "class Solution:\r\n    def reverseDegree(self, s: str) -> int:\r\n        ans = 0\r\n        for i, c in enumerate(s, 1):\r\n            x = 26 - (ord(c) - ord(\"a\"))\r\n            ans += i * x\r\n        return ans",
