    "language": "python3",
    "code": "# Definition for a binary tree node.\r\n# class TreeNode:\r\n#     def __init__(self, val=0, left=None, right=None):\r\n#         self.val = val\r\n#         self.left = left\r\n#         self.right = right\r\nclass Solution:\r\n    def inorderTraversal(self, root: Optional[TreeNode]) -> List[int]:\r\n        def dfs(root):\r\n            if root is None:\r\n                return\r\n            dfs(root.left)\r\n            ans.append(root.val)\r\n            dfs(root.right)\r\n\r\n        ans = []\r\n        dfs(root)\r\n        return ans",
