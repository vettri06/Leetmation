{
    "problemName": "wiggle-subsequence",
    "language": "python3",
    "code": "class Solution:\r\n    def wiggleMaxLength(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        ans = 1\r\n        f = [1] * n\r\n        g = [1] * n\r\n        for i in range(1, n):\r\n            for j in range(i):\r\n                if nums[j] < nums[i]:\r\n                    f[i] = max(f[i], g[j] + 1)\r\n                elif nums[j] > nums[i]:\r\n                    g[i] = max(g[i], f[j] + 1)\r\n            ans = max(ans, f[i], g[i])\r\n        return ans",
