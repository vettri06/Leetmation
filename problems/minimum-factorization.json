{
    "problemName": "minimum-factorization",
    "language": "python3",
    "code": "class Solution:\r\n    def smallestFactorization(self, num: int) -> int:\r\n        if num < 2:\r\n            return num\r\n        ans, mul = 0, 1\r\n        for i in range(9, 1, -1):\r\n            while num % i == 0:\r\n                num //= i\r\n                ans = mul * i + ans\r\n                mul *= 10\r\n        return ans if num < 2 and ans <= 2**31 - 1 else 0",
