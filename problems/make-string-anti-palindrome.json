    "problemName": "make-string-anti-palindrome",
    "language": "python3",
    "code": "class Solution:\r\n    def makeAntiPalindrome(self, s: str) -> str:\r\n        cs = sorted(s)\r\n        n = len(cs)\r\n        m = n // 2\r\n        if cs[m] == cs[m - 1]:\r\n            i = m\r\n            while i < n and cs[i] == cs[i - 1]:\r\n                i += 1\r\n            j = m\r\n            while j < n and cs[j] == cs[n - j - 1]:\r\n                if i >= n:\r\n                    return \"-1\"\r\n                cs[i], cs[j] = cs[j], cs[i]\r\n                i, j = i + 1, j + 1\r\n        return \"\".join(cs)",
