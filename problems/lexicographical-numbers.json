    "problemName": "lexicographical-numbers",
    "language": "python3",
    "code": "class Solution:\r\n    def lexicalOrder(self, n: int) -> List[int]:\r\n        ans = []\r\n        v = 1\r\n        for _ in range(n):\r\n            ans.append(v)\r\n            if v * 10 <= n:\r\n                v *= 10\r\n            else:\r\n                while v % 10 == 9 or v + 1 > n:\r\n                    v //= 10\r\n                v += 1\r\n        return ans",
