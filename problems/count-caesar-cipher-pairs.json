{
    "problemName": "count-caesar-cipher-pairs",
    "language": "python3",
    "code": "class Solution:\r\n    def countPairs(self, words: List[str]) -> int:\r\n        cnt = defaultdict(int)\r\n        for s in words:\r\n            t = list(s)\r\n            k = ord(\"z\") - ord(t[0])\r\n            for i in range(1, len(t)):\r\n                t[i] = chr((ord(t[i]) - ord(\"a\") + k) % 26 + ord(\"a\"))\r\n            t[0] = \"z\"\r\n            cnt[\"\".join(t)] += 1\r\n        return sum(v * (v - 1) // 2 for v in cnt.values())",
