{
    "problemName": "maximum-calories-burnt-from-jumps",
    "language": "python3",
    "code": "class Solution:\r\n    def maxCaloriesBurnt(self, heights: list[int]) -> int:\r\n        heights.sort()\r\n        pre = 0\r\n        l, r = 0, len(heights) - 1\r\n        ans = 0\r\n        while l < r:\r\n            ans += (heights[r] - pre) ** 2\r\n            ans += (heights[l] - heights[r]) ** 2\r\n            pre = heights[l]\r\n            l, r = l + 1, r - 1\r\n        ans += (heights[r] - pre) ** 2\r\n        return ans",
