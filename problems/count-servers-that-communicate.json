{
    "problemName": "count-servers-that-communicate",
    "language": "python3",
    "code": "class Solution:\r\n    def countServers(self, grid: List[List[int]]) -> int:\r\n        m, n = len(grid), len(grid[0])\r\n        row = [0] * m\r\n        col = [0] * n\r\n        for i in range(m):\r\n            for j in range(n):\r\n                row[i] += grid[i][j]\r\n                col[j] += grid[i][j]\r\n        return sum(\r\n            grid[i][j] and (row[i] > 1 or col[j] > 1)\r\n            for i in range(m)\r\n            for j in range(n)\r\n        )",
