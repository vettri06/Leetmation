    "code": "class Solution:\r\n    def toggleLightBulbs(self, bulbs: list[int]) -> list[int]:\r\n        st = [0] * 101\r\n        for x in bulbs:\r\n            st[x] ^= 1\r\n        return [i for i, x in enumerate(st) if x]",
