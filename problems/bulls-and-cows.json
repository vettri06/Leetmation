    "problemName": "bulls-and-cows",
    "language": "python3",
    "code": "class Solution:\r\n    def getHint(self, secret: str, guess: str) -> str:\r\n        cnt1, cnt2 = Counter(), Counter()\r\n        x = 0\r\n        for a, b in zip(secret, guess):\r\n            if a == b:\r\n                x += 1\r\n            else:\r\n                cnt1[a] += 1\r\n                cnt2[b] += 1\r\n        y = sum(min(cnt1[c], cnt2[c]) for c in cnt1)\r\n        return f\"{x}A{y}B\"",
