{
    "problemName": "permutation-sequence",
    "language": "python3",
    "code": "class Solution:\r\n    def getPermutation(self, n: int, k: int) -> str:\r\n        ans = []\r\n        vis = [False] * (n + 1)\r\n        for i in range(n):\r\n            fact = 1\r\n            for j in range(1, n - i):\r\n                fact *= j\r\n            for j in range(1, n + 1):\r\n                if not vis[j]:\r\n                    if k > fact:\r\n                        k -= fact\r\n                    else:\r\n                        ans.append(str(j))\r\n                        vis[j] = True\r\n                        break\r\n        return ''.join(ans)",
