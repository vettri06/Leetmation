{
    "problemName": "sliding-subarray-beauty",
    "language": "python3",
    "code": "class Solution:\r\n    def getSubarrayBeauty(self, nums: List[int], k: int, x: int) -> List[int]:\r\n        def f(x: int) -> int:\r\n            s = 0\r\n            for i in range(50):\r\n                s += cnt[i]\r\n                if s >= x:\r\n                    return i - 50\r\n            return 0\r\n\r\n        cnt = [0] * 101\r\n        for v in nums[:k]:\r\n            cnt[v + 50] += 1\r\n        ans = [f(x)]\r\n        for i in range(k, len(nums)):\r\n            cnt[nums[i] + 50] += 1\r\n            cnt[nums[i - k] + 50] -= 1\r\n            ans.append(f(x))\r\n        return ans",
