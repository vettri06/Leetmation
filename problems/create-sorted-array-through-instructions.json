    "problemName": "create-sorted-array-through-instructions",
    "language": "python3",
    "code": "class BinaryIndexedTree:\r\n    def __init__(self, n):\r\n        self.n = n\r\n        self.c = [0] * (n + 1)\r\n\r\n    def update(self, x: int, v: int):\r\n        while x <= self.n:\r\n            self.c[x] += v\r\n            x += x & -x\r\n\r\n    def query(self, x: int) -> int:\r\n        s = 0\r\n        while x:\r\n            s += self.c[x]\r\n            x -= x & -x\r\n        return s\r\n\r\n\r\nclass Solution:\r\n    def createSortedArray(self, instructions: List[int]) -> int:\r\n        m = max(instructions)\r\n        tree = BinaryIndexedTree(m)\r\n        ans = 0\r\n        mod = 10**9 + 7\r\n        for i, x in enumerate(instructions):\r\n            cost = min(tree.query(x - 1), i - tree.query(x))\r\n            ans += cost\r\n            tree.update(x, 1)\r\n        return ans % mod",
