{
    "problemName": "decrease-elements-to-make-array-zigzag",
    "language": "python3",
    "code": "class Solution:\r\n    def movesToMakeZigzag(self, nums: List[int]) -> int:\r\n        ans = [0, 0]\r\n        n = len(nums)\r\n        for i in range(2):\r\n            for j in range(i, n, 2):\r\n                d = 0\r\n                if j:\r\n                    d = max(d, nums[j] - nums[j - 1] + 1)\r\n                if j < n - 1:\r\n                    d = max(d, nums[j] - nums[j + 1] + 1)\r\n                ans[i] += d\r\n        return min(ans)",
