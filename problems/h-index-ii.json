{
    "problemName": "h-index-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def hIndex(self, citations: List[int]) -> int:\r\n        n = len(citations)\r\n        left, right = 0, n\r\n        while left < right:\r\n            mid = (left + right + 1) >> 1\r\n            if citations[n - mid] >= mid:\r\n                left = mid\r\n            else:\r\n                right = mid - 1\r\n        return left",
