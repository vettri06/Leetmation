{
    "problemName": "score-after-flipping-matrix",
    "language": "python3",
    "code": "class Solution:\r\n    def matrixScore(self, grid: List[List[int]]) -> int:\r\n        m, n = len(grid), len(grid[0])\r\n        for i in range(m):\r\n            if grid[i][0] == 0:\r\n                for j in range(n):\r\n                    grid[i][j] ^= 1\r\n        ans = 0\r\n        for j in range(n):\r\n            cnt = sum(grid[i][j] for i in range(m))\r\n            ans += max(cnt, m - cnt) * (1 << (n - j - 1))\r\n        return ans",
