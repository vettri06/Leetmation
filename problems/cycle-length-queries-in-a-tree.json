{
    "problemName": "cycle-length-queries-in-a-tree",
    "language": "python3",
    "code": "class Solution:\r\n    def cycleLengthQueries(self, n: int, queries: List[List[int]]) -> List[int]:\r\n        ans = []\r\n        for a, b in queries:\r\n            t = 1\r\n            while a != b:\r\n                if a > b:\r\n                    a >>= 1\r\n                else:\r\n                    b >>= 1\r\n                t += 1\r\n            ans.append(t)\r\n        return ans",
