    "problemName": "valid-binary-strings-with-cost-limit",
    "language": "python3",
    "code": "class Solution:\r\n    def generateValidStrings(self, n: int, k: int) -> list[str]:\r\n        def dfs(i: int, tot: int):\r\n            if i >= n:\r\n                ans.append(\"\".join(path))\r\n                return\r\n            path.append(\"0\")\r\n            dfs(i + 1, tot)\r\n            path.pop()\r\n            if (not path or path[-1] == \"0\") and tot + i <= k:\r\n                path.append(\"1\")\r\n                dfs(i + 1, tot + i)\r\n                path.pop()\r\n\r\n        ans = []\r\n        path = []\r\n        dfs(0, 0)\r\n        return ans",
