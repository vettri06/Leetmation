{
    "problemName": "maximize-distance-to-closest-person",
    "language": "python3",
    "code": "class Solution:\r\n    def maxDistToClosest(self, seats: List[int]) -> int:\r\n        first = last = None\r\n        d = 0\r\n        for i, c in enumerate(seats):\r\n            if c:\r\n                if last is not None:\r\n                    d = max(d, i - last)\r\n                if first is None:\r\n                    first = i\r\n                last = i\r\n        return max(first, len(seats) - last - 1, d // 2)",
