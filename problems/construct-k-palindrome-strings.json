    "problemName": "construct-k-palindrome-strings",
    "language": "python3",
    "code": "class Solution:\r\n    def canConstruct(self, s: str, k: int) -> bool:\r\n        if len(s) < k:\r\n            return False\r\n        cnt = Counter(s)\r\n        return sum(v & 1 for v in cnt.values()) <= k",
