    "language": "python3",
    "code": "class Solution:\r\n    def findDegrees(self, matrix: list[list[int]]) -> list[int]:\r\n        ans = [0] * len(matrix)\r\n        for i, row in enumerate(matrix):\r\n            for x in row:\r\n                ans[i] += x\r\n        return ans",
