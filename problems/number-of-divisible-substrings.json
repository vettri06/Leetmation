{
    "problemName": "number-of-divisible-substrings",
    "language": "python3",
    "code": "class Solution:\r\n    def countDivisibleSubstrings(self, word: str) -> int:\r\n        d = [\"ab\", \"cde\", \"fgh\", \"ijk\", \"lmn\", \"opq\", \"rst\", \"uvw\", \"xyz\"]\r\n        mp = {}\r\n        for i, s in enumerate(d, 1):\r\n            for c in s:\r\n                mp[c] = i\r\n        ans = 0\r\n        n = len(word)\r\n        for i in range(n):\r\n            s = 0\r\n            for j in range(i, n):\r\n                s += mp[word[j]]\r\n                ans += s % (j - i + 1) == 0\r\n        return ans",
