{
    "problemName": "minimum-cost-for-tickets",
    "language": "python3",
    "code": "class Solution:\r\n    def mincostTickets(self, days: List[int], costs: List[int]) -> int:\r\n        @cache\r\n        def dfs(i: int) -> int:\r\n            if i >= n:\r\n                return 0\r\n            ans = inf\r\n            for c, v in zip(costs, valid):\r\n                j = bisect_left(days, days[i] + v)\r\n                ans = min(ans, c + dfs(j))\r\n            return ans\r\n\r\n        n = len(days)\r\n        valid = [1, 7, 30]\r\n        return dfs(0)",
