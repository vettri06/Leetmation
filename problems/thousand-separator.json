    "problemName": "thousand-separator",
    "language": "python3",
    "code": "class Solution:\r\n    def thousandSeparator(self, n: int) -> str:\r\n        cnt = 0\r\n        ans = []\r\n        while 1:\r\n            n, v = divmod(n, 10)\r\n            ans.append(str(v))\r\n            cnt += 1\r\n            if n == 0:\r\n                break\r\n            if cnt == 3:\r\n                ans.append('.')\r\n                cnt = 0\r\n        return ''.join(ans[::-1])",
