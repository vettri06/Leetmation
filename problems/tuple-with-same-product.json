{
    "problemName": "tuple-with-same-product",
    "language": "python3",
    "code": "class Solution:\r\n    def tupleSameProduct(self, nums: List[int]) -> int:\r\n        cnt = defaultdict(int)\r\n        for i in range(1, len(nums)):\r\n            for j in range(i):\r\n                x = nums[i] * nums[j]\r\n                cnt[x] += 1\r\n        return sum(v * (v - 1) // 2 for v in cnt.values()) << 3",
