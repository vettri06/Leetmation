    "problemName": "alt-and-tab-simulation",
    "language": "python3",
    "code": "class Solution:\r\n    def simulationResult(self, windows: List[int], queries: List[int]) -> List[int]:\r\n        s = set()\r\n        ans = []\r\n        for q in queries[::-1]:\r\n            if q not in s:\r\n                ans.append(q)\r\n                s.add(q)\r\n        for w in windows:\r\n            if w not in s:\r\n                ans.append(w)\r\n        return ans",
