{
    "problemName": "boats-to-save-people",
    "language": "python3",
    "code": "class Solution:\r\n    def numRescueBoats(self, people: List[int], limit: int) -> int:\r\n        people.sort()\r\n        ans = 0\r\n        i, j = 0, len(people) - 1\r\n        while i <= j:\r\n            if people[i] + people[j] <= limit:\r\n                i += 1\r\n            j -= 1\r\n            ans += 1\r\n        return ans",
