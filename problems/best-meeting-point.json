    "problemName": "best-meeting-point",
    "language": "python3",
    "code": "class Solution:\r\n    def minTotalDistance(self, grid: List[List[int]]) -> int:\r\n        def f(arr, x):\r\n            return sum(abs(v - x) for v in arr)\r\n\r\n        rows, cols = [], []\r\n        for i, row in enumerate(grid):\r\n            for j, v in enumerate(row):\r\n                if v:\r\n                    rows.append(i)\r\n                    cols.append(j)\r\n        cols.sort()\r\n        i = rows[len(rows) >> 1]\r\n        j = cols[len(cols) >> 1]\r\n        return f(rows, i) + f(cols, j)",
