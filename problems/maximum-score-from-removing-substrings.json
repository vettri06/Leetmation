{
    "problemName": "maximum-score-from-removing-substrings",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumGain(self, s: str, x: int, y: int) -> int:\r\n        a, b = \"a\", \"b\"\r\n        if x < y:\r\n            x, y = y, x\r\n            a, b = b, a\r\n        ans = cnt1 = cnt2 = 0\r\n        for c in s:\r\n            if c == a:\r\n                cnt1 += 1\r\n            elif c == b:\r\n                if cnt1:\r\n                    ans += x\r\n                    cnt1 -= 1\r\n                else:\r\n                    cnt2 += 1\r\n            else:\r\n                ans += min(cnt1, cnt2) * y\r\n                cnt1 = cnt2 = 0\r\n        ans += min(cnt1, cnt2) * y\r\n        return ans",
