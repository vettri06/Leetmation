    "problemName": "maximum-students-on-a-single-bench",
    "language": "python3",
    "code": "class Solution:\r\n    def maxStudentsOnBench(self, students: List[List[int]]) -> int:\r\n        if not students:\r\n            return 0\r\n        d = defaultdict(set)\r\n        for student_id, bench_id in students:\r\n            d[bench_id].add(student_id)\r\n        return max(map(len, d.values()))",
