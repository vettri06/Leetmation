    "problemName": "last-substring-in-lexicographical-order",
    "language": "python3",
    "code": "class Solution:\r\n    def lastSubstring(self, s: str) -> str:\r\n        i, j, k = 0, 1, 0\r\n        while j + k < len(s):\r\n            if s[i + k] == s[j + k]:\r\n                k += 1\r\n            elif s[i + k] < s[j + k]:\r\n                i += k + 1\r\n                k = 0\r\n                if i >= j:\r\n                    j = i + 1\r\n            else:\r\n                j += k + 1\r\n                k = 0\r\n        return s[i:]",
