    "problemName": "minimize-deviation-in-array",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumDeviation(self, nums: List[int]) -> int:\r\n        h = []\r\n        mi = inf\r\n        for v in nums:\r\n            if v & 1:\r\n                v <<= 1\r\n            h.append(-v)\r\n            mi = min(mi, v)\r\n        heapify(h)\r\n        ans = -h[0] - mi\r\n        while h[0] % 2 == 0:\r\n            x = heappop(h) // 2\r\n            heappush(h, x)\r\n            mi = min(mi, -x)\r\n            ans = min(ans, -h[0] - mi)\r\n        return ans",
