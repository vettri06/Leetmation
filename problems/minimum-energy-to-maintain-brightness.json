{
    "problemName": "minimum-energy-to-maintain-brightness",
    "language": "python3",
    "code": "class Solution:\r\n    def minEnergy(self, n: int, brightness: int, intervals: list[list[int]]) -> int:\r\n        intervals.sort()\r\n        merged = [intervals[0]]\r\n        for x in intervals[1:]:\r\n            if merged[-1][1] < x[0]:\r\n                merged.append(x)\r\n            else:\r\n                merged[-1][1] = max(merged[-1][1], x[1])\r\n        ans = 0\r\n        for start, end in merged:\r\n            m = end - start + 1\r\n            ans += (brightness + 2) // 3 * m\r\n        return ans",
