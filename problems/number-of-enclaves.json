    "problemName": "number-of-enclaves",
    "language": "python3",
    "code": "class Solution:\r\n    def numEnclaves(self, grid: List[List[int]]) -> int:\r\n        def dfs(i: int, j: int):\r\n            grid[i][j] = 0\r\n            for a, b in pairwise(dirs):\r\n                x, y = i + a, j + b\r\n                if 0 <= x < m and 0 <= y < n and grid[x][y]:\r\n                    dfs(x, y)\r\n\r\n        m, n = len(grid), len(grid[0])\r\n        dirs = (-1, 0, 1, 0, -1)\r\n        for j in range(n):\r\n            for i in (0, m - 1):\r\n                if grid[i][j]:\r\n                    dfs(i, j)\r\n        for i in range(m):\r\n            for j in (0, n - 1):\r\n                if grid[i][j]:\r\n                    dfs(i, j)\r\n        return sum(sum(row) for row in grid)",
