{
    "problemName": "baseball-game",
    "language": "python3",
    "code": "class Solution:\r\n    def calPoints(self, operations: List[str]) -> int:\r\n        stk = []\r\n        for op in operations:\r\n            if op == \"+\":\r\n                stk.append(stk[-1] + stk[-2])\r\n            elif op == \"D\":\r\n                stk.append(stk[-1] << 1)\r\n            elif op == \"C\":\r\n                stk.pop()\r\n            else:\r\n                stk.append(int(op))\r\n        return sum(stk)",
