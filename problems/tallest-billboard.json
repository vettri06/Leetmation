{
    "problemName": "tallest-billboard",
    "language": "python3",
    "code": "class Solution:\r\n    def tallestBillboard(self, rods: List[int]) -> int:\r\n        @cache\r\n        def dfs(i: int, j: int) -> int:\r\n            if i >= len(rods):\r\n                return 0 if j == 0 else -inf\r\n            ans = max(dfs(i + 1, j), dfs(i + 1, j + rods[i]))\r\n            ans = max(ans, dfs(i + 1, abs(rods[i] - j)) + min(j, rods[i]))\r\n            return ans\r\n\r\n        return dfs(0, 0)",
