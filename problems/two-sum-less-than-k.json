{
    "problemName": "two-sum-less-than-k",
    "language": "python3",
    "code": "class Solution:\r\n    def twoSumLessThanK(self, nums: List[int], k: int) -> int:\r\n        nums.sort()\r\n        ans = -1\r\n        for i, x in enumerate(nums):\r\n            j = bisect_left(nums, k - x, lo=i + 1) - 1\r\n            if i < j:\r\n                ans = max(ans, x + nums[j])\r\n        return ans",
