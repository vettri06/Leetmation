{
    "problemName": "count-ways-to-group-overlapping-ranges",
    "language": "python3",
    "code": "class Solution:\r\n    def countWays(self, ranges: List[List[int]]) -> int:\r\n        ranges.sort()\r\n        cnt, mx = 0, -1\r\n        for start, end in ranges:\r\n            if start > mx:\r\n                cnt += 1\r\n            mx = max(mx, end)\r\n        mod = 10**9 + 7\r\n        return pow(2, cnt, mod)",
