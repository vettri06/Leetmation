{
    "problemName": "steps-to-make-array-non-decreasing",
    "language": "python3",
    "code": "class Solution:\r\n    def totalSteps(self, nums: List[int]) -> int:\r\n        stk = []\r\n        ans, n = 0, len(nums)\r\n        dp = [0] * n\r\n        for i in range(n - 1, -1, -1):\r\n            while stk and nums[i] > nums[stk[-1]]:\r\n                dp[i] = max(dp[i] + 1, dp[stk.pop()])\r\n            stk.append(i)\r\n        return max(dp)",
