{
    "problemName": "minimum-deletions-to-make-string-balanced",
    "language": "python3",
    "code": "class Solution:\r\n    def minimumDeletions(self, s: str) -> int:\r\n        n = len(s)\r\n        f = [0] * (n + 1)\r\n        b = 0\r\n        for i, c in enumerate(s, 1):\r\n            if c == 'b':\r\n                f[i] = f[i - 1]\r\n                b += 1\r\n            else:\r\n                f[i] = min(f[i - 1] + 1, b)\r\n        return f[n]",
    "problemId": 1653,
