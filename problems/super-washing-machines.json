{
    "problemName": "super-washing-machines",
    "language": "python3",
    "code": "class Solution:\r\n    def findMinMoves(self, machines: List[int]) -> int:\r\n        n = len(machines)\r\n        k, mod = divmod(sum(machines), n)\r\n        if mod:\r\n            return -1\r\n        ans = s = 0\r\n        for x in machines:\r\n            x -= k\r\n            s += x\r\n            ans = max(ans, abs(s), x)\r\n        return ans",
