    "problemName": "jump-game",
    "language": "python3",
    "code": "class Solution:\r\n    def canJump(self, nums: List[int]) -> bool:\r\n        mx = 0\r\n        for i, x in enumerate(nums):\r\n            if mx < i:\r\n                return False\r\n            mx = max(mx, i + x)\r\n        return True",
