    "problemName": "intervals-between-identical-elements",
    "language": "python3",
    "code": "class Solution:\r\n    def getDistances(self, arr: List[int]) -> List[int]:\r\n        d = defaultdict(list)\r\n        n = len(arr)\r\n        for i, v in enumerate(arr):\r\n            d[v].append(i)\r\n        ans = [0] * n\r\n        for v in d.values():\r\n            m = len(v)\r\n            val = sum(v) - v[0] * m\r\n            for i, p in enumerate(v):\r\n                delta = v[i] - v[i - 1] if i >= 1 else 0\r\n                val += i * delta - (m - i) * delta\r\n                ans[p] = val\r\n        return ans",
