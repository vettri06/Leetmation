{
    "problemName": "task-scheduler",
    "language": "python3",
    "code": "class Solution:\r\n    def leastInterval(self, tasks: List[str], n: int) -> int:\r\n        cnt = Counter(tasks)\r\n        x = max(cnt.values())\r\n        s = sum(v == x for v in cnt.values())\r\n        return max(len(tasks), (x - 1) * (n + 1) + s)",
