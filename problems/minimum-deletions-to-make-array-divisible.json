{
    "problemName": "minimum-deletions-to-make-array-divisible",
    "language": "python3",
    "code": "class Solution:\r\n    def minOperations(self, nums: List[int], numsDivide: List[int]) -> int:\r\n        x = numsDivide[0]\r\n        for v in numsDivide[1:]:\r\n            x = gcd(x, v)\r\n        nums.sort()\r\n        for i, v in enumerate(nums):\r\n            if x % v == 0:\r\n                return i\r\n        return -1",
