    "code": "class Solution:\r\n    def permute(self, n: int) -> List[List[int]]:\r\n        def dfs(i: int) -> None:\r\n            if i >= n:\r\n                ans.append(t[:])\r\n                return\r\n            for j in range(1, n + 1):\r\n                if not vis[j] and (i == 0 or t[-1] % 2 != j % 2):\r\n                    t.append(j)\r\n                    vis[j] = True\r\n                    dfs(i + 1)\r\n                    vis[j] = False\r\n                    t.pop()\r\n\r\n        ans = []\r\n        t = []\r\n        vis = [False] * (n + 1)\r\n        dfs(0)\r\n        return ans",
