    "language": "python3",
    "code": "class Solution:\r\n    def luckyNumbers(self, matrix: List[List[int]]) -> List[int]:\r\n        rows = {min(row) for row in matrix}\r\n        cols = {max(col) for col in zip(*matrix)}\r\n        return list(rows & cols)",
