    "problemName": "valid-palindrome",
    "language": "python3",
    "code": "class Solution:\r\n    def isPalindrome(self, s: str) -> bool:\r\n        i, j = 0, len(s) - 1\r\n        while i < j:\r\n            if not s[i].isalnum():\r\n                i += 1\r\n            elif not s[j].isalnum():\r\n                j -= 1\r\n            elif s[i].lower() != s[j].lower():\r\n                return False\r\n            else:\r\n                i, j = i + 1, j - 1\r\n        return True",
