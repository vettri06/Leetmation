    "problemName": "stone-game-iii",
    "language": "python3",
    "code": "class Solution:\r\n    def stoneGameIII(self, stoneValue: List[int]) -> str:\r\n        @cache\r\n        def dfs(i: int) -> int:\r\n            if i >= n:\r\n                return 0\r\n            ans, s = -inf, 0\r\n            for j in range(3):\r\n                if i + j >= n:\r\n                    break\r\n                s += stoneValue[i + j]\r\n                ans = max(ans, s - dfs(i + j + 1))\r\n            return ans\r\n\r\n        n = len(stoneValue)\r\n        ans = dfs(0)\r\n        if ans == 0:\r\n            return 'Tie'\r\n        return 'Alice' if ans > 0 else 'Bob'",
