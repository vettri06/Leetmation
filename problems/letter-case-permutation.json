    "problemName": "letter-case-permutation",
    "language": "python3",
    "code": "class Solution:\r\n    def letterCasePermutation(self, s: str) -> List[str]:\r\n        def dfs(i: int) -> None:\r\n            if i >= len(t):\r\n                ans.append(\"\".join(t))\r\n                return\r\n            dfs(i + 1)\r\n            if t[i].isalpha():\r\n                t[i] = chr(ord(t[i]) ^ 32)\r\n                dfs(i + 1)\r\n\r\n        t = list(s)\r\n        ans = []\r\n        dfs(0)\r\n        return ans",
