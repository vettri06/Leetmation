{
    "problemName": "count-number-of-nice-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def numberOfSubarrays(self, nums: List[int], k: int) -> int:\r\n        cnt = Counter({0: 1})\r\n        ans = t = 0\r\n        for v in nums:\r\n            t += v & 1\r\n            ans += cnt[t - k]\r\n            cnt[t] += 1\r\n        return ans",
