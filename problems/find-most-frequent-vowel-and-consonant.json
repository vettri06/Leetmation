    "problemName": "find-most-frequent-vowel-and-consonant",
    "language": "python3",
    "code": "class Solution:\r\n    def maxFreqSum(self, s: str) -> int:\r\n        cnt = Counter(s)\r\n        a = b = 0\r\n        for c, v in cnt.items():\r\n            if c in \"aeiou\":\r\n                a = max(a, v)\r\n            else:\r\n                b = max(b, v)\r\n        return a + b",
