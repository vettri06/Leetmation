{
    "problemName": "buddy-strings",
    "language": "python3",
    "code": "class Solution:\r\n    def buddyStrings(self, s: str, goal: str) -> bool:\r\n        m, n = len(s), len(goal)\r\n        if m != n:\r\n            return False\r\n        cnt1, cnt2 = Counter(s), Counter(goal)\r\n        if cnt1 != cnt2:\r\n            return False\r\n        diff = sum(s[i] != goal[i] for i in range(n))\r\n        return diff == 2 or (diff == 0 and any(v > 1 for v in cnt1.values()))",
