{
    "problemName": "longest-square-streak-in-an-array",
    "language": "python3",
    "code": "class Solution:\r\n    def longestSquareStreak(self, nums: List[int]) -> int:\r\n        s = set(nums)\r\n        ans = -1\r\n        for x in nums:\r\n            t = 0\r\n            while x in s:\r\n                x *= x\r\n                t += 1\r\n            if t > 1:\r\n                ans = max(ans, t)\r\n        return ans",
