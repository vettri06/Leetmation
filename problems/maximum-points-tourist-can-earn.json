{
    "problemName": "maximum-points-tourist-can-earn",
    "language": "python3",
    "code": "class Solution:\r\n    def maxScore(\r\n        self, n: int, k: int, stayScore: List[List[int]], travelScore: List[List[int]]\r\n    ) -> int:\r\n        f = [[-inf] * n for _ in range(k + 1)]\r\n        f[0] = [0] * n\r\n        for i in range(1, k + 1):\r\n            for j in range(n):\r\n                for h in range(n):\r\n                    f[i][j] = max(\r\n                        f[i][j],\r\n                        f[i - 1][h]\r\n                        + (stayScore[i - 1][j] if j == h else travelScore[h][j]),\r\n                    )\r\n        return max(f[k])",
    "problemId": 3332,
