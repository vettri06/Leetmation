{
    "problemName": "number-of-substrings-with-fixed-ratio",
    "language": "python3",
    "code": "class Solution:\r\n    def fixedRatio(self, s: str, num1: int, num2: int) -> int:\r\n        n0 = n1 = 0\r\n        ans = 0\r\n        cnt = Counter({0: 1})\r\n        for c in s:\r\n            n0 += c == '0'\r\n            n1 += c == '1'\r\n            x = n1 * num1 - n0 * num2\r\n            ans += cnt[x]\r\n            cnt[x] += 1\r\n        return ans",
