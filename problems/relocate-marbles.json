    "problemName": "relocate-marbles",
    "language": "python3",
    "code": "class Solution:\r\n    def relocateMarbles(\r\n        self, nums: List[int], moveFrom: List[int], moveTo: List[int]\r\n    ) -> List[int]:\r\n        pos = set(nums)\r\n        for f, t in zip(moveFrom, moveTo):\r\n            pos.remove(f)\r\n            pos.add(t)\r\n        return sorted(pos)",
