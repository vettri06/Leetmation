{
    "problemName": "rotate-non-negative-elements",
    "language": "python3",
    "code": "class Solution:\r\n    def rotateElements(self, nums: List[int], k: int) -> List[int]:\r\n        t = [x for x in nums if x >= 0]\r\n        m = len(t)\r\n        d = [0] * m\r\n        for i, x in enumerate(t):\r\n            d[((i - k) % m + m) % m] = x\r\n        j = 0\r\n        for i, x in enumerate(nums):\r\n            if x >= 0:\r\n                nums[i] = d[j]\r\n                j += 1\r\n        return nums",
