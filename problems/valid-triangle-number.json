    "problemName": "valid-triangle-number",
    "language": "python3",
    "code": "class Solution:\r\n    def triangleNumber(self, nums: List[int]) -> int:\r\n        nums.sort()\r\n        ans, n = 0, len(nums)\r\n        for i in range(n - 2):\r\n            for j in range(i + 1, n - 1):\r\n                k = bisect_left(nums, nums[i] + nums[j], lo=j + 1) - 1\r\n                ans += k - j\r\n        return ans",
