    "problemName": "valid-sudoku",
    "language": "python3",
    "code": "class Solution:\r\n    def isValidSudoku(self, board: List[List[str]]) -> bool:\r\n        row = [[False] * 9 for _ in range(9)]\r\n        col = [[False] * 9 for _ in range(9)]\r\n        sub = [[False] * 9 for _ in range(9)]\r\n        for i in range(9):\r\n            for j in range(9):\r\n                c = board[i][j]\r\n                if c == '.':\r\n                    continue\r\n                num = int(c) - 1\r\n                k = i // 3 * 3 + j // 3\r\n                if row[i][num] or col[j][num] or sub[k][num]:\r\n                    return False\r\n                row[i][num] = True\r\n                col[j][num] = True\r\n                sub[k][num] = True\r\n        return True",
