    "problemName": "largest-palindromic-number",
    "language": "python3",
    "code": "class Solution:\r\n    def largestPalindromic(self, num: str) -> str:\r\n        cnt = Counter(num)\r\n        ans = ''\r\n        for i in range(9, -1, -1):\r\n            v = str(i)\r\n            if cnt[v] % 2:\r\n                ans = v\r\n                cnt[v] -= 1\r\n                break\r\n        for i in range(10):\r\n            v = str(i)\r\n            if cnt[v]:\r\n                cnt[v] //= 2\r\n                s = cnt[v] * v\r\n                ans = s + ans + s\r\n        return ans.strip('0') or '0'",
