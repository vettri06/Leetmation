{
    "problemName": "maximum-multiplication-score",
    "language": "python3",
    "code": "class Solution:\r\n    def maxScore(self, a: List[int], b: List[int]) -> int:\r\n        @cache\r\n        def dfs(i: int, j: int) -> int:\r\n            if j >= len(b):\r\n                return 0 if i >= len(a) else -inf\r\n            if i >= len(a):\r\n                return 0\r\n            return max(dfs(i, j + 1), a[i] * b[j] + dfs(i + 1, j + 1))\r\n\r\n        return dfs(0, 0)",
