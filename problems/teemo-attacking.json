    "code": "class Solution:\r\n    def findPoisonedDuration(self, timeSeries: List[int], duration: int) -> int:\r\n        ans = duration\r\n        for a, b in pairwise(timeSeries):\r\n            ans += min(duration, b - a)\r\n        return ans",
