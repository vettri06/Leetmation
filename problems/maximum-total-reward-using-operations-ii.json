{
    "problemName": "maximum-total-reward-using-operations-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def maxTotalReward(self, rewardValues: List[int]) -> int:\r\n        nums = sorted(set(rewardValues))\r\n        f = 1\r\n        for v in nums:\r\n            f |= (f & ((1 << v) - 1)) << v\r\n        return f.bit_length() - 1",
