    "problemName": "reverse-k-subarrays",
    "language": "python3",
    "code": "class Solution:\r\n    def reverseSubarrays(self, nums: list[int], k: int) -> list[int]:\r\n        n = len(nums)\r\n        m = n // k\r\n        for i in range(0, n, m):\r\n            nums[i : i + m] = nums[i : i + m][::-1]\r\n        return nums",
