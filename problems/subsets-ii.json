    "problemName": "subsets-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def subsetsWithDup(self, nums: List[int]) -> List[List[int]]:\r\n        def dfs(i: int):\r\n            if i == len(nums):\r\n                ans.append(t[:])\r\n                return\r\n            t.append(nums[i])\r\n            dfs(i + 1)\r\n            x = t.pop()\r\n            while i + 1 < len(nums) and nums[i + 1] == x:\r\n                i += 1\r\n            dfs(i + 1)\r\n\r\n        nums.sort()\r\n        ans = []\r\n        t = []\r\n        dfs(0)\r\n        return ans",
