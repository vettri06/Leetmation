    "problemName": "maximum-consecutive-floors-without-special-floors",
    "language": "python3",
    "code": "class Solution:\r\n    def maxConsecutive(self, bottom: int, top: int, special: List[int]) -> int:\r\n        special.sort()\r\n        ans = max(special[0] - bottom, top - special[-1])\r\n        for x, y in pairwise(special):\r\n            ans = max(ans, y - x - 1)\r\n        return ans",
