{
    "problemName": "binary-subarrays-with-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def numSubarraysWithSum(self, nums: List[int], goal: int) -> int:\r\n        cnt = Counter({0: 1})\r\n        ans = s = 0\r\n        for v in nums:\r\n            s += v\r\n            ans += cnt[s - goal]\r\n            cnt[s] += 1\r\n        return ans",
