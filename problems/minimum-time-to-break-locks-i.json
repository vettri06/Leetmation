    "problemName": "minimum-time-to-break-locks-i",
    "language": "python3",
    "code": "class Solution:\r\n    def findMinimumTime(self, strength: List[int], K: int) -> int:\r\n        @cache\r\n        def dfs(i: int) -> int:\r\n            if i == (1 << len(strength)) - 1:\r\n                return 0\r\n            cnt = i.bit_count()\r\n            x = 1 + cnt * K\r\n            ans = inf\r\n            for j, s in enumerate(strength):\r\n                if i >> j & 1 ^ 1:\r\n                    ans = min(ans, dfs(i | 1 << j) + (s + x - 1) // x)\r\n            return ans\r\n\r\n        return dfs(0)",
