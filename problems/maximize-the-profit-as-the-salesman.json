    "problemName": "maximize-the-profit-as-the-salesman",
    "language": "python3",
    "code": "class Solution:\r\n    def maximizeTheProfit(self, n: int, offers: List[List[int]]) -> int:\r\n        offers.sort(key=lambda x: x[1])\r\n        f = [0] * (len(offers) + 1)\r\n        g = [x[1] for x in offers]\r\n        for i, (s, _, v) in enumerate(offers, 1):\r\n            j = bisect_left(g, s)\r\n            f[i] = max(f[i - 1], f[j] + v)\r\n        return f[-1]",
