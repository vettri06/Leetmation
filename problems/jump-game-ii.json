{
    "problemName": "jump-game-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def jump(self, nums: List[int]) -> int:\r\n        ans = mx = last = 0\r\n        for i, x in enumerate(nums[:-1]):\r\n            mx = max(mx, i + x)\r\n            if last == i:\r\n                ans += 1\r\n                last = mx\r\n        return ans",
