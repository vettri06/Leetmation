    "code": "class Solution:\r\n    def minimumAbsDifference(self, arr: List[int]) -> List[List[int]]:\r\n        arr.sort()\r\n        mi = min(b - a for a, b in pairwise(arr))\r\n        return [[a, b] for a, b in pairwise(arr) if b - a == mi]",
