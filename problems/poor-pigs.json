    "problemName": "poor-pigs",
    "language": "python3",
    "code": "class Solution:\r\n    def poorPigs(self, buckets: int, minutesToDie: int, minutesToTest: int) -> int:\r\n        base = minutesToTest // minutesToDie + 1\r\n        res, p = 0, 1\r\n        while p < buckets:\r\n            p *= base\r\n            res += 1\r\n        return res",
