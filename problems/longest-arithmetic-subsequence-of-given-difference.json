    "language": "python3",
    "code": "class Solution:\r\n    def longestSubsequence(self, arr: List[int], difference: int) -> int:\r\n        f = defaultdict(int)\r\n        for x in arr:\r\n            f[x] = f[x - difference] + 1\r\n        return max(f.values())",
