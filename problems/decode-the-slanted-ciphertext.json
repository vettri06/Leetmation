{
    "problemName": "decode-the-slanted-ciphertext",
    "language": "python3",
    "code": "class Solution:\r\n    def decodeCiphertext(self, encodedText: str, rows: int) -> str:\r\n        ans = []\r\n        cols = len(encodedText) // rows\r\n        for j in range(cols):\r\n            x, y = 0, j\r\n            while x < rows and y < cols:\r\n                ans.append(encodedText[x * cols + y])\r\n                x, y = x + 1, y + 1\r\n        return ''.join(ans).rstrip()",
