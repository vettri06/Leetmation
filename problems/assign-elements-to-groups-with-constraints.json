{
    "problemName": "assign-elements-to-groups-with-constraints",
    "language": "python3",
    "code": "class Solution:\r\n    def assignElements(self, groups: List[int], elements: List[int]) -> List[int]:\r\n        mx = max(groups)\r\n        d = [-1] * (mx + 1)\r\n        for j, x in enumerate(elements):\r\n            if x > mx or d[x] != -1:\r\n                continue\r\n            for y in range(x, mx + 1, x):\r\n                if d[y] == -1:\r\n                    d[y] = j\r\n        return [d[x] for x in groups]",
