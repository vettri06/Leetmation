    "problemName": "best-poker-hand",
    "language": "python3",
    "code": "class Solution:\r\n    def bestHand(self, ranks: List[int], suits: List[str]) -> str:\r\n        # if len(set(suits)) == 1:\r\n        if all(a == b for a, b in pairwise(suits)):\r\n            return 'Flush'\r\n        cnt = Counter(ranks)\r\n        if any(v >= 3 for v in cnt.values()):\r\n            return 'Three of a Kind'\r\n        if any(v == 2 for v in cnt.values()):\r\n            return 'Pair'\r\n        return 'High Card'",
