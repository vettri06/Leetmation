{
    "problemName": "count-number-of-special-subsequences",
    "language": "python3",
    "code": "class Solution:\r\n    def countSpecialSubsequences(self, nums: List[int]) -> int:\r\n        mod = 10**9 + 7\r\n        n = len(nums)\r\n        f = [[0] * 3 for _ in range(n)]\r\n        f[0][0] = nums[0] == 0\r\n        for i in range(1, n):\r\n            if nums[i] == 0:\r\n                f[i][0] = (2 * f[i - 1][0] + 1) % mod\r\n                f[i][1] = f[i - 1][1]\r\n                f[i][2] = f[i - 1][2]\r\n            elif nums[i] == 1:\r\n                f[i][0] = f[i - 1][0]\r\n                f[i][1] = (f[i - 1][0] + 2 * f[i - 1][1]) % mod\r\n                f[i][2] = f[i - 1][2]\r\n            else:\r\n                f[i][0] = f[i - 1][0]\r\n                f[i][1] = f[i - 1][1]\r\n                f[i][2] = (f[i - 1][1] + 2 * f[i - 1][2]) % mod\r\n        return f[n - 1][2]",
