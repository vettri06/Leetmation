    "problemName": "queens-that-can-attack-the-king",
    "language": "python3",
    "code": "class Solution:\r\n    def queensAttacktheKing(\r\n        self, queens: List[List[int]], king: List[int]\r\n    ) -> List[List[int]]:\r\n        n = 8\r\n        s = {(i, j) for i, j in queens}\r\n        ans = []\r\n        for a in range(-1, 2):\r\n            for b in range(-1, 2):\r\n                if a or b:\r\n                    x, y = king\r\n                    while 0 <= x + a < n and 0 <= y + b < n:\r\n                        x, y = x + a, y + b\r\n                        if (x, y) in s:\r\n                            ans.append([x, y])\r\n                            break\r\n        return ans",
