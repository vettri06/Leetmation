{
    "problemName": "smallest-rotation-with-highest-score",
    "language": "python3",
    "code": "class Solution:\r\n    def bestRotation(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        mx, ans = -1, n\r\n        d = [0] * n\r\n        for i, v in enumerate(nums):\r\n            l, r = (i + 1) % n, (n + i + 1 - v) % n\r\n            d[l] += 1\r\n            d[r] -= 1\r\n        s = 0\r\n        for k, t in enumerate(d):\r\n            s += t\r\n            if s > mx:\r\n                mx = s\r\n                ans = k\r\n        return ans",
