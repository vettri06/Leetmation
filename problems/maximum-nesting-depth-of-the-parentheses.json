{
    "problemName": "maximum-nesting-depth-of-the-parentheses",
    "language": "python3",
    "code": "class Solution:\r\n    def maxDepth(self, s: str) -> int:\r\n        ans = d = 0\r\n        for c in s:\r\n            if c == '(':\r\n                d += 1\r\n                ans = max(ans, d)\r\n            elif c == ')':\r\n                d -= 1\r\n        return ans",
