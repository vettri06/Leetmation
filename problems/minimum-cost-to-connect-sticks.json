    "problemName": "minimum-cost-to-connect-sticks",
    "language": "python3",
    "code": "class Solution:\r\n    def connectSticks(self, sticks: List[int]) -> int:\r\n        heapify(sticks)\r\n        ans = 0\r\n        while len(sticks) > 1:\r\n            z = heappop(sticks) + heappop(sticks)\r\n            ans += z\r\n            heappush(sticks, z)\r\n        return ans",
