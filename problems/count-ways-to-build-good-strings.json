{
    "problemName": "count-ways-to-build-good-strings",
    "language": "python3",
    "code": "class Solution:\r\n    def countGoodStrings(self, low: int, high: int, zero: int, one: int) -> int:\r\n        @cache\r\n        def dfs(i):\r\n            if i > high:\r\n                return 0\r\n            ans = 0\r\n            if low <= i <= high:\r\n                ans += 1\r\n            ans += dfs(i + zero) + dfs(i + one)\r\n            return ans % mod\r\n\r\n        mod = 10**9 + 7\r\n        return dfs(0)",
