{
    "problemName": "frog-jump-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def maxJump(self, stones: List[int]) -> int:\r\n        ans = stones[1] - stones[0]\r\n        for i in range(2, len(stones)):\r\n            ans = max(ans, stones[i] - stones[i - 2])\r\n        return ans",
