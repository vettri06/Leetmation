    "problemName": "remove-duplicates-from-sorted-array",
    "language": "python3",
    "code": "class Solution:\r\n    def removeDuplicates(self, nums: List[int]) -> int:\r\n        k = 0\r\n        for x in nums:\r\n            if k == 0 or x != nums[k - 1]:\r\n                nums[k] = x\r\n                k += 1\r\n        return k",
