{
    "problemName": "next-greater-element-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def nextGreaterElements(self, nums: List[int]) -> List[int]:\r\n        n = len(nums)\r\n        ans = [-1] * n\r\n        stk = []\r\n        for i in range(n * 2 - 1, -1, -1):\r\n            i %= n\r\n            while stk and stk[-1] <= nums[i]:\r\n                stk.pop()\r\n            if stk:\r\n                ans[i] = stk[-1]\r\n            stk.append(nums[i])\r\n        return ans",
