    "problemName": "valid-word-square",
    "language": "python3",
    "code": "class Solution:\r\n    def validWordSquare(self, words: List[str]) -> bool:\r\n        m = len(words)\r\n        for i, w in enumerate(words):\r\n            for j, c in enumerate(w):\r\n                if j >= m or i >= len(words[j]) or c != words[j][i]:\r\n                    return False\r\n        return True",
