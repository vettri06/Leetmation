{
    "problemName": "defuse-the-bomb",
    "language": "python3",
    "code": "class Solution:\r\n    def decrypt(self, code: List[int], k: int) -> List[int]:\r\n        n = len(code)\r\n        ans = [0] * n\r\n        if k == 0:\r\n            return ans\r\n        for i in range(n):\r\n            if k > 0:\r\n                for j in range(i + 1, i + k + 1):\r\n                    ans[i] += code[j % n]\r\n            else:\r\n                for j in range(i + k, i):\r\n                    ans[i] += code[(j + n) % n]\r\n        return ans",
