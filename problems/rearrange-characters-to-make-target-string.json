    "problemName": "rearrange-characters-to-make-target-string",
    "language": "python3",
    "code": "class Solution:\r\n    def rearrangeCharacters(self, s: str, target: str) -> int:\r\n        cnt1 = Counter(s)\r\n        cnt2 = Counter(target)\r\n        return min(cnt1[c] // v for c, v in cnt2.items())",
