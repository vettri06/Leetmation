{
    "problemName": "count-special-quadruplets",
    "language": "python3",
    "code": "class Solution:\r\n    def countQuadruplets(self, nums: List[int]) -> int:\r\n        ans, n = 0, len(nums)\r\n        for a in range(n - 3):\r\n            for b in range(a + 1, n - 2):\r\n                for c in range(b + 1, n - 1):\r\n                    for d in range(c + 1, n):\r\n                        if nums[a] + nums[b] + nums[c] == nums[d]:\r\n                            ans += 1\r\n        return ans",
