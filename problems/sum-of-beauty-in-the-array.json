{
    "problemName": "sum-of-beauty-in-the-array",
    "language": "python3",
    "code": "class Solution:\r\n    def sumOfBeauties(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        right = [nums[-1]] * n\r\n        for i in range(n - 2, -1, -1):\r\n            right[i] = min(right[i + 1], nums[i])\r\n        ans = 0\r\n        l = nums[0]\r\n        for i in range(1, n - 1):\r\n            r = right[i + 1]\r\n            if l < nums[i] < r:\r\n                ans += 2\r\n            elif nums[i - 1] < nums[i] < nums[i + 1]:\r\n                ans += 1\r\n            l = max(l, nums[i])\r\n        return ans",
