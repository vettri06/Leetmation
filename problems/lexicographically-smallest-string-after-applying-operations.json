{
    "problemName": "lexicographically-smallest-string-after-applying-operations",
    "language": "python3",
    "code": "class Solution:\r\n    def findLexSmallestString(self, s: str, a: int, b: int) -> str:\r\n        q = deque([s])\r\n        vis = {s}\r\n        ans = s\r\n        while q:\r\n            s = q.popleft()\r\n            if ans > s:\r\n                ans = s\r\n            t1 = ''.join(\r\n                [str((int(c) + a) % 10) if i & 1 else c for i, c in enumerate(s)]\r\n            )\r\n            t2 = s[-b:] + s[:-b]\r\n            for t in (t1, t2):\r\n                if t not in vis:\r\n                    vis.add(t)\r\n                    q.append(t)\r\n        return ans",
