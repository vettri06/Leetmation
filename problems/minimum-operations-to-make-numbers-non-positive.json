{
    "problemName": "minimum-operations-to-make-numbers-non-positive",
    "language": "python3",
    "code": "class Solution:\r\n    def minOperations(self, nums: List[int], x: int, y: int) -> int:\r\n        def check(t: int) -> bool:\r\n            cnt = 0\r\n            for v in nums:\r\n                if v > t * y:\r\n                    cnt += ceil((v - t * y) / (x - y))\r\n            return cnt <= t\r\n\r\n        l, r = 0, max(nums)\r\n        while l < r:\r\n            mid = (l + r) >> 1\r\n            if check(mid):\r\n                r = mid\r\n            else:\r\n                l = mid + 1\r\n        return l",
