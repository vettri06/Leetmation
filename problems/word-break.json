{
    "problemName": "word-break",
    "language": "python3",
    "code": "class Solution:\r\n    def wordBreak(self, s: str, wordDict: List[str]) -> bool:\r\n        words = set(wordDict)\r\n        n = len(s)\r\n        f = [True] + [False] * n\r\n        for i in range(1, n + 1):\r\n            f[i] = any(f[j] and s[j:i] in words for j in range(i))\r\n        return f[n]",
