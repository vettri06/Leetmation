    "problemName": "longest-palindromic-subsequence-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def longestPalindromeSubseq(self, s: str) -> int:\r\n        @cache\r\n        def dfs(i, j, x):\r\n            if i >= j:\r\n                return 0\r\n            if s[i] == s[j] and s[i] != x:\r\n                return dfs(i + 1, j - 1, s[i]) + 2\r\n            return max(dfs(i + 1, j, x), dfs(i, j - 1, x))\r\n\r\n        ans = dfs(0, len(s) - 1, '')\r\n        dfs.cache_clear()\r\n        return ans",
