{
    "problemName": "find-missing-observations",
    "language": "python3",
    "code": "class Solution:\r\n    def missingRolls(self, rolls: List[int], mean: int, n: int) -> List[int]:\r\n        m = len(rolls)\r\n        s = (n + m) * mean - sum(rolls)\r\n        if s > n * 6 or s < n:\r\n            return []\r\n        ans = [s // n] * n\r\n        for i in range(s % n):\r\n            ans[i] += 1\r\n        return ans",
