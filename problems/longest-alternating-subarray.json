{
    "problemName": "longest-alternating-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def alternatingSubarray(self, nums: List[int]) -> int:\r\n        ans, n = -1, len(nums)\r\n        for i in range(n):\r\n            k = 1\r\n            j = i\r\n            while j + 1 < n and nums[j + 1] - nums[j] == k:\r\n                j += 1\r\n                k *= -1\r\n            if j - i + 1 > 1:\r\n                ans = max(ans, j - i + 1)\r\n        return ans",
