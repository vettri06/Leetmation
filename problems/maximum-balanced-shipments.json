    "problemName": "maximum-balanced-shipments",
    "language": "python3",
    "code": "class Solution:\r\n    def maxBalancedShipments(self, weight: List[int]) -> int:\r\n        ans = mx = 0\r\n        for x in weight:\r\n            mx = max(mx, x)\r\n            if x < mx:\r\n                ans += 1\r\n                mx = 0\r\n        return ans",
