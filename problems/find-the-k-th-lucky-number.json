{
    "problemName": "find-the-k-th-lucky-number",
    "language": "python3",
    "code": "class Solution:\r\n    def kthLuckyNumber(self, k: int) -> str:\r\n        n = 1\r\n        while k > 1 << n:\r\n            k -= 1 << n\r\n            n += 1\r\n        ans = []\r\n        while n:\r\n            n -= 1\r\n            if k <= 1 << n:\r\n                ans.append(\"4\")\r\n            else:\r\n                ans.append(\"7\")\r\n                k -= 1 << n\r\n        return \"\".join(ans)",
