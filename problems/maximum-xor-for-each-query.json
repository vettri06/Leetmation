{
    "problemName": "maximum-xor-for-each-query",
    "language": "python3",
    "code": "class Solution:\r\n    def getMaximumXor(self, nums: List[int], maximumBit: int) -> List[int]:\r\n        ans = []\r\n        xs = reduce(xor, nums)\r\n        for x in nums[::-1]:\r\n            k = 0\r\n            for i in range(maximumBit - 1, -1, -1):\r\n                if (xs >> i & 1) == 0:\r\n                    k |= 1 << i\r\n            ans.append(k)\r\n            xs ^= x\r\n        return ans",
