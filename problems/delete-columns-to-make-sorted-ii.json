    "problemName": "delete-columns-to-make-sorted-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def minDeletionSize(self, strs: List[str]) -> int:\r\n        n = len(strs)\r\n        m = len(strs[0])\r\n        st = [False] * (n - 1)\r\n        ans = 0\r\n        for j in range(m):\r\n            must_del = False\r\n            for i in range(n - 1):\r\n                if not st[i] and strs[i][j] > strs[i + 1][j]:\r\n                    must_del = True\r\n                    break\r\n            if must_del:\r\n                ans += 1\r\n            else:\r\n                for i in range(n - 1):\r\n                    if not st[i] and strs[i][j] < strs[i + 1][j]:\r\n                        st[i] = True\r\n        return ans",
