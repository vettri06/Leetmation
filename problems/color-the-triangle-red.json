    "problemName": "color-the-triangle-red",
    "language": "python3",
    "code": "class Solution:\r\n    def colorRed(self, n: int) -> List[List[int]]:\r\n        ans = [[1, 1]]\r\n        k = 0\r\n        for i in range(n, 1, -1):\r\n            if k == 0:\r\n                for j in range(1, i << 1, 2):\r\n                    ans.append([i, j])\r\n            elif k == 1:\r\n                ans.append([i, 2])\r\n            elif k == 2:\r\n                for j in range(3, i << 1, 2):\r\n                    ans.append([i, j])\r\n            else:\r\n                ans.append([i, 1])\r\n            k = (k + 1) % 4\r\n        return ans",
