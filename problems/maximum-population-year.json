{
    "problemName": "maximum-population-year",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumPopulation(self, logs: List[List[int]]) -> int:\r\n        d = [0] * 101\r\n        offset = 1950\r\n        for a, b in logs:\r\n            a, b = a - offset, b - offset\r\n            d[a] += 1\r\n            d[b] -= 1\r\n        s = mx = j = 0\r\n        for i, x in enumerate(d):\r\n            s += x\r\n            if mx < s:\r\n                mx, j = s, i\r\n        return j + offset",
