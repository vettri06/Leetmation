{
    "problemName": "first-missing-positive",
    "language": "python3",
    "code": "class Solution:\r\n    def firstMissingPositive(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        for i in range(n):\r\n            while 1 <= nums[i] <= n and nums[i] != nums[nums[i] - 1]:\r\n                j = nums[i] - 1\r\n                nums[i], nums[j] = nums[j], nums[i]\r\n        for i in range(n):\r\n            if nums[i] != i + 1:\r\n                return i + 1\r\n        return n + 1",
