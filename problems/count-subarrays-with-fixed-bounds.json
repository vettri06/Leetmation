{
    "problemName": "count-subarrays-with-fixed-bounds",
    "language": "python3",
    "code": "class Solution:\r\n    def countSubarrays(self, nums: List[int], minK: int, maxK: int) -> int:\r\n        j1 = j2 = k = -1\r\n        ans = 0\r\n        for i, v in enumerate(nums):\r\n            if v < minK or v > maxK:\r\n                k = i\r\n            if v == minK:\r\n                j1 = i\r\n            if v == maxK:\r\n                j2 = i\r\n            ans += max(0, min(j1, j2) - k)\r\n        return ans",
