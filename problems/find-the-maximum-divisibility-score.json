{
    "problemName": "find-the-maximum-divisibility-score",
    "language": "python3",
    "code": "class Solution:\r\n    def maxDivScore(self, nums: List[int], divisors: List[int]) -> int:\r\n        ans, mx = divisors[0], 0\r\n        for div in divisors:\r\n            cnt = sum(x % div == 0 for x in nums)\r\n            if mx < cnt:\r\n                mx, ans = cnt, div\r\n            elif mx == cnt and ans > div:\r\n                ans = div\r\n        return ans",
