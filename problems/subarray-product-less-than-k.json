{
    "problemName": "subarray-product-less-than-k",
    "language": "python3",
    "code": "class Solution:\r\n    def numSubarrayProductLessThanK(self, nums: List[int], k: int) -> int:\r\n        ans = l = 0\r\n        p = 1\r\n        for r, x in enumerate(nums):\r\n            p *= x\r\n            while l <= r and p >= k:\r\n                p //= nums[l]\r\n                l += 1\r\n            ans += r - l + 1\r\n        return ans",
