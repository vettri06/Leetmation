    "language": "python3",
    "code": "# Definition for singly-linked list.\r\n# class ListNode:\r\n#     def __init__(self, val=0, next=None):\r\n#         self.val = val\r\n#         self.next = next\r\nclass Solution:\r\n    def swapPairs(self, head: Optional[ListNode]) -> Optional[ListNode]:\r\n        if head is None or head.next is None:\r\n            return head\r\n        t = self.swapPairs(head.next.next)\r\n        p = head.next\r\n        p.next = head\r\n        head.next = t\r\n        return p",
