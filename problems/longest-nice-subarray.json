{
    "problemName": "longest-nice-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def longestNiceSubarray(self, nums: List[int]) -> int:\r\n        ans = mask = l = 0\r\n        for r, x in enumerate(nums):\r\n            while mask & x:\r\n                mask ^= nums[l]\r\n                l += 1\r\n            mask |= x\r\n            ans = max(ans, r - l + 1)\r\n        return ans",
