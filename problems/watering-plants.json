{
    "problemName": "watering-plants",
    "language": "python3",
    "code": "class Solution:\r\n    def wateringPlants(self, plants: List[int], capacity: int) -> int:\r\n        ans, water = 0, capacity\r\n        for i, p in enumerate(plants):\r\n            if water >= p:\r\n                water -= p\r\n                ans += 1\r\n            else:\r\n                water = capacity - p\r\n                ans += i * 2 + 1\r\n        return ans",
