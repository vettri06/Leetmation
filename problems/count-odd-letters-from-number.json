{
    "problemName": "count-odd-letters-from-number",
    "language": "python3",
    "code": "d = {\r\n    0: \"zero\",\r\n    1: \"one\",\r\n    2: \"two\",\r\n    3: \"three\",\r\n    4: \"four\",\r\n    5: \"five\",\r\n    6: \"six\",\r\n    7: \"seven\",\r\n    8: \"eight\",\r\n    9: \"nine\",\r\n}\r\n\r\n\r\nclass Solution:\r\n    def countOddLetters(self, n: int) -> int:\r\n        mask = 0\r\n        while n:\r\n            x = n % 10\r\n            n //= 10\r\n            for c in d[x]:\r\n                mask ^= 1 << (ord(c) - ord(\"a\"))\r\n        return mask.bit_count()",
