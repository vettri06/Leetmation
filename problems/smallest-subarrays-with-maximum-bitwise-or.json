{
    "problemName": "smallest-subarrays-with-maximum-bitwise-or",
    "language": "python3",
    "code": "class Solution:\r\n    def smallestSubarrays(self, nums: List[int]) -> List[int]:\r\n        n = len(nums)\r\n        ans = [1] * n\r\n        f = [-1] * 32\r\n        for i in range(n - 1, -1, -1):\r\n            t = 1\r\n            for j in range(32):\r\n                if (nums[i] >> j) & 1:\r\n                    f[j] = i\r\n                elif f[j] != -1:\r\n                    t = max(t, f[j] - i + 1)\r\n            ans[i] = t\r\n        return ans",
