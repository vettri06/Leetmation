    "problemName": "pass-the-pillow",
    "language": "python3",
    "code": "class Solution:\r\n    def passThePillow(self, n: int, time: int) -> int:\r\n        ans = k = 1\r\n        for _ in range(time):\r\n            ans += k\r\n            if ans == 1 or ans == n:\r\n                k *= -1\r\n        return ans",
