    "problemName": "count-primes",
    "language": "python3",
    "code": "class Solution:\r\n    def countPrimes(self, n: int) -> int:\r\n        primes = [True] * n\r\n        ans = 0\r\n        for i in range(2, n):\r\n            if primes[i]:\r\n                ans += 1\r\n                for j in range(i + i, n, i):\r\n                    primes[j] = False\r\n        return ans",
