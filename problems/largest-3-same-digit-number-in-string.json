    "problemName": "largest-3-same-digit-number-in-string",
    "language": "python3",
    "code": "class Solution:\r\n    def largestGoodInteger(self, num: str) -> str:\r\n        for i in range(9, -1, -1):\r\n            if (s := str(i) * 3) in num:\r\n                return s\r\n        return \"\"",
