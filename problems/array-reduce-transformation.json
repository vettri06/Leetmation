    "code": "type Fn = (accum: number, curr: number) => number;\r\n\r\nfunction reduce(nums: number[], fn: Fn, init: number): number {\r\n    let acc: number = init;\r\n    for (const x of nums) {\r\n        acc = fn(acc, x);\r\n    }\r\n    return acc;\r\n}",
