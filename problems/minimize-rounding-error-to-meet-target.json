{
    "problemName": "minimize-rounding-error-to-meet-target",
    "language": "python3",
    "code": "class Solution:\r\n    def minimizeError(self, prices: List[str], target: int) -> str:\r\n        mi = 0\r\n        arr = []\r\n        for p in prices:\r\n            p = float(p)\r\n            mi += int(p)\r\n            if d := p - int(p):\r\n                arr.append(d)\r\n        if not mi <= target <= mi + len(arr):\r\n            return \"-1\"\r\n        d = target - mi\r\n        arr.sort(reverse=True)\r\n        ans = d - sum(arr[:d]) + sum(arr[d:])\r\n        return f'{ans:.3f}'",
