{
    "problemName": "rearrange-spaces-between-words",
    "language": "python3",
    "code": "class Solution:\r\n    def reorderSpaces(self, text: str) -> str:\r\n        spaces = text.count(\" \")\r\n        words = text.split()\r\n        if len(words) == 1:\r\n            return words[0] + \" \" * spaces\r\n        cnt, mod = divmod(spaces, len(words) - 1)\r\n        return (\" \" * cnt).join(words) + \" \" * mod",
