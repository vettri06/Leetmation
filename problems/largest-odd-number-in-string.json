    "problemName": "largest-odd-number-in-string",
    "language": "python3",
    "code": "class Solution:\r\n    def largestOddNumber(self, num: str) -> str:\r\n        for i in range(len(num) - 1, -1, -1):\r\n            if (int(num[i]) & 1) == 1:\r\n                return num[: i + 1]\r\n        return ''",
