{
    "problemName": "incremental-memory-leak",
    "language": "python3",
    "code": "class Solution:\r\n    def memLeak(self, memory1: int, memory2: int) -> List[int]:\r\n        i = 1\r\n        while i <= max(memory1, memory2):\r\n            if memory1 >= memory2:\r\n                memory1 -= i\r\n            else:\r\n                memory2 -= i\r\n            i += 1\r\n        return [i, memory1, memory2]",
