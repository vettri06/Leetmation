{
    "problemName": "count-square-sum-triples",
    "language": "python3",
    "code": "class Solution:\r\n    def countTriples(self, n: int) -> int:\r\n        ans = 0\r\n        for a in range(1, n):\r\n            for b in range(1, n):\r\n                x = a * a + b * b\r\n                c = int(sqrt(x))\r\n                if c <= n and c * c == x:\r\n                    ans += 1\r\n        return ans",
