{
    "problemName": "number-of-equal-count-substrings",
    "language": "python3",
    "code": "class Solution:\r\n    def equalCountSubstrings(self, s: str, count: int) -> int:\r\n        ans = 0\r\n        for i in range(1, 27):\r\n            k = i * count\r\n            if k > len(s):\r\n                break\r\n            cnt = Counter()\r\n            t = 0\r\n            for j, c in enumerate(s):\r\n                cnt[c] += 1\r\n                t += cnt[c] == count\r\n                t -= cnt[c] == count + 1\r\n                if j >= k:\r\n                    cnt[s[j - k]] -= 1\r\n                    t += cnt[s[j - k]] == count\r\n                    t -= cnt[s[j - k]] == count - 1\r\n                ans += i == t\r\n        return ans",
