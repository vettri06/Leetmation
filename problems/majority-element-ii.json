    "problemName": "majority-element-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def majorityElement(self, nums: List[int]) -> List[int]:\r\n        n1 = n2 = 0\r\n        m1, m2 = 0, 1\r\n        for m in nums:\r\n            if m == m1:\r\n                n1 += 1\r\n            elif m == m2:\r\n                n2 += 1\r\n            elif n1 == 0:\r\n                m1, n1 = m, 1\r\n            elif n2 == 0:\r\n                m2, n2 = m, 1\r\n            else:\r\n                n1, n2 = n1 - 1, n2 - 1\r\n        return [m for m in [m1, m2] if nums.count(m) > len(nums) // 3]",
