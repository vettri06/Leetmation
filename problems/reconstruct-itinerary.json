    "problemName": "reconstruct-itinerary",
    "language": "python3",
    "code": "class Solution:\r\n    def findItinerary(self, tickets: List[List[str]]) -> List[str]:\r\n        def dfs(f: str):\r\n            while g[f]:\r\n                dfs(g[f].pop())\r\n            ans.append(f)\r\n\r\n        g = defaultdict(list)\r\n        for f, t in sorted(tickets, reverse=True):\r\n            g[f].append(t)\r\n        ans = []\r\n        dfs(\"JFK\")\r\n        return ans[::-1]",
