    "problemName": "valid-palindrome-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def validPalindrome(self, s: str) -> bool:\r\n        def check(i, j):\r\n            while i < j:\r\n                if s[i] != s[j]:\r\n                    return False\r\n                i, j = i + 1, j - 1\r\n            return True\r\n\r\n        i, j = 0, len(s) - 1\r\n        while i < j:\r\n            if s[i] != s[j]:\r\n                return check(i, j - 1) or check(i + 1, j)\r\n            i, j = i + 1, j - 1\r\n        return True",
