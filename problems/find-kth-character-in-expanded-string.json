{
    "problemName": "find-kth-character-in-expanded-string",
    "language": "python3",
    "code": "class Solution:\r\n    def kthCharacter(self, s: str, k: int) -> str:\r\n        for w in s.split():\r\n            m = (1 + len(w)) * len(w) // 2\r\n            if k == m:\r\n                return \" \"\r\n            if k > m:\r\n                k -= m + 1\r\n            else:\r\n                cur = 0\r\n                for i in range(len(w)):\r\n                    cur += i + 1\r\n                    if k < cur:\r\n                        return w[i]",
