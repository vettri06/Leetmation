{
    "problemName": "happy-students",
    "language": "python3",
    "code": "class Solution:\r\n    def countWays(self, nums: List[int]) -> int:\r\n        nums.sort()\r\n        n = len(nums)\r\n        ans = 0\r\n        for i in range(n + 1):\r\n            if i and nums[i - 1] >= i:\r\n                continue\r\n            if i < n and nums[i] <= i:\r\n                continue\r\n            ans += 1\r\n        return ans",
