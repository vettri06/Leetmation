{
    "problemName": "squares-of-a-sorted-array",
    "language": "python3",
    "code": "class Solution:\r\n    def sortedSquares(self, nums: List[int]) -> List[int]:\r\n        ans = []\r\n        i, j = 0, len(nums) - 1\r\n        while i <= j:\r\n            a = nums[i] * nums[i]\r\n            b = nums[j] * nums[j]\r\n            if a > b:\r\n                ans.append(a)\r\n                i += 1\r\n            else:\r\n                ans.append(b)\r\n                j -= 1\r\n        return ans[::-1]",
