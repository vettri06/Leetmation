{
    "problemName": "equal-score-substrings",
    "language": "python3",
    "code": "class Solution:\r\n    def scoreBalance(self, s: str) -> bool:\r\n        l = 0\r\n        r = sum(ord(c) - ord(\"a\") + 1 for c in s)\r\n        for c in s[:-1]:\r\n            x = ord(c) - ord(\"a\") + 1\r\n            l += x\r\n            r -= x\r\n            if l == r:\r\n                return True\r\n        return False",
