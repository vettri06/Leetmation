{
    "problemName": "special-array-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def isArraySpecial(self, nums: List[int], queries: List[List[int]]) -> List[bool]:\r\n        n = len(nums)\r\n        d = list(range(n))\r\n        for i in range(1, n):\r\n            if nums[i] % 2 != nums[i - 1] % 2:\r\n                d[i] = d[i - 1]\r\n        return [d[t] <= f for f, t in queries]",
