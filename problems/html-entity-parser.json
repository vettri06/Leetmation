    "problemName": "html-entity-parser",
    "language": "python3",
    "code": "class Solution:\r\n    def entityParser(self, text: str) -> str:\r\n        d = {\r\n            '&quot;': '\"',\r\n            '&apos;': \"'\",\r\n            '&amp;': \"&\",\r\n            \"&gt;\": '>',\r\n            \"&lt;\": '<',\r\n            \"&frasl;\": '/',\r\n        }\r\n        i, n = 0, len(text)\r\n        ans = []\r\n        while i < n:\r\n            for l in range(1, 8):\r\n                j = i + l\r\n                if text[i:j] in d:\r\n                    ans.append(d[text[i:j]])\r\n                    i = j\r\n                    break\r\n            else:\r\n                ans.append(text[i])\r\n                i += 1\r\n        return ''.join(ans)",
