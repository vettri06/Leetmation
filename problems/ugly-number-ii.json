{
    "problemName": "ugly-number-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def nthUglyNumber(self, n: int) -> int:\r\n        h = [1]\r\n        vis = {1}\r\n        ans = 1\r\n        for _ in range(n):\r\n            ans = heappop(h)\r\n            for v in [2, 3, 5]:\r\n                nxt = ans * v\r\n                if nxt not in vis:\r\n                    vis.add(nxt)\r\n                    heappush(h, nxt)\r\n        return ans",
