{
    "problemName": "minimum-cost-tree-from-leaf-values",
    "language": "python3",
    "code": "class Solution:\r\n    def mctFromLeafValues(self, arr: List[int]) -> int:\r\n        @cache\r\n        def dfs(i: int, j: int) -> Tuple:\r\n            if i == j:\r\n                return 0, arr[i]\r\n            s, mx = inf, -1\r\n            for k in range(i, j):\r\n                s1, mx1 = dfs(i, k)\r\n                s2, mx2 = dfs(k + 1, j)\r\n                t = s1 + s2 + mx1 * mx2\r\n                if s > t:\r\n                    s = t\r\n                    mx = max(mx1, mx2)\r\n            return s, mx\r\n\r\n        return dfs(0, len(arr) - 1)[0]",
