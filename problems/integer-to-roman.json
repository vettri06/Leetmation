{
    "problemName": "integer-to-roman",
    "language": "python3",
    "code": "class Solution:\r\n    def intToRoman(self, num: int) -> str:\r\n        cs = ('M', 'CM', 'D', 'CD', 'C', 'XC', 'L', 'XL', 'X', 'IX', 'V', 'IV', 'I')\r\n        vs = (1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1)\r\n        ans = []\r\n        for c, v in zip(cs, vs):\r\n            while num >= v:\r\n                num -= v\r\n                ans.append(c)\r\n        return ''.join(ans)",
