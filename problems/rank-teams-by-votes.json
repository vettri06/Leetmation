{
    "problemName": "rank-teams-by-votes",
    "language": "python3",
    "code": "class Solution:\r\n    def rankTeams(self, votes: List[str]) -> str:\r\n        m = len(votes[0])\r\n        cnt = defaultdict(lambda: [0] * m)\r\n        for vote in votes:\r\n            for i, c in enumerate(vote):\r\n                cnt[c][i] += 1\r\n        return \"\".join(sorted(cnt, key=lambda c: (cnt[c], -ord(c)), reverse=True))",
