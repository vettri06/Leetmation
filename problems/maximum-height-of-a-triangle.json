{
    "problemName": "maximum-height-of-a-triangle",
    "language": "python3",
    "code": "class Solution:\r\n    def maxHeightOfTriangle(self, red: int, blue: int) -> int:\r\n        ans = 0\r\n        for k in range(2):\r\n            c = [red, blue]\r\n            i, j = 1, k\r\n            while i <= c[j]:\r\n                c[j] -= i\r\n                j ^= 1\r\n                ans = max(ans, i)\r\n                i += 1\r\n        return ans",
