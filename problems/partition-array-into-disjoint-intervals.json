{
    "problemName": "partition-array-into-disjoint-intervals",
    "language": "python3",
    "code": "class Solution:\r\n    def partitionDisjoint(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        mi = [inf] * (n + 1)\r\n        for i in range(n - 1, -1, -1):\r\n            mi[i] = min(nums[i], mi[i + 1])\r\n        mx = 0\r\n        for i, v in enumerate(nums, 1):\r\n            mx = max(mx, v)\r\n            if mx <= mi[i]:\r\n                return i",
