    "problemName": "count-prefix-and-suffix-pairs-i",
    "language": "python3",
    "code": "class Solution:\r\n    def countPrefixSuffixPairs(self, words: List[str]) -> int:\r\n        ans = 0\r\n        for i, s in enumerate(words):\r\n            for t in words[i + 1 :]:\r\n                ans += t.endswith(s) and t.startswith(s)\r\n        return ans",
