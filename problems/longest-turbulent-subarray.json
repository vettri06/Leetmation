    "problemName": "longest-turbulent-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def maxTurbulenceSize(self, arr: List[int]) -> int:\r\n        ans = f = g = 1\r\n        for a, b in pairwise(arr):\r\n            ff = g + 1 if a < b else 1\r\n            gg = f + 1 if a > b else 1\r\n            f, g = ff, gg\r\n            ans = max(ans, f, g)\r\n        return ans",
