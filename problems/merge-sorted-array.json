{
    "problemName": "merge-sorted-array",
    "language": "python3",
    "code": "class Solution:\r\n    def merge(self, nums1: List[int], m: int, nums2: List[int], n: int) -> None:\r\n        k = m + n - 1\r\n        i, j = m - 1, n - 1\r\n        while j >= 0:\r\n            if i >= 0 and nums1[i] > nums2[j]:\r\n                nums1[k] = nums1[i]\r\n                i -= 1\r\n            else:\r\n                nums1[k] = nums2[j]\r\n                j -= 1\r\n            k -= 1",
