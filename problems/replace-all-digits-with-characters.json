    "problemName": "replace-all-digits-with-characters",
    "language": "python3",
    "code": "class Solution:\r\n    def replaceDigits(self, s: str) -> str:\r\n        s = list(s)\r\n        for i in range(1, len(s), 2):\r\n            s[i] = chr(ord(s[i - 1]) + int(s[i]))\r\n        return ''.join(s)",
