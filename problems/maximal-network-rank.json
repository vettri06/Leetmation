    "problemName": "maximal-network-rank",
    "language": "python3",
    "code": "class Solution:\r\n    def maximalNetworkRank(self, n: int, roads: List[List[int]]) -> int:\r\n        g = defaultdict(set)\r\n        for a, b in roads:\r\n            g[a].add(b)\r\n            g[b].add(a)\r\n        ans = 0\r\n        for a in range(n):\r\n            for b in range(a + 1, n):\r\n                if (t := len(g[a]) + len(g[b]) - (a in g[b])) > ans:\r\n                    ans = t\r\n        return ans",
