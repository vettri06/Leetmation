    "code": "# Definition for singly-linked list.\r\n# class ListNode:\r\n#     def __init__(self, x):\r\n#         self.val = x\r\n#         self.next = None\r\n\r\n\r\nclass Solution:\r\n    def hasCycle(self, head: Optional[ListNode]) -> bool:\r\n        s = set()\r\n        while head:\r\n            if head in s:\r\n                return True\r\n            s.add(head)\r\n            head = head.next\r\n        return False",
