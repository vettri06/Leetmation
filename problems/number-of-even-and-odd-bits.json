    "problemName": "number-of-even-and-odd-bits",
    "language": "python3",
    "code": "class Solution:\r\n    def evenOddBit(self, n: int) -> List[int]:\r\n        ans = [0, 0]\r\n        i = 0\r\n        while n:\r\n            ans[i] += n & 1\r\n            i ^= 1\r\n            n >>= 1\r\n        return ans",
