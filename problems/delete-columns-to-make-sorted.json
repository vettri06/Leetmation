    "problemName": "delete-columns-to-make-sorted",
    "language": "python3",
    "code": "class Solution:\r\n    def minDeletionSize(self, strs: List[str]) -> int:\r\n        m, n = len(strs[0]), len(strs)\r\n        ans = 0\r\n        for j in range(m):\r\n            for i in range(1, n):\r\n                if strs[i][j] < strs[i - 1][j]:\r\n                    ans += 1\r\n                    break\r\n        return ans",
