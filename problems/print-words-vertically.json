{
    "problemName": "print-words-vertically",
    "language": "python3",
    "code": "class Solution:\r\n    def printVertically(self, s: str) -> List[str]:\r\n        words = s.split()\r\n        n = max(len(w) for w in words)\r\n        ans = []\r\n        for j in range(n):\r\n            t = [w[j] if j < len(w) else ' ' for w in words]\r\n            while t[-1] == ' ':\r\n                t.pop()\r\n            ans.append(''.join(t))\r\n        return ans",
