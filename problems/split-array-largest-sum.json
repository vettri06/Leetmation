{
    "problemName": "split-array-largest-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def splitArray(self, nums: List[int], k: int) -> int:\r\n        def check(mx):\r\n            s, cnt = inf, 0\r\n            for x in nums:\r\n                s += x\r\n                if s > mx:\r\n                    s = x\r\n                    cnt += 1\r\n            return cnt <= k\r\n\r\n        left, right = max(nums), sum(nums)\r\n        return left + bisect_left(range(left, right + 1), True, key=check)",
