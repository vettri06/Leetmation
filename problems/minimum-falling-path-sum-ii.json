{
    "problemName": "minimum-falling-path-sum-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def minFallingPathSum(self, grid: List[List[int]]) -> int:\r\n        n = len(grid)\r\n        f = [0] * n\r\n        for row in grid:\r\n            g = row[:]\r\n            for i in range(n):\r\n                g[i] += min((f[j] for j in range(n) if j != i), default=0)\r\n            f = g\r\n        return min(f)",
