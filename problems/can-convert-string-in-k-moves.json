{
    "problemName": "can-convert-string-in-k-moves",
    "language": "python3",
    "code": "class Solution:\r\n    def canConvertString(self, s: str, t: str, k: int) -> bool:\r\n        if len(s) != len(t):\r\n            return False\r\n        cnt = [0] * 26\r\n        for a, b in zip(s, t):\r\n            x = (ord(b) - ord(a) + 26) % 26\r\n            cnt[x] += 1\r\n        for i in range(1, 26):\r\n            if i + 26 * (cnt[i] - 1) > k:\r\n                return False\r\n        return True",
