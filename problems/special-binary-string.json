    "problemName": "special-binary-string",
    "language": "python3",
    "code": "class Solution:\r\n    def makeLargestSpecial(self, s: str) -> str:\r\n        if s == '':\r\n            return ''\r\n        ans = []\r\n        cnt = 0\r\n        i = j = 0\r\n        while i < len(s):\r\n            cnt += 1 if s[i] == '1' else -1\r\n            if cnt == 0:\r\n                ans.append('1' + self.makeLargestSpecial(s[j + 1 : i]) + '0')\r\n                j = i + 1\r\n            i += 1\r\n        ans.sort(reverse=True)\r\n        return ''.join(ans)",
