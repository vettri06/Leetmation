{
    "problemName": "count-number-of-bad-pairs",
    "language": "python3",
    "code": "class Solution:\r\n    def countBadPairs(self, nums: List[int]) -> int:\r\n        cnt = Counter()\r\n        ans = 0\r\n        for i, x in enumerate(nums):\r\n            ans += i - cnt[i - x]\r\n            cnt[i - x] += 1\r\n        return ans",
