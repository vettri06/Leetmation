    "problemName": "number-of-islands",
    "language": "python3",
    "code": "class Solution:\r\n    def numIslands(self, grid: List[List[str]]) -> int:\r\n        def dfs(i, j):\r\n            grid[i][j] = '0'\r\n            for a, b in pairwise(dirs):\r\n                x, y = i + a, j + b\r\n                if 0 <= x < m and 0 <= y < n and grid[x][y] == '1':\r\n                    dfs(x, y)\r\n\r\n        ans = 0\r\n        dirs = (-1, 0, 1, 0, -1)\r\n        m, n = len(grid), len(grid[0])\r\n        for i in range(m):\r\n            for j in range(n):\r\n                if grid[i][j] == '1':\r\n                    dfs(i, j)\r\n                    ans += 1\r\n        return ans",
