{
    "problemName": "find-the-pivot-integer",
    "language": "python3",
    "code": "class Solution:\r\n    def pivotInteger(self, n: int) -> int:\r\n        for x in range(1, n + 1):\r\n            if (1 + x) * x == (x + n) * (n - x + 1):\r\n                return x\r\n        return -1",
