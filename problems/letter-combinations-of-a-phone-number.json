{
    "problemName": "letter-combinations-of-a-phone-number",
    "language": "python3",
    "code": "class Solution:\r\n    def letterCombinations(self, digits: str) -> List[str]:\r\n        if not digits:\r\n            return []\r\n        d = [\"abc\", \"def\", \"ghi\", \"jkl\", \"mno\", \"pqrs\", \"tuv\", \"wxyz\"]\r\n        ans = [\"\"]\r\n        for i in digits:\r\n            s = d[int(i) - 2]\r\n            ans = [a + b for a in ans for b in s]\r\n        return ans",
