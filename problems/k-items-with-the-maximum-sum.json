{
    "problemName": "k-items-with-the-maximum-sum",
    "language": "python3",
    "code": "class Solution:\r\n    def kItemsWithMaximumSum(\r\n        self, numOnes: int, numZeros: int, numNegOnes: int, k: int\r\n    ) -> int:\r\n        if numOnes >= k:\r\n            return k\r\n        if numZeros >= k - numOnes:\r\n            return numOnes\r\n        return numOnes - (k - numOnes - numZeros)",
