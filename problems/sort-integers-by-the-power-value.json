    "problemName": "sort-integers-by-the-power-value",
    "language": "python3",
    "code": "@cache\r\ndef f(x: int) -> int:\r\n    ans = 0\r\n    while x != 1:\r\n        if x % 2 == 0:\r\n            x //= 2\r\n        else:\r\n            x = 3 * x + 1\r\n        ans += 1\r\n    return ans\r\n\r\n\r\nclass Solution:\r\n    def getKth(self, lo: int, hi: int, k: int) -> int:\r\n        return sorted(range(lo, hi + 1), key=f)[k - 1]",
