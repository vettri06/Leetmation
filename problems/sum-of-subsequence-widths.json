{
    "problemName": "sum-of-subsequence-widths",
    "language": "python3",
    "code": "class Solution:\r\n    def sumSubseqWidths(self, nums: List[int]) -> int:\r\n        mod = 10**9 + 7\r\n        nums.sort()\r\n        ans, p = 0, 1\r\n        for i, v in enumerate(nums):\r\n            ans = (ans + (v - nums[-i - 1]) * p) % mod\r\n            p = (p << 1) % mod\r\n        return ans",
