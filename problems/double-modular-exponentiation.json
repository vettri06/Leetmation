    "code": "class Solution:\r\n    def getGoodIndices(self, variables: List[List[int]], target: int) -> List[int]:\r\n        return [\r\n            i\r\n            for i, (a, b, c, m) in enumerate(variables)\r\n            if pow(pow(a, b, 10), c, m) == target\r\n        ]",
