    "problemName": "shortest-cycle-in-a-graph",
    "language": "python3",
    "code": "class Solution:\r\n    def findShortestCycle(self, n: int, edges: List[List[int]]) -> int:\r\n        def bfs(u: int, v: int) -> int:\r\n            dist = [inf] * n\r\n            dist[u] = 0\r\n            q = deque([u])\r\n            while q:\r\n                i = q.popleft()\r\n                for j in g[i]:\r\n                    if (i, j) != (u, v) and (j, i) != (u, v) and dist[j] == inf:\r\n                        dist[j] = dist[i] + 1\r\n                        q.append(j)\r\n            return dist[v] + 1\r\n\r\n        g = defaultdict(set)\r\n        for u, v in edges:\r\n            g[u].add(v)\r\n            g[v].add(u)\r\n        ans = min(bfs(u, v) for u, v in edges)\r\n        return ans if ans < inf else -1",
