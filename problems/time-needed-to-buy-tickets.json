{
    "problemName": "time-needed-to-buy-tickets",
    "language": "python3",
    "code": "class Solution:\r\n    def timeRequiredToBuy(self, tickets: List[int], k: int) -> int:\r\n        ans = 0\r\n        for i, x in enumerate(tickets):\r\n            ans += min(x, tickets[k] if i <= k else tickets[k] - 1)\r\n        return ans",
