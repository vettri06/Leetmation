{
    "problemName": "maximum-number-of-points-with-cost",
    "language": "python3",
    "code": "class Solution:\r\n    def maxPoints(self, points: List[List[int]]) -> int:\r\n        n = len(points[0])\r\n        f = points[0][:]\r\n        for p in points[1:]:\r\n            g = [0] * n\r\n            lmx = -inf\r\n            for j in range(n):\r\n                lmx = max(lmx, f[j] + j)\r\n                g[j] = max(g[j], p[j] + lmx - j)\r\n            rmx = -inf\r\n            for j in range(n - 1, -1, -1):\r\n                rmx = max(rmx, f[j] - j)\r\n                g[j] = max(g[j], p[j] + rmx + j)\r\n            f = g\r\n        return max(f)",
