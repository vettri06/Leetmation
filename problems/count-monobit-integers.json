    "problemName": "count-monobit-integers",
    "language": "python3",
    "code": "class Solution:\r\n    def countMonobit(self, n: int) -> int:\r\n        ans = x = 1\r\n        i = 1\r\n        while x <= n:\r\n            ans += 1\r\n            x += 1 << i\r\n            i += 1\r\n        return ans",
