    "problemName": "patching-array",
    "language": "python3",
    "code": "class Solution:\r\n    def minPatches(self, nums: List[int], n: int) -> int:\r\n        x = 1\r\n        ans = i = 0\r\n        while x <= n:\r\n            if i < len(nums) and nums[i] <= x:\r\n                x += nums[i]\r\n                i += 1\r\n            else:\r\n                ans += 1\r\n                x <<= 1\r\n        return ans",
