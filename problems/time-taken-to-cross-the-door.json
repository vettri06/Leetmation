    "problemName": "time-taken-to-cross-the-door",
    "language": "python3",
    "code": "class Solution:\r\n    def timeTaken(self, arrival: List[int], state: List[int]) -> List[int]:\r\n        q = [deque(), deque()]\r\n        n = len(arrival)\r\n        t = i = 0\r\n        st = 1\r\n        ans = [0] * n\r\n        while i < n or q[0] or q[1]:\r\n            while i < n and arrival[i] <= t:\r\n                q[state[i]].append(i)\r\n                i += 1\r\n            if q[0] and q[1]:\r\n                ans[q[st].popleft()] = t\r\n            elif q[0] or q[1]:\r\n                st = 0 if q[0] else 1\r\n                ans[q[st].popleft()] = t\r\n            else:\r\n                st = 1\r\n            t += 1\r\n        return ans",
