{
    "problemName": "strong-password-checker-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def strongPasswordCheckerII(self, password: str) -> bool:\r\n        if len(password) < 8:\r\n            return False\r\n        mask = 0\r\n        for i, c in enumerate(password):\r\n            if i and c == password[i - 1]:\r\n                return False\r\n            if c.islower():\r\n                mask |= 1\r\n            elif c.isupper():\r\n                mask |= 2\r\n            elif c.isdigit():\r\n                mask |= 4\r\n            else:\r\n                mask |= 8\r\n        return mask == 15",
