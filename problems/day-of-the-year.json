{
    "problemName": "day-of-the-year",
    "language": "python3",
    "code": "class Solution:\r\n    def dayOfYear(self, date: str) -> int:\r\n        y, m, d = (int(s) for s in date.split('-'))\r\n        v = 29 if y % 400 == 0 or (y % 4 == 0 and y % 100) else 28\r\n        days = [31, v, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]\r\n        return sum(days[: m - 1]) + d",
