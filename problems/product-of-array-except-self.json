    "problemName": "product-of-array-except-self",
    "language": "python3",
    "code": "class Solution:\r\n    def productExceptSelf(self, nums: List[int]) -> List[int]:\r\n        n = len(nums)\r\n        ans = [0] * n\r\n        left = right = 1\r\n        for i, x in enumerate(nums):\r\n            ans[i] = left\r\n            left *= x\r\n        for i in range(n - 1, -1, -1):\r\n            ans[i] *= right\r\n            right *= nums[i]\r\n        return ans",
