{
    "problemName": "n-ary-tree-postorder-traversal",
    "language": "python3",
    "code": "\"\"\"\r\n# Definition for a Node.\r\nclass Node:\r\n    def __init__(self, val=None, children=None):\r\n        self.val = val\r\n        self.children = children\r\n\"\"\"\r\n\r\n\r\nclass Solution:\r\n    def postorder(self, root: 'Node') -> List[int]:\r\n        def dfs(root):\r\n            if root is None:\r\n                return\r\n            for child in root.children:\r\n                dfs(child)\r\n            ans.append(root.val)\r\n\r\n        ans = []\r\n        dfs(root)\r\n        return ans",
