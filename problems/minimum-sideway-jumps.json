{
    "problemName": "minimum-sideway-jumps",
    "language": "python3",
    "code": "class Solution:\r\n    def minSideJumps(self, obstacles: List[int]) -> int:\r\n        f = [1, 0, 1]\r\n        for v in obstacles[1:]:\r\n            for j in range(3):\r\n                if v == j + 1:\r\n                    f[j] = inf\r\n                    break\r\n            x = min(f) + 1\r\n            for j in range(3):\r\n                if v != j + 1:\r\n                    f[j] = min(f[j], x)\r\n        return min(f)",
