{
    "problemName": "flip-string-to-monotone-increasing",
    "language": "python3",
    "code": "class Solution:\r\n    def minFlipsMonoIncr(self, s: str) -> int:\r\n        tot = s.count(\"0\")\r\n        ans, cur = tot, 0\r\n        for i, c in enumerate(s, 1):\r\n            cur += int(c == \"0\")\r\n            ans = min(ans, i - cur + tot - cur)\r\n        return ans",
