    "code": "class Solution:\r\n    def optimalDivision(self, nums: List[int]) -> str:\r\n        n = len(nums)\r\n        if n == 1:\r\n            return str(nums[0])\r\n        if n == 2:\r\n            return f'{nums[0]}/{nums[1]}'\r\n        return f'{nums[0]}/({\"/\".join(map(str, nums[1:]))})'",
