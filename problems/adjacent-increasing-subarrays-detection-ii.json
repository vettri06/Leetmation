{
    "problemName": "adjacent-increasing-subarrays-detection-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def maxIncreasingSubarrays(self, nums: List[int]) -> int:\r\n        ans = pre = cur = 0\r\n        for i, x in enumerate(nums):\r\n            cur += 1\r\n            if i == len(nums) - 1 or x >= nums[i + 1]:\r\n                ans = max(ans, cur // 2, min(pre, cur))\r\n                pre, cur = cur, 0\r\n        return ans",
