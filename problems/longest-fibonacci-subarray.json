{
    "problemName": "longest-fibonacci-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def longestSubarray(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        ans = f = 2\r\n        for i in range(2, n):\r\n            if nums[i] == nums[i - 1] + nums[i - 2]:\r\n                f = f + 1\r\n                ans = max(ans, f)\r\n            else:\r\n                f = 2\r\n        return ans",
