    "code": "class Solution:\r\n    def mergeArrays(\r\n        self, nums1: List[List[int]], nums2: List[List[int]]\r\n    ) -> List[List[int]]:\r\n        cnt = Counter()\r\n        for i, v in nums1 + nums2:\r\n            cnt[i] += v\r\n        return sorted(cnt.items())",
