    "problemName": "valid-word",
    "language": "python3",
    "code": "class Solution:\r\n    def isValid(self, word: str) -> bool:\r\n        if len(word) < 3:\r\n            return False\r\n        has_vowel = has_consonant = False\r\n        vs = set(\"aeiouAEIOU\")\r\n        for c in word:\r\n            if not c.isalnum():\r\n                return False\r\n            if c.isalpha():\r\n                if c in vs:\r\n                    has_vowel = True\r\n                else:\r\n                    has_consonant = True\r\n        return has_vowel and has_consonant",
