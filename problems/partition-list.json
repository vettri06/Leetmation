{
    "problemName": "partition-list",
    "language": "python3",
    "code": "# Definition for singly-linked list.\r\n# class ListNode:\r\n#     def __init__(self, val=0, next=None):\r\n#         self.val = val\r\n#         self.next = next\r\nclass Solution:\r\n    def partition(self, head: Optional[ListNode], x: int) -> Optional[ListNode]:\r\n        l = ListNode()\r\n        r = ListNode()\r\n        tl, tr = l, r\r\n        while head:\r\n            if head.val < x:\r\n                tl.next = head\r\n                tl = tl.next\r\n            else:\r\n                tr.next = head\r\n                tr = tr.next\r\n            head = head.next\r\n        tr.next = None\r\n        tl.next = r.next\r\n        return l.next",
