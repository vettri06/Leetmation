    "code": "class Solution:\r\n    def trafficSignal(self, timer: int) -> str:\r\n        if timer == 0:\r\n            return \"Green\"\r\n        if timer == 30:\r\n            return \"Orange\"\r\n        if 30 < timer <= 90:\r\n            return \"Red\"\r\n        return \"Invalid\"",
