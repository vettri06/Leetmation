{
    "problemName": "compare-sums-of-bitonic-parts",
    "language": "python3",
    "code": "class Solution:\r\n    def compareBitonicSums(self, nums: list[int]) -> int:\r\n        l, r = nums[0], sum(nums)\r\n        for a, b in pairwise(nums):\r\n            if a > b:\r\n                break\r\n            l += b\r\n            r -= a\r\n        if l == r:\r\n            return -1\r\n        return 0 if l > r else 1",
