{
    "problemName": "3sum-closest",
    "language": "python3",
    "code": "class Solution:\r\n    def threeSumClosest(self, nums: List[int], target: int) -> int:\r\n        nums.sort()\r\n        n = len(nums)\r\n        ans = inf\r\n        for i, v in enumerate(nums):\r\n            j, k = i + 1, n - 1\r\n            while j < k:\r\n                t = v + nums[j] + nums[k]\r\n                if t == target:\r\n                    return t\r\n                if abs(t - target) < abs(ans - target):\r\n                    ans = t\r\n                if t > target:\r\n                    k -= 1\r\n                else:\r\n                    j += 1\r\n        return ans",
