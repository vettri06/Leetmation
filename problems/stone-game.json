{
    "problemName": "stone-game",
    "language": "python3",
    "code": "class Solution:\r\n    def stoneGame(self, piles: List[int]) -> bool:\r\n        @cache\r\n        def dfs(i: int, j: int) -> int:\r\n            if i > j:\r\n                return 0\r\n            return max(piles[i] - dfs(i + 1, j), piles[j] - dfs(i, j - 1))\r\n\r\n        return dfs(0, len(piles) - 1) > 0",
