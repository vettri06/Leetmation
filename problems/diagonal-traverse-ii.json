    "problemName": "diagonal-traverse-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def findDiagonalOrder(self, nums: List[List[int]]) -> List[int]:\r\n        arr = []\r\n        for i, row in enumerate(nums):\r\n            for j, v in enumerate(row):\r\n                arr.append((i + j, j, v))\r\n        arr.sort()\r\n        return [v[2] for v in arr]",
