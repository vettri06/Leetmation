{
    "problemName": "video-stitching",
    "language": "python3",
    "code": "class Solution:\r\n    def videoStitching(self, clips: List[List[int]], time: int) -> int:\r\n        last = [0] * time\r\n        for a, b in clips:\r\n            if a < time:\r\n                last[a] = max(last[a], b)\r\n        ans = mx = pre = 0\r\n        for i, v in enumerate(last):\r\n            mx = max(mx, v)\r\n            if mx <= i:\r\n                return -1\r\n            if pre == i:\r\n                ans += 1\r\n                pre = mx\r\n        return ans",
