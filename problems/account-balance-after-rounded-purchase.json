{
    "problemName": "account-balance-after-rounded-purchase",
    "language": "python3",
    "code": "class Solution:\r\n    def accountBalanceAfterPurchase(self, purchaseAmount: int) -> int:\r\n        diff, x = 100, 0\r\n        for y in range(100, -1, -10):\r\n            if (t := abs(y - purchaseAmount)) < diff:\r\n                diff = t\r\n                x = y\r\n        return 100 - x",
