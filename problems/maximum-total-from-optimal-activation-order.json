{
    "problemName": "maximum-total-from-optimal-activation-order",
    "language": "python3",
    "code": "class Solution:\r\n    def maxTotal(self, value: List[int], limit: List[int]) -> int:\r\n        g = defaultdict(list)\r\n        for v, lim in zip(value, limit):\r\n            g[lim].append(v)\r\n        ans = 0\r\n        for lim, vs in g.items():\r\n            vs.sort()\r\n            ans += sum(vs[-lim:])\r\n        return ans",
