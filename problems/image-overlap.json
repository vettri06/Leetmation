    "problemName": "image-overlap",
    "language": "python3",
    "code": "class Solution:\r\n    def largestOverlap(self, img1: List[List[int]], img2: List[List[int]]) -> int:\r\n        n = len(img1)\r\n        cnt = Counter()\r\n        for i in range(n):\r\n            for j in range(n):\r\n                if img1[i][j]:\r\n                    for h in range(n):\r\n                        for k in range(n):\r\n                            if img2[h][k]:\r\n                                cnt[(i - h, j - k)] += 1\r\n        return max(cnt.values()) if cnt else 0",
