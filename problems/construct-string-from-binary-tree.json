{
    "problemName": "construct-string-from-binary-tree",
    "language": "python3",
    "code": "# Definition for a binary tree node.\r\n# class TreeNode:\r\n#     def __init__(self, val=0, left=None, right=None):\r\n#         self.val = val\r\n#         self.left = left\r\n#         self.right = right\r\nclass Solution:\r\n    def tree2str(self, root: Optional[TreeNode]) -> str:\r\n        def dfs(root):\r\n            if root is None:\r\n                return ''\r\n            if root.left is None and root.right is None:\r\n                return str(root.val)\r\n            if root.right is None:\r\n                return f'{root.val}({dfs(root.left)})'\r\n            return f'{root.val}({dfs(root.left)})({dfs(root.right)})'\r\n\r\n        return dfs(root)",
    "problemId": 606,
