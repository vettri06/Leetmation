{
    "problemName": "longest-semi-repeating-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def longestSubarray(self, nums: List[int], k: int) -> int:\r\n        cnt = defaultdict(int)\r\n        ans = cur = l = 0\r\n        for r, x in enumerate(nums):\r\n            cnt[x] += 1\r\n            cur += cnt[x] == 2\r\n            while cur > k:\r\n                cnt[nums[l]] -= 1\r\n                cur -= cnt[nums[l]] == 1\r\n                l += 1\r\n            ans = max(ans, r - l + 1)\r\n        return ans",
