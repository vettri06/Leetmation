    "language": "python3",
    "code": "class Solution:\r\n    def findIntersectionValues(self, nums1: List[int], nums2: List[int]) -> List[int]:\r\n        s1, s2 = set(nums1), set(nums2)\r\n        return [sum(x in s2 for x in nums1), sum(x in s1 for x in nums2)]",
