    "problemName": "factor-combinations",
    "language": "python3",
    "code": "class Solution:\r\n    def getFactors(self, n: int) -> List[List[int]]:\r\n        def dfs(n, i):\r\n            if t:\r\n                ans.append(t + [n])\r\n            j = i\r\n            while j * j <= n:\r\n                if n % j == 0:\r\n                    t.append(j)\r\n                    dfs(n // j, j)\r\n                    t.pop()\r\n                j += 1\r\n\r\n        t = []\r\n        ans = []\r\n        dfs(n, 2)\r\n        return ans",
