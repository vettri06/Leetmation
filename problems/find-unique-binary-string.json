{
    "problemName": "find-unique-binary-string",
    "language": "python3",
    "code": "class Solution:\r\n    def findDifferentBinaryString(self, nums: List[str]) -> str:\r\n        mask = 0\r\n        for x in nums:\r\n            mask |= 1 << x.count(\"1\")\r\n        for i in count(0):\r\n            if mask >> i & 1 ^ 1:\r\n                return \"1\" * i + \"0\" * (len(nums) - i)",
