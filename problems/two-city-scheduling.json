    "code": "class Solution:\r\n    def twoCitySchedCost(self, costs: List[List[int]]) -> int:\r\n        costs.sort(key=lambda x: x[0] - x[1])\r\n        n = len(costs) >> 1\r\n        return sum(costs[i][0] + costs[i + n][1] for i in range(n))",
