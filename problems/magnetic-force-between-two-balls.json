{
    "problemName": "magnetic-force-between-two-balls",
    "language": "python3",
    "code": "class Solution:\r\n    def maxDistance(self, position: List[int], m: int) -> int:\r\n        def check(f: int) -> bool:\r\n            prev = -inf\r\n            cnt = 0\r\n            for curr in position:\r\n                if curr - prev >= f:\r\n                    prev = curr\r\n                    cnt += 1\r\n            return cnt < m\r\n\r\n        position.sort()\r\n        l, r = 1, position[-1]\r\n        return bisect_left(range(l, r + 1), True, key=check)",
