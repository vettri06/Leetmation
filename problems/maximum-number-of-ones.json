{
    "problemName": "maximum-number-of-ones",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumNumberOfOnes(\r\n        self, width: int, height: int, sideLength: int, maxOnes: int\r\n    ) -> int:\r\n        x = sideLength\r\n        cnt = [0] * (x * x)\r\n        for i in range(width):\r\n            for j in range(height):\r\n                k = (i % x) * x + (j % x)\r\n                cnt[k] += 1\r\n        cnt.sort(reverse=True)\r\n        return sum(cnt[:maxOnes])",
