{
    "problemName": "break-a-palindrome",
    "language": "python3",
    "code": "class Solution:\r\n    def breakPalindrome(self, palindrome: str) -> str:\r\n        n = len(palindrome)\r\n        if n == 1:\r\n            return \"\"\r\n        s = list(palindrome)\r\n        i = 0\r\n        while i < n // 2 and s[i] == \"a\":\r\n            i += 1\r\n        if i == n // 2:\r\n            s[-1] = \"b\"\r\n        else:\r\n            s[i] = \"a\"\r\n        return \"\".join(s)",
