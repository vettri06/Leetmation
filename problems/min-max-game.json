{
    "problemName": "min-max-game",
    "language": "python3",
    "code": "class Solution:\r\n    def minMaxGame(self, nums: List[int]) -> int:\r\n        n = len(nums)\r\n        while n > 1:\r\n            n >>= 1\r\n            for i in range(n):\r\n                a, b = nums[i << 1], nums[i << 1 | 1]\r\n                nums[i] = min(a, b) if i % 2 == 0 else max(a, b)\r\n        return nums[0]",
