    "language": "python3",
    "code": "class Solution:\r\n    def isBoomerang(self, points: List[List[int]]) -> bool:\r\n        (x1, y1), (x2, y2), (x3, y3) = points\r\n        return (y2 - y1) * (x3 - x2) != (y3 - y2) * (x2 - x1)",
