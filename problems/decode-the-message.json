    "code": "class Solution:\r\n    def decodeMessage(self, key: str, message: str) -> str:\r\n        d = {\" \": \" \"}\r\n        i = 0\r\n        for c in key:\r\n            if c not in d:\r\n                d[c] = ascii_lowercase[i]\r\n                i += 1\r\n        return \"\".join(d[c] for c in message)",
