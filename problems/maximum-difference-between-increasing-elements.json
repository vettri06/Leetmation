{
    "problemName": "maximum-difference-between-increasing-elements",
    "language": "python3",
    "code": "class Solution:\r\n    def maximumDifference(self, nums: List[int]) -> int:\r\n        mi = inf\r\n        ans = -1\r\n        for x in nums:\r\n            if x > mi:\r\n                ans = max(ans, x - mi)\r\n            else:\r\n                mi = x\r\n        return ans",
