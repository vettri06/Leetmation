{
    "problemName": "maximize-palindrome-length-from-subsequences",
    "language": "python3",
    "code": "class Solution:\r\n    def longestPalindrome(self, word1: str, word2: str) -> int:\r\n        s = word1 + word2\r\n        n = len(s)\r\n        f = [[0] * n for _ in range(n)]\r\n        for i in range(n):\r\n            f[i][i] = 1\r\n        ans = 0\r\n        for i in range(n - 2, -1, -1):\r\n            for j in range(i + 1, n):\r\n                if s[i] == s[j]:\r\n                    f[i][j] = f[i + 1][j - 1] + 2\r\n                    if i < len(word1) <= j:\r\n                        ans = max(ans, f[i][j])\r\n                else:\r\n                    f[i][j] = max(f[i + 1][j], f[i][j - 1])\r\n        return ans",
