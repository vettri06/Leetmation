    "problemName": "h-index",
    "language": "python3",
    "code": "class Solution:\r\n    def hIndex(self, citations: List[int]) -> int:\r\n        citations.sort(reverse=True)\r\n        for h in range(len(citations), 0, -1):\r\n            if citations[h - 1] >= h:\r\n                return h\r\n        return 0",
