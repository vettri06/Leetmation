{
    "problemName": "distinct-subsequences-ii",
    "language": "python3",
    "code": "class Solution:\r\n    def distinctSubseqII(self, s: str) -> int:\r\n        mod = 10**9 + 7\r\n        n = len(s)\r\n        dp = [[0] * 26 for _ in range(n + 1)]\r\n        for i, c in enumerate(s, 1):\r\n            k = ord(c) - ord('a')\r\n            for j in range(26):\r\n                if j == k:\r\n                    dp[i][j] = sum(dp[i - 1]) % mod + 1\r\n                else:\r\n                    dp[i][j] = dp[i - 1][j]\r\n        return sum(dp[-1]) % mod",
