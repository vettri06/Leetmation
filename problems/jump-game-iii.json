    "problemName": "jump-game-iii",
    "language": "python3",
    "code": "class Solution:\r\n    def canReach(self, arr: List[int], start: int) -> bool:\r\n        q = deque([start])\r\n        while q:\r\n            i = q.popleft()\r\n            if arr[i] == 0:\r\n                return True\r\n            x = arr[i]\r\n            arr[i] = -1\r\n            for j in (i + x, i - x):\r\n                if 0 <= j < len(arr) and arr[j] >= 0:\r\n                    q.append(j)\r\n        return False",
