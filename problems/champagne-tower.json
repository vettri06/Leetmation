{
    "problemName": "champagne-tower",
    "language": "python3",
    "code": "class Solution:\r\n    def champagneTower(self, poured: int, query_row: int, query_glass: int) -> float:\r\n        f = [[0] * 101 for _ in range(101)]\r\n        f[0][0] = poured\r\n        for i in range(query_row + 1):\r\n            for j in range(i + 1):\r\n                if f[i][j] > 1:\r\n                    half = (f[i][j] - 1) / 2\r\n                    f[i][j] = 1\r\n                    f[i + 1][j] += half\r\n                    f[i + 1][j + 1] += half\r\n        return f[query_row][query_glass]",
