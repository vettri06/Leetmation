{
    "problemName": "number-of-valid-clock-times",
    "language": "python3",
    "code": "class Solution:\r\n    def countTime(self, time: str) -> int:\r\n        def check(s: str, t: str) -> bool:\r\n            return all(a == b or b == '?' for a, b in zip(s, t))\r\n\r\n        return sum(\r\n            check(f'{h:02d}:{m:02d}', time) for h in range(24) for m in range(60)\r\n        )",
