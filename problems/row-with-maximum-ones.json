    "problemName": "row-with-maximum-ones",
    "language": "python3",
    "code": "class Solution:\r\n    def rowAndMaximumOnes(self, mat: List[List[int]]) -> List[int]:\r\n        ans = [0, 0]\r\n        for i, row in enumerate(mat):\r\n            cnt = sum(row)\r\n            if ans[1] < cnt:\r\n                ans = [i, cnt]\r\n        return ans",
