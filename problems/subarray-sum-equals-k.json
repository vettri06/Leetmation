{
    "problemName": "subarray-sum-equals-k",
    "language": "python3",
    "code": "class Solution:\r\n    def subarraySum(self, nums: List[int], k: int) -> int:\r\n        cnt = Counter({0: 1})\r\n        ans = s = 0\r\n        for x in nums:\r\n            s += x\r\n            ans += cnt[s - k]\r\n            cnt[s] += 1\r\n        return ans",
