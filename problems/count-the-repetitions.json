{
    "problemName": "count-the-repetitions",
    "language": "python3",
    "code": "class Solution:\r\n    def getMaxRepetitions(self, s1: str, n1: int, s2: str, n2: int) -> int:\r\n        n = len(s2)\r\n        d = {}\r\n        for i in range(n):\r\n            cnt = 0\r\n            j = i\r\n            for c in s1:\r\n                if c == s2[j]:\r\n                    j += 1\r\n                if j == n:\r\n                    cnt += 1\r\n                    j = 0\r\n            d[i] = (cnt, j)\r\n\r\n        ans = 0\r\n        j = 0\r\n        for _ in range(n1):\r\n            cnt, j = d[j]\r\n            ans += cnt\r\n        return ans // n2",
