{
    "problemName": "count-asterisks",
    "language": "python3",
    "code": "class Solution:\r\n    def countAsterisks(self, s: str) -> int:\r\n        ans, ok = 0, 1\r\n        for c in s:\r\n            if c == \"*\":\r\n                ans += ok\r\n            elif c == \"|\":\r\n                ok ^= 1\r\n        return ans",
