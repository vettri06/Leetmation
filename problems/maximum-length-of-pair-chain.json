    "problemName": "maximum-length-of-pair-chain",
    "language": "python3",
    "code": "class Solution:\r\n    def findLongestChain(self, pairs: List[List[int]]) -> int:\r\n        pairs.sort(key=lambda x: x[1])\r\n        ans, pre = 0, -inf\r\n        for a, b in pairs:\r\n            if pre < a:\r\n                ans += 1\r\n                pre = b\r\n        return ans",
