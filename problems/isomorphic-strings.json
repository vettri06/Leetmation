    "problemName": "isomorphic-strings",
    "language": "python3",
    "code": "class Solution:\r\n    def isIsomorphic(self, s: str, t: str) -> bool:\r\n        d1 = {}\r\n        d2 = {}\r\n        for a, b in zip(s, t):\r\n            if (a in d1 and d1[a] != b) or (b in d2 and d2[b] != a):\r\n                return False\r\n            d1[a] = b\r\n            d2[b] = a\r\n        return True",
