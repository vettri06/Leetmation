{
    "problemName": "binary-number-with-alternating-bits",
    "language": "python3",
    "code": "class Solution:\r\n    def hasAlternatingBits(self, n: int) -> bool:\r\n        prev = -1\r\n        while n:\r\n            curr = n & 1\r\n            if prev == curr:\r\n                return False\r\n            prev = curr\r\n            n >>= 1\r\n        return True",
