    "language": "python3",
    "code": "class Solution:\r\n    def balancedStringSplit(self, s: str) -> int:\r\n        ans = l = 0\r\n        for c in s:\r\n            if c == 'L':\r\n                l += 1\r\n            else:\r\n                l -= 1\r\n            if l == 0:\r\n                ans += 1\r\n        return ans",
