    "problemName": "maximum-sum-of-almost-unique-subarray",
    "language": "python3",
    "code": "class Solution:\r\n    def maxSum(self, nums: List[int], m: int, k: int) -> int:\r\n        cnt = Counter(nums[:k])\r\n        s = sum(nums[:k])\r\n        ans = s if len(cnt) >= m else 0\r\n        for i in range(k, len(nums)):\r\n            cnt[nums[i]] += 1\r\n            cnt[nums[i - k]] -= 1\r\n            s += nums[i] - nums[i - k]\r\n            if cnt[nums[i - k]] == 0:\r\n                cnt.pop(nums[i - k])\r\n            if len(cnt) >= m:\r\n                ans = max(ans, s)\r\n        return ans",
