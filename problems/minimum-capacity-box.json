    "language": "python3",
    "code": "class Solution:\r\n    def minimumIndex(self, capacity: list[int], itemSize: int) -> int:\r\n        ans = -1\r\n        for i, x in enumerate(capacity):\r\n            if x >= itemSize and (ans == -1 or x < capacity[ans]):\r\n                ans = i\r\n        return ans",
