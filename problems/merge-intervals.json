{
    "problemName": "merge-intervals",
    "language": "python3",
    "code": "class Solution:\r\n    def merge(self, intervals: List[List[int]]) -> List[List[int]]:\r\n        intervals.sort()\r\n        ans = []\r\n        st, ed = intervals[0]\r\n        for s, e in intervals[1:]:\r\n            if ed < s:\r\n                ans.append([st, ed])\r\n                st, ed = s, e\r\n            else:\r\n                ed = max(ed, e)\r\n        ans.append([st, ed])\r\n        return ans",
